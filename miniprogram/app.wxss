/* 🔴 裁 #22(店主 05w §三)· 病根是**写死色**,不是变量继承 ══
   店主亲看:小程序挂上 `theme-dark` 之后,只有英雄块变深,别的面还是白底深字。
   查明:`.theme-dark` 那 30 个令牌一条不少、类也挂对了 —— **可这些面根本没读令牌**,
   读的是**字面色**(纸底、白卡、描边那几个十六进制值),字面色不会跟着主题走。
   英雄块之所以是深的,正因为**只有它用了 `var(--…)`**。
   改法就一条:这些面改成读令牌,**值只从 `styles/tokens.wxss` 出,一个新字面色都不许加**。
   店主否掉的两条:①再写死一份深色(把症状盖住,方向与病根相反)②砍掉站内三档(与她「白天/晚上两种模式」直接冲突)。
   同族棘轮见 `tools/pre-regression.sh` 的「小程序 wxss 写死色」那一条。 */
/* 🔴 D168 段 4:设计令牌**先引进来**(值与网页 `design-tokens.css` 逐条相等,同一把刀比三份)。
   `@import` 必须排在最前:后面所有页面的 `var(--x)` 都靠它。 */
@import "styles/tokens.wxss";
/* 站内显式选的那两档要**把整屏铺满并上底色** —— 令牌换了,页面根节点(`page`)那一层
   还挂着浅色档的值(class 在里面那个 view 上)。这条只写在 app.wxss 里,
   而 app.wxss **不作用于自定义组件**,所以 tabbar 那类组件不会被它撑成整屏(05x 现踩)。 */
.theme-light, .theme-dark { min-height: 100vh; background: var(--paper); color: var(--ink); }
/* D181:数字大字的 Fraunces(woff2 子集 base64 内嵌;只有数字与几个币符,中文一个字都没有) */
@import "styles/fraunces-digits.wxss";

page {
  min-height: 100%;
  background: var(--paper);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
  font-size: 28rpx;
  overflow-x: hidden;
}

view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}

button {
  padding: 0;
  margin: 0;
  border: none;
  /* 二形法(店主 01u):能点的都是胶囊 —— 全局复位从 0 改 999rpx,裸 button 也不长歪 */
  border-radius: 999rpx;
  background: transparent;
  color: inherit;
  line-height: 1.2;
}

button::after {
  border: none;
}

.page {
  width: 100%;
  min-height: 100vh;
  padding: 28rpx 28rpx 160rpx;
  overflow-x: hidden;
}

.page-title {
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 650;
  letter-spacing: 0;
}

.section {
  margin-top: 34rpx;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 0;
}

.section-note {
  color: var(--sub);
  font-size: 24rpx;
}

.card {
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  background: var(--card);
}

.muted {
  color: var(--sub);
}.btn {
  height: 88rpx;
  padding: 0 34rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 650;
}

.btn-primary {
  background: var(--brand);
  color: var(--hero);
}

.btn-ghost {
  border: 1rpx solid var(--line);
  background: var(--card);
  color: var(--ink);
}

.btn-dark {
  background: var(--hero);
  color: var(--heroink);
}

.price {
  color: var(--brand);
  font-weight: 700;
}

.bottom-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  display: flex;
  gap: 18rpx;
  align-items: center;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--line);
  background: var(--card);
  box-sizing: border-box;
}

.bottom-fill {
  flex: 1;
  min-width: 0;
}

.empty {
  padding: 96rpx 32rpx;
  text-align: center;
  color: var(--sub);
}

.visual {
  position: relative;
  overflow: hidden;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #f4e6dc 0%, #fff8f0 48%, #d9b99c 100%);
}

.visual::before,
.visual::after {
  position: absolute;
  content: "";
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.55);
}

.visual::before {
  width: 180rpx;
  height: 180rpx;
  right: -60rpx;
  top: -40rpx;
}

.visual::after {
  width: 130rpx;
  height: 130rpx;
  left: -38rpx;
  bottom: -32rpx;
}

.image-placeholder {
  position: relative;
  overflow: hidden;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #fff8f1 0%, #f0dfd1 58%, #d7b792 100%);
}

.image-placeholder::before,
.image-placeholder::after {
  position: absolute;
  content: "";
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.68);
}

.image-placeholder::before {
  width: 172rpx;
  height: 172rpx;
  right: -44rpx;
  top: -46rpx;
}

.image-placeholder::after {
  width: 128rpx;
  height: 128rpx;
  left: -42rpx;
  bottom: -42rpx;
}

.image-label {
  position: absolute;
  left: 22rpx;
  bottom: 18rpx;
  z-index: 1;
  color: var(--sub);
  font-size: 24rpx;
  font-weight: 700;
}

.image-placeholder > text {
  position: relative;
  z-index: 1;
}

/* D89(店主 08-30f 实测:placeholder 上下截半,打字后正常)—— 一条全局规格管所有框(批次五手法):
   根因=placeholder 层吃 CSS line-height(会从父容器继承紧行高),已输入文字走原生排版不受影响;
   padding 撑高、无显式行高的框在部分机型上 placeholder 半截。
   规格:行高归 normal + 最小高度兜底 + border-box —— 类规则里显式 height 的框优先级更高,不受扰。 */
input { line-height: normal; min-height: 76rpx; box-sizing: border-box; }
textarea { line-height: 1.5; box-sizing: border-box; }
