:host{display:block}.dp{margin:24rpx 0;padding:28rpx;border:1rpx solid var(--line);border-radius:12rpx;background:var(--card);color:var(--ink);font-size:26rpx;line-height:1.6}.dp-head{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-bottom:24rpx;flex-wrap:wrap}.dp-title{font-size:30rpx;font-weight:600}.dp-badge{padding:6rpx 16rpx;background:var(--wall);color:var(--brandd);border-radius:999rpx;font-size:22rpx}.dp-row{display:flex;justify-content:space-between;gap:24rpx;padding:12rpx 0}.dp-value{text-align:right;font-weight:500;font-variant-numeric:tabular-nums;flex-shrink:0}.dp-total{border-top:1rpx solid var(--line);margin-top:12rpx;padding-top:20rpx;font-weight:600}.dp-note{font-size:24rpx;line-height:1.65;color:var(--sub);margin-top:12rpx;word-break:break-all}.dp-actions{display:flex;gap:16rpx;margin-top:28rpx;flex-wrap:wrap}.dp-actions .dp-button{margin:0;padding:0 24rpx;background:var(--brand);color:var(--hero);border-radius:999rpx;font-size:26rpx;line-height:76rpx;min-height:76rpx;flex:1;white-space:nowrap}.dp-actions .dp-ghost{background:var(--card);color:var(--brandd);border:1rpx solid var(--line)}.dp-actions .dp-button::after,.dp-close::after{border:0}.dp-veil{position:fixed;inset:0;background:rgba(35,30,24,.38);z-index:980;display:flex;align-items:center;justify-content:center;padding:28rpx;box-sizing:border-box}.dp-modal{background:var(--card);width:100%;max-height:85vh;overflow-y:auto;border-radius:12rpx;padding:32rpx;box-sizing:border-box;color:var(--ink);font-size:26rpx}.dp-close{padding:0;margin:0;width:56rpx;line-height:56rpx;background:transparent;color:var(--sub);font-size:36rpx}.dp-field{display:block;margin-top:24rpx}.dp-label{display:block;margin-bottom:10rpx;color:var(--sub);font-size:24rpx}.dp-edit,.dp-input{border:1rpx solid var(--line);background:var(--card);border-radius:12rpx;height:80rpx;min-height:80rpx;padding:0 22rpx;box-sizing:border-box;font-size:28rpx}.dp-input{display:flex;align-items:center;justify-content:space-between}.dp-warning{background:var(--tagmbg);padding:20rpx;border-radius:12rpx}.dp-error{color:var(--bad);margin-top:16rpx;line-height:1.6}.dp-event{padding:24rpx 0;border-top:1rpx solid var(--line)}.dp-history{margin-top:24rpx}
.dp-edit,.dp-input{color:var(--ink);background:var(--paper)}

.dp-modal>.dp-actions{position:sticky;bottom:-32rpx;background:var(--card);padding:24rpx 0;border-top:1rpx solid var(--line)}
.dp-modal>.dp-actions .dp-button{flex:1 1 100%;white-space:normal;line-height:1.5;padding:18rpx 24rpx;overflow:visible;word-break:break-word}
