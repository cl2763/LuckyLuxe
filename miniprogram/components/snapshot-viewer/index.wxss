.sv-mask{position:fixed;left:0;right:0;top:0;bottom:0;background:rgba(20,16,14,.86);z-index:1000;display:flex;align-items:center;justify-content:center}
.sv-box{width:92vw;height:82vh;display:flex;flex-direction:column}
.sv-head{display:flex;align-items:center;justify-content:space-between;padding:0 8rpx 16rpx}
.sv-title{color:#fff;font-size:28rpx;font-weight:600}
.sv-page{color:rgba(255,255,255,.7);font-size:24rpx}
.sv-close{color:#fff;font-size:36rpx;padding:0 12rpx}
/* stage 必须纵向 flex:横向时 flex:1 只给宽度,swiper 高度会塌成默认值(08-23 实拍抓到) */
.sv-stage{flex:1;position:relative;display:flex;flex-direction:column}
.sv-swiper{flex:1;height:100%;background:#fff;border-radius:16rpx;overflow:hidden}
.sv-scroll{height:100%}
.sv-img{width:100%}
.sv-arrow{position:absolute;top:50%;transform:translateY(-50%);width:72rpx;height:96rpx;line-height:92rpx;text-align:center;font-size:52rpx;color:#fff;background:rgba(20,16,14,.42);border-radius:12rpx;z-index:2}
.sv-arrow.left{left:12rpx}
.sv-arrow.right{right:12rpx}
.sv-tip{text-align:center;color:rgba(255,255,255,.65);font-size:22rpx;padding-top:14rpx}
