@import '../../styles/tokens-component.wxss';
.cc-mask{position:fixed;inset:0;z-index:300;background:rgba(0,0,0,.5);display:flex;align-items:center;justify-content:center;padding:32rpx;box-sizing:border-box}
.cc-panel{background:var(--card);color:var(--ink);border:1rpx solid var(--line);border-radius:24rpx;padding:36rpx;width:100%;box-sizing:border-box;max-height:85vh;overflow:auto}
.cc-title{font-family:serif;font-size:34rpx;font-weight:700;margin-bottom:24rpx}.cc-label{font-size:27rpx;margin:24rpx 0 12rpx}.cc-required,.cc-note{color:var(--sub)}
.cc-input{background:var(--paper);color:var(--ink);border:1rpx solid var(--line);padding:18rpx;border-radius:14rpx;font-size:28rpx}
.cc-note,.cc-error{font-size:24rpx;line-height:1.7;margin:20rpx 0}.cc-error{color:var(--bad)}
.cc-button{font-size:25rpx;white-space:normal;line-height:1.5;padding:16rpx 24rpx;background:var(--card);color:var(--ink);border-radius:40rpx;border:1rpx solid var(--line);margin:12rpx 0}.cc-button::after{border:0}.cc-actions{display:flex;justify-content:flex-end;gap:16rpx}.cc-actions .cc-button{margin:0}.cc-save{background:var(--hero);color:var(--heroink)}
