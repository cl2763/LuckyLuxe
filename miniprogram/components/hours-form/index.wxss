.hf-day { display: flex; align-items: center; gap: 16rpx; padding: 18rpx 0; border-bottom: 2rpx dashed #e2e0d8; }
.hf-sw { transform: scale(.8); }
.hf-dn { width: 4.4em; font-size: 28rpx; }
.hf-tm { margin-left: auto; font-size: 26rpx; background: #f1efe9; border-radius: 8rpx; padding: 6rpx 16rpx; color: #6b6f66; }
.hf-tm.set { margin-left: auto; background: #eef4f2; color: #20211f; }
.hf-tm.set + .hf-dash + .hf-tm.set { margin-left: 0; }
.hf-dash { color: #6b6f66; }
.hf-tm.ph { margin-left: auto; }
.hf-save { margin-top: 36rpx; text-align: center; border-radius: 12rpx; padding: 22rpx 0; font-size: 30rpx; font-weight: 700; }
.hf-save.go { background: #0e6e62; color: #fff; }
.hf-save.dis { background: #f1efe9; color: #6b6f66; }
.hf-note { text-align: center; font-size: 24rpx; color: #b45309; margin-top: 12rpx; }
