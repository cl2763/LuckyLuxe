/* 颜色一律裸 var(--x),圆角取形制集 {999rpx, 12rpx, 50%} —— 10b/10c 两批的教训 */
.sdm{margin:24rpx;padding:24rpx;border-radius:12rpx;background:var(--card);border:1rpx solid var(--line)}
.sdm-hd{font-size:28rpx;font-weight:700;margin-bottom:12rpx}
.sdm-empty{border:1rpx dashed var(--line);border-radius:12rpx;padding:32rpx 20rpx;text-align:center;color:var(--sub);font-size:24rpx;white-space:pre-line}
.sdm-row{display:flex;align-items:center;gap:18rpx;padding:16rpx 0;border-top:1rpx solid var(--line)}
.sdm-row:first-of-type{border-top:0}
.sdm-th{width:60rpx;height:78rpx;flex:none;border:1rpx solid var(--line);border-radius:12rpx;background:var(--wall)}
.sdm-tx{flex:1;min-width:0}
.sdm-nm{font-size:26rpx;font-weight:600}
.sdm-mt{font-size:22rpx;color:var(--sub)}
.sdm-note{font-size:22rpx;color:var(--sub);margin-top:12rpx}
