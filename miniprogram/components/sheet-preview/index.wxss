.spmask{position:fixed;inset:0;background:rgba(24,20,16,.5);z-index:120}
.spcard{position:fixed;left:32rpx;right:32rpx;top:8vh;max-height:84vh;background:var(--card);border-radius:24rpx;z-index:121;display:flex;flex-direction:column;padding:26rpx 26rpx 20rpx;box-shadow:0 14rpx 48rpx rgba(40,34,28,.25)}
.sploading{text-align:center;color:var(--sub);font-size:24rpx;padding:60rpx 0}
.sphead{display:flex;align-items:center;gap:14rpx}
.sptitle{font-size:30rpx;font-weight:700;color:var(--ink);flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.spstamp{font-size:20rpx;padding:4rpx 14rpx;border-radius:999rpx;flex-shrink:0}
.spstamp.signed{background:var(--goodbg);color:var(--good)}
.spstamp.pending{background:var(--paper);color:var(--brandd)}
.spx{font-size:32rpx;color:var(--sub);padding:0 8rpx;flex-shrink:0}
.spsub{font-size:22rpx;color:var(--sub);margin:8rpx 0 12rpx;overflow-wrap:anywhere}
.spbody{flex:1;min-height:0;max-height:56vh}
.spgt{font-size:24rpx;font-weight:600;color:var(--ink);margin:12rpx 0 6rpx}
.spline{display:flex;justify-content:space-between;align-items:center;padding:8rpx 0;border-bottom:1rpx solid var(--line)}
.spname{font-size:24rpx;color:var(--sub);flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.spamt{display:flex;align-items:baseline;gap:10rpx;flex-shrink:0}
.spstrike{font-size:20rpx;color:var(--sub);text-decoration:line-through}
.spstrike.big{font-size:24rpx}
.spval{font-size:26rpx;font-weight:600;color:var(--ink)}
.spval.free{color:var(--good)}
.sptot{margin-top:14rpx;border-top:2rpx solid var(--line);padding-top:10rpx}
.sprow{display:flex;justify-content:space-between;padding:6rpx 0}
.spk{font-size:24rpx;color:var(--sub)}
.spv{font-size:26rpx;color:var(--ink);font-weight:600}
.green{color:var(--good)}
.sprow.due .spk{font-size:26rpx;color:var(--ink);font-weight:700}
.sprow.due .spv{font-size:34rpx;font-weight:800}
.spsign{margin-top:16rpx;background:var(--paper);border-radius:14rpx;padding:14rpx 18rpx}
.spsig{font-size:34rpx;font-family:cursive;color:var(--ink);margin-top:6rpx}
.spsigat{font-size:20rpx;color:var(--sub);margin-left:16rpx;font-family:initial}
.spbtns{display:flex;gap:16rpx;margin-top:16rpx}.spbtn {flex:1;text-align:center;background:var(--hero);color:var(--heroink);border-radius:999rpx;padding:20rpx 0;font-size:26rpx}
.spbtn.ghost{background:var(--wall);color:var(--ink)}
.spbtn.wide{flex:1}

/* D60 组卡自证区 */
.spgroupnote{margin:8rpx 24rpx 0;padding:12rpx 16rpx;background:var(--paper);border:1rpx solid var(--line);border-radius:12rpx}
.spgn-t{font-size:22rpx;font-weight:700;color:var(--brandd);margin-bottom:4rpx}
.spgn-row{display:flex;justify-content:space-between;font-size:22rpx;color:var(--sub);padding:2rpx 0}
.spnotice{margin:8rpx 24rpx 0;padding:10rpx 16rpx;background:var(--badbg);border:1rpx solid var(--line);border-radius:10rpx;font-size:22rpx;color:var(--bad)}
