.card{padding:28rpx;margin:24rpx 0;background:var(--card);border:1rpx solid var(--line);border-radius:12rpx;color:var(--ink)}.title{font-size:30rpx;font-weight:600;margin:12rpx 0}.row{display:flex;justify-content:space-between;gap:24rpx;padding:16rpx 0}.hint{font-size:24rpx;color:var(--sub);line-height:1.6;margin:12rpx 0}.actions{display:flex;gap:16rpx}.actions button{flex:1}button{border-radius:999rpx;font-size:26rpx}.primary{background:var(--hero);color:var(--heroink)}textarea{width:100%;box-sizing:border-box;padding:24rpx;border:1rpx solid var(--line);margin:24rpx 0}.history{padding:16rpx 0;border-bottom:1rpx solid var(--line)}.error{color:var(--bad)}

.history{overflow-wrap:anywhere;word-break:break-all}

button{min-height:80rpx;line-height:1.4;padding:20rpx 24rpx;margin:16rpx 0;box-sizing:border-box;border:1rpx solid var(--line);background:var(--card);color:var(--ink)}button.primary{background:var(--hero);color:var(--heroink)}.actions{align-items:stretch}.actions button{margin:0}.history{line-height:1.6}

.mask{position:fixed;inset:0;background:#0006;z-index:999;display:flex;align-items:center;padding:32rpx}.sheet{width:100%;padding:28rpx;background:var(--card);border-radius:12rpx;box-sizing:border-box}.records{max-height:65vh}.sheet .row{align-items:center}.sheet button{margin:0}
