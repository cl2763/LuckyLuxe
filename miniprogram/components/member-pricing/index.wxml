<view wx:if="{{error}}" class="card error">{{error}}<button bindtap="load">重新读取</button></view><view wx:if="{{member.active}}" class="card"><view class="title">{{en?'Your member benefits':'个人会员权益'}}</view><view class="row"><text>{{en?'Membership':'会员资格'}}</text><text>{{member.eligibilityText}}</text></view><view class="row"><text>{{en?'Personal discount':'个人折扣'}}</text><text>{{member.discountText}}</text></view><view wx:if="{{customer && showBalance}}" class="row"><text>{{en?'Stored balance':'储值余额'}}</text><text>{{balanceText}}</text></view><view class="hint">{{member.statusText}}</view><button wx:if="{{isOwner && !editing}}" class="ghost" bindtap="edit">调整个人折扣</button><view wx:if="{{editing}}"><discount-wheel value="{{rateBps}}" bindchange="rate"/><textarea value="{{reason}}" bindinput="reason" maxlength="300" placeholder="填写调整原因"/><view class="actions"><button class="primary" loading="{{saving}}" disabled="{{saving}}" bindtap="save">确认调整</button><button bindtap="close">取消</button></view></view><button wx:if="{{!customer && history.length}}" class="ghost" bindtap="toggleHistory">查看折扣记录</button><view wx:if="{{!customer && showHistory}}" class="mask" catchtap="toggleHistory"><view class="sheet" catchtap="noop"><view class="row"><text class="title">折扣修改记录</text><button bindtap="toggleHistory">关闭</button></view><scroll-view scroll-y class="records"><view class="history" wx:for="{{history}}" wx:key="id"><text>{{item.beforeText}} → {{item.afterText}}</text><view class="hint">{{item.createdText}} · {{item.actor}} · {{item.sourceText}}</view><view class="hint">{{item.reason}}</view><view wx:if="{{item.source_id}}" class="hint">来源 {{item.source_id}}</view><view wx:if="{{item.source==='recharge'}}" class="hint">充值本金 / 赠金 {{item.principalText}} / {{item.bonusText}}</view></view></scroll-view></view></view></view>
