.ph-img { display: block; width: 100%; height: 100%; }
.ph-box {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  width: 100%; height: 100%; min-height: 120rpx; box-sizing: border-box;
  background: repeating-linear-gradient(45deg, rgba(0,0,0,.02) 0 16rpx, rgba(0,0,0,.05) 16rpx 32rpx);
  border: 1rpx dashed #ded7cf; color: #9a938c;
}
/* 相机图标:纯 CSS 画,免得又引一张图(引图=这块自己也可能变成"图没上传") */
.ph-cam {
  width: 44rpx; height: 34rpx; border: 2rpx solid currentColor; border-radius: 6rpx; position: relative; opacity: .6;
}
.ph-cam::before { content: ''; position: absolute; top: -10rpx; left: 12rpx; width: 18rpx; height: 8rpx; border: 2rpx solid currentColor; border-bottom: none; border-radius: 4rpx 4rpx 0 0; }
.ph-cam::after { content: ''; position: absolute; top: 8rpx; left: 13rpx; width: 14rpx; height: 14rpx; border: 2rpx solid currentColor; border-radius: 50%; }
.ph-txt { font-size: 22rpx; margin-top: 8rpx; }
