.binding-card{margin:24rpx 0;padding:32rpx;background:var(--card,#fff);color:var(--ink,#292520);border:1rpx solid var(--line,#e7e2d8);border-radius:24rpx}.title{font-size:32rpx;font-weight:700}.status{font-size:28rpx;font-weight:600;margin:20rpx 0}.hint{font-size:25rpx;line-height:1.7;color:var(--sub,#746b60)}.actions{display:flex;flex-wrap:wrap;gap:20rpx;margin:24rpx 0}.actions button{margin:0;padding:0 28rpx;min-height:88rpx;line-height:88rpx;font-size:26rpx;background:var(--ink,#292520);color:var(--paper,#faf8f2);border-radius:999rpx}.actions .secondary{background:var(--paper,#faf8f2);color:var(--ink,#292520);border:1rpx solid var(--line,#ddd)}.code{display:block;width:440rpx;max-width:100%;height:440rpx;margin:24rpx auto}.error{font-size:26rpx;line-height:1.6;margin-top:20rpx}
