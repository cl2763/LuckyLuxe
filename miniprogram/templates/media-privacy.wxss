.media-privacy-overlay{position:fixed;inset:0;z-index:10000;background:rgba(0,0,0,.62);display:flex;align-items:center;justify-content:center;padding:36rpx;box-sizing:border-box}
.media-privacy-card{width:100%;padding:34rpx;box-sizing:border-box;border-radius:12rpx;background:var(--card);color:var(--ink)}
.media-privacy-title{font-size:34rpx;font-weight:600}.media-privacy-copy{font-size:26rpx;line-height:1.6;margin:20rpx 0;color:var(--sub)}
.media-privacy-link{font-size:25rpx;color:var(--brandd);margin-bottom:22rpx;text-decoration:underline}
.media-privacy-agree,.media-privacy-cancel{font-size:27rpx;border-radius:999rpx;margin-top:14rpx}.media-privacy-agree{background:var(--brand);color:var(--hero)}.media-privacy-cancel{background:var(--wall);color:var(--ink)}
