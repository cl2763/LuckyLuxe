<view class="page privacy-page {{themeClass}}">
  <view class="card privacy-summary">
    <view class="privacy-title">{{policy.title}}</view>
    <view class="privacy-meta">{{policy.operator}}</view>
    <view class="privacy-meta">生效日期：{{policy.effectiveDate}}</view>
    <button class="privacy-contact" hover-class="tap-feedback" bindtap="callPrivacy">隐私咨询 / 删除 / 撤回申请 · {{policy.phone}}</button>
  </view>
  <view wx:for="{{policy.sections}}" wx:key="title" class="card privacy-section">
    <view class="privacy-heading">{{item.title}}</view>
    <view wx:for="{{item.paragraphs}}" wx:for-item="paragraph" wx:key="*this" class="privacy-paragraph">{{paragraph}}</view>
  </view>
  <button class="privacy-wechat" hover-class="tap-feedback" bindtap="openWechatPolicy">查看微信隐私保护指引</button>
</view>
