<view wx:if="{{order}}" class="page order-detail-page">
  <!-- 批③首件 A1(§二):头卡=服务名+状态徽标(后端三态同源)+单号 -->
  <view class="detail-card card">
    <view class="status-line">
      <text wx:if="{{order.listBadgeText}}" class="status badge-{{order.listBadgeKind}}">{{order.listBadgeText}}</text>
      <text wx:else>{{order.statusText}}</text>
    </view>
    <view class="service-name">{{order.serviceInfo.serviceName}}</view>
    <view class="muted">{{t.orderNo}} {{order.orderNo}}</view>
    <image class="order-cover" src="{{order.serviceImage}}" mode="aspectFill"></image>
  </view>

  <view class="section">
    <view class="section-head">
      <view class="section-title">{{t.bookingInfo}}</view>
    </view>
    <view class="info-card card">
      <view class="info-row">
        <text>{{t.arrival}}</text>
        <text>{{order.appointment.date}} {{order.appointment.time}}</text>
      </view>
      <view class="info-row">
        <text>{{t.duration}}</text>
        <text>{{order.serviceInfo.duration}}{{t.minutes}}</text>
      </view>
      <view class="info-row">
        <text>{{t.technician}}</text>
        <text>{{order.serviceInfo.technicianName}}</text>
      </view>
      <view class="info-row">
        <text>{{t.store}}</text>
        <text>{{order.store.storeName}}</text>
      </view>
      <view class="info-row">
        <text>{{t.address}}</text>
        <text>{{order.store.address}}</text>
      </view>
      <view class="info-row">
        <text>{{t.remark}}</text>
        <text>{{order.appointment.remark || t.none}}</text>
      </view>
    </view>
  </view>

  <!-- 批③首件 A2/A3/A6(§二):服务签署单卡=后端 flow 一条五步账直贴(与签署页/快照同源);
       旧「实付」行消亡;未签署的完成单=「本单未产生结算单」明示空态(不放例句) -->
  <view class="section">
    <view class="section-head">
      <view class="section-title">服务签署单</view>
      <!-- D67②:标题右侧小字去 Emoji(店主 08-22) -->
      <view wx:if="{{order.pay}}" class="section-note">已签署 {{order.pay.signedAt}}</view>
    </view>
    <!-- L3 裁(店主 08-22):多张单=顶部组汇总行(Σ各张头条,与组卡同构)+逐张签署单卡(各自五步账+头条+原件) -->
    <block wx:if="{{order.pay && order.pay.sheets.length > 1}}">
      <view class="info-card card">
        <view class="info-row hero"><text>{{order.pay.groupCashLabel}}</text><text class="price">{{order.pay.groupCashText}}</text></view>
      </view>
      <view class="info-card card" wx:for="{{order.pay.sheets}}" wx:for-item="sh" wx:key="code">
        <!-- D68 文案:行首=后端句「服务确认单 n/N · 状态」(不出「第 n/N 张」内部话术) -->
        <view class="info-row"><text>{{sh.label}}</text><text class="muted">{{sh.signedAtText}}</text></view>
        <view class="info-row" wx:for="{{sh.flowLines}}" wx:for-item="fl" wx:key="key">
          <text>{{fl.label}}</text><text>{{fl.amountText}}</text>
        </view>
        <view class="info-row hero"><text>{{sh.heroLabel}}</text><text class="price">{{sh.heroText}}</text></view>
        <!-- D68②:原件=悬浮查看器(不跳页=不压栈,D68① 同族) -->
        <view class="as-link" data-code="{{sh.code}}" bindtap="openViewer">查看原件 ›</view>
      </view>
    </block>
    <view class="info-card card" wx:elif="{{order.pay}}">
      <view class="info-row" wx:for="{{order.pay.flowLines}}" wx:for-item="fl" wx:key="key">
        <text>{{fl.label}}</text><text>{{fl.amountText}}</text>
      </view>
      <view class="info-row hero"><text>{{order.pay.heroLabel}}</text><text class="price">{{order.pay.heroText}}</text></view>
      <view class="as-link" bindtap="openViewer">查看服务确认单原件 ›</view>
    </view>
    <view class="info-card card" wx:elif="{{order.status === 'completed' || order.status === 'after_sales'}}">
      <view class="archive-empty">本单未产生结算单</view>
    </view>
    <view class="info-card card" wx:else>
      <view class="info-row"><text>服务总价</text><text wx:if="{{order.servicePrice !== null}}">{{cur.p}}{{cur.s}}{{order.servicePrice}}</text><text wx:else>—</text></view>
      <view wx:if="{{order.depositState === 'received'}}" class="info-row"><text>定金(已收)</text><text class="price" wx:if="{{order.payableAmount !== null}}">{{cur.p}}{{cur.s}}{{order.payableAmount}}</text><text wx:else>—</text></view>
      <view wx:elif="{{order.depositState === 'unpaid'}}" class="info-row"><text>定金(待到店支付)</text><text>—</text></view>
      <view class="info-row"><text>到店结算</text><text>按当日结算单为准</text></view>
    </view>
  </view>

  <!-- 批③首件 A4(§二):留档卡=有则显示,无则整卡不出现(不占位)。
       批④ S8 顺序件(店主 08-24):四块顺序双端统一为 预约信息 → 签署单 → **服务留档** → 去售后
       (原小程序把售后排在留档前、网页把留档排在签署单前,双端各不同且都与图不同=四之九分叉)。
       裁:技师小记不给顾客看,留档只留照片。 -->
  <view wx:if="{{order.visibleWorkImages.length}}" class="section">
    <view class="section-head">
      <view class="section-title">{{lang === 'en' ? 'Service Archive' : '服务留档'}}</view>
      <view class="section-note">{{order.serviceInfo.technicianName}}</view>
    </view>
    <view class="archive-card card">
      <view class="work-grid">
        <block wx:for="{{order.visibleWorkImages}}" wx:key="*this">
          <button class="work-thumb" bindtap="previewWork" data-url="{{item}}">
            <image src="{{item}}" mode="aspectFill"></image>
          </button>
        </block>
      </view>
    </view>
  </view>

  <!-- 批③首件 屏B:售后区——按钮句后端唯一;同屏展开表单(不弹层);D3 三步进度卡 -->
  <view class="section" wx:if="{{order.afterSalesAction}}">
    <view class="info-card card">
      <view class="as-btn" bindtap="asAction">{{order.afterSalesActionText}}</view>
      <block wx:if="{{asPanelOpen}}">
        <textarea class="as-desc" placeholder="问题描述(必填):哪里不满意/出了什么状况" value="{{asDesc}}" bindinput="onAsDesc" maxlength="300"></textarea>
        <view class="as-submit {{asSubmitting ? 'ing' : ''}}" bindtap="submitAfterSales">{{asSubmitting ? '提交中…' : '提交,转人工跟进'}}</view>
        <view class="as-note">提交后门店会跟进处理;涉及退款/补差走门店更正单,这里只记录过程与结论。</view>
      </block>
    </view>
  </view>
  <view class="section as-progress-card" wx:if="{{order.afterSales}}">
    <view class="section-head"><view class="section-title">{{order.afterSales.title}}</view></view>
    <view class="info-card card">
      <view class="as-step" wx:for="{{order.afterSales.steps}}" wx:for-item="st" wx:key="key">
        <view class="as-dot {{st.done ? 'on' : ''}}"></view>
        <view class="as-step-main"><view class="as-step-t">{{st.label}}</view><view class="as-step-at">{{st.at}}</view></view>
      </view>
      <view wx:if="{{order.afterSalesAction === 'progress'}}" class="as-link" bindtap="withdrawAfterSales">撤回本次售后(记录保留)</view>
    </view>
  </view>

  <!-- D68③(店主 08-23 裁):浮层查看器=全仓共用组件(顾客端/商家端同一份实现) -->
  <snapshot-viewer open="{{viewer.open}}" items="{{viewer.items}}" index="{{viewer.index}}" bind:close="closeViewer"></snapshot-viewer>

  <view wx:if="{{order.status === 'pending_service'}}" class="bottom-bar">
    <button class="btn btn-ghost bottom-fill" bindtap="callStore">{{t.support}}</button>
    <button class="btn btn-ghost bottom-fill" bindtap="openLocation">{{t.nav}}</button>
    <button class="btn btn-primary bottom-fill" bindtap="cancelOrder">{{t.cancel}}</button>
  </view>
</view>
