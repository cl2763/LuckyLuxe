.detail-card {
  padding: 34rpx;
}

.order-cover {
  display: block;
  width: 100%;
  height: 260rpx;
  margin-top: 24rpx;
  border-radius: 16rpx;
}

.status-line {
  color: #c6a27e;
  font-size: 25rpx;
  font-weight: 700;
}

.service-name {
  margin: 14rpx 0;
  font-size: 40rpx;
  font-weight: 800;
}

.info-card {
  padding: 8rpx 26rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f0e8e1;
  color: #5e514b;
}

.info-row:last-child {
  border-bottom: none;
}

.info-row text:last-child {
  max-width: 420rpx;
  text-align: right;
  color: #3a2e2a;
}

.archive-card {
  padding: 8rpx 24rpx 24rpx;
}

.work-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 12rpx;
}

.work-thumb {
  height: 168rpx;
  overflow: hidden;
  border-radius: 14rpx;
}

.work-thumb image {
  width: 100%;
  height: 100%;
  display: block;
}

.archive-empty {
  padding: 36rpx 0 16rpx;
  color: #8a7f78;
  font-size: 25rpx;
  font-weight: 600;
  text-align: center;
}

.strike{text-decoration:line-through;color:#b9b3a8}

/* 批③首件:签署单卡+售后区 */
.info-row.hero{font-size:32rpx;font-weight:850;border-top:1rpx solid #f2ebe3;margin-top:8rpx;padding-top:14rpx}
.info-row.hero .price{color:#9b7655}
.as-link{margin-top:14rpx;text-align:center;font-size:24rpx;color:#9b7655;text-decoration:underline}
.as-btn{background:#2d2826;color:#fff;text-align:center;padding:22rpx;border-radius:14rpx;font-size:28rpx;font-weight:800}
.as-desc{width:100%;min-height:160rpx;background:#faf6f1;border:1rpx solid #ece2d6;border-radius:12rpx;padding:16rpx;font-size:26rpx;margin-top:16rpx;box-sizing:border-box}
.as-submit{margin-top:14rpx;background:#9b7655;color:#fff;text-align:center;padding:20rpx;border-radius:12rpx;font-size:27rpx;font-weight:700}
.as-submit.ing{background:#b3a89c}
.as-note{margin-top:10rpx;font-size:21rpx;color:#9a8c7c;line-height:1.6}
.as-step{display:flex;gap:14rpx;padding:10rpx 0}
.as-dot{width:22rpx;height:22rpx;border-radius:50%;background:#ded4ca;margin-top:8rpx;flex:none}
.as-dot.on{background:#2f7d5c}
.as-step-t{font-size:25rpx;color:#241f1d;line-height:1.5}
.as-step-at{font-size:20rpx;color:#9a8c7c;margin-top:2rpx}
.status.badge-signed{color:#2f7d5c}
.status.badge-amended{color:#a8551f}
.status.badge-aftersales{color:#a34c48}
