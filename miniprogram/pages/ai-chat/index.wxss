page{background:var(--paper);height:100%}
.pg{display:flex;flex-direction:column;height:100vh}
.chat{flex:1;padding:24rpx 24rpx 0;box-sizing:border-box;overflow:hidden}
.row{display:flex;margin-bottom:20rpx;align-items:flex-start;gap:12rpx}
.row.c{flex-direction:row-reverse}
.av{width:56rpx;height:56rpx;border-radius:50%;background:var(--hero);color:var(--herogold);font-size:20rpx;display:flex;align-items:center;justify-content:center;flex:0 0 auto}
.bubble{max-width:74%;font-size:26rpx;line-height:1.65;padding:18rpx 22rpx;border-radius:18rpx;white-space:pre-wrap;word-break:break-word}
.bubble.a{background:var(--card);border:1rpx solid var(--line);color:var(--ink);border-top-left-radius:6rpx}
.bubble.c{background:var(--brand);color:var(--hero);border-top-right-radius:6rpx}
.bubble.ho{border-color:var(--line);background:var(--paper)}
.bubble.typing{color:var(--sub)}
.quick{white-space:nowrap;padding:12rpx 20rpx;flex:none}.chip {display:inline-block;font-size:23rpx;color:var(--brandd);background:var(--wall);border:1rpx solid var(--line);border-radius:999rpx;padding:10rpx 24rpx;margin-right:12rpx}
.bar{display:flex;gap:14rpx;align-items:center;padding:14rpx 20rpx calc(20rpx + env(safe-area-inset-bottom));background:var(--card);border-top:1rpx solid var(--line);flex:none}
.inp{flex:1;font-size:26rpx;background:var(--paper);border:1rpx solid var(--line);border-radius:40rpx;padding:16rpx 26rpx}.sendbtn {font-size:26rpx;color:var(--hero);background:var(--brand);border-radius:999rpx;padding:16rpx 34rpx;flex:none}
.sendbtn.off{opacity:.5}
