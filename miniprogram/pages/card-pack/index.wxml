<view class="page card-pack-page {{themeClass}}">
  <view wx:if="{{loading}}" class="empty">加载中…</view>
  <view wx:elif="{{error}}" class="empty">{{error}}</view>
  <block wx:elif="{{pack}}"><view class="empty-btn" bindtap="goMall">充值套餐与次卡商城</view>
    <view wx:if="{{pack.migration.hasPending}}" class="cp-card card"><view class="cp-name">{{pack.migration.title}}</view><view class="cp-sub">{{pack.migration.message}}</view></view>
    <view class="cp-filters"><button wx:for="{{filters}}" wx:key="key" data-key="{{item.key}}" bindtap="filterChange" class="cp-filter {{filter===item.key?'selected':''}}">{{item.name}}</button></view>
    <view wx:if="{{pack.emptyText}}" class="empty-state">
      <view class="empty-t">{{pack.emptyText}}</view>
      <view class="empty-btn" bindtap="goMall">去商城看看</view>
    </view>
    <view wx:if="{{(filter==='all'||filter==='service') && pack.timecards.length}}" class="sec">
      <view class="sec-hd">
        <text class="sec-t">次卡</text>
        <text class="sec-link" bindtap="goMallTimecards">去商城 ›</text>
      </view>
      <view class="cp-card card" wx:for="{{pack.timecards}}" wx:for-item="c" wx:key="id"
        data-key="tc-{{c.id}}" bindtap="toggleCard">
        <view class="cp-row"><text class="cp-name">{{c.name}}</text><text class="cp-badge">剩 {{c.remaining}}/{{c.totalTimes}}</text></view>
        <view class="cp-sub">{{c.expiresAt ? c.expiresAt + ' 到期' : '长期有效'}}</view>
        <view wx:if="{{c.sourceLabel}}" class="cp-src">{{c.sourceLabel}}</view>
        <view wx:if="{{open['tc-' + c.id]}}" class="cp-more">
          <text>{{c.kindLabel}} · 可核销项目:{{c.projectGroupText}}</text>
          <text class="cp-note">到店开单时选「次卡」大类核销,核销后次数自动减 1</text>
        </view>
      </view>
    </view>

    <view wx:if="{{(filter==='all'||filter==='physical') && pack.giftEntitlements.length}}" class="sec"><view class="sec-t">赠品领取</view><view class="cp-sub">到店由门店登记领取，无需自行核销。</view><view wx:for="{{pack.giftEntitlements}}" wx:for-item="g" wx:key="id" class="cp-card card"><view class="cp-row"><text class="cp-name">{{g.name}}</text><text class="cp-badge">剩 {{g.remaining}}/{{g.quantity}}</text></view><view class="cp-sub">已领 {{g.claimed}} · {{g.expiresOn?g.expiresOn+' 到期':'长期有效'}}{{g.expired?' · 已过期':''}}</view><view wx:if="{{g.events.length}}" class="cp-link" data-key="gift-{{g.id}}" bindtap="toggleCard">{{open['gift-'+g.id]?'收起领取记录':'查看领取记录 ›'}}</view><block wx:if="{{open['gift-'+g.id]}}"><view wx:for="{{g.events}}" wx:for-item="ev" wx:key="id" class="cp-sub">{{ev.label}} {{ev.quantityText}} · {{ev.createdText}}</view></block></view></view>
    <view wx:if="{{(filter==='all'||filter==='coupon') && pack.coupons.length}}" class="sec">
      <view class="sec-t">优惠券</view>
      <view class="cp-card card" wx:for="{{pack.coupons}}" wx:for-item="q" wx:key="grantId"
        data-key="cp-{{q.grantId}}" bindtap="toggleCard">
        <view class="cp-row"><text class="cp-name">{{q.name}}</text><text class="cp-face">{{q.faceText}}</text></view>
        <view class="cp-sub">{{q.subtitle}}</view>
        <view wx:if="{{q.sourceLabel}}" class="cp-src">{{q.sourceLabel}}</view>
        <view wx:if="{{open['cp-' + q.grantId]}}" class="cp-more">
          <text class="cp-note">结算时由店员或你在签署页选用;一单一张,不与次卡叠加</text>
        </view>
      </view>
    </view>

    <block wx:if="{{pack.giftHistory.length}}"><button class="cp-history-toggle" bindtap="toggleHistory">{{showHistory?'收起历史记录':'查看已使用 / 已过期权益与记录 ›'}}</button><block wx:if="{{showHistory}}"><block wx:for="{{pack.giftHistory}}" wx:for-item="g" wx:key="id"><view wx:if="{{filter==='all'||filter==='coupon'&&g.kind==='coupon'||filter==='service'&&g.kind!=='coupon'}}" class="cp-card card"><view class="cp-row"><text class="cp-name">{{g.name}}</text><text class="cp-sub">{{g.statusText}}</text></view><view class="cp-sub">{{g.kindLabel}} · 已用 {{g.used}} · 剩余 {{g.remaining}} · 作废 {{g.voided}}</view><view class="cp-sub">{{g.sourceLabel}} · {{g.expiresOn?g.expiresOn+' 到期':'长期有效'}}</view><view wx:for="{{g.records}}" wx:for-item="r" wx:key="id" class="cp-sub">{{r.label}} · {{r.createdText}}</view><view wx:for="{{g.events}}" wx:for-item="ev" wx:key="id" class="cp-sub">{{ev.label}} {{ev.quantityText}} · {{ev.createdText}}</view></view></block></block></block>

  </block>
</view>
