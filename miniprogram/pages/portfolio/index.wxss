.portfolio-page {
  padding: 20rpx 24rpx 180rpx;
}


.tech-strip {
  white-space: nowrap;
  padding: 8rpx 0 6rpx;
}

.tech-cell {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 116rpx;
  margin-right: 6rpx;
  vertical-align: top;
}

.tech-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--brand);
  color: var(--hero);
  font-size: 36rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid var(--line);
  box-shadow: 0 4rpx 14rpx rgba(92, 70, 48, 0.16);
  box-sizing: border-box;
}

.tech-avatar.all {
  background: var(--hero);
  color: var(--heroink);
  font-size: 26rpx;
  font-weight: 700;
}

.tech-cell.on .tech-avatar {
  border-color: var(--brand);
  box-shadow: 0 0 0 4rpx rgba(200, 164, 126, 0.45);
}

.tech-cell-name {
  margin-top: 8rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--brandd);
  max-width: 112rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tech-cell-badge {
  font-size: 19rpx;
  color: var(--sub);
}


.chip-bar {
  white-space: nowrap;
  padding: 14rpx 0 6rpx;
}

.chip {
  display: inline-block;
  font-size: 24rpx;
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: var(--card);
  color: var(--brandd);
  border: 1rpx solid var(--line);
  margin-right: 14rpx;
}

.chip.on {
  background: var(--hero);
  color: var(--heroink);
  border-color: var(--hero);
  font-weight: 700;
}


.wall {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  align-items: start;
  gap: 16rpx;
  margin-top: 14rpx;
}

.work-card {
  background: var(--card);
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 14rpx rgba(92, 70, 48, 0.07);
}

.work-visual-wrap {
  position: relative;
  width: 100%;
}

.work-visual {
  width: 100%;
  height: 360rpx;
  display: block;
}

.work-cat {
  position: absolute;
  left: 12rpx;
  top: 12rpx;
  background: rgba(45, 40, 38, 0.55);
  color: var(--heroink);
  font-size: 19rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

.work-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 14rpx 12rpx;
  min-width: 0;
}

.work-tech-name {
  font-size: 22rpx;
  color: var(--brandd);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.work-book {
  margin-left: auto;
  flex: none;
  font-size: 21rpx;
  color: var(--brandd);
  font-weight: 700;
  padding: 4rpx 0 4rpx 12rpx;
}

.wall-empty {
  text-align: center;
  color: var(--sub);
  font-size: 25rpx;
  padding: 120rpx 0;
}

.work-preview { position:fixed; inset:0; z-index:100; background:var(--paper); color:var(--ink); display:flex; flex-direction:column; }
.portfolio-page button.preview-close { width:auto; min-width:0; min-height:72rpx; font-size:26rpx; line-height:1.4; flex:none; align-self:flex-end; margin:24rpx; padding:12rpx 32rpx; background:var(--card); color:var(--ink); border-radius:999rpx; z-index:2; }
.preview-area { width:100%; flex:1; min-height:0; overflow:hidden; }
.preview-mover, .preview-image { width:100%; height:100%; }
.preview-status { position:absolute; top:45%; left:10%; width:80%; box-sizing:border-box; background:var(--card); color:var(--ink); }
.preview-caption { padding:24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom)); text-align:center; color:var(--muted); }

.portfolio-page button.photo-arrow{position:absolute;top:50%;transform:translateY(-50%);width:72rpx;min-width:72rpx;max-width:72rpx;height:72rpx;min-height:72rpx;padding:0;margin:0;display:flex;align-items:center;justify-content:center;line-height:1;border-radius:50%;background:rgba(30,26,22,.42);color:var(--heroink);font-size:48rpx;border:1rpx solid rgba(255,255,255,.3);z-index:3}
.portfolio-page button.photo-arrow[disabled]{opacity:.3;color:var(--heroink);background:rgba(30,26,22,.42)}
.portfolio-page button.photo-arrow:active{transform:translateY(-50%) scale(.96)}
.photo-prev{left:8rpx}.photo-next{right:8rpx}
.photo-count{position:absolute;bottom:10rpx;left:50%;transform:translateX(-50%);padding:4rpx 12rpx;border-radius:999rpx;background:rgba(30,26,22,.42);color:var(--heroink);font-size:20rpx}
