.portfolio-page {
  padding: 20rpx 24rpx 180rpx;
}

/* ===== 技师头像条 ===== */
.tech-strip {
  white-space: nowrap;
  padding: 8rpx 0 6rpx;
}

.tech-cell {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 116rpx;
  margin-right: 6rpx;
  vertical-align: top;
}

.tech-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #e7c9a4, #c8a47e);
  color: #fff;
  font-size: 36rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #fff;
  box-shadow: 0 4rpx 14rpx rgba(92, 70, 48, 0.16);
  box-sizing: border-box;
}

.tech-avatar.all {
  background: #2d2826;
  font-size: 26rpx;
  font-weight: 700;
}

.tech-cell.on .tech-avatar {
  border-color: #c8a47e;
  box-shadow: 0 0 0 4rpx rgba(200, 164, 126, 0.45);
}

.tech-cell-name {
  margin-top: 8rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #5c4630;
  max-width: 112rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tech-cell-badge {
  font-size: 19rpx;
  color: #9a8c7c;
}

/* ===== 品类筛选 ===== */
.chip-bar {
  white-space: nowrap;
  padding: 14rpx 0 6rpx;
}

.chip {
  display: inline-block;
  font-size: 24rpx;
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #5c4630;
  border: 1rpx solid #e9dccb;
  margin-right: 14rpx;
}

.chip.on {
  background: #2d2826;
  color: #fff;
  border-color: #2d2826;
  font-weight: 700;
}

/* ===== 作品墙(双列瀑布流) ===== */
.wall {
  display: flex;
  gap: 16rpx;
  margin-top: 14rpx;
}

.wall-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.work-card {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 14rpx rgba(92, 70, 48, 0.07);
}

.work-visual-wrap {
  position: relative;
  width: 100%;
}

.work-visual {
  width: 100%;
  display: block;
}

.work-cat {
  position: absolute;
  left: 12rpx;
  top: 12rpx;
  background: rgba(45, 40, 38, 0.55);
  color: #fff;
  font-size: 19rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

.work-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 14rpx 12rpx;
  min-width: 0;
}

.work-tech-avatar {
  flex: none;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #e7c9a4, #c8a47e);
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.work-tech-name {
  font-size: 22rpx;
  color: #5c4630;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.work-book {
  margin-left: auto;
  flex: none;
  font-size: 21rpx;
  color: #c8a47e;
  font-weight: 700;
  padding: 4rpx 0 4rpx 12rpx;
}

.wall-empty {
  text-align: center;
  color: #9a8c7c;
  font-size: 25rpx;
  padding: 120rpx 0;
}
