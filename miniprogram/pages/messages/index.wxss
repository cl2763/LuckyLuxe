page{background:var(--paper)}
.pg{padding:22rpx 26rpx 60rpx}
.demobar{font-size:20rpx;color:var(--brandd);background:var(--paper);border:1rpx solid var(--line);border-radius:10rpx;padding:8rpx 12rpx;margin-bottom:14rpx;text-align:center}
.li{display:flex;gap:14rpx;background:var(--card);border:1rpx solid var(--line);border-radius:14rpx;padding:18rpx 18rpx;margin-bottom:12rpx}
.dot{width:14rpx;height:14rpx;border-radius:50%;background:var(--accd);margin-top:8rpx;flex:0 0 auto}
.mi{flex:1;min-width:0}
.mt{font-size:25rpx;color:var(--ink)}
.mm{font-size:21rpx;color:var(--sub);margin-top:5rpx}
.empty{background:var(--card);border:1rpx solid var(--line);border-radius:16rpx;padding:56rpx 34rpx;text-align:center}
.et{font-size:26rpx;color:var(--sub)}
.ed{font-size:22rpx;color:var(--sub);line-height:1.6;margin-top:12rpx}
.note{font-size:21rpx;color:var(--sub);line-height:1.6;margin-top:18rpx}
