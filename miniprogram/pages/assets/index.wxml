<view class="page assets-page">
  <view wx:if="{{error}}" class="empty">{{error}}</view>
  <block wx:elif="{{assets}}">
    <!-- 四类各一行:数字后端唯一出口给,与各自明细页同源同数 -->
    <view class="as-row card" bindtap="goCardPack">
      <view class="as-main"><text class="as-t">卡包</text><text class="as-sub">{{assets.cardPack.summaryText}}</text></view>
      <view class="as-right"><text wx:if="{{assets.cardPack.count}}" class="as-num">{{assets.cardPack.count}}</text><text class="as-arrow">›</text></view>
    </view>
    <view class="as-row card" bindtap="goStored">
      <view class="as-main"><text class="as-t">储值</text><text class="as-sub">余额与流水明细</text></view>
      <view class="as-right"><text class="as-num">{{assets.stored.balanceText}}</text><text class="as-arrow">›</text></view>
    </view>
    <view class="as-row card" bindtap="goPoints">
      <view class="as-main"><text class="as-t">积分</text><text class="as-sub">明细与积分商城</text></view>
      <view class="as-right"><text class="as-num">{{assets.points.balance}}</text><text class="as-arrow">›</text></view>
    </view>
    <view class="as-row card" bindtap="goBenefits">
      <view class="as-main"><text class="as-t">会员权益</text><text class="as-sub">{{assets.membership.level}}</text></view>
      <view class="as-right"><text class="as-arrow">›</text></view>
    </view>
  </block>
</view>
