page{background:var(--paper)}
.pg{padding:30rpx 26rpx 60rpx}
.head{margin-bottom:24rpx}
.ht{font-size:34rpx;font-weight:600;color:var(--ink)}
.hd{font-size:23rpx;color:var(--sub);margin-top:8rpx;line-height:1.6}.scanbtn {text-align:center;font-size:26rpx;color:var(--hero);background:var(--brand);border-radius:999rpx;padding:22rpx 0;margin-bottom:20rpx}
.empty{text-align:center;color:var(--sub);font-size:24rpx;padding:80rpx 0}
.shop{display:flex;align-items:center;gap:16rpx;background:var(--card);border:1rpx solid var(--line);border-radius:16rpx;padding:22rpx 20rpx;margin-bottom:14rpx}
.sav{width:72rpx;height:72rpx;border-radius:16rpx;background:var(--wall);color:var(--brandd);display:flex;align-items:center;justify-content:center;font-size:30rpx;font-weight:600;flex:0 0 auto}
.sinfo{flex:1;min-width:0}
.sname{font-size:28rpx;font-weight:600;color:var(--ink)}
.saddr{font-size:22rpx;color:var(--sub);margin-top:6rpx}
.chev{color:var(--sub);font-size:32rpx}
.dtag{display:inline-block;margin-left:10rpx;font-size:19rpx;font-weight:700;color:var(--brandd);background:var(--wall);border:1rpx solid var(--line);border-radius:6rpx;padding:2rpx 10rpx;vertical-align:middle}
.demotip{margin-top:12rpx;font-size:21rpx;color:var(--brandd);background:var(--wall);border:1rpx dashed var(--line);border-radius:10rpx;padding:10rpx 14rpx;line-height:1.5}
