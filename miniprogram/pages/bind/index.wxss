.wrap{min-height:100vh;background:#f7f3ea;padding:48rpx 32rpx;box-sizing:border-box}
.card{background:#fff;border-radius:24rpx;padding:44rpx 36rpx;box-shadow:0 6rpx 24rpx rgba(60,50,30,.06)}
.store{font-size:24rpx;color:#8a8172;margin-bottom:8rpx}
.title{font-size:40rpx;font-weight:700;color:#2f2a22;margin-bottom:24rpx}
.line{display:flex;justify-content:space-between;padding:16rpx 0;border-bottom:1rpx solid #f0ebe0}
.k{color:#8a8172;font-size:26rpx}
.v{color:#2f2a22;font-size:28rpx;font-weight:600}
.safe{margin:24rpx 0;padding:18rpx 22rpx;background:#eef5ee;color:#2f6b3c;border-radius:14rpx;font-size:24rpx;line-height:1.6}
.safe.warn{background:#fdf1e7;color:#b5541f}
.btn{margin-top:12rpx;background:#2f2a22;color:#fff;text-align:center;border-radius:16rpx;padding:26rpx 0;font-size:30rpx;font-weight:600}
.mut{color:#9a917f;font-size:24rpx;margin-top:20rpx}
.center{text-align:center}
.done{text-align:center;padding:80rpx 36rpx}
.okmark{font-size:48rpx;font-weight:700;color:#2f6b3c}
.okhint{font-size:30rpx;color:#2f2a22;margin-top:18rpx}
.mc{margin-top:26rpx;font-size:24rpx;color:#8a8172}
