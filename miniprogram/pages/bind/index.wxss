.wrap{min-height:100vh;background:var(--paper);padding:48rpx 32rpx;box-sizing:border-box}
.card{background:var(--card);border-radius:24rpx;padding:44rpx 36rpx;box-shadow:0 6rpx 24rpx rgba(60,50,30,.06)}
.store{font-size:24rpx;color:var(--sub);margin-bottom:8rpx}
.title{font-size:40rpx;font-weight:700;color:var(--ink);margin-bottom:24rpx}
.line{display:flex;justify-content:space-between;padding:16rpx 0;border-bottom:1rpx solid var(--line)}
.k{color:var(--sub);font-size:26rpx}
.v{color:var(--ink);font-size:28rpx;font-weight:600}
.safe{margin:24rpx 0;padding:18rpx 22rpx;background:var(--goodbg);color:var(--good);border-radius:14rpx;font-size:24rpx;line-height:1.6}
.safe.warn{background:var(--badbg);color:var(--bad)}.btn {margin-top:12rpx;background:var(--hero);color:var(--heroink);text-align:center;border-radius:999rpx;padding:26rpx 0;font-size:30rpx;font-weight:600}
.mut{color:var(--sub);font-size:24rpx;margin-top:20rpx}
.center{text-align:center}
.done{text-align:center;padding:80rpx 36rpx}
.okmark{font-size:48rpx;font-weight:700;color:var(--good)}
.okhint{font-size:30rpx;color:var(--ink);margin-top:18rpx}
.mc{margin-top:26rpx;font-size:24rpx;color:var(--sub)}

.line{gap:20rpx}.v{min-width:0;overflow-wrap:break-word}.btn{padding-left:20rpx;padding-right:20rpx;line-height:1.6}
