page{background:var(--paper)}
.fp{padding:32rpx 30rpx}
.title{font-size:34rpx;font-weight:600;color:var(--ink);margin-bottom:22rpx}
.card{background:var(--card);border:1rpx solid var(--line);border-radius:18rpx;padding:22rpx 22rpx;margin-bottom:20rpx}
.ct{font-size:28rpx;font-weight:600;color:var(--ink);margin-bottom:10rpx}
.cb{font-size:25rpx;color:var(--brandd);line-height:1.7}
.contact{margin-top:16rpx;border-top:1rpx solid var(--line);padding-top:14rpx}
.crow{display:flex;justify-content:space-between;margin-bottom:8rpx}
.ck{font-size:24rpx;color:var(--sub)}
.cv{font-size:24rpx;color:var(--brandd)}
.note{font-size:22rpx;color:var(--sub);line-height:1.6;margin-top:8rpx}
