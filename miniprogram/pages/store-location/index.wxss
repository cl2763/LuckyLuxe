@import "../../templates/media-privacy.wxss";
.store-hero {
  width: 100%;
  height: 220rpx;
  display: block;
  border-radius: 18rpx;
}

.store-card {
  margin-top: 22rpx;
  padding: 30rpx;
}

.store-name {
  font-size: 38rpx;
  font-weight: 800;
}

.store-desc {
  margin-top: 14rpx;
  color: var(--sub);
  line-height: 1.55;
}

.info-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.info-row:last-child {
  border-bottom: none;
}

.info-row text:first-child {
  color: var(--sub);
}

.info-row text:last-child {
  max-width: 440rpx;
  text-align: right;
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 24rpx;
}

.map-placeholder {
  height: 260rpx;
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  align-items: center;
  justify-content: center;
  color: var(--ink);
}

/* D17 失败态(与 home / booking / services 同一套) */
.d17fail{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:20rpx;padding:140rpx 40rpx}
.d17msg{color:var(--sub);font-size:27rpx}
.d17btn{border:1rpx solid var(--line);border-radius:999rpx;padding:14rpx 48rpx;font-size:27rpx;color:var(--brandd)}

.arrival-guide{padding:28rpx;margin-top:24rpx}.guide-title{font-size:32rpx;font-weight:700}.arrival-step{margin-top:28rpx;font-size:27rpx;line-height:1.6;white-space:pre-wrap}.arrival-heading{display:flex;gap:14rpx;align-items:center;font-weight:600;margin-bottom:14rpx}.arrival-heading text{width:40rpx;height:40rpx;background:var(--brandd);color:var(--card);border-radius:50%;text-align:center;line-height:40rpx}.arrival-step image{width:100%;height:300rpx;border-radius:12rpx;margin-bottom:10rpx}

.action-grid .btn{width:100%;padding:0 8rpx;font-size:25rpx;min-height:88rpx;display:flex;align-items:center;justify-content:center}

.store-card{margin-top:0;padding:24rpx}.store-summary{display:flex;gap:22rpx;align-items:flex-start}.store-summary .store-hero{width:160rpx;height:160rpx;flex:0 0 160rpx;border-radius:12rpx}.store-summary-copy{flex:1;min-width:0}.store-name{font-size:30rpx}.store-summary-line{font-size:24rpx;line-height:1.55;margin-top:10rpx;color:var(--sub)}.action-grid{padding-top:16rpx;border-top:1rpx solid var(--line)}
