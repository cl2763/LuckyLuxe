<include src="../../templates/media-privacy.wxml" />
<!-- D17 失败态:与正文互斥,取不到真门店就如实说,不拿假门店占位 -->
<view wx:if="{{loadFailed}}" class="page store-page d17fail {{themeClass}}">
  <view class="d17msg">加载失败，请检查网络后重试</view>
  <view class="d17btn" bindtap="load">重试</view>
</view>

<view wx:else class="page store-page {{themeClass}}">
  <view class="store-card card">
    <view class="store-summary">
      <img-placeholder class="store-hero" src="{{storeCover}}" img-class="store-hero" text="暂无门店照片"></img-placeholder>
      <view class="store-summary-copy">
        <view class="store-name">{{store.storeName}}</view>
        <view class="store-summary-line">{{store.address}}</view>
        <view class="store-summary-line">{{store.businessHours}}</view>
      </view>
    </view>
    <view class="store-desc" wx:if="{{store.description}}">{{store.description}}</view>
    <button class="btn btn-ghost" open-type="share">{{lang === 'en' ? 'Share directions' : '分享门店与到店指引'}}</button>
    <view class="action-grid">
      <button class="btn btn-ghost" bindtap="openLocation">{{t.nav}}</button>
      <button class="btn btn-ghost" wx:if="{{store.phone}}" bindtap="callStore">{{t.call}}</button>
      <button class="btn btn-ghost" bindtap="copyAddress">{{t.copy}}</button>
    </view>
  </view>

  <view wx:if="{{store.arrivalGuide.length}}" class="card arrival-guide">
    <view class="guide-title">{{lang === 'en' ? 'Getting here' : '到店指引'}}</view>
    <view wx:for="{{store.arrivalGuide}}" wx:key="index" class="arrival-step">
      <view class="arrival-heading"><text>{{index + 1}}</text>{{lang === 'en' ? 'Step' : '步骤'}} {{index + 1}}</view>
      <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" binderror="guideImageFailed" data-src="{{item.image}}" bindtap="previewGuide" />
      <view wx:if="{{item.description}}">{{item.description}}</view>
    </view>
  </view>
</view>
