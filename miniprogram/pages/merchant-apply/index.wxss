page{background:var(--paper)}
.page{padding:24rpx 26rpx 60rpx}
.intro{margin-bottom:20rpx}
.it{font-size:34rpx;font-weight:600;color:var(--ink)}
.id{font-size:23rpx;color:var(--sub);line-height:1.6;margin-top:10rpx}
.form{background:var(--card);border:1rpx solid var(--line);border-radius:18rpx;overflow:hidden}
.frow{display:flex;align-items:center;padding:24rpx 24rpx;border-bottom:1rpx solid var(--line);gap:16rpx}
.frow:last-child{border-bottom:none}
.frow.col{flex-direction:column;align-items:stretch;gap:10rpx}
.lb{font-size:25rpx;color:var(--ink);flex:0 0 150rpx}
.in{flex:1;font-size:25rpx;color:var(--ink);text-align:right}
.pk{flex:1;text-align:right}
.pkv{font-size:25rpx;color:var(--brandd)}
.ta{width:100%;height:150rpx;font-size:24rpx;color:var(--ink);background:var(--paper);border:1rpx solid var(--line);border-radius:12rpx;padding:16rpx;box-sizing:border-box}
.frow.col .lb{flex:none}.btn {margin-top:26rpx;text-align:center;font-size:28rpx;color:var(--hero);background:var(--brand);border-radius:999rpx;padding:26rpx 0;letter-spacing:2rpx}
.btn.off{opacity:.55}
.note{font-size:21rpx;color:var(--sub);text-align:center;margin-top:16rpx}
.ok{text-align:center;padding:80rpx 40rpx}
.okic{width:110rpx;height:110rpx;border-radius:50%;background:var(--goodbg);color:var(--good);font-size:56rpx;display:flex;align-items:center;justify-content:center;margin:0 auto 24rpx}
.okt{font-size:32rpx;font-weight:600;color:var(--ink)}
.okd{font-size:24rpx;color:var(--sub);line-height:1.7;margin-top:12rpx}
.ok .btn{background:var(--wall);color:var(--brandd);margin-top:40rpx}
