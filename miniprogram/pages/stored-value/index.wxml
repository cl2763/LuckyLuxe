<view class="pg">
  <view class="hero">
    <view class="row"><text class="hl">储值余额</text><text class="lv" wx:if="{{level}}">{{level}}</text></view>
    <view class="hv">{{cur.p}}{{cur.s}}{{balance}}</view>
    <view class="charge" bindtap="soon">在线充值(微信支付)</view>
  </view>

  <!-- B3-3/4 代充回执:门店代充到账后的回执卡(金额/渠道/时间);确认=「我看到了」,不确认不影响余额 -->
  <block wx:if="{{pendingConfirm.length}}">
    <view class="t2">到账回执 · 待确认</view>
    <view class="card rc" wx:for="{{pendingConfirm}}" wx:key="id">
      <view class="rc-l">
        <view class="pn">门店已为你充值 {{item.amount}}</view>
        <view class="ps">{{item.at}}{{item.channel ? ' · ' + item.channel : ''}}{{item.note ? ' · ' + item.note : ''}}</view>
        <view class="ps">当前余额见顶部;如金额有出入请联系门店。</view>
      </view>
      <view class="buy" data-id="{{item.id}}" bindtap="confirmRecharge">确认到账</view>
    </view>
  </block>

  <view class="t2">充值套餐 <text class="demo">示例</text></view>
  <view class="card row sp" wx:for="{{packages}}" wx:key="id">
    <view><view class="pn">{{item.name}}</view><view class="ps">{{item.sub}}</view></view>
    <view class="buy" bindtap="soon">购买</view>
  </view>

  <view class="t2">收支明细</view>
  <view wx:if="{{txns.length}}" class="list">
    <view class="li" wx:for="{{txns}}" wx:key="id">
      <view class="li-main"><view class="li-t">{{item.title}}<text wx:if="{{item.needsConfirm}}" class="li-unconfirmed">待确认</text></view><view class="li-d">{{item.date}}</view></view>
      <text class="li-v {{item.up ? 'up' : 'down'}}">{{item.delta}}</text>
    </view>
  </view>
  <view wx:else class="empty">暂无明细,充值 / 耗卡记录会显示在这里,与门店账本实时一致。</view>
  <view class="note">余额与门店账本实时一致;耗卡即门店确认收入。在线充值上线前,可到店由老板手动为你充值。</view>
</view>
