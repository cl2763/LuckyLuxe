<template name="receipt"><view class="rc-note"><block wx:if="{{r.kind==='recharge'}}"><view>充值回执 · {{r.receiptId}}</view><view>充值已到账</view><view>本金 / 赠金：{{r.principalText}} / {{r.bonusText}}</view></block><view>个人折扣：{{r.beforeText}} → {{r.afterText}}</view><view>办理人：{{r.actor}}</view><view>{{r.statusText}}</view><view wx:if="{{r.kind==='recharge'}}">本笔已到账，核对回执不会再次扣款。</view></view></template>
<view class="pg {{themeClass}}">
<member-pricing customer="{{true}}"/>

  <view class="hero">
    <view class="row"><text class="hl">储值余额</text><text class="lv" wx:if="{{level}}">{{level}}</text></view>
    <view class="hv">{{balanceText}}</view>

    <view class="charge" bindtap="goMall">去充值 ›</view>
  </view>


  <block wx:if="{{pendingConfirm.length}}">
    <view class="t2">到账回执 · 待确认</view>
    <view class="card rc" wx:for="{{pendingConfirm}}" wx:key="id">
      <view class="rc-l">
        <view class="pn">门店已为你充值 {{item.amount}}</view>
        <view class="ps">{{item.at}}{{item.channel ? ' · ' + item.channel : ''}}{{item.note ? ' · ' + item.note : ''}}</view>
        <view class="ps">当前余额见顶部;如金额有出入请联系门店。</view><template wx:if="{{item.discountReceipt}}" is="receipt" data="{{r:item.discountReceipt}}"/><view wx:if="{{item.giftItems.length}}" class="gift-list">
        <view class="gift-title">赠送物品</view>
        <view class="gift-line" wx:for="{{item.giftItems}}" wx:for-item="gift" wx:key="index"><text>{{gift.name}} × {{gift.quantity}}</text><text class="gift-unit">单件价值 {{gift.unitValueText}}</text></view>
        <view class="gift-note">物品领取请联系门店，此清单不代表已领取。</view>
      </view>
      </view>
      <view class="buy" data-id="{{item.id}}" bindtap="confirmRecharge">确认已核对</view><view class="buy" bindtap="contactStore">联系门店</view>
    </view>
  </block>


  <block wx:if="{{isDemo}}">
    <view class="t2">充值套餐 <text class="demo">示例</text></view>
    <view class="card row sp" wx:for="{{packages}}" wx:key="id">
      <view><view class="pn">{{item.name}}</view><view class="ps">{{item.sub}}</view></view>
    </view>
  </block>

  <view class="t2">收支明细</view>
  <view wx:if="{{txns.length}}" class="list">
    <view class="li" wx:for="{{txns}}" wx:key="id">
      <view class="li-main"><view class="li-t">{{item.title}}<text wx:if="{{item.needsConfirm}}" class="li-unconfirmed">待确认</text></view><view class="li-d">{{item.date}}</view><template wx:if="{{item.discountReceipt}}" is="receipt" data="{{r:item.discountReceipt}}"/><view wx:if="{{item.giftItems.length}}" class="gift-list">
        <view class="gift-title">赠送物品</view>
        <view class="gift-line" wx:for="{{item.giftItems}}" wx:for-item="gift" wx:key="index"><text>{{gift.name}} × {{gift.quantity}}</text><text class="gift-unit">单件价值 {{gift.unitValueText}}</text></view>
        <view class="gift-note">物品领取请联系门店，此清单不代表已领取。</view>
      </view></view>
      <text class="li-v {{item.up ? 'up' : 'down'}}">{{item.delta}}</text>
    </view>
  </view>
  <view wx:else class="empty">暂无明细,充值 / 耗卡记录会显示在这里,与门店账本实时一致。</view>
  <view class="note">余额与门店账本实时一致;耗卡即门店确认收入。充值与收款均在线下完成，本页仅展示门店记录。</view>
</view>
