page{background:var(--paper)}
.mlogin{padding:56rpx 44rpx}
.head{margin-bottom:44rpx}
.title{font-size:40rpx;font-weight:600;color:var(--ink)}
.sub{font-size:24rpx;color:var(--sub);margin-top:12rpx}
.label{font-size:24rpx;color:var(--sub);margin:0 0 12rpx 4rpx}
.field{height:92rpx;background:var(--card);border:1rpx solid var(--line);border-radius:18rpx;display:flex;align-items:center;padding:0 24rpx;margin-bottom:28rpx}
.inp{flex:1;font-size:30rpx;color:var(--ink)}
.ph{color:var(--sub)}
.eye{width:42rpx;height:42rpx;margin-left:12rpx;flex:0 0 auto}
.remember{display:flex;align-items:center;font-size:26rpx;color:var(--sub);margin:6rpx 0 40rpx 4rpx}
.box{width:34rpx;height:34rpx;border:2rpx solid var(--brand);border-radius:8rpx;margin-right:14rpx;display:flex;align-items:center;justify-content:center;color:var(--heroink);font-size:22rpx}
.box.on{background:var(--brand);color:var(--hero)}   /* 规矩丙:勾在金底上,深字才看得见 */.btn {height:92rpx;line-height:92rpx;background:var(--brand);color:var(--hero);font-size:32rpx;border-radius:999rpx;font-weight:500}
.btn::after{border:none}
.hint{text-align:center;font-size:24rpx;color:var(--brandd);margin-top:32rpx;text-decoration:underline}
.applybar{display:flex;align-items:center;justify-content:center;gap:8rpx;margin-top:48rpx;padding-top:28rpx;border-top:1rpx solid var(--line)}
.applytx{font-size:24rpx;color:var(--sub)}
.applylink{font-size:25rpx;color:var(--brandd);font-weight:600}
