.mall-page{padding:24rpx 24rpx 60rpx}
.ml-card{padding:26rpx;border-radius:18rpx;background:var(--card);margin-bottom:18rpx}
.ml-top{display:flex;justify-content:space-between;align-items:baseline}
.ml-title{font-size:30rpx;font-weight:600;color:var(--ink)}
.ml-bonus{font-size:26rpx;color:var(--brandd);font-weight:600}
.ml-sub{font-size:24rpx;color:var(--ink);margin-top:8rpx}
.ml-buy{margin-top:18rpx;text-align:center;padding:18rpx;border-radius:12rpx;background:var(--tagmbg);color:var(--ink);font-size:28rpx;font-weight:600}
.ml-note{margin-top:12rpx;font-size:24rpx;color:var(--ink);background:var(--card);border-radius:10rpx;padding:14rpx}
.empty{padding:80rpx 24rpx;text-align:center;color:var(--ink);font-size:26rpx}

/* 裁定②:统一商城的筛选条与大类分区标题 */
.ml-filters{display:flex;gap:12rpx;margin-bottom:18rpx}
.ml-filter{padding:10rpx 26rpx;border-radius:999rpx;background:var(--card);color:var(--ink);font-size:24rpx}
.ml-filter.on{background:var(--hero);color:var(--heroink);font-weight:600}
.ml-sec{font-size:26rpx;color:var(--ink);margin:16rpx 4rpx 10rpx}
