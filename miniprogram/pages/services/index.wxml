<view class="page services-page">
  <view class="type-switch">
    <button class="type-tab {{activeType === 'nail' ? 'active' : ''}}" bindtap="switchType" data-type="nail">{{t.nail}}</button>
    <button class="type-tab {{activeType === 'lash' ? 'active' : ''}}" bindtap="switchType" data-type="lash">{{t.lash}}</button>
    <button class="type-tab {{activeType === 'care' ? 'active' : ''}}" bindtap="switchType" data-type="care">{{lang === 'en' ? 'Care' : '护理·其他'}}</button>
  </view>

  <view class="service-layout">
    <scroll-view class="category-list" scroll-y enhanced show-scrollbar="{{false}}" wx:if="{{categories.length}}">
      <block wx:for="{{categories}}" wx:key="*this">
        <view class="category-item {{activeCategory === item.key ? 'active' : ''}}" bindtap="switchCategory" data-category="{{item.key}}">
          <text>{{item.label}}</text>
        </view>
      </block>
    </scroll-view>

    <scroll-view class="service-list" scroll-y>
      <view class="service-list-inner">
        <block wx:if="{{serviceList.length}}">
          <block wx:for="{{serviceList}}" wx:key="_id">
            <view class="service-card card" bindtap="goDetail" data-id="{{item._id}}">
              <image class="service-visual" src="{{item.image}}" mode="aspectFill"></image>
              <view class="service-info">
                <view class="service-name">{{item.name}}</view>
                <view class="service-desc">{{item.description}}</view>
                <view class="service-meta">
                  <text class="price">{{lang === 'en' ? (item.priceFromLabelEn || item.priceLabelEn) : (item.priceFromLabelZh || item.priceLabelZh)}}</text>
                  <text>{{item.duration}}{{t.minutes}}</text>
                  <text>{{t.deposit}} {{cur.p}}{{cur.s}}{{item.depositAmount}}</text>
                </view>
                <view class="quote-hint">{{lang === 'en' ? item.quoteHintEn : item.quoteHintZh}}</view>
              </view>
            </view>
          </block>
        </block>
        <!-- D17 失败态:接口挂了如实说,不拿假数据糊住(书面标准代图) -->
        <view wx:elif="{{loadFailed}}" class="empty failbox">
          <view class="failmsg">加载失败，请检查网络后重试</view>
          <view class="failbtn" bindtap="refresh">重试</view>
        </view>
        <view wx:else class="empty">{{t.empty}}</view>
      </view>
    </scroll-view>
  </view>
</view>
