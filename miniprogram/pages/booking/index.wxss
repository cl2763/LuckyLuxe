@import "../../templates/media-privacy.wxss";
.booking-page {
  padding: 24rpx 24rpx 320rpx;
}

.booking-service {
  display: flex;
  gap: 20rpx;
  padding: 16rpx;
}

.mini-visual {
  width: 150rpx;
  height: 124rpx;
  flex: none;
  display: block;
  border-radius: 14rpx;
}

.booking-service-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.service-name {
  margin-bottom: 14rpx;
  font-size: 32rpx;
  font-weight: 750;
}

.form-card {
  padding: 20rpx;
}

.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  background: var(--paper);
  font-weight: 650;
}

.technician-row {
  margin-bottom: 14rpx;
}

.picker-label,
.picker-value {
  display: block;
}

.picker-label {
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 850;
}

.picker-sub {
  display: block;
  margin-top: 8rpx;
  color: var(--sub);
  font-size: 22rpx;
  font-weight: 600;
}

.picker-right {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.picker-value {
  color: var(--brandd);
  font-size: 27rpx;
  font-weight: 850;
}

.chevron {
  color: var(--brandd);
  font-size: 42rpx;
  line-height: 1;
}

.slot-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 22rpx;
}

.slot {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 74rpx;
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  background: var(--card);
  color: var(--sub);
  font-size: 30rpx;
  font-weight: 750;
  line-height: 1;
}

.slot.active {
  border-color: var(--brand);
  background: var(--wall);
  color: var(--brandd);
  font-weight: 700;
}

.addon-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.addon {
  min-width: 0;
  min-height: 108rpx;
  padding: 20rpx 22rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  gap: 10rpx;
  text-align: left;
  font-size: 28rpx;
  font-weight: 780;
}

.addon.active {
  border-color: var(--brand);
  background: var(--paper);
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.image-wrap,
.upload-box {
  position: relative;
  width: 150rpx;
  height: 150rpx;
}

.ref-image {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
}

.remove-image {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: var(--hero);
  color: var(--heroink);
}

.upload-box {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 8rpx;
  border: 2rpx dashed var(--line);
  background: var(--paper);
  color: var(--sub);
  font-size: 24rpx;
  font-weight: 800;
}

.upload-plus {
  color: var(--brandd);
  font-size: 46rpx;
  font-weight: 500;
  line-height: 1;
}

.ai-reference-card {
  margin-top: 16rpx;
  padding: 22rpx;
}

.ai-title {
  color: var(--ink);
  font-size: 27rpx;
  font-weight: 850;
}

.ai-text {
  margin-top: 8rpx;
  color: var(--sub);
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1.4;
}

.ai-btn {
  height: 58rpx;
  margin-top: 16rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: var(--hero);
  color: var(--heroink);
  font-size: 23rpx;
  font-weight: 760;
}

.ai-btn[disabled] {
  background: var(--wall);
  color: var(--sub);
}

.ai-result {
  display: grid;
  gap: 8rpx;
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 14rpx;
  background: var(--paper);
  color: var(--sub);
  font-size: 23rpx;
  font-weight: 650;
  line-height: 1.4;
}

.remark {
  width: 100%;
  height: 170rpx;
  padding: 22rpx;
  line-height: 1.5;
}

.summary {
  flex: 1;
  min-width: 126rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.bottom-bar {
  gap: 12rpx;
  padding-right: 24rpx;
  padding-left: 24rpx;
}

.bottom-bar .btn {
  width: 210rpx;
  min-width: 0;
  padding: 0 16rpx;
  font-size: 27rpx;
}

.style-preset {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx;
  border: 1rpx dashed var(--brand);
  background: var(--paper);
}

.sp-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  flex: none;
  background: var(--wall);
}

.sp-info { flex: 1; min-width: 0; }
.sp-t { font-size: 26rpx; font-weight: 700; color: var(--brandd); }
.sp-d { font-size: 22rpx; color: var(--sub); margin-top: 6rpx; line-height: 1.5; }

/* D17 失败态:主体区居中一行文案 + 重试按钮(书面标准,不做局部假数据) */
.d17fail{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:20rpx;padding:140rpx 40rpx}
.d17msg{color:var(--sub);font-size:27rpx}
.d17btn{border:1rpx solid var(--line);border-radius:999rpx;padding:14rpx 48rpx;font-size:27rpx;color:var(--brandd)}

/* 时段空态(⬜ 无图,假设清单已记):约满就如实说,不列假时段 */
.slot-empty{color:var(--sub);font-size:26rpx;padding:24rpx 8rpx}
