page{background:var(--card)}
.page{padding:24rpx 26rpx 60rpx}

/* WiFi 状态条 */
.wifibar{display:flex;align-items:center;gap:12rpx;border-radius:16rpx;padding:16rpx 20rpx;margin-bottom:20rpx;font-size:24rpx}
.wifibar.ok{background:var(--wall);color:var(--good);border:1rpx solid var(--line)}
.wifibar.warn{background:var(--tagmbg);color:var(--bad);border:1rpx solid var(--line)}
.wb-txt{flex:1;line-height:1.4}

/* 打卡大卡 */
.clockcard{background:var(--card);border:1rpx solid var(--line);border-radius:26rpx;padding:36rpx 30rpx;text-align:center}
.cc-date{font-size:24rpx;color:var(--brandd);margin-bottom:24rpx}
.bigbtn{margin:0 auto;width:320rpx;height:320rpx;border-radius:50%;background:linear-gradient(135deg,#c8a47e,#b5885d);color:var(--heroink);font-size:40rpx;font-weight:800;display:flex;align-items:center;justify-content:center;box-shadow:0 12rpx 30rpx rgba(181,136,93,.35)}
.bigbtn.out{background:linear-gradient(135deg,#2d2826,#463d34);box-shadow:0 12rpx 30rpx rgba(45,40,38,.3)}
.bigbtn.dim{opacity:.6}
.cc-hint{font-size:22rpx;color:var(--brandd);margin-top:22rpx}
.cc-state{font-size:28rpx;color:var(--ink);margin-bottom:24rpx}
.cc-state .b{font-weight:800}
.cc-state.done{color:var(--good);font-weight:800;font-size:32rpx}
.cc-summary{font-size:27rpx;color:var(--ink);margin-top:10rpx}
.cc-summary .b2{font-weight:800;color:var(--ink)}
.cc-summary.abn{color:var(--bad)}
.ot{color:var(--bad);font-weight:700}

/* 本周 */
.sec{font-size:23rpx;color:var(--brandd);font-weight:700;margin:26rpx 4rpx 12rpx}
.weekcard{background:var(--card);border:1rpx solid var(--line);border-radius:22rpx;padding:8rpx 22rpx}
.wrow{display:flex;align-items:center;gap:14rpx;padding:18rpx 0;border-bottom:1rpx solid var(--line);font-size:25rpx}
.wrow:last-child{border-bottom:none}
.w-day{width:150rpx;color:var(--brandd)}
.w-time{flex:1;color:var(--ink)}
.w-dur{color:var(--ink);font-weight:700}
.w-adj{margin-left:8rpx;font-size:18rpx;color:var(--heroink);background:#c8955a;border-radius:6rpx;padding:2rpx 8rpx}
.empty{text-align:center;color:var(--brandd);font-size:24rpx;padding:30rpx 0}

/* 老板看板 */
.boardhead{display:flex;justify-content:space-between;align-items:center;margin-bottom:18rpx}
.bh-t{font-size:30rpx;font-weight:800;color:var(--ink)}
.bh-wifi{font-size:21rpx;color:var(--brandd);font-weight:700}.wifibtn {background:linear-gradient(135deg,#c8a47e,#b5885d);border-radius:999rpx;padding:20rpx 24rpx;margin-bottom:18rpx;box-shadow:0 6rpx 16rpx rgba(181,136,93,.25)}
.wifibtn:active{opacity:.85}
.wb-l{font-size:27rpx;font-weight:800;color:var(--heroink)}
.wb-d{font-size:20rpx;color:var(--heroink);margin-top:4rpx}
.stats{display:flex;background:var(--card);border:1rpx solid var(--line);border-radius:22rpx;padding:22rpx 0;margin-bottom:18rpx}
.st{flex:1;text-align:center}
.sn{font-size:44rpx;font-weight:800;color:var(--ink)}
.sn.live{color:var(--good)}
.sn.warn{color:var(--bad)}
.sl{font-size:21rpx;color:var(--brandd);margin-top:4rpx}
.stdiv{width:1rpx;background:var(--tagmbg);margin:8rpx 0}
.arow{display:flex;align-items:center;gap:18rpx;background:var(--card);border:1rpx solid var(--line);border-radius:20rpx;padding:20rpx;margin-bottom:12rpx}
.arow.hl{border-color:#e7b9b0;background:var(--card)}
.av{width:64rpx;height:64rpx;border-radius:50%;background:#c8a47e;color:var(--heroink);display:flex;align-items:center;justify-content:center;font-size:26rpx;font-weight:700;flex:none}
.ainfo{flex:1;min-width:0}
.aname{font-size:28rpx;font-weight:700;color:var(--ink)}
.ameta{font-size:22rpx;color:var(--brandd);margin-top:3rpx}
.atag{flex:none;font-size:22rpx;font-weight:700;border-radius:999rpx;padding:8rpx 18rpx}
.atag.working{background:var(--wall);color:var(--good)}
.atag.overtime{background:var(--hero2);color:var(--heroink)}
.atag.done{background:var(--wall);color:var(--brandd)}
.atag.rest{background:var(--card);color:var(--brandd);border:1rpx solid var(--line)}
.atag.none{background:var(--tagmbg);color:var(--bad)}
.tip{font-size:20rpx;color:var(--brandd);text-align:center;margin-top:8rpx}

/* 修正弹层 */
.mask{position:fixed;left:0;top:0;right:0;bottom:0;background:rgba(36,26,18,.45);z-index:1999}
.fsheet{position:fixed;left:0;right:0;bottom:0;background:var(--card);border-radius:24rpx 24rpx 0 0;padding:28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));z-index:2000}
.fs-t{font-size:30rpx;font-weight:800;color:var(--ink);margin-bottom:8rpx}
.fs-k{font-size:22rpx;color:var(--brandd);margin:16rpx 0 8rpx}
.fs-time{background:var(--card);border:1rpx solid var(--line);border-radius:12rpx;padding:18rpx;font-size:28rpx;color:var(--ink);display:flex;justify-content:space-between}
.fs-time .g{color:var(--brandd)}
.fs-save{margin-top:24rpx;background:var(--hero);color:var(--heroink);text-align:center;padding:24rpx;border-radius:14rpx;font-size:28rpx;font-weight:700}
