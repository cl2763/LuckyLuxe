page{background:#fbf8f5}
.page{padding:24rpx 26rpx 60rpx}

/* WiFi 状态条 */
.wifibar{display:flex;align-items:center;gap:12rpx;border-radius:16rpx;padding:16rpx 20rpx;margin-bottom:20rpx;font-size:24rpx}
.wifibar.ok{background:#e3eee8;color:#1f7a4d;border:1rpx solid #cfe3d8}
.wifibar.warn{background:#fbf1e4;color:#a5674c;border:1rpx solid #ecd9bd}
.wb-txt{flex:1;line-height:1.4}

/* 打卡大卡 */
.clockcard{background:#fff;border:1rpx solid #eadfd7;border-radius:26rpx;padding:36rpx 30rpx;text-align:center}
.cc-date{font-size:24rpx;color:#9a8c7c;margin-bottom:24rpx}
.bigbtn{margin:0 auto;width:320rpx;height:320rpx;border-radius:50%;background:linear-gradient(135deg,#c8a47e,#b5885d);color:#fff;font-size:40rpx;font-weight:800;display:flex;align-items:center;justify-content:center;box-shadow:0 12rpx 30rpx rgba(181,136,93,.35)}
.bigbtn.out{background:linear-gradient(135deg,#2d2826,#463d34);box-shadow:0 12rpx 30rpx rgba(45,40,38,.3)}
.bigbtn.dim{opacity:.6}
.cc-hint{font-size:22rpx;color:#9a8c7c;margin-top:22rpx}
.cc-state{font-size:28rpx;color:#241f1d;margin-bottom:24rpx}
.cc-state .b{font-weight:800}
.cc-state.done{color:#1f7a4d;font-weight:800;font-size:32rpx}
.cc-summary{font-size:27rpx;color:#5c4630;margin-top:10rpx}
.cc-summary .b2{font-weight:800;color:#241f1d}
.cc-summary.abn{color:#c0392b}
.ot{color:#c0392b;font-weight:700}

/* 本周 */
.sec{font-size:23rpx;color:#9a8c7c;font-weight:700;margin:26rpx 4rpx 12rpx}
.weekcard{background:#fff;border:1rpx solid #eadfd7;border-radius:22rpx;padding:8rpx 22rpx}
.wrow{display:flex;align-items:center;gap:14rpx;padding:18rpx 0;border-bottom:1rpx solid #f2ebe4;font-size:25rpx}
.wrow:last-child{border-bottom:none}
.w-day{width:150rpx;color:#9a8c7c}
.w-time{flex:1;color:#241f1d}
.w-dur{color:#5c4630;font-weight:700}
.w-adj{margin-left:8rpx;font-size:18rpx;color:#fff;background:#c8955a;border-radius:6rpx;padding:2rpx 8rpx}
.empty{text-align:center;color:#9a8c7c;font-size:24rpx;padding:30rpx 0}

/* 老板看板 */
.boardhead{display:flex;justify-content:space-between;align-items:center;margin-bottom:18rpx}
.bh-t{font-size:30rpx;font-weight:800;color:#241f1d}
.bh-wifi{font-size:21rpx;color:#b5885d;font-weight:700}
.wifibtn{background:linear-gradient(135deg,#c8a47e,#b5885d);border-radius:16rpx;padding:20rpx 24rpx;margin-bottom:18rpx;box-shadow:0 6rpx 16rpx rgba(181,136,93,.25)}
.wifibtn:active{opacity:.85}
.wb-l{font-size:27rpx;font-weight:800;color:#fff}
.wb-d{font-size:20rpx;color:rgba(255,255,255,.85);margin-top:4rpx}
.stats{display:flex;background:#fff;border:1rpx solid #eadfd7;border-radius:22rpx;padding:22rpx 0;margin-bottom:18rpx}
.st{flex:1;text-align:center}
.sn{font-size:44rpx;font-weight:800;color:#241f1d}
.sn.live{color:#1f7a4d}
.sn.warn{color:#c0392b}
.sl{font-size:21rpx;color:#9a8c7c;margin-top:4rpx}
.stdiv{width:1rpx;background:#eadfd7;margin:8rpx 0}
.arow{display:flex;align-items:center;gap:18rpx;background:#fff;border:1rpx solid #eadfd7;border-radius:20rpx;padding:20rpx;margin-bottom:12rpx}
.arow.hl{border-color:#e7b9b0;background:#fdf3f1}
.av{width:64rpx;height:64rpx;border-radius:50%;background:#c8a47e;color:#fff;display:flex;align-items:center;justify-content:center;font-size:26rpx;font-weight:700;flex:none}
.ainfo{flex:1;min-width:0}
.aname{font-size:28rpx;font-weight:700;color:#241f1d}
.ameta{font-size:22rpx;color:#9a8c7c;margin-top:3rpx}
.atag{flex:none;font-size:22rpx;font-weight:700;border-radius:999rpx;padding:8rpx 18rpx}
.atag.working{background:#e3eee8;color:#1f7a4d}
.atag.overtime{background:#c0392b;color:#fff}
.atag.done{background:#efe9e3;color:#6d5f52}
.atag.rest{background:#fbf8f5;color:#9a8c7c;border:1rpx solid #eadfd7}
.atag.none{background:#fbf1e4;color:#a5674c}
.tip{font-size:20rpx;color:#9a8c7c;text-align:center;margin-top:8rpx}

/* 修正弹层 */
.mask{position:fixed;left:0;top:0;right:0;bottom:0;background:rgba(36,26,18,.45);z-index:1999}
.fsheet{position:fixed;left:0;right:0;bottom:0;background:#fff;border-radius:24rpx 24rpx 0 0;padding:28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));z-index:2000}
.fs-t{font-size:30rpx;font-weight:800;color:#241f1d;margin-bottom:8rpx}
.fs-k{font-size:22rpx;color:#9a8c7c;margin:16rpx 0 8rpx}
.fs-time{background:#fbf8f5;border:1rpx solid #eadfd7;border-radius:12rpx;padding:18rpx;font-size:28rpx;color:#241f1d;display:flex;justify-content:space-between}
.fs-time .g{color:#b5885d}
.fs-save{margin-top:24rpx;background:#2d2826;color:#fff;text-align:center;padding:24rpx;border-radius:14rpx;font-size:28rpx;font-weight:700}
