page{background:#fbf8f5}
/* 🔴 D178 第 3 条(店主 09-09):顶行「LUVIA 半径…」左边被切了一块。
   两件事一起治:①**安全区**——顶上留出 `env(safe-area-inset-top)`(现在用的是系统导航栏,
   切不到;但换成自定义导航或全面屏机型就会切,这一行是把它钉死);
   ②**长店名**——北京店那个名字有 16 个字,原来靠 `space-between` 挤,挤不下就被裁;
   改成「左边可收缩 + 单行省略号」,名字再长也只会变成「…」,不会缺一块。 */
.page{padding:calc(24rpx + env(safe-area-inset-top)) 26rpx 160rpx}
.topbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:20rpx;gap:16rpx}
.topbar > view:first-child{flex:1;min-width:0}
.greeting{font-size:36rpx;font-weight:600;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.date{font-size:24rpx;color:var(--sub);margin-top:8rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.rolechip {font-size:22rpx;font-weight:700;color:#fff;background:#c8a47e;border-radius:999rpx;padding:6rpx 22rpx}
.rolechip.owner{background:#2d2826}

/* AI 总结(压缩) */
.ai{background:linear-gradient(135deg,#2d2826,#463d34);border-radius:22rpx;padding:20rpx 24rpx;margin-bottom:18rpx}
.ai-h{font-size:21rpx;color:#d8c3a6;font-weight:700;margin-bottom:6rpx}
.ai-dot{color:#c8a47e}
.ai-txt{font-size:25rpx;color:#f3ece3;line-height:1.55}
.ai-txt.dim{color:#cbbfae}
.ai-act{display:flex;gap:12rpx;margin-top:8rpx;align-items:flex-start}
.ai-adot{width:10rpx;height:10rpx;border-radius:50%;background:#c8a47e;margin-top:14rpx;flex:none}
.ai-atxt{font-size:23rpx;color:#e7dccc;line-height:1.5;flex:1}

/* 员工:老板站内提醒横幅 */
.nudge{display:flex;align-items:center;gap:14rpx;background:#fbf1e4;border:1rpx solid #ecd9bd;border-radius:18rpx;padding:18rpx 20rpx;margin-bottom:14rpx}
.nudge-ico{font-size:30rpx;flex:none}
.nudge-txt{flex:1;font-size:24rpx;color:#8a5a24;line-height:1.5}
.nudge-ok{flex:none;font-size:23rpx;font-weight:700;color:#fff;background:#c8955a;border-radius:999rpx;padding:10rpx 22rpx}

/* 分区标题 */
.sec{font-size:23rpx;color:#9a8c7c;font-weight:700;margin:22rpx 4rpx 12rpx}

/* 台面小结(员工端置顶) */
.board{display:flex;background:#fff;border:1rpx solid #eadfd7;border-radius:26rpx;padding:24rpx 16rpx}
.bitem{flex:1;text-align:center}
.bn{font-size:44rpx;font-weight:800;color:#241f1d;line-height:1.15}
.bn.live{color:#1f7a4d}
.bn.wait{color:#c8955a}
.bn.go{color:#b5885d}
.bl{font-size:21rpx;color:#9a8c7c;margin-top:4rpx}
.bdiv{width:1rpx;background:#eadfd7;margin:6rpx 0}

/* 横条待办(手风琴) */
.rowcard{background:#fff;border:1rpx solid #eadfd7;border-radius:24rpx;margin-bottom:16rpx;overflow:hidden}
.rowhead{display:flex;align-items:center;gap:20rpx;padding:24rpx 24rpx}
.rowico{width:64rpx;height:64rpx;border-radius:18rpx;background:#fbf8f5;display:flex;align-items:center;justify-content:center;font-size:32rpx;flex:none}
.rowico.warn{background:#fdeeea}
.rowico.dark{background:#efe9e3}
.rowt{flex:1;min-width:0}
.rowname{font-size:29rpx;font-weight:700;color:#241f1d}
.rowhint{font-size:21rpx;color:#9a8c7c;margin-top:3rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.nbadge{min-width:44rpx;height:44rpx;padding:0 14rpx;border-radius:999rpx;background:#c8a47e;color:#fff;font-size:25rpx;font-weight:800;display:flex;align-items:center;justify-content:center;flex:none;box-sizing:border-box}
.nbadge.warn{background:#c0392b}
.nbadge.mut{background:#efe9e3;color:#9a8c7c}
.chev{color:#9a8c7c;font-size:32rpx;flex:none;transition:transform .2s}
.chev.open{transform:rotate(90deg);color:#b5885d}

/* 展开体 */
.rowbody{border-top:1rpx dashed #eadfd7;padding:6rpx 24rpx 18rpx;background:#fdfaf7}
.subrow{display:flex;align-items:center;gap:18rpx;padding:18rpx 2rpx;border-bottom:1rpx solid #f2ebe4}
.subrow:last-child{border-bottom:none}
.subrow.center{justify-content:center}
.av{width:60rpx;height:60rpx;border-radius:50%;background:#c8a47e;color:#fff;display:flex;align-items:center;justify-content:center;font-size:24rpx;font-weight:700;flex:none}
.subinfo{flex:1;min-width:0}
.subname{font-size:27rpx;font-weight:600;color:#241f1d}
.submeta{font-size:21rpx;color:#9a8c7c;margin-top:2rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.submeta.wrap{white-space:normal;overflow:visible;text-overflow:clip;line-height:1.5}
.subempty{font-size:24rpx;color:#1f7a4d;text-align:center;padding:20rpx 0}
.gobtn{font-size:24rpx;font-weight:700;color:#b5885d;flex:none;padding:8rpx 4rpx}
.gobtn.solid{color:#fff;background:#2d2826;border-radius:999rpx;padding:12rpx 26rpx}
.gobtn.solid.gold{background:#c8a47e}
.gobtn.done{color:#1f7a4d}
.gobtn.dim{color:#b3a595;opacity:.7}

/* 财务锁行 */
.lockrow{display:flex;align-items:center;gap:20rpx;padding:24rpx;background:#fff;border:1rpx dashed #eadfd7;border-radius:24rpx;margin-bottom:16rpx}
.lockrow .rowname{color:#6d5f52}

/* 快捷(员工端) */
.quick{display:flex;gap:16rpx}
.qcard{flex:1;background:#fff;border:1rpx solid #eadfd7;border-radius:22rpx;padding:24rpx 8rpx;text-align:center}
.qi{font-size:40rpx;line-height:1.2}
.ql{font-size:23rpx;font-weight:600;color:#241f1d;margin-top:8rpx}

/* ===== 老板视角 · 业绩大屏 —— **皮按合同图原样搬**(D168 段 4;图 v3.2 §一)=====

   原来这一段自成一套色(`#fbf8f5`/`#c8a47e`/`#2d2826`),与合同图**不是一套**。
   现在颜色一律走令牌(`styles/tokens.wxss`,值与网页那份逐条相等)。

   ⚠️ **如实说明两处做不到的**(店主 05t 段 4 第 2 条明令「不许悄悄用系统字体冒充」):
   ① **中文字体退回系统字体**。小程序不能引 Google Fonts,`Noto Serif SC / Noto Sans SC`
      加载不进来 —— 页面上的中文就是**系统字体**(iOS 苹方 / 安卓思源黑),不是 Noto。
   ② **数字大字想用 Fraunces 要走 `wx.loadFontFace`**,而它只吃 **https 且在域名白名单里**的地址,
      本地沙箱给不出这样的地址。所以今天数字也是系统字体,`utils/numfont.js` 把这件事说明白并留了口子,
      自托管字体地址进上线批(待裁 #18)。 */
.dh-card{background:var(--card);border-radius:12rpx;padding:24rpx;margin:0 0 20rpx}
.dh-skel{height:56rpx;background:var(--wall);border-radius:12rpx;margin-bottom:16rpx}
.dh-skel.short{width:40%}
.dh-truth{color:var(--sub);font-size:26rpx}
.dh-retry{margin-top:14rpx;display:inline-block;padding:10rpx 22rpx;border:1rpx solid var(--line);border-radius:999rpx;font-size:24rpx;color:var(--sub)}

/* 英雄块:深色底 + 金色数字 + 细网格(图 §一 那一整块) */
.dh-hero{background:var(--hero);border-radius:12rpx;padding:24rpx;margin:0 0 20rpx}
.dh-periods{display:flex;gap:12rpx;margin-bottom:18rpx}
.dh-period{padding:8rpx 22rpx;border:1rpx solid var(--herogrid);border-radius:999rpx;font-size:24rpx;color:var(--herosub)}
.dh-period.on{background:var(--herogold);color:var(--hero);border-color:var(--herogold);font-weight:700}
.dh-eyebrow{font-size:22rpx;color:var(--herosub);margin-bottom:6rpx}
/* D178 大数字三段式(图 line 51–52):币码 1.2rem 金色 · 主数 3.3rem · 分位 1.6rem 淡一档。
   小程序用 rpx:主数 62rpx ≈ 图上的 3.3rem;币码与分位按同一比例缩(约 3:1 与 2:1)。 */
/* D180 第 3 条:第一次轮播换指标时淡入一句「自动轮播中」,2 秒后消失,**每台设备只出一次** */
.dh-hint{font-size:20rpx;color:var(--herosub);margin-left:12rpx;opacity:0;animation:dhhint 2s ease forwards}
@keyframes dhhint{0%{opacity:0}15%{opacity:1}70%{opacity:1}100%{opacity:0}}
.dh-big{line-height:1.1;color:var(--heroink);font-variant-numeric:tabular-nums;display:flex;align-items:baseline;white-space:nowrap}
.dh-big-code{font-family:'FrauncesNum';font-size:22rpx;color:var(--herogold);font-weight:500;margin-right:8rpx}
.dh-big-num{font-family:'FrauncesNum';font-size:62rpx;font-weight:700;letter-spacing:-0.01em}
.dh-big-cent{font-family:'FrauncesNum';font-size:30rpx;font-weight:500;opacity:.75}
.dh-delta{font-size:24rpx;margin-top:6rpx;display:inline-block;padding:2rpx 14rpx;border-radius:999rpx}
.dh-delta.up{background:var(--goodbg);color:var(--good)}
.dh-delta.down{background:var(--badbg);color:var(--bad)}
.dh-delta.flat{background:var(--flatbg);color:var(--flat)}
.dh-sd.up{color:var(--good)}
.dh-sd.down{color:var(--bad)}
.dh-sd.flat{color:var(--flat)}
/* 折线:小程序端画不了 SVG,仍是柱形,但**颜色改成金色渐变**,与图上那条金线同一族。
   与图的差异写进回执:图上是带渐变填充的折线,这里是渐变柱(待裁 #19,要不要上 canvas)。 */
.dh-spark{display:flex;align-items:flex-end;gap:6rpx;height:72rpx;margin:16rpx 0}
.dh-bar{flex:1;background:linear-gradient(180deg,var(--herogold),rgba(217,185,126,0));border-radius:0}

/* dots:5 个,选中那个变成金色胶囊并会移动(图 §一)。
   🔴 D180(店主 2026-09-09 三句话都在说这个):「动态轮播效果也不是很自然,感觉要等很久
   才自动展示下一个数据,而且**让人看不出来这个版面是有自动轮播的**」。
   三件一起治:①间隔 6 秒 → **4 秒**;②选中那颗上叠一条**4 秒走满的进度**(看得见它在走);
   ③暂停时整排 dots 变灰(「已暂停」得看得出来)。
   进度用 **animation 不用 transition**:每次轮播都会重画这一排,
   transition 在重画后不会自己跑,animation 会(元素一新建就从头放)。 */
.dh-dots{display:flex;gap:10rpx;justify-content:center;margin-top:18rpx;align-items:center}
.dh-dots.paused{opacity:.45}
.dh-prog{position:absolute;left:0;top:0;bottom:0;background:var(--heroink);opacity:.55;border-radius:999rpx;width:0;animation:dhprog 4s linear forwards}
@keyframes dhprog{from{width:0}to{width:100%}}
@media (prefers-reduced-motion: reduce){.dh-prog{animation:none;width:0}}
/* 🔴 现测(automator 量出来的):选中那颗的 class 明明是 `dh-dot-i on`,宽度却还是 10rpx ——
   **`width` 没顶住**。dots 是 flex 子项,`flex-shrink` 默认 1、`flex-basis` 是 auto,
   小程序 WebView 渲染下会把 `width` 当成可压缩的建议值。加 `flex:none` 钉死。
   这条正是店主说的「**让人看不出来这个版面是有自动轮播的**」的一半原因:
   五颗点长得一模一样,当前是哪一颗根本看不出来。 */
.dh-dot-i{width:10rpx;height:10rpx;border-radius:50%;background:var(--herogrid);flex:none}
.dh-dot-i.on{background:var(--herogold);width:28rpx;min-width:28rpx;border-radius:999rpx;transition:width .3s;flex:none;position:relative;overflow:hidden}

/* 🔴 D178:五个小数**严格一行五列**(图 line 69 `grid-template-columns:repeat(5,1fr)`)。
   她截图里排成了两行(3+2),还把「现金业绩 CAD $5,760.00」折成两行 ——
   图 §一 第 2 条要的是「五个数**任何时刻都在屏上**」,折成两行就不是那句话了。
   长金额靠 `tabular-nums` + 缩字号 + 省略号顶住,**不许折行**。 */
.dh-smalls{display:grid;grid-template-columns:repeat(5,1fr);gap:8rpx;margin-top:8rpx;padding-top:18rpx;border-top:1rpx solid var(--herogrid)}
.dh-small{min-width:0;padding:12rpx 0;transition:opacity .3s}
.dh-small.dim{opacity:.28}
.dh-sl{font-size:20rpx;color:var(--herosub);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.dh-sv{font-family:'FrauncesNum';font-size:30rpx;font-weight:700;color:var(--heroink);margin-top:4rpx;font-variant-numeric:tabular-nums;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.dh-sub{font-size:19rpx;color:var(--herosub);margin-top:4rpx;display:flex;align-items:center;gap:4rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.dh-dot{width:10rpx;height:10rpx;border-radius:50%;background:var(--herolive);display:inline-block}
.dh-sd{font-size:19rpx;margin-top:2rpx;white-space:nowrap}
.dh-asof{margin-top:16rpx;font-size:21rpx;color:var(--herosub)}

.dh-ai{font-size:26rpx;color:var(--ink);line-height:1.5}
.dh-h{font-size:27rpx;font-weight:700;color:var(--ink);margin-bottom:12rpx}
.dh-h-sub{font-size:21rpx;color:var(--sub);font-weight:400;margin-left:10rpx}
.dh-row{display:flex;align-items:center;gap:14rpx;padding:12rpx 0;border-top:1rpx solid var(--line)}
.dh-time{font-size:28rpx;font-weight:700;color:var(--ink);min-width:100rpx;font-variant-numeric:tabular-nums}
.dh-who{flex:1;font-size:25rpx;color:var(--ink)}
.dh-st{font-size:22rpx;color:var(--sub)}
.dh-empty{font-size:25rpx;color:var(--sub);padding:8rpx 0}
.dh-go{margin-top:14rpx;font-size:25rpx;color:var(--brandd)}
.dh-todo{display:flex;align-items:center;justify-content:space-between;padding:14rpx 0;border-top:1rpx solid var(--line)}
.dh-todo.urgent .dh-todo-n{color:var(--bad)}
.dh-todo-l{font-size:26rpx;color:var(--ink)}
.dh-todo-n{font-size:28rpx;font-weight:700;color:var(--brandd)}

/* ===== 员工视角 · 打卡门(图 v3.2 §二,段 10)===== */
.clock-gate{text-align:center;padding:48rpx 24rpx}
.clock-shift{font-size:26rpx;color:#6b6259;margin-bottom:28rpx}
.clock-btn{width:220rpx;height:220rpx;line-height:220rpx;margin:0 auto;border-radius:50%;
  background:#2b2b2b;color:#fff;font-size:32rpx;font-weight:700}
.clock-hint{margin-top:24rpx;font-size:23rpx;color:#a09488}
.clock-err{margin-top:18rpx;font-size:24rpx;color:#c0503c;line-height:1.5}
.clock-badge{margin-left:auto;font-size:22rpx;color:#2f8f5b}
.clock-out{margin-top:10rpx;font-size:24rpx;color:#a58e6f}
