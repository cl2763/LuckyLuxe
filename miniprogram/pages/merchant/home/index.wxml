<view class="page {{themeClass}}">
  <view class="topbar">
    <view>
      <!-- 图 §一 顶栏:**店名 · 问候**在上,日期在下(原来只有「嗨,老板」,看不出这是哪家店) -->
      <view class="greeting" data-dh-hello>{{storeLine}}</view>
      <view class="date" data-dh-date>{{dateText}}</view>
    </view>
    <view class="rolechip {{isOwner?'owner':''}}">{{roleLabel}}</view>
  </view>

  <!-- ============ 老板视角 · 业绩大屏(图 v3.2 §一,段 9)============
       三条接口与网页端**同一份数据**;这一页零计算、零拼串,句子都由 utils/dashboard-view.js 出。 -->
  <block wx:if="{{isOwner}}">
    <!-- 加载中 / 取数失败 / 正常,三态互斥 -->
    <view wx:if="{{dhState==='loading'}}" class="dh-card" data-dh-state="loading">
      <view class="dh-skel"></view><view class="dh-skel short"></view>
    </view>
    <view wx:elif="{{dhState==='failed'}}" class="dh-card" data-dh-state="failed">
      <view class="dh-truth">业绩数据暂时取不到</view>
      <view class="dh-retry" bindtap="loadPulse">下拉重试 · 或稍后再看</view>
    </view>
    <block wx:else>
      <!-- 🔴 D168 段 4:整块改成**深色英雄块**(图 §一)。原来是白卡片黑字。 -->
      <view class="dh-hero" data-dh-state="ready" data-dh-hero>
        <view class="dh-periods" data-dh-periods>
          <view wx:for="{{dh.periods}}" wx:key="key" class="dh-period {{item.on?'on':''}}"
                data-p="{{item.key}}" bindtap="switchPeriod">{{item.label}}</view>
        </view>
        <view class="dh-eyebrow">{{dh.headLabel}}</view>
        <!-- D178:大数字**三段**(图 line 51–52):币码小字金色 + 主数 Fraunces 大字 + 分位小一档淡一档 -->
        <view class="dh-big" data-dh-metric="{{dh.headKey}}" data-dh-big>
          <text class="dh-big-code" wx:if="{{dh.headParts.code}}">{{dh.headParts.code}}</text><text class="dh-big-num">{{dh.headParts.amount}}</text><text class="dh-big-cent" wx:if="{{dh.headParts.cents}}">{{dh.headParts.cents}}</text>
        </view>
        <view wx:if="{{dh.headDelta}}" class="dh-delta {{dh.headDelta.tone}}" data-delta>{{dh.headDelta.arrow}} {{dh.headDelta.text}}</view>
        <view wx:if="{{dh.spark.length}}" class="dh-spark" data-dh-spark>
          <view wx:for="{{dh.sparkBars}}" wx:key="i" class="dh-bar" style="height:{{item}}%"></view>
        </view>
        <!-- dots:5 个,点一下换指标;轮播 6 秒自己走一格(图 §一) -->
        <view class="dh-dots" data-dh-dots>
          <view wx:for="{{dh.dots}}" wx:key="key" class="dh-dot-i {{item.on?'on':''}}"
                data-k="{{item.key}}" bindtap="switchMetric"></view>
        </view>
        <!-- 五个小数收在大屏底部一行;今日预约那一格带实时副行 -->
        <view class="dh-smalls" data-dh-smalls>
          <view wx:for="{{dh.smalls}}" wx:key="key" class="dh-small {{item.dimmed?'dim':''}}" data-dh-small="{{item.key}}">
            <view class="dh-sl">{{item.label}}</view>
            <view class="dh-sv">{{item.value}}</view>
            <view wx:if="{{item.sub}}" class="dh-sub" data-dh-live><text class="dh-dot"></text>{{item.sub}}</view>
            <view wx:if="{{item.delta}}" class="dh-sd {{item.delta.tone}}">{{item.delta.arrow}} {{item.delta.text}}</view>
          </view>
        </view>
        <view class="dh-asof" data-dh-asof>{{dh.asOf}}</view>
      </view>

      <!-- AI 今日一句(只读已生成的,不为首页新起模型调用) -->
      <view class="dh-card dh-ai" wx:if="{{dh.aiLine}}" data-dh-ai-line>{{dh.aiLine}}</view>
      <view class="dh-card dh-ai" wx:else data-dh-ai-none>今天还没有一句 —— 去「AI 日报」生成一次就有了</view>

      <!-- 今日预约:此刻之后前 3 条 + 看全部 -->
      <view class="dh-card" data-dh-next3>
        <view class="dh-h">今日预约<text class="dh-h-sub">{{dh.nextHint}}</text></view>
        <view wx:if="{{dhClosed}}" class="dh-truth" data-dh-truth-closed>今日休息</view>
        <block wx:else>
          <view wx:for="{{dh.next3}}" wx:key="id" class="dh-row" data-dh-next-row>
            <view class="dh-time">{{item.time}}</view>
            <view class="dh-who">{{item.text}}</view>
            <view class="dh-st">{{item.status}}</view>
          </view>
          <view wx:if="{{!dh.next3.length}}" class="dh-empty">后面没有待到店的了</view>
        </block>
        <view class="dh-go" bindtap="goOrders">看全部 ›</view>
      </view>

      <!-- 今日要处理:0 不出现,全 0 换一句;顾客在等的两项标红排前 -->
      <view class="dh-card" data-dh-todo>
        <view class="dh-h">今日要处理<text class="dh-h-sub">按急缓排</text></view>
        <view wx:if="{{dh.todoEmpty}}" class="dh-empty">今天没有要处理的</view>
        <view wx:for="{{dh.todos}}" wx:key="key" class="dh-todo {{item.urgent?'urgent':''}}"
              data-urgent="{{item.urgent?1:0}}" data-k="{{item.key}}" bindtap="goTodo">
          <view class="dh-todo-l">{{item.label}}</view>
          <view class="dh-todo-n">{{item.n}}</view>
        </view>
      </view>
    </block>
  </block>

  <!-- ============ 员工视角 · 打卡门(图 v3.2 §二,段 10)============
       打卡不是一条待办,是一道门:没打卡就没有大屏。 -->
  <block wx:if="{{!isOwner}}">
    <!-- ① 没打卡:大屏位置只有一个钮 + 今天的班次一句 -->
    <view wx:if="{{gate.state==='gate'}}" class="dh-card clock-gate" data-clock-gate>
      <view class="clock-shift" data-clock-shift>{{shiftLine}}</view>
      <view class="clock-btn" bindtap="clockIn" data-clock-in>上班打卡</view>
      <view class="clock-hint">打完卡,业绩大屏在这里出现</view>
      <!-- 打卡失败:钮不收起,底下说清原因,**不进大屏** -->
      <view wx:if="{{clockErr}}" class="clock-err" data-clock-err>{{clockErr}}</view>
    </view>
    <!-- ② 今天没班:不出钮,大屏直接显示,顶部一句 -->
    <view wx:if="{{gate.state==='off'}}" class="dh-card" data-clock-off>{{gate.note}}</view>
    <!-- ③ 打了卡(或今天没班):我的业绩大屏 -->
    <view wx:if="{{gate.showBoard}}" class="dh-card" data-staff-board>
      <view class="dh-periods" data-staff-periods>
        <view wx:for="{{staffPeriods}}" wx:key="key" class="dh-period {{item.on?'on':''}}"
              data-p="{{item.key}}" bindtap="switchStaffPeriod">{{item.label}}</view>
        <view wx:if="{{gate.badge}}" class="clock-badge" data-clock-badge>{{gate.badge}}</view>
      </view>
      <view class="dh-eyebrow">我的业绩 · 服务单</view>
      <view class="dh-big" data-staff-metric="perf">{{staffPerf}}</view>
      <view wx:if="{{gate.action==='out'}}" class="clock-out" bindtap="clockOut" data-clock-out>下班打卡 ›</view>
      <view class="dh-smalls" data-staff-smalls>
        <view wx:for="{{staffStats}}" wx:key="key" class="dh-small" data-staff-small="{{item.key}}">
          <view class="dh-sl">{{item.label}}</view>
          <view class="dh-sv">{{item.value}}</view>
          <view wx:if="{{item.sub}}" class="dh-sub"><text wx:if="{{item.live}}" class="dh-dot"></text>{{item.sub}}</view>
        </view>
      </view>
    </view>


    <!-- 老板站内提醒横幅 -->
    <view class="nudge" wx:for="{{nudges}}" wx:key="id">
      <text class="nudge-ico">📣</text>
      <view class="nudge-txt">{{item.message}}</view>
      <view class="nudge-ok" data-id="{{item.id}}" catchtap="dismissNudge">知道了</view>
    </view>

    <!-- 「我的今日台面」卡退役(图 §二):并进上面三个小数里「今日单数」那一格的实时副行 -->
    <!-- 今日要处理(图 §二:员工端**只有两项来源** —— 待写小记 / 我的调休申请状态) -->
    <view class="sec">今日要处理</view>
    <view class="rowcard">
      <view class="rowhead" data-k="notes" bindtap="toggle">
        <view class="rowico warn">📝</view>
        <view class="rowt"><view class="rowname">服务小记</view><view class="rowhint">做完趁记忆写一句,画像越用越准</view></view>
        <view class="nbadge {{notes.count?'warn':'mut'}}">{{notes.count}}</view>
        <view class="chev {{expand==='notes'?'open':''}}">›</view>
      </view>
      <view class="rowbody" wx:if="{{expand==='notes'}}">
        <view wx:if="{{!notes.items.length}}" class="subempty">今天没有待写的小记 ✓</view>
        <view class="subrow" wx:for="{{notes.items}}" wx:key="bookingId">
          <view class="av">{{item.av}}</view>
          <view class="subinfo"><view class="subname">{{item.customerName}}</view><view class="submeta">{{item.serviceName}} · {{item.time}} 完成</view></view>
          <view class="gobtn solid" data-bid="{{item.bookingId}}" data-uid="{{item.userId}}" data-name="{{item.customerName}}" data-service="{{item.serviceName}}" data-tech="{{item.technicianName}}" catchtap="writeNote">写小记</view>
        </view>
      </view>
    </view>
    <!-- 「打卡」那一条退役(图 §二 原话:**打卡不再是快捷,是门**)—— 它现在在最上面那道门里 -->
    <view class="rowcard">
      <view class="rowhead" bindtap="goSchedule">
        <view class="rowico"></view>
        <view class="rowt"><view class="rowname">我的排班</view><view class="rowhint">本周班表 · 申请调休</view></view>
        <view class="chev">›</view>
      </view>
    </view>

    <!-- 快捷格取消(图 §一/§二 都写了:底部导航四键还在,首页不再摆快捷格) -->
  </block>

  <!-- ================= 老板端旧块:整段退役(图 v3.2 §一,段 9)=================
       图上写明「不再单独出现的旧块」:
       ·「我的今日台面」卡 → 并进上面五个小数里「今日预约」那一格的副行(在做 N · 待到店 N);
       ·「待办小记」「客服工作台」→ 并进「今日要处理」那张清单;
       · 打卡 / 排班 → 归员工视角(段 10 打卡门);
       · 快捷格取消(底部导航四键还在)。
       删掉而不是隐藏 —— 留着迟早有人再打开,一页就成了两套(D154 在网页端同样处置)。 -->

  <merchant-tabbar active="home"></merchant-tabbar>
</view>
