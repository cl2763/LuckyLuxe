<view class="page {{themeClass}}"><view class="title">来源与建档日期</view><view class="card"><label>获客来源（选填）</label><input value="{{profile.acquisitionSource}}" bindinput="source" maxlength="120" placeholder="例如：朋友介绍、美团"/><label>原建档日期（未知留空）</label><picker mode="date" value="{{profile.originalJoinedDate}}" bindchange="date"><view class="input">{{profile.originalJoinedDate || '选择日期'}}</view></picker><button wx:if="{{profile.originalJoinedDate}}" bindtap="clearDate">清空日期</button><button class="primary" disabled="{{saving || loading}}" bindtap="save">{{saving?'保存中…':'保存来源与日期'}}</button></view><view class="error" wx:if="{{error}}">{{error}}<button bindtap="retry">重新读取</button></view><view class="title">原系统资料与旧权益</view><view wx:if="{{loading}}" class="hint">读取中…</view><view class="card" wx:for="{{pending}}" wx:key="id"><view>{{item.status==='pending'?'待核对旧余额':'原余额快照'}} {{item.amountText}}</view><view class="hint">截止 {{item.cutoff}}
{{item.status==='pending'?'尚未启用，不计入当前可用余额。':item.status==='allocated'?'已分配为次数卡，未增加储值余额。':'已核对，当前可用余额以账户流水为准。'}}</view><button data-id="{{item.id}}" bindtap="review">{{item.status==='pending'?'核对旧余额':'查看启用回执'}}</button><button data-id="{{item.id}}" bindtap="reconcile">分卡对平预览</button></view><view class="card" wx:for="{{rows}}" wx:key="id"><button data-id="{{item.id}}" bindtap="toggle">{{item.title}} {{item.open?'收起':'展开'}}</button><button wx:if="{{item.giftId}}" data-id="{{item.giftId}}" bindtap="reviewGift">核对／领取实物赠品</button><button wx:if="{{item.giftId}}" data-id="{{item.giftId}}" bindtap="reviewService">核对服务赠卡</button><text wx:if="{{item.open}}" class="raw" selectable>{{item.text}}</text></view><view wx:if="{{!loading && !rows.length && !pending.length && !error}}" class="hint">暂无导入的历史资料。</view><view class="hint">历史资料只读，不代表权益已启用。服务小记仅内部可见，小记图片本期暂未迁入。</view><view class="actions"><button wx:if="{{page>0}}" bindtap="prev" disabled="{{loading || saving}}">上一页</button><button wx:if="{{hasMore}}" bindtap="next" disabled="{{loading || saving}}">下一页</button></view></view>