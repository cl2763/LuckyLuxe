.page{min-height:100vh;background:var(--paper);color:var(--ink);padding:30rpx;box-sizing:border-box}.title{font-family:'Songti SC',serif;font-size:36rpx;font-weight:600;margin:20rpx 0}.card{padding:26rpx;background:var(--card);border:1rpx solid var(--line);border-radius:22rpx;margin:20rpx 0}.hint{color:var(--sub);font-size:25rpx;line-height:1.8;margin-top:16rpx}.raw{display:block;white-space:pre-wrap;word-break:break-all;font-size:24rpx;margin-top:20rpx}label{display:block;margin:16rpx 0 10rpx;font-size:27rpx}input,.input{border:1rpx solid var(--line);background:var(--paper);padding:20rpx;border-radius:14rpx;font-size:27rpx;height:auto;min-height:48rpx}button{font-size:26rpx;line-height:1.6;background:var(--paper);color:var(--ink);border:1rpx solid var(--line);margin-top:18rpx;border-radius:999rpx;padding:15rpx;white-space:normal;word-break:break-all}button::after{border:none}button.primary{background:var(--brand);color:var(--hero)}.actions{display:flex;gap:18rpx}.error{color:var(--bad);font-size:26rpx}