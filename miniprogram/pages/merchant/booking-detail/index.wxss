page{background:var(--paper)}
.page{padding:24rpx;min-height:100vh;box-sizing:border-box;background:var(--paper);color:var(--ink)}
.card{background:var(--card);border:1rpx solid var(--line);border-radius:18rpx;padding:28rpx;margin-bottom:20rpx}
.notice{padding:100rpx 20rpx;text-align:center;color:var(--sub);font-size:26rpx}
.status{font-size:24rpx;color:var(--brand);font-weight:700;margin-bottom:12rpx}
.title{font-size:36rpx;font-weight:800;line-height:1.3}
.muted{font-size:22rpx;color:var(--sub);line-height:1.6;margin-top:12rpx}
.rows>view{display:flex;justify-content:space-between;gap:20rpx;padding:15rpx 0;border-bottom:1rpx solid var(--line);font-size:25rpx;line-height:1.5}
.rows>view:last-child{border:0}.rows>view text:first-child{color:var(--sub);flex:none}.rows>view text:last-child{text-align:right;overflow-wrap:anywhere}
.amount-label{font-size:23rpx;color:var(--sub)}.amount{font-size:34rpx;font-weight:800;margin:8rpx 0;color:var(--ink)}
.button{margin-top:22rpx;padding:20rpx;text-align:center;border-radius:999rpx;background:var(--hero);color:var(--heroink);font-size:26rpx;font-weight:700}
