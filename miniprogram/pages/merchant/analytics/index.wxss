page{background:var(--paper)}
.page{padding:20rpx 26rpx 60rpx}
.empty{text-align:center;color:var(--sub);font-size:24rpx;padding:80rpx 0}
.t2{font-size:25rpx;color:var(--ink);font-weight:600;margin:20rpx 4rpx 14rpx}
.funnel{display:flex;flex-direction:column;gap:8rpx}
.fb{display:flex;align-items:center;justify-content:space-between;color:var(--heroink);border-radius:10rpx;padding:16rpx 20rpx;min-width:120rpx}
.fl{font-size:23rpx}
.fn{font-size:26rpx;font-weight:700}
.fnote{font-size:21rpx;color:var(--sub);margin:12rpx 4rpx 0}
.mets{display:flex;gap:12rpx;margin:18rpx 0}
.met{flex:1;background:var(--card);border:1rpx solid var(--line);border-radius:14rpx;padding:18rpx 12rpx;text-align:center}
.ml{font-size:20rpx;color:var(--sub)}
.mv{font-size:32rpx;color:var(--brandd);font-weight:700;margin-top:8rpx}
.card{background:var(--card);border:1rpx solid var(--line);border-radius:16rpx;overflow:hidden}
.brow{display:flex;align-items:center;padding:20rpx 22rpx;border-bottom:1rpx solid var(--line)}
.brow:last-child{border-bottom:none}
.rank{width:38rpx;height:38rpx;border-radius:50%;background:var(--wall);color:var(--brandd);font-size:22rpx;font-weight:700;display:flex;align-items:center;justify-content:center;margin-right:14rpx;flex:0 0 auto}
.bname{flex:1;font-size:25rpx;color:var(--ink);min-width:0}
.bn{font-size:23rpx;color:var(--sub)}
.none{text-align:center;color:var(--sub);font-size:22rpx;padding:24rpx 0}
.note{font-size:21rpx;color:var(--sub);line-height:1.6;margin-top:18rpx}
