<view class="pg">
  <view class="h1">{{title}}</view>
  <view wx:if="{{loading}}" class="empty">加载中…</view>
  <view wx:elif="{{note}}" class="empty">{{note}}</view>

  <block wx:else>
    <view class="hero">
      <view class="sub">{{v.month}} · 本月业绩(已确认日结)</view>
      <view class="amt">{{v.perf}}</view>
      <view class="sub">{{v.orderCount}} 单 · 本月还剩 {{v.daysLeft}} 天</view>
      <block wx:if="{{v.hasTarget}}">
        <view class="pbar"><view class="pfill" style="width:{{v.pct}}%"></view></view>
        <view class="goal"><text>{{v.pctText}}</text><text>{{v.gapText}}</text></view>
      </block>
      <view wx:if="{{v.hasSplit}}" class="split">
        <text>卡耗 {{v.cardUsed}}{{v.cardTarget ? ' / ' + v.cardTarget : ''}}</text>
        <text wx:if="{{v.orderTarget}}">单量 {{v.orderCount}} / {{v.orderTarget}}</text>
      </view>
    </view>

    <view class="trend">
      <view class="tb" wx:for="{{v.trend}}" wx:key="label">
        <view class="col"><view class="bar {{item.cur ? 'cur' : ''}}" style="height:{{item.h}}%"></view></view>
        <text class="lb">{{item.label}}</text>
      </view>
    </view>
    <view class="tlegend">近 6 个月业绩趋势(本月高亮)</view>

    <view class="tabs">
      <view class="t {{tab === it.k ? 'on' : ''}}" wx:for="{{tabs}}" wx:for-item="it" wx:key="k" data-k="{{it.k}}" bindtap="switchTab">{{it.t}}</view>
    </view>

    <view class="card" wx:if="{{tab === 'daily'}}">
      <view wx:for="{{v.daily}}" wx:key="date">
        <view class="row">
          <text class="d">{{item.date}}</text>
          <text class="o {{item.pending ? 'mut' : ''}}">{{item.orders}}</text>
          <text wx:if="{{item.card}}" class="c">卡耗 {{item.card}}</text>
          <text class="p {{item.pending ? 'mut' : ''}}">{{item.perf}}</text>
        </view>
        <!-- 售后业绩扣回显式行(裁③:员工看得见钱减在哪;上行 perf 已是净额) -->
        <view class="row deduct-row" wx:for="{{item.deductions}}" wx:for-item="dd" wx:key="code">
          <text class="d"></text><text class="c">售后扣回 · {{dd.code}}</text><text class="p neg">{{dd.amt}}</text>
        </view>
      </view>
      <view wx:if="{{!v.daily.length}}" class="empty">本月还没有已确认的日结。</view>
    </view>
    <view class="card" wx:elif="{{tab === 'monthly'}}">
      <view class="row" wx:for="{{v.monthly}}" wx:key="key"><text class="d">{{item.key}}</text><text class="o">{{item.orders}}</text><text class="p">{{item.perf}}</text></view>
    </view>
    <view class="card" wx:else>
      <view class="row" wx:for="{{v.yearly}}" wx:key="key"><text class="d">{{item.key}}</text><text class="o">{{item.orders}}</text><text class="p">{{item.perf}}</text></view>
      <view wx:if="{{!v.yearly.length}}" class="empty">还没有年度数据。</view>
    </view>
  </block>
</view>
