<view class="page">
  <view class="month">{{monthText}} · 本月完成 {{doneCount}} 单</view>

  <view wx:if="{{loading}}" class="empty">加载中…</view>

  <!-- 新:按老板配置的薪资方案实时预估 -->
  <block wx:elif="{{mode === 'plan'}}">
    <view class="hero">
      <view class="hl">本月预估到手</view>
      <view class="hv">≈ {{e.total}}</view>
      <view class="hn">按门店薪资方案实时估算,月底以老板核算为准</view>
    </view>
    <view class="rows">
      <view class="r" wx:if="{{e.hasBase}}"><text class="k">底薪</text><text class="v">{{e.base}}</text></view>
      <view class="r" wx:if="{{e.hasHandwork}}"><text class="k">手工费 · {{e.orderCount}} 单</text><text class="v">{{e.handwork}}</text></view>
      <view class="r"><text class="k">提成(业绩 {{e.perf}} · {{e.pct}}% {{e.tierText}})</text><text class="v">{{e.commission}}</text></view>
      <view class="r" wx:if="{{e.hasOt}}"><text class="k">加班费({{e.otText}})</text><text class="v hot">{{e.otPay}}</text></view>
    </view>
    <view class="nextcard" wx:if="{{e.next}}">🚀 离下一档:{{e.next}}</view>
    <view class="note">仅显示你本人的业绩与薪酬估算,其他同事数据不可见。最终以门店月末结算为准。</view>
  </block>

  <!-- 旧口径兜底 -->
  <block wx:elif="{{mode === 'old'}}">
    <view class="hero">
      <view class="hl">预估应发合计</view>
      <view class="hv">{{old.total}}</view>
      <view class="hn">底薪 + 提成,以老板月末核算为准</view>
    </view>
    <view class="rows">
      <view class="r"><text class="k">本月个人营收</text><text class="v">{{old.revenue}}</text></view>
      <view class="r"><text class="k">底薪</text><text class="v">{{old.base}}</text></view>
      <view class="r"><text class="k">提成比例</text><text class="v">{{old.rate}}%</text></view>
      <view class="r"><text class="k">提成估算</text><text class="v">{{old.commission}}</text></view>
    </view>
    <view class="note">仅显示你本人的业绩与薪酬估算,其他同事数据不可见。最终以门店月末结算为准。</view>
  </block>

  <block wx:else>
    <view class="empty">老板还没为你配置薪酬方案。<view class="sub">配置后这里会显示底薪、手工费、阶梯提成与加班费估算。</view></view>
  </block>
</view>
