.pg{padding:16rpx 24rpx 60rpx;background:var(--paper);min-height:100vh}
.h1{font-size:34rpx;font-weight:800;color:var(--ink);padding:8rpx 4rpx 16rpx}
.empty{padding:60rpx 0;text-align:center;color:var(--sub);font-size:26rpx}
.hero{background:linear-gradient(135deg,var(--hero),var(--hero2));color:var(--heroink);border-radius:22rpx;padding:26rpx 24rpx}
.hero .sub{font-size:22rpx;opacity:.8;line-height:1.8}
.hero .amt{font-size:64rpx;font-weight:850;letter-spacing:-1rpx;margin:4rpx 0}
.hero .pbar{height:16rpx;background:rgba(255,255,255,.22);border-radius:999rpx;overflow:hidden;margin-top:16rpx}
.hero .pbar .pfill{height:100%;background:var(--brand);border-radius:999rpx}
.hero .goal{display:flex;justify-content:space-between;font-size:22rpx;color:var(--herogold);margin-top:10rpx}
.hero .split{display:flex;gap:20rpx;font-size:22rpx;opacity:.85;margin-top:12rpx}
.trend{display:flex;align-items:flex-end;gap:12rpx;height:200rpx;margin:20rpx 0 6rpx}
.trend .tb{flex:1;display:flex;flex-direction:column;align-items:center;gap:8rpx}
.trend .col{width:100%;height:160rpx;display:flex;align-items:flex-end;justify-content:center}
.trend .bar{width:38rpx;background:var(--wall);border-radius:8rpx 8rpx 0 0;min-height:6rpx}
.trend .bar.cur{background:var(--brand)}
.trend .lb{font-size:20rpx;color:var(--sub)}
.tlegend{font-size:20rpx;color:var(--sub);text-align:center;margin-bottom:14rpx}
.tabs{display:flex;gap:12rpx;margin-bottom:12rpx}
.tabs .t{font-size:25rpx;padding:10rpx 26rpx;border-radius:999rpx;background:var(--wall);color:var(--sub);font-weight:700}
.tabs .t.on{background:var(--hero);color:var(--heroink)}
.card{background:var(--card);border-radius:18rpx;padding:6rpx 18rpx;box-shadow:0 3rpx 10rpx rgba(92,70,48,.06)}
.row{display:flex;align-items:center;gap:12rpx;padding:16rpx 0;border-bottom:1rpx solid var(--line)}
.row:last-child{border-bottom:none}
.row .d{width:110rpx;flex:none;font-size:22rpx;color:var(--sub)}
.row .o{flex:1;font-size:24rpx;color:var(--ink)}
.row .c{font-size:21rpx;color:var(--sub)}
.row .p{font-size:27rpx;font-weight:800;color:var(--ink)}
.row .mut{color:var(--sub);font-weight:400}

/* 售后业绩扣回显式行(裁③:负数+单号) */
.deduct-row .neg{color:#b3423a;font-weight:700}
.deduct-row .c{color:var(--bad)}

/* 清单#2:薪资估算卡(08-31) */
.sal-card { margin-top: 24rpx; }
.sal-row { display:flex; justify-content:space-between; font-size:28rpx; padding:8rpx 0; }
.sal-row.total { font-weight:600; border-top:1rpx solid var(--line); margin-top:4rpx; padding-top:12rpx; }

/* D91 薪资卡月切换(形制照 salary-month 的 monthbar) */
.sal-monthbar{display:flex;align-items:center;justify-content:center;gap:26rpx}
.sal-monthbar .h{margin:0}
.marrow{width:56rpx;height:56rpx;border-radius:50%;background:var(--card);border:1rpx solid var(--line);display:flex;align-items:center;justify-content:center;font-size:30rpx;color:var(--ink)}
.marrow.dim{opacity:.35}
