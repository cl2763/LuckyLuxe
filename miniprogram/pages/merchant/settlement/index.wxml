<view class="pg">
  <view class="hd">
    <text class="t">结算开单</text>
    <!-- 屏 S2:顾客行 = 姓名 + 脱敏手机号 + 「新客·未绑定」徽标。
         徽标只看**档案绑定状态**、文案由后端下发;绑定后后端给空串,这里自然消失。 -->
    <view class="s2row">
      <text class="s2name">{{customerName}}</text>
      <text class="s2phone" wx:if="{{bind.phoneMasked}}">{{bind.phoneMasked}}</text>
      <text class="s2badge" wx:if="{{bind.badgeText}}">{{bind.badgeText}}</text>
      <text class="s2proxy" wx:if="{{isProxy}}">代付·卡主 {{customerName}}</text>
    </view>
    <view class="s2hint" wx:if="{{bind.hintText}}">{{bind.hintText}}</view>
  </view>

  <view wx:if="{{!ready}}" class="loading">正在读取本店价目表…</view>

  <block wx:else>
    <view class="card">
      <view class="ch">① 价格体系 <text class="hint">{{tierChanged ? '已改档，将留痕' : '默认按会员判定'}}</text></view>
      <view class="chiprow">
        <view class="chip {{tierKey === it.key ? 'on' : ''}}" wx:for="{{tiers}}" wx:for-item="it" wx:key="key" data-k="{{it.key}}" bindtap="pickTier">{{it.label}}</view>
      </view>
    </view>

    <view class="card">
      <view class="ch">② 服务项目 <text class="hint">默认=预约项目，可改可多选</text></view>
      <scroll-view class="cattabs" scroll-x>
        <view class="chip {{catId === c.id ? 'on' : ''}}" wx:for="{{cats}}" wx:for-item="c" wx:key="id" data-id="{{c.id}}" bindtap="pickCat">{{c.name}}</view>
      </scroll-view>
      <view class="item" wx:for="{{mainItems}}" wx:for-item="it" wx:key="id" data-id="{{it.id}}" bindtap="toggleItem">
        <view class="ck {{it.on ? 'on' : ''}}">{{it.on ? '✓' : ''}}</view>
        <view class="iname">{{it.name}}</view>
        <view class="pr">
          <text wx:if="{{it.listText}}" class="mut">{{it.listText}}</text>
          <text class="now {{it.isFree ? 'free' : ''}}">{{it.priceText}}</text>
        </view>
      </view>
      <view wx:if="{{!mainItems.length}}" class="empty">该大类下暂无在售项目</view>
    </view>

    <view class="card">
      <view class="ch">③ 加项目录 <text class="hint">按本单价格档计价</text></view>
      <block wx:for="{{addonGroups}}" wx:for-item="g" wx:key="title">
        <view class="gh">{{g.title}}</view>
        <view class="item" wx:for="{{g.items}}" wx:for-item="it" wx:key="id">
          <block wx:if="{{it.perFinger}}">
            <view class="iname wide">{{it.name}}</view>
            <view class="stepper">
              <view class="sb" data-id="{{it.id}}" data-d="-1" catchtap="stepQty">−</view>
              <text class="qn">{{it.qty}} 指</text>
              <view class="sb" data-id="{{it.id}}" data-d="1" catchtap="stepQty">＋</view>
            </view>
          </block>
          <block wx:else>
            <view class="ck {{it.on ? 'on' : ''}}" data-id="{{it.id}}" catchtap="toggleItem">{{it.on ? '✓' : ''}}</view>
            <view class="iname" data-id="{{it.id}}" catchtap="toggleItem">{{it.name}}</view>
            <view class="pr">
              <text wx:if="{{it.listText}}" class="mut">{{it.listText}}</text>
              <text class="now {{it.isFree ? 'free' : ''}}">{{it.priceText}}</text>
            </view>
          </block>
        </view>
      </block>
      <view class="gh">整单规则</view>
      <view class="item">
        <view class="iname wide">足部美甲<text class="sub">手部基础上整单加收</text></view>
        <view class="sw {{applyFootSurcharge ? 'on' : ''}}" bindtap="toggleFoot"><view class="dot"></view></view>
      </view>
      <view class="item">
        <view class="iname wide">甲片重复利用<text class="sub">固定价 · 仅限本店甲片</text></view>
        <view class="sw {{applyTipReuse ? 'on' : ''}}" bindtap="toggleTipReuse"><view class="dot"></view></view>
      </view>
    </view>

    <view class="card">
      <view class="ch">④ 自选填写行 <text class="hint">价目表外项目</text></view>
      <view class="inputline">
        <input class="in" placeholder="项目名称（例：钻球）" value="{{customName}}" bindinput="onCustomName" />
        <input class="in amt" placeholder="金额" type="digit" value="{{customAmount}}" bindinput="onCustomAmount" />
        <view class="addbtn" bindtap="addCustom">＋添加</view>
      </view>
      <view class="cst" wx:for="{{customItems}}" wx:for-item="c" wx:key="name" wx:for-index="index" data-i="{{index}}" bindtap="removeCustom">
        <text>{{c.name}}</text><text class="del">移除</text>
      </view>
    </view>

    <view class="card">
      <view class="ch">⑤ 定金</view>
      <view wx:if="{{depositDeductible}}" class="radios">
        <view class="radio {{depositApplied ? 'on' : ''}}" data-v="1" bindtap="setDeposit">
          <view class="dt"></view>已付定金抵扣
          <text wx:if="{{view.hasDeposit}}" class="ok">−{{view.depositDeduct}}</text>
        </view>
        <view class="radio {{depositApplied ? '' : 'on'}}" data-v="0" bindtap="setDeposit"><view class="dt"></view>未付定金</view>
      </view>
      <view wx:else class="empty">本店定金不抵扣尾款（门店设置 → 定金与取消规则）</view>

      <!-- 屏 C1：优惠券行，位置=定金行正下方。默认收起显示可用券数；点开=选券面板 -->
      <view class="cpnline" bindtap="openCouponPanel">
        <text class="l">优惠券</text>
        <block wx:if="{{couponPicked}}">
          <text class="v ok">{{couponPicked.name}} {{couponPicked.deductText}}</text>
          <text class="arr">›</text>
        </block>
        <block wx:elif="{{couponUsableCount}}">
          <text class="v">顾客有 {{couponUsableCount}} 张可用券</text>
          <text class="arr">›</text>
        </block>
        <block wx:else>
          <text class="v mut">无可用券</text>
        </block>
      </view>
    </view>

    <view class="card">
      <view class="ch">⑥ 本单技师 <text class="hint">先从本店名单勾人（1–2 位）</text></view>
      <view class="roster">
        <view class="chip {{selectedTechs[0] === t.id || selectedTechs[1] === t.id ? 'on' : ''}}" wx:for="{{roster}}" wx:for-item="t" wx:key="id" data-id="{{t.id}}" bindtap="toggleTech">
          {{t.name}}<text wx:if="{{t.title}}" class="r">{{t.title}}</text>
        </view>
      </view>
      <view class="tip" wx:if="{{selectedTechs.length}}">
        已选 {{selectedTechs.length}} 位（第一位为主技师<text wx:if="{{selectedTechs.length > 1}}" class="link" bindtap="swapMain">· 对调主副</text>）· 再各自勾自己做的项目编号：
      </view>
      <view class="techrow" wx:for="{{techRows}}" wx:for-item="tr" wx:key="id">
        <view class="tn">{{tr.name}}<text class="role {{tr.isMain ? '' : 'sub'}}">{{tr.role}}</text></view>
        <view class="minichips">
          <view class="mchip {{c.on ? 'on' : ''}}" wx:for="{{tr.chips}}" wx:for-item="c" wx:key="no" data-tech="{{tr.id}}" data-no="{{c.no}}" bindtap="toggleTechItem">{{c.no}}</view>
        </view>
      </view>
      <view class="tip">分成金额由店长在日结时核定，此处不填</view>
    </view>

    <view class="card" wx:if="{{view}}">
      <view class="ch">⑦ 支付构成</view>
      <view class="payline" wx:for="{{view.legs}}" wx:for-item="l" wx:key="label">
        <text class="l">{{l.label}}</text><text class="v">{{l.amount}}</text>
      </view>
      <view class="alert" wx:if="{{view.hasShortfall}}">
        <view class="ah">余额不足以全额抵扣（差 {{view.shortfall}}）请选择处理方式：</view>
        <view class="opts">
          <view class="opt {{payIntent === p.key ? 'on' : ''}}" wx:for="{{payPlans}}" wx:for-item="p" wx:key="key" data-k="{{p.key}}" bindtap="pickPayPlan">{{payIntent === p.key ? '✓ ' : ''}}{{p.label}}</view>
        </view>
      </view>
      <view class="warn" wx:for="{{view.warnings}}" wx:for-item="w" wx:key="*this">{{w}}</view>
    </view>

    <view class="card">
      <view class="ch">被服务者 <text class="hint">朋友不建档：填称呼即可，单据仍推卡主签</text></view>
      <input class="in full" placeholder="留空=本人；朋友填称呼" value="{{servedPersonName}}" bindinput="onServedName" />
    </view>

    <view class="total" wx:if="{{view}}">
      <view class="tl"><text>原价合计</text><text class="strike">{{view.listTotal}}</text></view>
      <view class="tl"><text>档位小计</text><text>{{view.subtotal}}</text></view>
      <view class="tl" wx:if="{{view.hasDeposit}}"><text>定金抵扣</text><text>−{{view.depositDeduct}}</text></view>
      <view class="tl save" wx:if="{{view.hasCoupon}}"><text>优惠券 {{view.couponName}}</text><text>−{{view.couponDeduct}}</text></view>
      <view class="tl save"><text>{{view.discountLabel}}</text><text>{{view.discountTotal}}</text></view>
      <view class="tl big"><text>应收合计</text><text>{{view.total}}</text></view>
    </view>

    <!-- 选券面板：可用在上，不可用置灰在下并写原因（金额与原因均由后端下发） -->
    <view wx:if="{{couponPanel}}" class="cpnmask" bindtap="closeCouponPanel">
      <view class="cpnsheet" catchtap="noop">
        <view class="ch">选择优惠券 · {{customerName}}的券包</view>
        <scroll-view class="cpnlist" scroll-y>
          <view class="cpn {{o.usable ? '' : 'dis'}} {{couponGrantId === o.grantId ? 'on' : ''}}"
                wx:for="{{couponOptions}}" wx:for-item="o" wx:key="grantId" data-id="{{o.grantId}}" bindtap="pickCoupon">
            <view class="l">
              <text class="n">{{o.name}}</text>
              <text class="s">{{o.usable ? o.subtitle : o.reason}}</text>
            </view>
            <text wx:if="{{o.usable}}" class="d">{{o.deductText}}</text>
            <view class="pick"></view>
          </view>
          <view class="cpn {{couponGrantId ? '' : 'on'}}" data-id="" bindtap="pickCoupon">
            <view class="l"><text class="n">不使用优惠券</text><text class="s">本单不抵扣</text></view>
            <view class="pick"></view>
          </view>
        </scroll-view>
        <view class="cpnok" bindtap="closeCouponPanel">确定</view>
      </view>
    </view>

    <view class="cta {{submitting ? 'ing' : ''}}" bindtap="submit">{{submitting ? '提交中…' : ctaText}}</view>

  <!-- 屏 S3:推送签署后所有单都弹这一层。沙盒态=占位图+链接+复制(裁决 b),
       真码等接微信官方 wxacode.getUnlimited;状态行实时三态,签完自动关闭。 -->
  <view wx:if="{{qr}}" class="qmask" bindtap="closeQr"></view>
  <view wx:if="{{qr}}" class="qsheet">
    <view class="qhd">
      <text class="qt">请顾客扫码签署</text>
      <text class="qx" bindtap="closeQr">✕</text>
    </view>
    <view class="qpushed" wx:if="{{qr.pushedText}}">{{qr.pushedText}}</view>
    <view class="qcode">
      <view class="qph">二维码</view>
      <view class="qphs">沙盒占位 · 发版接微信小程序码后显示真码</view>
    </view>
    <view class="qno">{{qr.code}}</view>
    <view class="qamt">{{qr.amountText}}</view>
    <view class="qsub">{{qr.breakdownText}}</view>
    <view class="qlink">{{qr.url}}</view>
    <view class="qcopy" bindtap="copyQrLink">复制链接</view>
    <view class="qstate {{qr.state}}">{{qr.stateText}}</view>
    <view class="qtip">顾客扫码 → 手机号授权 → 核对明细 → 签字;签完此页自动关闭并回到今日台面</view>
    <view class="qhand" bindtap="handSign">顾客无法扫码?店员设备当面手签</view>
    <view class="qhandtip">当面手签=本人在场本人签;档案保持未绑定,下次可扫店内建档码补绑</view>
  </view>
    <view class="foot">金额全部由后端计价引擎算出，本页不做任何金额运算</view>
  </block>
</view>
