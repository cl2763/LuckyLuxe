<view class="pg">
  <view class="hd">
    <text class="t">结算开单</text>
    <!-- 屏 S2:顾客行 = 姓名 + 脱敏手机号 + 「新客·未绑定」徽标(文案后端下发) -->
    <view class="s2row">
      <text class="s2name">{{customerName}}</text>
      <text class="s2phone" wx:if="{{bind.phoneMasked}}">{{bind.phoneMasked}}</text>
      <text class="s2badge" wx:if="{{bind.badgeText}}">{{bind.badgeText}}</text>
    </view>
    <view class="s2hint" wx:if="{{bind.hintText}}">{{bind.hintText}} <text class="bindlink" catchtap="openBindCode">出示绑定码 →</text></view>
  </view>

  <!-- qrOnly 纯出码模式不加载价目表 -->
  <view wx:if="{{!ready && !qrOnly}}" class="loading">正在读取本店价目表…</view>

  <block wx:else>
    <!-- ═══ 组内六件套 × N(图 v2.2 屏1/屏2):每个服务项目一组,这组做什么、谁做、给谁做,一张卡说清 ═══ -->
    <block wx:for="{{groups}}" wx:for-item="grp" wx:for-index="gi" wx:key="key">

      <!-- 收起态摘要行(屏2 上半) -->
      <view wx:if="{{grp.collapsed}}" class="card grpcard dim" data-g="{{gi}}" bindtap="gToggleCollapse">
        <view class="ch">服务项目 {{grp.label}} · {{grp.mainName || '(未选)'}}{{grp.techLine ? ' · ' + grp.techLine : ''}} <text class="hint">展开 ▸</text></view>
        <view class="grpsum">{{grp.summary}}</view>
      </view>

      <!-- 展开态:六件套 -->
      <view wx:else class="card grpcard">
        <view class="ch">服务项目 {{grp.label}}
          <text wx:if="{{gi > 0}}" class="grpx" data-g="{{gi}}" catchtap="removeGroup">✕ 移除此项目</text>
          <text wx:elif="{{groups.length > 1}}" class="hint" data-g="{{gi}}" catchtap="gToggleCollapse">收起 ▾</text>
        </view>

        <!-- 拍板(店主 08-21):次卡=独立消费不叠优惠——次卡组隐藏价格体系整排(折算价/套餐价与档位无关) -->
        <block wx:if="{{grp.catId !== '__timecard'}}">
          <view class="sec">价格体系(本组独立) <text class="hint">{{grp.tierChanged ? '已改档，将留痕' : '默认按会员判定'}}</text></view>
          <view class="chiprow">
            <view class="chip {{grp.tierKey === it.key ? 'on' : ''}}" wx:for="{{tiers}}" wx:for-item="it" wx:key="key" data-g="{{gi}}" data-k="{{it.key}}" bindtap="gPickTier">{{it.label}}</view>
          </view>
        </block>
        <view wx:else class="sec">次卡为独立消费 <text class="hint">按折算价/套餐价,不叠加会员价与优惠</text></view>

        <view class="sec">服务项目(单选自动替换)</view>
        <scroll-view class="cattabs" scroll-x>
          <view class="chip {{grp.catId === c.id ? 'on' : ''}}" wx:for="{{cats}}" wx:for-item="c" wx:key="id" data-g="{{gi}}" data-id="{{c.id}}" bindtap="gPickCat">{{c.name}}<text wx:if="{{c.badge}}" class="tcbadge">{{c.badge}}</text></view>
        </scroll-view>
        <!-- B1 次卡大类(图 §四 屏1):卡列表(label 后端句;过期置灰点击拦)→组内选项目→金额=折算单价(后端算) -->
        <block wx:if="{{grp.catId === '__timecard'}}">
          <view class="item tccard {{it.on ? '' : ''}} {{!it.redeemable ? 'tcdead' : ''}}" wx:for="{{grp.tcCards}}" wx:for-item="it" wx:key="id" data-g="{{gi}}" data-id="{{it.id}}" bindtap="gPickTimecard">
            <view class="ck {{it.on ? 'on' : ''}}">{{it.on ? '✓' : ''}}</view>
            <view class="iname">{{it.label}}<text wx:if="{{it.expired}}" class="tcexp">已过期</text></view>
          </view>
          <!-- B1-6 现场购卡入口(图 §四 屏1:顾客没卡?当场买当场用):选套餐→组内选项目→一次签署分行 -->
          <view wx:if="{{grp.tcPkgs.length}}" class="sec">＋ 现场购卡(顾客没卡?当场买当场用)</view>
          <view class="item tccard {{it.on ? '' : ''}}" wx:if="{{grp.tcPkgs.length}}" wx:for="{{grp.tcPkgs}}" wx:for-item="it" wx:key="id" data-g="{{gi}}" data-id="{{it.id}}" bindtap="gPickPurchasePkg">
            <view class="ck {{it.on ? 'on' : ''}}">{{it.on ? '✓' : ''}}</view>
            <view class="iname">{{it.label}}</view>
          </view>
          <view wx:if="{{grp.tcMode}}" class="sec">本次核销项目({{grp.tcMode === 'purchase' ? '新卡' : '卡'}}关联组内选)</view>
          <scroll-view wx:if="{{grp.tcMode}}" class="cattabs" scroll-x>
            <view class="chip {{s.on ? 'on' : ''}}" wx:for="{{grp.tcServices}}" wx:for-item="s" wx:key="id" data-g="{{gi}}" data-id="{{s.id}}" bindtap="gPickTcService">{{s.name}}</view>
          </scroll-view>
          <view wx:if="{{grp.tcMode && !grp.tcServices.length}}" class="empty">卡关联组内暂无在售项目</view>
          <view wx:if="{{grp.tcMode && grp.mainName}}" class="grppicked">本组:{{grp.mainName}}(金额=折算单价,签字{{grp.tcMode === 'purchase' ? '购卡+扣第 1 次' : '扣一次'}})</view>
        </block>
        <view class="item" wx:if="{{grp.catId !== '__timecard'}}" wx:for="{{grp.mainItems}}" wx:for-item="it" wx:key="id" data-g="{{gi}}" data-id="{{it.id}}" bindtap="gToggleMain">
          <view class="ck {{it.on ? 'on' : ''}}">{{it.on ? '✓' : ''}}</view>
          <view class="iname">{{it.name}}</view>
          <view class="pr">
            <text wx:if="{{it.listText}}" class="mut">{{it.listText}}</text>
            <text class="now {{it.isFree ? 'free' : ''}}">{{it.priceText}}</text>
          </view>
        </view>
        <view wx:if="{{!grp.mainItems.length && grp.catId !== '__timecard'}}" class="empty">该大类下暂无在售项目</view>
        <view wx:if="{{grp.mainId && grp.mainName}}" class="grppicked">本组主项目:{{grp.mainName}}(点其他大类里的项目=替换)</view>

        <view class="sec">加项目录(按本组主项目类别过滤) <text class="hint">按本组价格档计价</text></view>
        <block wx:for="{{grp.addonGroups}}" wx:for-item="ag" wx:key="title">
          <view class="gh">{{ag.title}}</view>
          <view class="item" wx:for="{{ag.items}}" wx:for-item="it" wx:key="id"
                data-g="{{gi}}" data-id="{{it.id}}" bindtap="{{it.perFinger ? '' : 'gToggleAddon'}}">
            <block wx:if="{{it.perFinger}}">
              <view class="iname wide">{{it.name}}</view>
              <view class="stepper">
                <view class="sb" data-g="{{gi}}" data-id="{{it.id}}" data-d="-1" catchtap="gStepQty">−</view>
                <text class="qn">{{it.qty}} 指</text>
                <view class="sb" data-g="{{gi}}" data-id="{{it.id}}" data-d="1" catchtap="gStepQty">＋</view>
              </view>
            </block>
            <block wx:else>
              <view class="ck {{it.on ? 'on' : ''}}">{{it.on ? '✓' : ''}}</view>
              <view class="iname">{{it.name}}</view>
              <view class="pr">
                <text wx:if="{{it.listText}}" class="mut">{{it.listText}}</text>
                <text class="now {{it.isFree ? 'free' : ''}}">{{it.priceText}}</text>
              </view>
            </block>
          </view>
        </block>

        <view class="sec">自选填写行(本组) <text class="hint">价目表外项目</text></view>
        <view class="inputline">
          <input class="in" placeholder="项目名称（例：钻球）" value="{{grp.customName}}" data-g="{{gi}}" bindinput="gCustomName" />
          <input class="in amt" placeholder="金额" type="digit" value="{{grp.customAmount}}" data-g="{{gi}}" bindinput="gCustomAmount" />
          <view class="addbtn" data-g="{{gi}}" bindtap="gAddCustom">＋添加</view>
        </view>
        <view class="cst" wx:for="{{grp.customItems}}" wx:for-item="c" wx:key="name" wx:for-index="ci" data-g="{{gi}}" data-i="{{ci}}" bindtap="gRemoveCustom">
          <text>{{c.name}}</text>
          <view class="cst-r"><text class="cst-amt">{{c.amountText}}</text><text class="del">移除</text></view>
        </view>

        <view class="sec">本单技师(本组,1–2 位) <text class="hint">双技师分成由店长日结核定</text></view>
        <view class="roster">
          <view class="chip {{grp.selectedTechs[0] === t.id || grp.selectedTechs[1] === t.id ? 'on' : ''}}" wx:for="{{roster}}" wx:for-item="t" wx:key="id" data-g="{{gi}}" data-id="{{t.id}}" bindtap="gToggleTech">
            {{t.name}}<text wx:if="{{t.title}}" class="r">{{t.title}}</text>
          </view>
        </view>

        <block wx:if="{{grp.techRows}}">
          <view class="numlist">
            <view class="numrow" wx:for="{{grp.numbered}}" wx:for-item="n" wx:key="no"><text class="nno">{{n.label}}</text><text class="nname">{{n.name}}</text></view>
          </view>
          <view class="techrow" wx:for="{{grp.techRows}}" wx:for-item="tr" wx:key="id">
            <view class="tn">{{tr.name}}</view>
            <view class="minichips">
              <view class="mchip {{c.on ? 'on' : ''}}" wx:for="{{tr.chips}}" wx:for-item="c" wx:key="no" data-g="{{gi}}" data-tech="{{tr.id}}" data-no="{{c.no}}" catchtap="gToggleTechItem">{{c.label}}</view>
            </view>
          </view>
          <view class="hint">每人点自己做的编号,可两人都点=共做;分成金额店长日结核定,此处只记录</view>
        </block>

        <view class="sec">被服务者(本组) <text class="hint">朋友不建档:填称呼即可,单据仍推卡主签</text></view>
        <input class="in full" placeholder="留空=本人；朋友填称呼" value="{{grp.servedPersonName}}" data-g="{{gi}}" bindinput="gServedName" />
      </view>

      <!-- 「＋添加第二个服务项目」在组①末尾之后(合同规则④) -->
      <view wx:if="{{gi === groups.length - 1}}" class="addmain" bindtap="addGroup">＋ 添加第二个服务项目</view>
    </block>

    <!-- ═══ 单级四件(图 v2.2 屏3):整单一份,在所有组之后 ═══ -->

    <view class="card">
      <view class="ch">定金 <text class="hint">按店配收取 · 有收取记录才出开关</text></view>
      <view wx:if="{{depositDeductible && view.hasDepositReceipt}}" class="radios">
        <view class="radio {{depositApplied ? 'on' : ''}}" data-v="1" bindtap="setDeposit">
          <view class="dt"></view>已付定金抵扣
          <text wx:if="{{view.hasDeposit}}" class="ok">−{{view.depositDeduct}}</text>
        </view>
        <view class="radio {{depositApplied ? '' : 'on'}}" data-v="0" bindtap="setDeposit"><view class="dt"></view>未付定金</view>
      </view>
      <view wx:elif="{{depositDeductible}}" class="empty">这张单没有定金收取记录,没有可抵扣的定金</view>
      <view wx:else class="empty">本店定金不抵扣尾款（门店设置 → 定金与取消规则）</view>

      <!-- 优惠券(图 v2.2 未画,按现状保留;挂组①的单,一单一张口径不变 —— 记假设) -->
      <view class="cpnline" bindtap="openCouponPanel">
        <text class="l">优惠券</text>
        <block wx:if="{{couponPicked}}">
          <text class="v ok">{{couponPicked.name}} {{couponPicked.deductText}}</text>
          <text class="arr">›</text>
        </block>
        <block wx:elif="{{couponUsableCount}}">
          <text class="v">顾客有 {{couponUsableCount}} 张可用券</text>
          <text class="arr">›</text>
        </block>
        <block wx:else>
          <text class="v mut">无可用券</text>
        </block>
      </view>

      <!-- 整单规则(足部加收/甲片重复利用):图未画,按现状保留为单级 —— 记假设 -->
      <view class="gh">整单规则</view>
      <view class="item">
        <view class="iname wide">足部美甲<text class="sub">手部基础上整单加收</text></view>
        <view class="sw {{applyFootSurcharge ? 'on' : ''}}" bindtap="toggleFoot"><view class="dot"></view></view>
      </view>
      <view class="item">
        <view class="iname wide">甲片重复利用<text class="sub">固定价 · 仅限本店甲片</text></view>
        <view class="sw {{applyTipReuse ? 'on' : ''}}" bindtap="toggleTipReuse"><view class="dot"></view></view>
      </view>
    </view>

    <!-- 支付构成 · 菜单式(合同规则③):技师勾"路",金额全部后端重算回显 -->
    <view class="card" wx:if="{{view}}">
      <view class="ch">支付构成 · 菜单式 <text class="hint">勾选支付方式,金额后端算</text></view>
      <!-- D55(店主终验抓出):勾选态与金额一致律——金额为 0 的支付腿不得处于勾选态(✓ 与高亮同条件) -->
      <view class="paym {{payMenu.useBalance && view.hasStored ? 'on' : ''}}" wx:if="{{view.hasBalance}}" bindtap="payToggleBalance">
        <view class="ck {{payMenu.useBalance && view.hasStored ? 'on' : ''}}">{{payMenu.useBalance && view.hasStored ? '✓' : ''}}</view>
        <view class="pmain"><b>储值卡抵扣</b><text class="psmall">可用余额 {{view.balance}}{{view.rvNote}}{{payMenu.useBalance && view.hasStored ? ' → 本单抵 ' + view.storedDeduct : (payMenu.useBalance ? ' · 本单无可抵金额' : '')}}</text></view>
      </view>
      <view class="paym {{depositApplied && view.hasDeposit ? 'on' : ''}}" wx:if="{{view.hasDepositReceipt && depositDeductible}}" bindtap="payToggleDeposit">
        <view class="ck {{depositApplied && view.hasDeposit ? 'on' : ''}}">{{depositApplied && view.hasDeposit ? '✓' : ''}}</view>
        <view class="pmain"><b>已收定金抵扣</b><text class="psmall">−{{view.depositDeduct}}(来自收取记录)</text></view>
      </view>
      <view class="paym {{view.hasOffline ? 'on' : ''}}" bindtap="payToggleOffline">
        <view class="ck {{view.hasOffline ? 'on' : ''}}">{{view.hasOffline ? '✓' : ''}}</view>
        <view class="pmain"><b>线下收款(现金/扫码/POS)</b><text class="psmall">差额 {{view.offlineDue}} 到店收</text></view>
      </view>
      <view class="paym {{payMenu.recharge ? 'on' : ''}}" bindtap="payToggleRecharge">
        <view class="ck {{payMenu.recharge ? 'on' : ''}}">{{payMenu.recharge ? '✓' : ''}}</view>
        <view class="pmain">
          <b>随单充值(签字生效)</b>　<text class="rvlink {{bind.bound?'':'dis'}}" catchtap="openRecharge">{{rvDraft ? '改充值 →' : '去挂充值 →'}}</text>
          <view wx:if="{{userId && !bind.bound}}" class="bindbar">未绑定档案不可充值 —— 请先让顾客扫码绑定<view class="bindbtn" catchtap="openBindCode">出示绑定码</view></view>
          <text class="psmall">{{rvDraft ? '已挂:' + rvDraft.label + ';签字那一刻才入账,充完即抵本单' : '挂到本单一起签:签字那一刻充值才入账,充完即抵本单'}}</text>
        </view>
      </view>
      <view class="paynote">勾/不勾任何一项,金额分解都由后端重新算出并回显;不勾储值=全额线下。</view>
      <view class="warn" wx:for="{{view.warnings}}" wx:for-item="w" wx:key="*this">{{w}}</view>
    </view>

    <!-- 分组明细 + 合计(合同 单级③):谁的挂谁下面;原价合计与共优惠行不许丢 -->
    <view class="total" wx:if="{{view}}">
      <block wx:for="{{view.groups}}" wx:for-item="dg" wx:key="title">
        <view class="mg">{{dg.title}}</view>
        <view class="dtl" wx:for="{{dg.lines}}" wx:for-item="l" wx:key="no">
          <text class="dtl-n">{{l.name}}{{l.qty > 1 ? ' ×' + l.qty : ''}}</text>
          <view class="dtl-r">
            <text wx:if="{{l.list}}" class="mut strike">{{l.list}}</text>
            <text class="dtl-a">{{l.amount}}</text>
          </view>
        </view>
      </block>
      <view class="tl"><text>原价合计</text><text class="strike">{{view.listTotal}}</text></view>
      <view class="tl"><text>档位小计</text><text>{{view.subtotal}}</text></view>
      <view class="tl save"><text>{{view.discountLabel}}</text><text>{{view.discountTotal}}</text></view>
      <view class="tl save" wx:if="{{view.hasTimecard}}"><text>次卡抵扣(签字扣次)</text><text>−{{view.timecardCover}}</text></view>
      <view class="tl" wx:if="{{view.hasStored}}"><text>储值抵扣</text><text>−{{view.storedDeduct}}</text></view>
      <view class="tl" wx:if="{{view.hasDeposit}}"><text>定金抵扣</text><text>−{{view.depositDeduct}}</text></view>
      <!-- D60 自证行:现场购卡款显式(预收)——不许隐身进应收 -->
      <view class="tl" wx:if="{{view.hasPurchase}}"><text>现场购卡{{view.purchaseName ? ' · ' + view.purchaseName : ''}}(购卡款,预收)</text><text>+{{view.purchaseAmount}}</text></view>
      <!-- B3-1 随单充值三行分行(图 §四 屏3):实收/赠送/充后余额;签字生效,数字全由后端回传 -->
      <view class="tl" wx:if="{{view.hasRecharge}}"><text>本次充值实收(签字生效)</text><text>+{{view.rechargeAmount}}</text></view>
      <view class="tl save" wx:if="{{view.hasRecharge && view.rechargeBonus}}"><text>充值赠送(营销让利)</text><text>+{{view.rechargeBonus}}</text></view>
      <view class="tl" wx:if="{{view.hasRecharge && view.afterBalance}}"><text>充后余额(预计)</text><text>{{view.afterBalance}}</text></view>
      <view class="tl big"><text>到店应收</text><text>{{view.total}}</text></view>
    </view>

    <!-- 选券面板(现状保留) -->
    <view wx:if="{{couponPanel}}" class="cpnmask" bindtap="closeCouponPanel">
      <view class="cpnsheet" catchtap="noop">
        <view class="ch">选择优惠券 · {{customerName}}的券包</view>
        <scroll-view class="cpnlist" scroll-y>
          <view class="cpn {{o.usable ? '' : 'dis'}} {{couponGrantId === o.grantId ? 'on' : ''}}"
                wx:for="{{couponOptions}}" wx:for-item="o" wx:key="grantId" data-id="{{o.grantId}}" bindtap="pickCoupon">
            <view class="l">
              <text class="n">{{o.name}}</text>
              <text class="s">{{o.usable ? o.subtitle : o.reason}}</text>
            </view>
            <text wx:if="{{o.usable}}" class="d">{{o.deductText}}</text>
            <view class="pick"></view>
          </view>
          <view class="cpn {{couponGrantId ? '' : 'on'}}" data-id="" bindtap="pickCoupon">
            <view class="l"><text class="n">不使用优惠券</text><text class="s">本单不抵扣</text></view>
            <view class="pick"></view>
          </view>
        </scroll-view>
        <view class="cpnok" bindtap="closeCouponPanel">确定</view>
      </view>
    </view>

    <view class="cta {{submitting ? 'ing' : ''}}" bindtap="submit">{{submitting ? '提交中…' : ctaText}}</view>

    <view class="foot">金额全部由后端计价引擎算出，本页不做任何金额运算</view>
  </block>

  <!-- B3-1 随单充值面板(挂单随签:只挂草稿,签字那一刻才入账)—— 浮层放顶层闸门外(护栏) -->
  <view wx:if="{{rvPanel}}" class="qmask" bindtap="closeRecharge"></view>
  <view wx:if="{{rvPanel}}" class="rvsheet">
    <view class="qhd">
      <text class="qt">帮 {{customerName}} 随单充值</text>
      <text class="qx" bindtap="closeRecharge">✕</text>
    </view>
    <view class="sec" wx:if="{{rvPanel.pkgs.length}}">选充值套餐(充X赠Y,赠额后端按套餐算)</view>
    <view class="rvtier {{rvPanel.packageId === p.id ? 'on' : ''}}" wx:for="{{rvPanel.pkgs}}" wx:for-item="p" wx:key="id" data-id="{{p.id}}" bindtap="rvPickPkg">
      <text>{{p.label}}</text>
    </view>
    <view class="sec">或手输金额(无赠送)</view>
    <input class="in full" type="digit" placeholder="充值金额" value="{{rvPanel.amount}}" bindinput="rvAmountInput" />
    <view class="rvnote">挂到本单一起签:签字那一刻充值才入账、随即抵扣本单,签署单上分行列明「充值实收 / 本单抵扣 / 充后余额」。未签退出=什么都没发生。</view>
    <view class="ds-confirm" bindtap="rvConfirm">挂到本单(签字生效)</view>
    <view class="rvlink center" wx:if="{{rvDraft}}" bindtap="rvRemove">移除本单充值</view>
  </view>

  <!-- 屏 S3 出码层(现有闭环全保留;多组=同组多张单,顾客按 待签 1/N 顺序签) -->
  <view wx:if="{{bindQr}}" class="qmask" bindtap="closeBindCode"></view>
  <view wx:if="{{bindQr}}" class="qsheet">
    <view class="qtitle">出示绑定码 · {{bindQr.displayName}}</view>
    <view class="qnewc">{{bindQr.hint}}</view>
    <view class="qrbox"><view class="qrph">沙盒占位码
(上线换 wxacode 真码)</view></view>
    <!-- 店主 2026-08-12 小改:链接文本删除,只留两钮(打开/复制) -->
    <view class="qbtns">
      <view class="qbtn dark" catchtap="openBindLink">打开链接</view>
      <view class="qbtn" catchtap="copyBindLink">复制链接</view>
    </view>
    <view class="qstate waiting">{{bindQr.stateText}}</view>
    <view class="qsub">顾客扫码只做绑定 —— 不会进入签署、看不到结算单与金额</view>
  </view>
  <view wx:if="{{qr}}" class="qmask" bindtap="closeQr"></view>
  <view wx:if="{{qr}}" class="qsheet">
    <view class="qhd">
      <text class="qt">请顾客扫码签署</text>
      <text class="qx" bindtap="closeQr">✕</text>
    </view>
    <view class="qnewc" wx:if="{{qr.unbound}}">新客 · 尚未绑定档案——请顾客扫码签署(扫码即自动建立绑定)</view>
    <view class="qpushed" wx:if="{{qr.pushedText}}">{{qr.pushedText}}</view>
    <view class="qcode">
      <view class="qph">二维码</view>
      <view class="qphs">沙盒占位 · 发版接微信小程序码后显示真码</view>
    </view>
    <view class="qno">{{qr.code}}</view>
    <view class="qamt">{{qr.amountText}}</view>
    <view class="qsub">{{qr.breakdownText}}</view>
    <view class="qbtns">
      <view class="qbtn dark" catchtap="openQrLink">打开链接</view>
      <view class="qbtn" catchtap="copyQrLink">复制链接</view>
    </view>
    <view class="qstate {{qr.state}}">{{qr.stateText}}</view>
    <view class="qtip">顾客扫码 → 手机号授权 → 核对明细 → 签字;签完此页自动关闭并回到今日台面</view>
    <block wx:if="{{!qr.unbound}}">
      <view class="qhand" bindtap="handSign">顾客无法扫码?店员设备当面手签</view>
      <view class="qhandtip">当面手签=本人在场本人签;档案保持未绑定,下次可扫店内建档码补绑</view>
    </block>
    <view wx:else class="qhandtip">新客只有扫码一条签署路 —— 扫码签署会自动建立档案绑定</view>
  </view>
</view>
