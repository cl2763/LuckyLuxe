.pg{padding:16rpx 24rpx 60rpx;background:var(--paper);min-height:100vh}
.hd{padding:8rpx 4rpx 16rpx}
.hd .t{font-size:36rpx;font-weight:800;color:var(--ink)}
.hd .s{display:block;font-size:24rpx;color:var(--sub);margin-top:6rpx}
.loading{padding:80rpx 0;text-align:center;color:var(--sub);font-size:26rpx}
.retry-boot{max-width:320rpx;border-radius:999rpx;background:var(--hero);color:var(--heroink);font-size:27rpx}
.empty{padding:24rpx 0;text-align:center;color:var(--sub);font-size:24rpx}

.card{background:var(--card);border-radius:18rpx;padding:20rpx 18rpx;margin-bottom:16rpx;box-shadow:0 3rpx 10rpx rgba(92,70,48,.06)}
.ch{font-size:26rpx;font-weight:800;color:var(--ink);margin-bottom:12rpx}
.ch .hint{font-size:22rpx;font-weight:400;color:var(--sub);margin-left:10rpx}

.chiprow,.roster{display:flex;flex-wrap:wrap;gap:12rpx}
.chip{font-size:26rpx;padding:10rpx 24rpx;border-radius:999rpx;background:var(--wall);color:var(--brandd);flex:none}
.chip.on{background:var(--hero);color:var(--heroink);font-weight:700}
.chip .r{font-size:20rpx;opacity:.7;margin-left:6rpx}
.cattabs{white-space:nowrap;margin-bottom:8rpx}
.cattabs .chip{display:inline-block;margin-right:12rpx}

.item{display:flex;align-items:center;gap:12rpx;padding:16rpx 0;border-bottom:1rpx solid var(--line)}
.item:last-child{border-bottom:none}
.ck{width:38rpx;height:38rpx;flex:none;border-radius:10rpx;border:2rpx solid var(--line);color:var(--heroink);font-size:24rpx;display:flex;align-items:center;justify-content:center}
.ck.on{background:var(--hero);border-color:var(--hero)}
.iname{flex:1;font-size:27rpx;color:var(--ink)}
.iname.wide{flex:1}
.iname .sub{display:block;font-size:21rpx;color:var(--sub);margin-top:4rpx}
.pr{text-align:right;flex:none}
.pr .mut{font-size:22rpx;color:var(--sub);text-decoration:line-through;margin-right:8rpx}
.pr .now{font-size:28rpx;font-weight:800;color:var(--brandd)}
.pr .now.free{color:var(--good)}
.gh{font-size:22rpx;color:var(--brandd);font-weight:700;margin-top:14rpx;padding-bottom:4rpx}

.stepper{display:flex;align-items:center;gap:14rpx;flex:none}
.stepper .sb{width:48rpx;height:48rpx;border-radius:12rpx;background:var(--wall);color:var(--brandd);font-size:30rpx;display:flex;align-items:center;justify-content:center}
.stepper .qn{font-size:24rpx;color:var(--ink);min-width:70rpx;text-align:center}

.sw{width:78rpx;height:44rpx;border-radius:999rpx;background:var(--wall);flex:none;position:relative;transition:background .2s}
.sw.on{background:var(--good)}
.sw .dot{position:absolute;top:5rpx;left:5rpx;width:34rpx;height:34rpx;border-radius:50%;background:#fff;transition:transform .2s}
.sw.on .dot{transform:translateX(34rpx)}

.inputline{display:flex;gap:10rpx;align-items:center}
.in{flex:1;background:var(--paper);border:1rpx solid var(--line);border-radius:12rpx;padding:16rpx 14rpx;font-size:26rpx;color:var(--ink)}
.in.amt{flex:.55}
.in.full{width:100%}.addbtn {flex:none;background:var(--hero);color:var(--heroink);border-radius:999rpx;padding:16rpx 20rpx;font-size:25rpx;font-weight:700}
.cst{display:flex;justify-content:space-between;font-size:25rpx;color:var(--ink);padding:14rpx 0;border-bottom:1rpx solid var(--line)}
.cst .del{color:var(--bad);font-size:23rpx}

.radios{display:flex;gap:24rpx;flex-wrap:wrap}
.radio{display:flex;align-items:center;gap:10rpx;font-size:26rpx;color:var(--brandd)}
.radio .dt{width:30rpx;height:30rpx;border-radius:50%;border:3rpx solid var(--line)}
.radio.on{color:var(--ink);font-weight:700}
.radio.on .dt{border-color:var(--hero);background:var(--hero)}
.radio .ok{color:var(--good);font-weight:800;margin-left:8rpx}

.tip{font-size:22rpx;color:var(--sub);margin:12rpx 0;line-height:1.6}
.tip .link{color:var(--brandd);font-weight:700}
.techrow{background:var(--paper);border-radius:14rpx;padding:14rpx;margin-bottom:10rpx}
.techrow .tn{font-size:26rpx;font-weight:800;color:var(--ink);margin-bottom:10rpx}
.techrow .role{font-size:20rpx;background:var(--hero);color:var(--heroink);border-radius:999rpx;padding:2rpx 12rpx;margin-left:10rpx}
.techrow .role.sub{background:var(--line)}
.minichips{display:flex;flex-wrap:wrap;gap:10rpx}.mchip {min-width:56rpx;text-align:center;font-size:22rpx;padding:8rpx 0;border-radius:999rpx;background:var(--card);border:1rpx solid var(--line);color:var(--sub)}
.mchip.on{background:var(--hero);border-color:var(--hero);color:var(--heroink);font-weight:700}

.payline{display:flex;justify-content:space-between;align-items:center;font-size:26rpx;padding:12rpx 0;border-bottom:1rpx solid var(--line)}
.payline:last-child{border-bottom:none}
.payline .l{color:var(--brandd)}
.payline .v{font-weight:800;color:var(--ink)}
.alert{background:var(--paper);border:1rpx solid var(--line);border-radius:14rpx;padding:14rpx;margin-top:12rpx}
.alert .ah{font-size:24rpx;color:var(--brandd);font-weight:700;line-height:1.6}
.opts{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:12rpx}
.opt{font-size:23rpx;padding:10rpx 18rpx;border-radius:999rpx;background:var(--card);border:1rpx solid var(--line);color:var(--brandd)}
.opt.on{background:var(--brand);border-color:var(--brand);color:var(--hero);font-weight:700}
.warn{margin-top:10rpx;font-size:23rpx;color:var(--brandd);line-height:1.6}

.total{background:var(--card);border-radius:18rpx;padding:18rpx;box-shadow:0 3rpx 10rpx rgba(92,70,48,.06)}
.tl{display:flex;justify-content:space-between;font-size:26rpx;color:var(--brandd);padding:8rpx 0}
.tl .strike{text-decoration:line-through;color:var(--sub)}
.tl.save{color:var(--good);font-weight:700}
.tl.big{font-size:32rpx;font-weight:850;color:var(--ink);border-top:1rpx solid var(--line);margin-top:8rpx;padding-top:14rpx}.cta {margin-top:18rpx;background:var(--hero);color:var(--heroink);text-align:center;padding:28rpx;border-radius:999rpx;font-size:30rpx;font-weight:800}
.cta.ing{background:var(--line)}
.foot{margin-top:14rpx;text-align:center;font-size:21rpx;color:var(--sub)}

/* 屏 C1 优惠券行 + 选券面板(2026-08-09)。金额与不可用原因全部来自后端,本页零算术。 */
.cpnline{display:flex;align-items:center;justify-content:space-between;padding:18rpx 0 6rpx;border-top:1rpx solid var(--line);margin-top:8rpx}
.cpnline .l{font-size:26rpx;color:var(--brandd)}
.cpnline .v{font-size:26rpx;font-weight:700;color:var(--ink);margin-left:auto}
.cpnline .v.ok{color:var(--good)}
.cpnline .v.mut{color:var(--sub);font-weight:400}
.cpnline .arr{color:var(--sub);font-size:26rpx;margin-left:10rpx}

.cpnmask{position:fixed;left:0;right:0;top:0;bottom:0;background:rgba(35,30,28,.42);z-index:60;display:flex;align-items:flex-end}
.cpnsheet{width:100%;background:var(--card);border-radius:28rpx 28rpx 0 0;padding:24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom))}
.cpnlist{max-height:56vh}
.cpn{display:flex;align-items:center;gap:12rpx;border:1rpx solid var(--line);border-radius:16rpx;padding:18rpx;margin-bottom:12rpx;background:var(--card)}
.cpn.on{border-color:var(--good);background:var(--goodbg)}
.cpn.dis{opacity:.55}
.cpn .l{flex:1}
.cpn .n{font-size:27rpx;font-weight:700;color:var(--ink)}
.cpn .s{display:block;font-size:21rpx;color:var(--sub);margin-top:6rpx}
.cpn.dis .s{color:var(--brandd)}
.cpn .d{font-size:27rpx;font-weight:800;color:var(--good);margin-right:8rpx}
.cpn .pick{width:34rpx;height:34rpx;flex:none;border-radius:50%;border:3rpx solid var(--line)}
.cpn.on .pick{border-color:var(--good);background:var(--goodbg);box-shadow:inset 0 0 0 6rpx #fff}
.cpnok{margin-top:8rpx;background:var(--hero);color:var(--heroink);text-align:center;padding:26rpx;border-radius:16rpx;font-size:29rpx;font-weight:800}

/* 屏 S2:顾客行 + 「新客·未绑定」徽标(文案后端下发,绑定后整块消失) */
.s2row{display:flex;align-items:center;flex-wrap:wrap;gap:10rpx;margin-top:6rpx}
.s2name{font-size:26rpx;font-weight:700;color:var(--ink)}
.s2phone{font-size:23rpx;color:var(--sub)}
.s2badge{font-size:21rpx;font-weight:700;background:var(--badbg);color:var(--bad);border-radius:999rpx;padding:3rpx 14rpx}
.s2proxy{font-size:21rpx;color:var(--brandd)}
.s2hint{margin-top:8rpx;font-size:21rpx;color:var(--sub);line-height:1.6}

/* 屏 S3 出示二维码弹层 */
.qmask{position:fixed;inset:0;background:rgba(20,16,14,.45);z-index:60}
.qsheet{position:fixed;left:32rpx;right:32rpx;top:50%;transform:translateY(-50%);background:var(--card);border-radius:24rpx;padding:28rpx 26rpx 24rpx;z-index:61;box-shadow:0 12rpx 40rpx rgba(45,40,38,.22)}
.qhd{display:flex;align-items:center;justify-content:space-between}
.qhd .qt{font-size:30rpx;font-weight:800;color:var(--ink)}
.qhd .qx{font-size:30rpx;color:var(--sub);padding:0 8rpx}
.qpushed{margin-top:12rpx;text-align:center;font-size:23rpx;font-weight:700;color:var(--good);background:var(--goodbg);border-radius:12rpx;padding:10rpx 0}
.qcode{margin:22rpx auto 0;width:340rpx;height:340rpx;border:2rpx dashed var(--line);border-radius:20rpx;background:var(--paper);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10rpx}
.qcode .qph{font-size:34rpx;font-weight:800;color:var(--sub)}
.qcode .qphs{font-size:20rpx;color:var(--sub);text-align:center;padding:0 24rpx;line-height:1.5}
.qno{margin-top:18rpx;text-align:center;font-size:24rpx;color:var(--sub);letter-spacing:1rpx}
.qamt{margin-top:6rpx;text-align:center;font-size:36rpx;font-weight:800;color:var(--ink)}
.qsub{margin-top:4rpx;text-align:center;font-size:22rpx;color:var(--sub)}
.qlink{margin-top:16rpx;font-size:20rpx;color:var(--brandd);word-break:break-all;text-align:center;line-height:1.5}
.qcopy{margin:10rpx auto 0;width:220rpx;text-align:center;font-size:23rpx;font-weight:700;color:var(--brandd);border:1rpx solid var(--line);border-radius:12rpx;padding:12rpx 0}
.qstate{margin-top:18rpx;text-align:center;font-size:25rpx;font-weight:700;color:var(--brandd);background:var(--paper);border-radius:12rpx;padding:14rpx 0}
.qstate.viewing{color:var(--good);background:var(--goodbg)}
.qstate.signed{color:var(--paper);background:var(--good)}
.qtip{margin-top:12rpx;font-size:21rpx;color:var(--sub);line-height:1.6;text-align:center}
.qhand{margin-top:18rpx;text-align:center;font-size:25rpx;font-weight:700;color:var(--ink);background:var(--wall);border-radius:14rpx;padding:20rpx 0}
.qhandtip{margin-top:8rpx;font-size:20rpx;color:var(--sub);line-height:1.5;text-align:center}

/* D9 规则⑤:新客(未绑定轻档案)进签署的显著提示 */
.qnewc{margin-top:12rpx;text-align:center;font-size:24rpx;font-weight:700;color:var(--bad);background:var(--paper);border:1rpx solid var(--line);border-radius:12rpx;padding:14rpx 12rpx;line-height:1.5}

/* D22③ 金额区逐行明细(点开对账) */
.dtl-toggle{margin-left:12rpx;font-size:22rpx;color:var(--brandd);font-weight:400}
.dtl{display:flex;justify-content:space-between;align-items:center;font-size:24rpx;color:var(--sub);padding:8rpx 0 8rpx 16rpx;border-bottom:1rpx dashed var(--line)}
.dtl-n{flex:1;margin-right:12rpx}
.dtl-r{display:flex;align-items:center;gap:12rpx}
.dtl-a{color:var(--ink);font-weight:600}
.dtl-x{color:var(--bad);font-size:26rpx;padding:0 8rpx}
/* D22 跨大类已选主项目芯片:看不见但在计费的行,钉出来 */
.ghostrow{display:flex;flex-wrap:wrap;align-items:center;gap:10rpx;margin:-8rpx 0 16rpx;padding:12rpx 16rpx;background:var(--wall);border:1rpx solid var(--line);border-radius:12rpx}
.ghost-t{font-size:23rpx;color:var(--brandd);font-weight:700}
.ghost-chip{display:flex;align-items:center;gap:4rpx;font-size:23rpx;color:var(--ink);background:var(--card);border:1rpx solid var(--line);border-radius:999rpx;padding:6rpx 8rpx 6rpx 16rpx}
/* D23:自选行显示金额;输入框加高,文字不上下截断 */
.cst-r{display:flex;align-items:center;gap:16rpx}
.cst-amt{color:var(--ink);font-weight:600}
.in{min-height:72rpx;line-height:40rpx;box-sizing:border-box}

/* 主项目选择机制终版:「＋加第二个主项目」显式加选按钮(弹层已整段移除) */
.addmain{margin:-8rpx 0 16rpx;text-align:center;font-size:26rpx;font-weight:700;color:var(--brandd);border:1rpx dashed var(--line);border-radius:14rpx;padding:18rpx 0;background:var(--card)}
.addmain.armed{color:var(--good);border-color:var(--line);background:var(--goodbg)}

/* ═══ 服务分组完整版(图 v2.2)═══ */
.grpcard{border:1.5rpx solid var(--brand);background:var(--paper)}
.grpcard.dim{border-color:var(--line);background:var(--card)}
.grpsum{font-size:23rpx;color:var(--sub);line-height:1.6}
.grpx{float:right;font-size:23rpx;color:var(--bad);font-weight:400}
.sec{font-size:21rpx;color:var(--brandd);font-weight:800;letter-spacing:1rpx;margin:18rpx 0 8rpx}
.sec .hint{font-weight:400;color:var(--sub);margin-left:8rpx}
.grppicked{font-size:22rpx;color:var(--good);background:var(--goodbg);border-radius:10rpx;padding:10rpx 14rpx;margin-top:8rpx}
/* 支付菜单 */
.paym{display:flex;align-items:flex-start;gap:14rpx;border:1rpx solid var(--line);border-radius:14rpx;padding:16rpx;margin:10rpx 0;background:var(--card)}
.paym.on{border-color:var(--line);background:var(--goodbg)}
.paym .pmain{flex:1}
.paym b{font-size:26rpx;color:var(--ink)}
.psmall{display:block;font-size:21rpx;color:var(--sub);margin-top:2rpx}
.rvlink{font-size:22rpx;color:var(--tagw);text-decoration:underline}
/* D25:未绑定档案充值链接禁用态(点了有提示,后端同拦) */
.rvlink.dis{color:var(--sub);text-decoration:line-through}
.rvlink.center{display:block;text-align:center;padding:16rpx 0 6rpx;color:var(--bad)}
.paynote{font-size:20rpx;color:var(--sub);margin-top:6rpx;line-height:1.5}
/* 分组明细 */
.mg{font-weight:700;font-size:25rpx;color:var(--ink);margin-top:10rpx;padding-top:8rpx}
.strike{text-decoration:line-through;color:var(--sub);font-weight:400}
/* 内嵌充值面板 */
.rvsheet{position:fixed;left:50%;top:45%;transform:translate(-50%,-50%);width:84%;background:var(--card);border-radius:20rpx;padding:26rpx;z-index:97;box-shadow:0 12rpx 48rpx rgba(36,31,29,.18);max-height:80vh;overflow-y:auto}
.rvtier{display:flex;justify-content:space-between;border:1rpx solid var(--line);border-radius:12rpx;padding:14rpx 18rpx;margin:8rpx 0;font-size:26rpx}
.rvtier.on{border-color:var(--good);background:var(--goodbg)}
.rvgift{color:var(--brandd);font-size:22rpx}
.rvnote{font-size:20rpx;color:var(--sub);margin:10rpx 0;line-height:1.5}
.rvsheet .ds-confirm{margin:8rpx -26rpx -26rpx;border-radius:0 0 20rpx 20rpx;background:var(--hero);color:var(--heroink);text-align:center;font-size:28rpx;font-weight:700;padding:22rpx 0}

/* 规则⑦:绑定码入口与拦截提示条 */
.bindlink{color:var(--tagw);text-decoration:underline;font-size:22rpx}
.bindbar{margin-top:10rpx;padding:12rpx 16rpx;background:var(--paper);color:var(--brandd);border-radius:12rpx;font-size:22rpx;display:flex;align-items:center;justify-content:space-between}.bindbtn {background:var(--hero);color:var(--heroink);border-radius:999rpx;padding:8rpx 20rpx;font-size:22rpx;margin-left:16rpx;flex-shrink:0}
.qrbox{display:flex;justify-content:center;margin:20rpx 0}
.qrph{width:280rpx;height:280rpx;border:2rpx dashed var(--line);border-radius:16rpx;display:flex;align-items:center;justify-content:center;color:var(--sub);font-size:22rpx;text-align:center;white-space:pre-line}
.qrimg{width:300rpx;height:300rpx;display:block;border-radius:12rpx;background:#fff}
.qbtns{display:flex;justify-content:center;margin:12rpx 0}.qbtn {background:var(--wall);border-radius:999rpx;padding:14rpx 32rpx;font-size:24rpx;color:var(--ink)}

/* 规则⑧:条目编号清单 + 技师数字排(原样恢复) */
.numlist{background:var(--paper);border-radius:12rpx;padding:12rpx 16rpx;margin-bottom:10rpx}
.numrow{display:flex;gap:10rpx;font-size:22rpx;color:var(--sub);padding:4rpx 0}
.nno{flex-shrink:0}
.nname{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.techrow{display:flex;align-items:center;margin:8rpx 0}
.tn{width:110rpx;font-size:24rpx;color:var(--ink);flex-shrink:0}
.minichips{display:flex;flex-wrap:wrap;gap:10rpx}
.mchip{min-width:56rpx;height:56rpx;line-height:56rpx;text-align:center;border-radius:50%;background:var(--wall);color:var(--sub);font-size:24rpx}
.mchip.on{background:var(--hero);color:var(--heroink)}
.qlink.tap{color:var(--tagw);text-decoration:underline}
.qbtn.dark{background:var(--hero);color:var(--heroink)}

/* B1 次卡大类(图 §四 屏1) */
.tcbadge{display:inline-block;margin-left:6rpx;min-width:28rpx;padding:0 8rpx;background:var(--brand);color:var(--hero);border-radius:999rpx;font-size:20rpx;text-align:center;line-height:32rpx}
.tccard .iname{font-weight:600}
.tcdead{opacity:.45}
.tcexp{margin-left:10rpx;font-size:20rpx;color:var(--bad);border:1rpx solid var(--line);border-radius:6rpx;padding:0 6rpx}

/* D3:线下行非勾选样式(回显位) */
.paym.passive{background:var(--paper);border-style:dashed}
.pmark{width:44rpx;height:44rpx;border-radius:10rpx;display:flex;align-items:center;justify-content:center;color:var(--brandd);font-weight:700;flex-shrink:0}
