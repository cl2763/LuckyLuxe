.pg{padding:16rpx 24rpx 60rpx;background:#fbf8f5;min-height:100vh}
.hd{padding:8rpx 4rpx 16rpx}
.hd .t{font-size:36rpx;font-weight:800;color:#241f1d}
.hd .s{display:block;font-size:24rpx;color:#9a8c7c;margin-top:6rpx}
.loading{padding:80rpx 0;text-align:center;color:#9a8c7c;font-size:26rpx}
.empty{padding:24rpx 0;text-align:center;color:#9a8c7c;font-size:24rpx}

.card{background:#fff;border-radius:18rpx;padding:20rpx 18rpx;margin-bottom:16rpx;box-shadow:0 3rpx 10rpx rgba(92,70,48,.06)}
.ch{font-size:26rpx;font-weight:800;color:#241f1d;margin-bottom:12rpx}
.ch .hint{font-size:22rpx;font-weight:400;color:#9a8c7c;margin-left:10rpx}

.chiprow,.roster{display:flex;flex-wrap:wrap;gap:12rpx}
.chip{font-size:26rpx;padding:10rpx 24rpx;border-radius:999rpx;background:#f3ece2;color:#5c4630;flex:none}
.chip.on{background:#2d2826;color:#fff;font-weight:700}
.chip .r{font-size:20rpx;opacity:.7;margin-left:6rpx}
.cattabs{white-space:nowrap;margin-bottom:8rpx}
.cattabs .chip{display:inline-block;margin-right:12rpx}

.item{display:flex;align-items:center;gap:12rpx;padding:16rpx 0;border-bottom:1rpx solid #f2ebe3}
.item:last-child{border-bottom:none}
.ck{width:38rpx;height:38rpx;flex:none;border-radius:10rpx;border:2rpx solid #e0d3c4;color:#fff;font-size:24rpx;display:flex;align-items:center;justify-content:center}
.ck.on{background:#2d2826;border-color:#2d2826}
.iname{flex:1;font-size:27rpx;color:#241f1d}
.iname.wide{flex:1}
.iname .sub{display:block;font-size:21rpx;color:#9a8c7c;margin-top:4rpx}
.pr{text-align:right;flex:none}
.pr .mut{font-size:22rpx;color:#b3a89c;text-decoration:line-through;margin-right:8rpx}
.pr .now{font-size:28rpx;font-weight:800;color:#9b7655}
.pr .now.free{color:#1f7a4d}
.gh{font-size:22rpx;color:#c8a47e;font-weight:700;margin-top:14rpx;padding-bottom:4rpx}

.stepper{display:flex;align-items:center;gap:14rpx;flex:none}
.stepper .sb{width:48rpx;height:48rpx;border-radius:12rpx;background:#f3ece2;color:#5c4630;font-size:30rpx;display:flex;align-items:center;justify-content:center}
.stepper .qn{font-size:24rpx;color:#241f1d;min-width:70rpx;text-align:center}

.sw{width:78rpx;height:44rpx;border-radius:999rpx;background:#ded4ca;flex:none;position:relative;transition:background .2s}
.sw.on{background:#2f7d5c}
.sw .dot{position:absolute;top:5rpx;left:5rpx;width:34rpx;height:34rpx;border-radius:50%;background:#fff;transition:transform .2s}
.sw.on .dot{transform:translateX(34rpx)}

.inputline{display:flex;gap:10rpx;align-items:center}
.in{flex:1;background:#faf6f1;border:1rpx solid #ece2d6;border-radius:12rpx;padding:16rpx 14rpx;font-size:26rpx;color:#241f1d}
.in.amt{flex:.55}
.in.full{width:100%}
.addbtn{flex:none;background:#2d2826;color:#fff;border-radius:12rpx;padding:16rpx 20rpx;font-size:25rpx;font-weight:700}
.cst{display:flex;justify-content:space-between;font-size:25rpx;color:#241f1d;padding:14rpx 0;border-bottom:1rpx solid #f2ebe3}
.cst .del{color:#c0392b;font-size:23rpx}

.radios{display:flex;gap:24rpx;flex-wrap:wrap}
.radio{display:flex;align-items:center;gap:10rpx;font-size:26rpx;color:#5c4630}
.radio .dt{width:30rpx;height:30rpx;border-radius:50%;border:3rpx solid #ded4ca}
.radio.on{color:#241f1d;font-weight:700}
.radio.on .dt{border-color:#2d2826;background:#2d2826}
.radio .ok{color:#1f7a4d;font-weight:800;margin-left:8rpx}

.tip{font-size:22rpx;color:#9a8c7c;margin:12rpx 0;line-height:1.6}
.tip .link{color:#9b7655;font-weight:700}
.techrow{background:#faf6f1;border-radius:14rpx;padding:14rpx;margin-bottom:10rpx}
.techrow .tn{font-size:26rpx;font-weight:800;color:#241f1d;margin-bottom:10rpx}
.techrow .role{font-size:20rpx;background:#2d2826;color:#fff;border-radius:999rpx;padding:2rpx 12rpx;margin-left:10rpx}
.techrow .role.sub{background:#b3a89c}
.minichips{display:flex;flex-wrap:wrap;gap:10rpx}
.mchip{min-width:56rpx;text-align:center;font-size:22rpx;padding:8rpx 0;border-radius:10rpx;background:#fff;border:1rpx solid #e7ddd4;color:#9a8c7c}
.mchip.on{background:#2d2826;border-color:#2d2826;color:#fff;font-weight:700}

.payline{display:flex;justify-content:space-between;align-items:center;font-size:26rpx;padding:12rpx 0;border-bottom:1rpx solid #f2ebe3}
.payline:last-child{border-bottom:none}
.payline .l{color:#5c4630}
.payline .v{font-weight:800;color:#241f1d}
.alert{background:#fdf3ec;border:1rpx solid #f0d9c4;border-radius:14rpx;padding:14rpx;margin-top:12rpx}
.alert .ah{font-size:24rpx;color:#a8551f;font-weight:700;line-height:1.6}
.opts{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:12rpx}
.opt{font-size:23rpx;padding:10rpx 18rpx;border-radius:999rpx;background:#fff;border:1rpx solid #e7ddd4;color:#5c4630}
.opt.on{background:#9b7655;border-color:#9b7655;color:#fff;font-weight:700}
.warn{margin-top:10rpx;font-size:23rpx;color:#a8551f;line-height:1.6}

.total{background:#fff;border-radius:18rpx;padding:18rpx;box-shadow:0 3rpx 10rpx rgba(92,70,48,.06)}
.tl{display:flex;justify-content:space-between;font-size:26rpx;color:#5c4630;padding:8rpx 0}
.tl .strike{text-decoration:line-through;color:#b3a89c}
.tl.save{color:#1f7a4d;font-weight:700}
.tl.big{font-size:32rpx;font-weight:850;color:#241f1d;border-top:1rpx solid #f2ebe3;margin-top:8rpx;padding-top:14rpx}

.cta{margin-top:18rpx;background:#2d2826;color:#fff;text-align:center;padding:28rpx;border-radius:16rpx;font-size:30rpx;font-weight:800}
.cta.ing{background:#8a7f78}
.foot{margin-top:14rpx;text-align:center;font-size:21rpx;color:#b3a89c}

/* 屏 C1 优惠券行 + 选券面板(2026-08-09)。金额与不可用原因全部来自后端,本页零算术。 */
.cpnline{display:flex;align-items:center;justify-content:space-between;padding:18rpx 0 6rpx;border-top:1rpx solid #f2ebe3;margin-top:8rpx}
.cpnline .l{font-size:26rpx;color:#5c4630}
.cpnline .v{font-size:26rpx;font-weight:700;color:#241f1d;margin-left:auto}
.cpnline .v.ok{color:#1f7a4d}
.cpnline .v.mut{color:#b3a89c;font-weight:400}
.cpnline .arr{color:#c8c0b2;font-size:26rpx;margin-left:10rpx}

.cpnmask{position:fixed;left:0;right:0;top:0;bottom:0;background:rgba(35,30,28,.42);z-index:60;display:flex;align-items:flex-end}
.cpnsheet{width:100%;background:#fff;border-radius:28rpx 28rpx 0 0;padding:24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom))}
.cpnlist{max-height:56vh}
.cpn{display:flex;align-items:center;gap:12rpx;border:1rpx solid #e7ddd4;border-radius:16rpx;padding:18rpx;margin-bottom:12rpx;background:#fff}
.cpn.on{border-color:#2f7d5c;background:#e9f2ec}
.cpn.dis{opacity:.55}
.cpn .l{flex:1}
.cpn .n{font-size:27rpx;font-weight:700;color:#241f1d}
.cpn .s{display:block;font-size:21rpx;color:#9a8c7c;margin-top:6rpx}
.cpn.dis .s{color:#a8551f}
.cpn .d{font-size:27rpx;font-weight:800;color:#1f7a4d;margin-right:8rpx}
.cpn .pick{width:34rpx;height:34rpx;flex:none;border-radius:50%;border:3rpx solid #ded4ca}
.cpn.on .pick{border-color:#2f7d5c;background:#2f7d5c;box-shadow:inset 0 0 0 6rpx #fff}
.cpnok{margin-top:8rpx;background:#2d2826;color:#fff;text-align:center;padding:26rpx;border-radius:16rpx;font-size:29rpx;font-weight:800}

/* 屏 S2:顾客行 + 「新客·未绑定」徽标(文案后端下发,绑定后整块消失) */
.s2row{display:flex;align-items:center;flex-wrap:wrap;gap:10rpx;margin-top:6rpx}
.s2name{font-size:26rpx;font-weight:700;color:#241f1d}
.s2phone{font-size:23rpx;color:#8c8279}
.s2badge{font-size:21rpx;font-weight:700;background:#fdecec;color:#c0392b;border-radius:999rpx;padding:3rpx 14rpx}
.s2proxy{font-size:21rpx;color:#9b7655}
.s2hint{margin-top:8rpx;font-size:21rpx;color:#8c8279;line-height:1.6}

/* 屏 S3 出示二维码弹层 */
.qmask{position:fixed;inset:0;background:rgba(20,16,14,.45);z-index:60}
.qsheet{position:fixed;left:32rpx;right:32rpx;top:50%;transform:translateY(-50%);background:#fff;border-radius:24rpx;padding:28rpx 26rpx 24rpx;z-index:61;box-shadow:0 12rpx 40rpx rgba(45,40,38,.22)}
.qhd{display:flex;align-items:center;justify-content:space-between}
.qhd .qt{font-size:30rpx;font-weight:800;color:#241f1d}
.qhd .qx{font-size:30rpx;color:#8c8279;padding:0 8rpx}
.qpushed{margin-top:12rpx;text-align:center;font-size:23rpx;font-weight:700;color:#2f7d5c;background:#e3eee8;border-radius:12rpx;padding:10rpx 0}
.qcode{margin:22rpx auto 0;width:340rpx;height:340rpx;border:2rpx dashed #e0d3c4;border-radius:20rpx;background:#faf6f1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10rpx}
.qcode .qph{font-size:34rpx;font-weight:800;color:#c8bfb6}
.qcode .qphs{font-size:20rpx;color:#a99d92;text-align:center;padding:0 24rpx;line-height:1.5}
.qno{margin-top:18rpx;text-align:center;font-size:24rpx;color:#8c8279;letter-spacing:1rpx}
.qamt{margin-top:6rpx;text-align:center;font-size:36rpx;font-weight:800;color:#241f1d}
.qsub{margin-top:4rpx;text-align:center;font-size:22rpx;color:#8c8279}
.qlink{margin-top:16rpx;font-size:20rpx;color:#9b7655;word-break:break-all;text-align:center;line-height:1.5}
.qcopy{margin:10rpx auto 0;width:220rpx;text-align:center;font-size:23rpx;font-weight:700;color:#9b7655;border:1rpx solid #e7d3b8;border-radius:12rpx;padding:12rpx 0}
.qstate{margin-top:18rpx;text-align:center;font-size:25rpx;font-weight:700;color:#a8551f;background:#fdf3ec;border-radius:12rpx;padding:14rpx 0}
.qstate.viewing{color:#2f7d5c;background:#e3eee8}
.qstate.signed{color:#fff;background:#2f7d5c}
.qtip{margin-top:12rpx;font-size:21rpx;color:#8c8279;line-height:1.6;text-align:center}
.qhand{margin-top:18rpx;text-align:center;font-size:25rpx;font-weight:700;color:#241f1d;background:#f3ece2;border-radius:14rpx;padding:20rpx 0}
.qhandtip{margin-top:8rpx;font-size:20rpx;color:#a99d92;line-height:1.5;text-align:center}

/* D9 规则⑤:新客(未绑定轻档案)进签署的显著提示 */
.qnewc{margin-top:12rpx;text-align:center;font-size:24rpx;font-weight:700;color:#b3552f;background:#faeee6;border:1rpx solid #e8c8ae;border-radius:12rpx;padding:14rpx 12rpx;line-height:1.5}

/* D22③ 金额区逐行明细(点开对账) */
.dtl-toggle{margin-left:12rpx;font-size:22rpx;color:#9b7655;font-weight:400}
.dtl{display:flex;justify-content:space-between;align-items:center;font-size:24rpx;color:#5f564e;padding:8rpx 0 8rpx 16rpx;border-bottom:1rpx dashed #f2ebe3}
.dtl-n{flex:1;margin-right:12rpx}
.dtl-r{display:flex;align-items:center;gap:12rpx}
.dtl-a{color:#241f1d;font-weight:600}
.dtl-x{color:#c0392b;font-size:26rpx;padding:0 8rpx}
/* D22 跨大类已选主项目芯片:看不见但在计费的行,钉出来 */
.ghostrow{display:flex;flex-wrap:wrap;align-items:center;gap:10rpx;margin:-8rpx 0 16rpx;padding:12rpx 16rpx;background:#faf3e3;border:1rpx solid #e8d9b8;border-radius:12rpx}
.ghost-t{font-size:23rpx;color:#b98a2f;font-weight:700}
.ghost-chip{display:flex;align-items:center;gap:4rpx;font-size:23rpx;color:#3a2e2a;background:#fff;border:1rpx solid #e8d9b8;border-radius:999rpx;padding:6rpx 8rpx 6rpx 16rpx}
/* D23:自选行显示金额;输入框加高,文字不上下截断 */
.cst-r{display:flex;align-items:center;gap:16rpx}
.cst-amt{color:#241f1d;font-weight:600}
.in{min-height:72rpx;line-height:40rpx;box-sizing:border-box}

/* 主项目选择机制终版:「＋加第二个主项目」显式加选按钮(弹层已整段移除) */
.addmain{margin:-8rpx 0 16rpx;text-align:center;font-size:26rpx;font-weight:700;color:#9b7655;border:1rpx dashed #d8cec4;border-radius:14rpx;padding:18rpx 0;background:#fff}
.addmain.armed{color:#2f7d5c;border-color:#9fc3ab;background:#eef5ee}

/* ═══ 服务分组完整版(图 v2.2)═══ */
.grpcard{border:1.5rpx solid #c6a27e;background:#fdfbf8}
.grpcard.dim{border-color:#e8e0d8;background:#fff}
.grpsum{font-size:23rpx;color:#8c8279;line-height:1.6}
.grpx{float:right;font-size:23rpx;color:#c0392b;font-weight:400}
.sec{font-size:21rpx;color:#9b7655;font-weight:800;letter-spacing:1rpx;margin:18rpx 0 8rpx}
.sec .hint{font-weight:400;color:#a89c92;margin-left:8rpx}
.grppicked{font-size:22rpx;color:#5e8c61;background:#eef5ee;border-radius:10rpx;padding:10rpx 14rpx;margin-top:8rpx}
/* 支付菜单 */
.paym{display:flex;align-items:flex-start;gap:14rpx;border:1rpx solid #e8e0d8;border-radius:14rpx;padding:16rpx;margin:10rpx 0;background:#fff}
.paym.on{border-color:#9fc3ab;background:#eef5ee}
.paym .pmain{flex:1}
.paym b{font-size:26rpx;color:#241f1d}
.psmall{display:block;font-size:21rpx;color:#8c8279;margin-top:2rpx}
.rvlink{font-size:22rpx;color:#5b7a99;text-decoration:underline}
.paynote{font-size:20rpx;color:#a89c92;margin-top:6rpx;line-height:1.5}
/* 分组明细 */
.mg{font-weight:700;font-size:25rpx;color:#241f1d;margin-top:10rpx;padding-top:8rpx}
.strike{text-decoration:line-through;color:#b9afa6;font-weight:400}
/* 内嵌充值面板 */
.rvsheet{position:fixed;left:50%;top:45%;transform:translate(-50%,-50%);width:84%;background:#fff;border-radius:20rpx;padding:26rpx;z-index:97;box-shadow:0 12rpx 48rpx rgba(36,31,29,.18);max-height:80vh;overflow-y:auto}
.rvtier{display:flex;justify-content:space-between;border:1rpx solid #e8e0d8;border-radius:12rpx;padding:14rpx 18rpx;margin:8rpx 0;font-size:26rpx}
.rvtier.on{border-color:#5e8c61;background:#eef5ee}
.rvgift{color:#9b7655;font-size:22rpx}
.rvnote{font-size:20rpx;color:#a89c92;margin:10rpx 0;line-height:1.5}
.rvsheet .ds-confirm{margin:8rpx -26rpx -26rpx;border-radius:0 0 20rpx 20rpx;background:#2d2826;color:#fff;text-align:center;font-size:28rpx;font-weight:700;padding:22rpx 0}
