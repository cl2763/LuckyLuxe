.page{padding:32rpx;}.card{padding:32rpx;background:var(--card);border:1rpx solid var(--line);border-radius:12rpx;margin:24rpx 0;}.title{font-size:34rpx;font-weight:600;}.hint{color:var(--sub);font-size:26rpx;line-height:1.7;}.change{padding:24rpx 0;border-bottom:1rpx solid var(--line);line-height:1.7;white-space:pre-wrap;word-break:break-all;}.before{color:var(--sub);}.after{margin-top:12rpx;}button{margin-top:24rpx;}checkbox-group{margin-top:24rpx;font-size:28rpx;}

.feedback-box{padding:24rpx;border:1rpx solid var(--line);border-radius:12rpx;margin:16rpx 0;background:var(--card);}.feedback{display:block;width:100%;height:180rpx;padding:0;margin:0;font-size:28rpx;line-height:1.6;color:var(--ink);}.feedback-placeholder{color:var(--sub);}.review-primary,.review-secondary{width:100%;min-height:88rpx;padding:22rpx 28rpx;font-size:28rpx;line-height:1.5;}.review-primary{background:var(--brand);color:var(--hero);}.review-primary[disabled]{background:var(--wall);color:var(--sub);border:1rpx solid var(--line);}.review-secondary{background:var(--card);color:var(--ink);border:1rpx solid var(--line);}
