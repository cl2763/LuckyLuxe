.page{padding:32rpx;background:var(--paper);min-height:100vh;box-sizing:border-box}.card{background:var(--card);padding:28rpx;border:1rpx solid var(--line);border-radius:12rpx;color:var(--ink)}.title{font-size:36rpx;font-weight:600}.hint{font-size:26rpx;line-height:1.7;color:var(--sub);margin:20rpx 0}.choice{padding:24rpx 12rpx;border-bottom:1rpx solid var(--line);font-size:28rpx;line-height:1.6}button{margin-top:28rpx;background:var(--brand);color:var(--hero);font-size:28rpx;border-radius:999rpx}
