<view class="pg">
  <view class="datebar">
    <view class="nav" bindtap="prevDay">‹</view>
    <text class="d">{{date}}</text>
    <view class="nav" bindtap="nextDay">›</view>
    <!-- D3/D4/D5(店主 2026-08-10 开检):当期就说「今天/本周」,非当期要说「返回今天/返回本周」——
       以前每一天都写着「今天」,翻到 8/03 那页按钮还叫「今天」,根本看不出自己在哪一天。 -->
    <view class="today {{isToday ? 'cur' : ''}}" bindtap="closeToday">{{isToday ? '今天' : '返回今天'}}</view>
  </view>

  <view wx:if="{{loading}}" class="empty">加载中…</view>

  <block wx:elif="{{v && !correcting}}">
    <view wx:if="{{v.confirmed}}" class="okbar">
      已确认日结 · {{v.confirmedAt}}{{v.reopenCount ? ' · 重开过 ' + v.reopenCount + ' 次' : ''}}
      <text class="lnk" bindtap="reopen">重开</text>
    </view>
    <view class="pills">
      <text class="pill">今日 <text class="b">{{v.orderCount}}</text> 单</text>
      <text class="pill">营业额 <text class="b">{{v.revenue}}</text></text>
      <text class="pill hot" wx:if="{{v.pending.length}}">待分配 <text class="b">{{v.pending.length}}</text></text>
    </view>

    <view class="card" wx:for="{{v.pending}}" wx:for-item="p" wx:key="id">
      <view class="ah" data-id="{{p.id}}" bindtap="toggleOpen">
        <text class="code"><text class="tm">{{p.timeText}}</text>{{p.who}} · {{p.techLabel}}<text wx:if="{{p.crossDayNote}}" class="xday">{{p.crossDayNote}}</text></text>
        <text class="amt">{{p.total}}<text wx:if="{{p.couponNote}}" class="arr"> {{p.couponNote}}</text> <text class="arr">{{open[p.id] ? '收起 ∧' : '点开分配 ∨'}}</text></text>
      </view>
      <block wx:if="{{open[p.id]}}">
        <view class="aline" wx:for="{{p.techs}}" wx:for-item="t" wx:key="id">
          <text class="nm">{{t.name}}</text>
          <text class="wn">{{t.role}} · {{t.nos}}</text>
          <input class="pct" type="number" value="{{shares[p.id + '|' + t.id]}}" data-sid="{{p.id}}" data-tid="{{t.id}}" bindinput="onShare" />
          <text class="pcts">%</text>
        </view>
        <view class="links">
          <text wx:if="{{p.hasSnapshot}}" class="lnk" data-code="{{p.code}}" bindtap="viewSnapshot">查看签署单</text>
          <text class="lnk" data-code="{{p.code}}" bindtap="startCorrect">金额有误?发起更正</text>
          <view class="savebtn" data-id="{{p.id}}" bindtap="saveAlloc">保存分配</view>
        </view>
      </block>
    </view>


          <view class="dcsub" wx:if="{{v.awaiting.length}}">无需分配 · 待确认 {{v.awaiting.length}} 单</view>
          <view class="card awaitcard" wx:for="{{v.awaiting}}" wx:for-item="a" wx:key="id">
            <view class="ah">
              <text class="code"><text class="tm">{{a.timeText}}</text>{{a.who}} · {{a.techs}}<text wx:if="{{a.crossDayNote}}" class="xday">{{a.crossDayNote}}</text></text>
              <text class="amt">{{a.amount}} <text class="arr">{{a.reason}}</text></text>
            </view>
            <view class="links">
              <text wx:if="{{a.hasSnapshot}}" class="lnk" data-code="{{a.code}}" bindtap="viewSnapshot">查看签署单</text>
              <text class="lnk" data-code="{{a.code}}" bindtap="startCorrect">金额有误?发起更正</text>
            </view>
          </view>
    <view class="card">
      <view class="th"><text class="c1">技师</text><text class="c2">单数</text><text class="c3">业绩</text><text class="c3">卡耗</text><text class="c3">冲卡</text><text class="c4">目标</text></view>
      <view class="tr" wx:for="{{v.techs}}" wx:key="name">
        <text class="c1 nm">{{item.name}}</text>
        <text class="c2">{{item.orderCount}}</text>
        <text class="c3">{{item.perf}}</text>
        <text class="c3">{{item.card}}</text>
        <text class="c3">{{item.recharge}}</text>
        <text class="c4 {{item.hit ? 'ok' : ''}}">{{item.target}}</text>
      </view>
    </view>

    <view class="card anom">
      <view>价档异常 <text class="badge {{v.tierChanges.length ? 'warn' : ''}}">{{v.tierChanges.length}}</text>
        <text class="sub" wx:for="{{v.tierChanges}}" wx:key="*this">{{item}}</text>
      </view>
      <view>免卸甲/免卸睫 <text class="badge">{{v.freeRemoval}} 笔</text></view>
    </view>

    <view class="warn" wx:for="{{v.blockers}}" wx:key="*this">{{item}}</view>
    <view wx:if="{{!v.confirmed}}" class="cta {{v.canConfirm ? '' : 'dis'}}" bindtap="{{v.canConfirm ? 'confirmClose' : ''}}">
      {{v.canConfirm ? '确认日结' : '确认日结(还有待办)'}}
    </view>
  </block>

  <!-- 屏 1b 金额更正 -->
  <block wx:elif="{{correcting}}">
    <view class="ch">金额更正 · {{correcting.code}}<text class="lnk back" bindtap="cancelCorrect">返回日结</text></view>
    <view class="ro">
      <view class="rot"><text>顾客已签存档单(只读)</text><text class="lock">不可修改</text></view>
      <view class="rol">{{correcting.who}}{{correcting.proxy ? '(代付)' : ''}} · {{correcting.signedAt}} · {{correcting.techs}}</view>
      <view class="rol" wx:for="{{correcting.items}}" wx:key="*this">{{item}}</view>
      <view class="rol"><text wx:if="{{correcting.deposit}}">定金抵扣 {{correcting.deposit}} · </text><text class="b">合计 {{correcting.total}}</text></view>
    </view>
    <view class="card">
      <view class="fh">更正内容</view>
      <view class="fd"><text class="lab">更正后合计</text><input class="in" type="digit" value="{{newTotal}}" bindinput="onNewTotal" /></view>
      <textarea class="ta" placeholder="原因(必填):例「实际只补了 1 指,技师勾多了」" value="{{reason}}" bindinput="onReason"></textarea>
      <view class="note">提交后:① 原签署单保持原样,顾客服务记录追加一条更正记录 ② 用卡付过的单,储值差额由系统自动补配 ③ 更正进当日日结留痕</view>
      <view class="cta" bindtap="submitCorrect">提交更正</view>
    </view>
  </block>
</view>

<sheet-preview sheet-id="{{previewSheet}}" bind:close="closePreview" />
