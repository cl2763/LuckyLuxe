page{background:var(--paper)}
.page{padding:24rpx 26rpx 60rpx;background:var(--paper);color:var(--ink)}
.gate{margin-top:80rpx;text-align:center;padding:0 20rpx}
.gate-ic{font-size:70rpx}
.gate-t{font-size:32rpx;font-weight:600;color:var(--ink);margin-top:16rpx}
.gate-s{font-size:24rpx;color:var(--sub);margin-top:10rpx;line-height:1.6}
.ginp{height:88rpx;background:var(--card);color:var(--ink);border:1rpx solid var(--line);border-radius:16rpx;padding:0 24rpx;font-size:28rpx;margin-top:22rpx}
.ph{color:var(--sub)}.gbtn {height:88rpx;line-height:88rpx;background:var(--brand);color:var(--hero);border-radius:999rpx;font-size:30rpx;font-weight:500;margin-top:24rpx}
.gate-hint{font-size:21rpx;color:var(--sub);margin-top:20rpx;line-height:1.6}
/* hero */
.hero{background:linear-gradient(135deg,var(--hero),var(--hero2));border-radius:24rpx;padding:26rpx 28rpx;margin-bottom:16rpx}
.h-row{display:flex;justify-content:space-between;gap:12rpx}
.h-item{flex:1;min-width:0}
.h-l{font-size:21rpx;color:var(--brandd)}
.h-n{font-size:36rpx;font-weight:700;color:var(--brandd);margin-top:4rpx}
.h-est{font-size:21rpx;color:var(--sub);margin-top:12rpx}
.rings{display:flex;justify-content:space-around;border-top:1rpx solid var(--line);margin-top:18rpx;padding-top:20rpx}
.ring{text-align:center;width:150rpx}
.ring-c{width:118rpx;height:118rpx;border-radius:50%;margin:0 auto;display:flex;align-items:center;justify-content:center}
.ring-i{width:90rpx;height:90rpx;border-radius:50%;background:var(--hero);display:flex;align-items:center;justify-content:center;font-size:24rpx;font-weight:700;color:var(--herogold)}
.ring-i.done{color:var(--good)}
.ring-l{font-size:21rpx;color:var(--brandd);margin-top:8rpx}
.ring-s{font-size:18rpx;color:var(--sub);margin-top:2rpx}
.h-daily{font-size:21rpx;color:var(--sub);margin-top:14rpx;text-align:center}
.h-edit{color:var(--brandd);text-decoration:underline}
/* AI 智能总结 */
.aibox{background:linear-gradient(135deg,var(--card),var(--wall));border:1rpx solid var(--line);border-radius:20rpx;padding:20rpx 24rpx;margin-bottom:16rpx}
.ai-h{font-size:23rpx;font-weight:700;color:var(--brandd);margin-bottom:10rpx}
.ai-spark{animation:aipulse 2.2s infinite}
@keyframes aipulse{0%,100%{opacity:.55}50%{opacity:1}}
.ai-li{position:relative;padding-left:24rpx;font-size:23rpx;color:var(--ink);line-height:1.6;margin-bottom:8rpx;opacity:0;animation:aiup .6s ease forwards}
@keyframes aiup{from{opacity:0;transform:translateY(10rpx)}to{opacity:1;transform:none}}
.ai-li::before{content:"";position:absolute;left:2rpx;top:14rpx;width:9rpx;height:9rpx;border-radius:50%;background:var(--brandd)}
.ai-li.warn{color:var(--bad)}
.ai-li.good{color:var(--good)}
/* 引导行 */
.guide{background:var(--wall);border:1rpx dashed var(--brand);border-radius:20rpx;padding:20rpx 24rpx;display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-bottom:16rpx}
.guide-l{flex:1;min-width:0}
.guide-b{display:block;font-size:25rpx;font-weight:700;color:var(--brandd)}
.guide-s{display:block;font-size:20rpx;color:var(--sub);margin-top:4rpx;line-height:1.5}
.guide-go{flex:0 0 auto;background:var(--brand);color:var(--hero);border-radius:40rpx;padding:12rpx 26rpx;font-size:23rpx;font-weight:700}
/* 记一笔/流水入口 */
.entry2{display:flex;gap:14rpx;margin-bottom:16rpx}.ebtn {flex:1;background:var(--card);border:1rpx solid var(--line);border-radius:999rpx;padding:20rpx 16rpx;text-align:center}
.ebtn.hl{border-color:var(--brand);background:var(--wall)}
.ei{font-size:40rpx}
.et{font-size:26rpx;font-weight:700;color:var(--ink);margin-top:4rpx}
.es{font-size:19rpx;color:var(--sub);margin-top:2rpx}
/* 其余沿用 */
.card{background:var(--card);border:1rpx solid var(--line);border-radius:14rpx;padding:16rpx 18rpx;margin-bottom:14rpx}
.row-sb{display:flex;justify-content:space-between;align-items:center;margin-bottom:6rpx}
.cb{font-size:28rpx;font-weight:600;color:var(--ink)}
.mut{font-size:24rpx;color:var(--sub)}.abtn {text-align:center;height:80rpx;line-height:80rpx;border-radius:999rpx;border:1rpx solid var(--brand);color:var(--brandd);font-size:26rpx;font-weight:500;background:var(--card)}
.abtn.full{display:block;width:100%;margin-bottom:12rpx}
.dormrow{display:flex;align-items:center;justify-content:space-between;gap:12rpx}
.dorm-l{flex:1;min-width:0}
.dorm-t{font-size:24rpx;color:var(--sub)}
.dorm-s{display:block;font-size:22rpx;color:var(--brandd);margin-top:4rpx}.wakebtn {flex:0 0 auto;background:var(--brand);color:var(--hero);border-radius:999rpx;padding:8rpx 24rpx;font-size:23rpx}
.insight{background:var(--wall);border:1rpx solid var(--line);border-radius:14rpx;padding:16rpx;font-size:24rpx;color:var(--ink);line-height:1.6;margin-bottom:14rpx}
.t2{font-size:26rpx;font-weight:600;color:var(--ink);margin:6rpx 0 10rpx}
.divi{height:1rpx;background:var(--line);margin:10rpx 0}
.weblink{text-align:center;font-size:22rpx;color:var(--brandd);background:var(--line);border:1rpx solid var(--line);border-radius:12rpx;padding:14rpx;margin-top:6rpx}
.cb.warn2{color:var(--bad)}
/* 设个目标弹窗 */
.mask{position:fixed;inset:0;background:rgba(30,24,18,.55);z-index:50;display:flex;align-items:center;justify-content:center;padding:40rpx}
.modal{width:100%;max-width:640rpx;background:var(--card);border-radius:28rpx;padding:28rpx 30rpx 30rpx;max-height:86vh;overflow-y:auto}
.md-h{display:flex;justify-content:space-between;align-items:center;margin-bottom:6rpx}
.md-t{font-size:32rpx;font-weight:700;color:var(--ink)}
.md-x{font-size:30rpx;color:var(--sub);padding:6rpx 10rpx}
.md-lab{font-size:22rpx;color:var(--sub);font-weight:700;margin:20rpx 0 10rpx}.seg {display:flex;background:var(--wall);border-radius:999rpx;padding:5rpx}.seg-b {flex:1;text-align:center;font-size:25rpx;font-weight:700;padding:14rpx 0;border-radius:999rpx;color:var(--ink);background:var(--card);border:1rpx solid var(--ink)}
.seg-b.on{background:var(--hero);color:var(--heroink);border-color:var(--hero)}
.md-inp{height:84rpx;background:var(--card);border:1rpx solid var(--line);border-radius:16rpx;padding:0 24rpx;font-size:30rpx;font-weight:700;color:var(--ink)}
.raterow{display:flex;gap:14rpx;align-items:center}
.raterow .rate{flex:1}.sug-btn {flex:0 0 auto;background:var(--ink);color:var(--paper);border-radius:999rpx;padding:16rpx 24rpx;font-size:23rpx;font-weight:700;box-shadow:0 4rpx 12rpx rgba(45,40,38,.25)}
.md-tip{font-size:20rpx;color:var(--sub);line-height:1.6;margin-top:10rpx}
.md-save{height:88rpx;line-height:88rpx;text-align:center;background:var(--ink);color:var(--paper);border-radius:16rpx;font-size:29rpx;font-weight:700;margin-top:26rpx}
.md-skip{text-align:center;font-size:22rpx;color:var(--sub);margin-top:14rpx}

/* 储值逐笔流水(2026-08-12 店主裁决补的商家端视图,只读) */
.svtxn-h{font-size:24rpx;color:var(--sub);margin:14rpx 0 6rpx}
.svtxn{display:flex;align-items:center;justify-content:space-between;padding:10rpx 0;border-bottom:1rpx solid var(--line)}
.svtxn-l{display:flex;flex-direction:column;flex:1;min-width:0}
.svtxn-t{font-size:22rpx;color:var(--sub)}
.svtxn-unconfirmed{margin-left:8rpx;padding:2rpx 10rpx;border-radius:8rpx;background:var(--badbg);color:var(--bad);font-size:18rpx}
.svtxn-u{font-size:26rpx;color:var(--ink);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.svtxn-m{display:flex;flex-direction:column;align-items:flex-end;margin-right:20rpx}
.svtxn-h2{font-size:22rpx;color:var(--sub)}
.svtxn-s{font-size:20rpx;color:var(--sub)}
.svtxn-a{font-size:28rpx;font-weight:700;color:var(--good);flex-shrink:0}
.svtxn-empty{font-size:22rpx;color:var(--sub);margin-top:10rpx}
.svchips{display:flex;align-items:center;gap:12rpx;margin:14rpx 0 6rpx}
.svchip{padding:8rpx 22rpx;border-radius:999rpx;background:var(--wall);color:var(--sub);font-size:22rpx}
.svchip.on{background:var(--ink);color:var(--paper)}
.svtxn-a.neg{color:var(--bad)}
.svtxn-code{font-size:22rpx;color:var(--tagw);text-decoration:underline}
