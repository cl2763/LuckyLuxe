page{background:var(--paper)}
.page{padding:16rpx 26rpx 140rpx;background:var(--paper);min-height:100vh;box-sizing:border-box}.seg {display:flex;background:var(--wall);border-radius:999rpx;padding:5rpx;margin-bottom:16rpx}
.s{flex:1;text-align:center;font-size:24rpx;color:var(--ink);background:var(--card);border:1rpx solid var(--line);padding:14rpx 0;border-radius:9rpx}
.s.on{background:var(--hero);color:var(--heroink);border-color:var(--hero);font-weight:600}
.empty{text-align:center;color:var(--sub);font-size:24rpx;padding:60rpx 20rpx}
/* 展示图墙 */
/* 真机 WebView 对 calc(50% - 6rpx) 支持不稳(工具正常真机变单列),改用百分比+space-between 双列 */
.grid{display:flex;flex-wrap:wrap;justify-content:space-between}
.gcell{width:48.8%;margin-bottom:12rpx;position:relative;border-radius:14rpx;overflow:hidden;background:var(--wall)}
.gimg{width:100%;height:300rpx;display:block}
.gcount{position:absolute;top:12rpx;right:12rpx;background:rgba(45,40,38,.6);color:#fff;font-size:20rpx;border-radius:40rpx;padding:2rpx 12rpx}
.gcap{position:absolute;left:0;right:0;bottom:0;background:linear-gradient(transparent,rgba(45,40,38,.62));color:#fff;font-size:22rpx;padding:20rpx 14rpx 12rpx}
/* 作品管理 */
.tipbar{display:flex;gap:12rpx;margin-bottom:14rpx}
.tip1,.tip2{flex:1;text-align:center;font-size:22rpx;border-radius:12rpx;padding:14rpx 0}
.tip1{background:var(--card);color:var(--sub);border:1rpx solid var(--line)}
.tip2{background:var(--card);color:var(--brand);border:1rpx solid var(--line)}
.card{background:var(--card);border:1rpx solid var(--line);border-radius:16rpx;padding:18rpx;margin-bottom:14rpx}
.head{display:flex;align-items:center;justify-content:space-between}
.hinfo{flex:1;min-width:0}
.hname{font-size:26rpx;font-weight:600;color:var(--ink)}
.hdate{font-size:21rpx;color:var(--sub);margin-top:5rpx}
.badge{font-size:21rpx;border-radius:40rpx;padding:4rpx 14rpx;flex:0 0 auto}
.badge.published{background:#e3eee8;color:#47735f}
.badge.topublish{background:#fbf0e2;color:#a3703f}
.badge.toupload{background:var(--wall);color:var(--sub);border:1rpx solid var(--line)}
.thumbs{white-space:nowrap;margin-top:14rpx}
.thumb{display:inline-block;width:150rpx;height:150rpx;border-radius:12rpx;margin-right:10rpx;background:var(--wall)}
.noimg{margin-top:14rpx;font-size:22rpx;color:var(--sub);background:var(--wall);border:1rpx dashed var(--line);border-radius:12rpx;padding:26rpx 0;text-align:center}
.acts{display:flex;gap:12rpx;margin-top:14rpx}
.b{flex:1;text-align:center;font-size:24rpx;border-radius:12rpx;padding:16rpx 0;background:var(--wall);border:1rpx solid var(--line);color:var(--ink)}
.b.p{background:var(--brand);color:var(--hero);border-color:var(--brand)}
.note{font-size:21rpx;color:var(--sub);line-height:1.6;margin-top:18rpx}

.creation-tools{margin-bottom:32rpx}.creation-title{font-size:42rpx;font-family:'Songti SC',serif;color:var(--ink);margin:16rpx 0 24rpx;font-weight:600}.creation-card{padding:26rpx;border:1rpx solid var(--line);border-radius:22rpx;background:var(--card);margin-bottom:18rpx}.creation-name{font-size:32rpx;font-weight:600;color:var(--ink)}.creation-copy{font-size:25rpx;line-height:1.7;color:var(--sub);margin:12rpx 0 20rpx}.creation-button{font-size:26rpx;line-height:1.5;padding:20rpx;border-radius:999rpx;color:var(--ink);background:var(--paper);border:1rpx solid var(--line)}.creation-button::after{border:none}.creation-button.primary{background:var(--brand);color:var(--hero);border-color:var(--brand)}
