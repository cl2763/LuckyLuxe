<view class="pg {{themeClass}}">
  <view class="topbar">
    <view class="nav" bindtap="prevWeek">‹</view>
    <text class="h1">排班</text>
    <view class="nav" bindtap="nextWeek">›</view>
    <!-- D3/D4/D5(店主 2026-08-10 开检):当期就说「今天/本周」,非当期要说「返回今天/返回本周」——
       以前每一天都写着「今天」,翻到 8/03 那页按钮还叫「今天」,根本看不出自己在哪一天。 -->
    <view class="btn {{isThisWeek ? 'cur' : ''}}" bindtap="thisWeek">{{isThisWeek ? '本周' : '返回本周'}}</view>
  </view>
  <!-- D11:员工只读,不给"点这里改" -->
  <view wx:if="{{!readOnly}}" class="splitbar" bindtap="editSplit">上下午分界 <text class="b">{{afternoonStart}}</text> · 点这里改 ›</view>
  <view wx:else class="splitbar">我的班表 · 上下午分界 <text class="b">{{afternoonStart}}</text> · 排班由店长安排</view>

  <view wx:if="{{loading}}" class="empty">加载中…</view>

  <block wx:else>
    <view class="dayrow" wx:for="{{days}}" wx:for-item="d" wx:key="date">
      <view class="dhead">
        <text class="dt">{{d.title}}<text wx:if="{{d.isToday}}" class="todaytag">今天</text></text>
        <text class="closed" wx:if="{{d.isClosed}}">店休</text>
        <text class="onduty">在岗 {{d.onDuty}}</text>
      </view>
      <scroll-view class="caps" scroll-x>
        <view class="cap {{c.kind}}" wx:for="{{d.caps}}" wx:for-item="c" wx:key="techId"
              data-date="{{d.date}}" data-tech="{{c.techId}}" data-name="{{c.name}}" data-kind="{{c.kind}}" bindtap="openSheet">
          <text class="cn">{{c.name}}</text>
          <text class="cl">{{c.label}}</text>
          <text class="cc" wx:if="{{c.carryLabel}}">{{c.carryLabel}}</text>
          <text class="cc" wx:if="{{c.count}}">{{c.count}} 单</text>
        </view>
      </scroll-view>
    </view>
    <view class="tip">{{readOnly ? '点自己的排班申请休假或调整时段，老板处理后生效。' : '点任意胶囊改这一天该技师的时段。半天胶囊半填色；可预约范围同时受门店规则限制；最晚开始模式下，班次结束表示停止接客，服务可延长。'}}</view>
  </block>

  <view wx:if="{{readOnly && !loading}}" class="request-list">
    <view class="sh">我的排班申请</view>
    <view wx:if="{{!myTechId}}" class="tip">账号尚未关联技师，请联系老板处理。</view>
    <view wx:elif="{{!requests.length}}" class="tip">暂无申请记录。</view>
    <view wx:for="{{requests}}" wx:key="id" class="request-row"><view>{{item.date}} · {{item.statusLabel}}</view><view class="tip">{{item.note}}</view></view>
  </view>
  <view wx:if="{{requestSheet}}" class="mask"></view>
  <view wx:if="{{requestSheet}}" class="sheet">
    <view class="sh">申请调整我的排班 · {{requestSheet.date}}</view>
    <view class="tip">写明希望调整的时段或休假原因。这里只提交申请，不直接改变排班。</view>
    <textarea class="request-note" maxlength="300" value="{{requestNote}}" bindinput="onRequestNote" placeholder="例如：希望休息一天，或改为 12:00–18:00" disabled="{{requestSaving}}" />
    <view wx:if="{{requestError}}" class="request-error">{{requestError}}</view>
    <button class="save" bindtap="submitRequest" loading="{{requestSaving}}" disabled="{{requestSaving}}">提交申请</button>
    <button class="cancel" bindtap="closeRequest" disabled="{{requestSaving}}">取消</button>
  </view>
  <!-- 屏 4a-2 时段编辑弹层 -->
  <view wx:if="{{sheet}}" class="mask"></view>
  <view wx:if="{{sheet}}" class="sheet">
    <button class="cancel" bindtap="closeSheet" disabled="{{saving}}">关闭 ×</button><view class="sh">{{sheet.name}} · {{sheet.date}} 周{{sheet.weekday}}</view>
    <view class="tip">{{sheet.latestMode ? "班次结束为停止接客时间；服务可延长至次日。" : "服务须在营业与班次结束前完成。"}}</view>
    <view class="tip">门店营业：{{sheet.isClosed ? '休息' : sheet.businessOpen+'–'+sheet.businessClose}}</view><view wx:if="{{sheet.latestMode}}" class="tip">最晚开始：{{sheet.cutoff}}</view><view class="tip">技师原班次：{{sheet.originalRange}}。已保存班次不会随营业时间延长自动延长。</view><button bindtap="fillBusinessHours" disabled="{{saving || shiftReviewLoading || sheet.isClosed}}">按当天营业／接客时间填入</button><view class="tip">填入后仍需保存，不会同时改动其他日期。</view><view class="kinds">
      <view class="k {{sheet.kind === 'full' ? 'on' : ''}}" data-k="full" bindtap="pickKind">全天</view>
      <view class="k {{sheet.kind === 'am' ? 'on' : ''}}" data-k="am" bindtap="pickKind">上午</view>
      <view class="k {{sheet.kind === 'pm' ? 'on' : ''}}" data-k="pm" bindtap="pickKind">下午</view>
      <view class="k {{sheet.kind === 'custom' ? 'on' : ''}}" data-k="custom" bindtap="pickKind">自定义</view>
      <view class="k {{sheet.kind === 'off' ? 'on' : ''}}" data-k="off" bindtap="pickKind">休息</view>
    </view>
    <view wx:if="{{sheet.kind === 'custom'}}" class="times">
      <picker mode="time" value="{{sheet.start}}" bindchange="onStart"><view class="tp">{{sheet.start}}</view></picker>
      <text class="dash">–</text>
      <picker mode="time" value="{{sheet.end}}" bindchange="onEnd"><view class="tp">{{sheet.end}}</view></picker>
    </view>
    <view class="tip" wx:if="{{sheet.isClosed}}">当天店休；自定义排班不会修改营业设置。</view>
    <view class="tip">分界只用于新选择；保存后的具体时段不会跟随分界改变。</view>
    <view class="rep" bindtap="toggleRepeat">
      <view class="box {{sheet.repeat ? 'on' : ''}}">{{sheet.repeat ? '✓' : ''}}</view>
      <text>应用到之后每个周{{sheet.weekday}}（再加 8 周）</text>
    </view>
    <view wx:if="{{conflicts.length}}" class="conf">
      <view class="ct">这么排会有 {{conflicts.length}} 单落在时段外(已保存,自己决定要不要改预约):</view>
      <view class="cr" wx:for="{{conflicts}}" wx:key="bookingId">{{item.date}} {{item.startTime}}–{{item.endTime}} {{item.customerName}} · {{item.serviceName}}</view>
    </view>
    <view wx:for="{{warnings}}" wx:key="date" class="request-error">{{item.date}} {{item.message}}</view>
    <view class="tip">顾客时段预览（门店与班次交集）</view>
    <view class="times"><text>示例总时长（分钟）</text><input type="number" value="{{shiftDuration || 120}}" bindinput="shiftDuration" style="padding:16rpx;min-width:100rpx"/></view>
    <button bindtap="previewShift" loading="{{shiftReviewLoading}}" disabled="{{shiftReviewLoading}}">核对接客范围与冲突</button>
    <view wx:if="{{shiftReviewError}}" class="tip">{{shiftReviewError}}</view>
    <view wx:if="{{shiftPreview}}"><view class="tip">{{shiftPreview.note}}</view><view wx:for="{{shiftPreview.previews}}" wx:key="date" class="tip">{{item.date}} · 班次 {{item.startTime}}–{{item.endTime}} · {{item.earliestStart ? '可开始 '+item.earliestStart+'–'+item.latestStart : '没有完整可约时段'}} · 时段外预约 {{item.conflicts.length}} 单<view wx:for="{{item.warnings}}" wx:for-item="w" wx:key="date">{{w.message}}</view><view wx:for="{{item.conflicts}}" wx:for-item="c" wx:key="bookingId">{{c.code}} {{c.startTime}}–{{c.endTime}} {{c.customerName}}</view></view></view>
    <button class="save" bindtap="saveShift" loading="{{saving}}" disabled="{{saving}}">保存</button>
  </view>
</view>
