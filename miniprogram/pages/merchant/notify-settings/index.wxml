<view class="page">
  <view wx:if="{{loading}}" class="empty">加载中…</view>
  <block wx:else>
    <view class="card">
      <view class="h">通知与回访</view>
      <view class="hint">开关与提前量按本店生效;现阶段通知落在下方「通知记录」里(站内记录通道),微信/短信通道等资质开通后另批接入。</view>
      <view class="rule" wx:for="{{rules}}" wx:key="type">
        <view class="rule-main">
          <text class="rule-label">{{item.label}}</text>
          <switch checked="{{item.enabled}}" data-type="{{item.type}}" bindchange="onToggle" />
        </view>
        <view class="rule-field" wx:if="{{item.type === 'arrival_reminder'}}">
          提前 <input class="num" type="number" value="{{item.offsetMinutes}}" data-type="{{item.type}}" data-field="offsetMinutes" bindinput="onNum" /> 分钟
        </view>
        <view class="rule-field" wx:elif="{{item.type === 'revisit'}}">
          间隔 <input class="num" type="number" value="{{item.revisitDays}}" data-type="{{item.type}}" data-field="revisitDays" bindinput="onNum" /> 天
        </view>
        <view class="rule-field" wx:elif="{{item.advanceDays !== null}}">
          提前 <input class="num" type="number" value="{{item.advanceDays}}" data-type="{{item.type}}" data-field="advanceDays" bindinput="onNum" /> 天
        </view>
      </view>
      <button class="save" bindtap="save" disabled="{{saving}}">保存通知设置</button>
    </view>

    <view class="card">
      <view class="qhead">
        <view class="h">通知记录</view>
        <picker range="{{filters}}" range-key="t" bindchange="pickFilter">
          <view class="filter">{{filter ? filter : '全部状态'}} ▾</view>
        </picker>
      </view>
      <view wx:if="{{!tasks.length}}" class="empty">还没有通知记录 —— 打开上面的开关后,系统会按事件与每日扫描生成。</view>
      <view class="task {{t.statusCls}}" wx:for="{{tasks}}" wx:for-item="t" wx:key="id">
        <view class="task-top">
          <text class="task-type">{{t.typeLabel}}</text>
          <text class="task-status {{t.statusCls}}">{{t.statusZh}}</text>
        </view>
        <view class="task-text">{{t.text || '—'}}</view>
        <view class="task-meta">{{t.whenText}}<text wx:if="{{t.failReason}}"> · {{t.failReason}}</text></view>
      </view>
    </view>
  </block>
</view>
