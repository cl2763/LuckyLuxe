/* 照《通知与回访设置图 v1.0》:页签黑白规格同账调;卡四件套;三色记录。零糙原则:间距/字号统一 */
.page { padding: 24rpx; }
.tabs { display: flex; gap: 12rpx; margin-bottom: 20rpx; }.tab { border-radius: 999rpx; padding: 8rpx 32rpx; font-size: 26rpx; font-weight: 700; border: 2rpx solid var(--hero); background: var(--card); color: var(--ink); }
.tab.on { background: var(--hero); color: var(--heroink); }
.notice { background: var(--wall); border-radius: 14rpx; padding: 14rpx 20rpx; font-size: 22rpx; color: var(--sub); margin-bottom: 20rpx; line-height: 1.6; }
.grp { font-size: 26rpx; font-weight: 700; margin: 20rpx 0 12rpx; }
.grp-note { font-size: 22rpx; font-weight: 400; color: var(--sub); }
.ncard { background: var(--card); border: 2rpx solid var(--line); border-radius: 18rpx; padding: 20rpx 22rpx; margin-bottom: 16rpx; }
.ncard.off { opacity: .85; }
.nhead { display: flex; align-items: center; justify-content: space-between; }
.nlabel { font-size: 28rpx; font-weight: 600; }
.param { font-size: 24rpx; color: var(--ink); margin-top: 12rpx; display: flex; align-items: center; gap: 8rpx; }
.num { display: inline-block; width: 120rpx; border: 2rpx solid var(--line); border-radius: 8rpx; padding: 4rpx 10rpx; text-align: center; }
.tpl { width: 100%; box-sizing: border-box; margin-top: 12rpx; border: 2rpx dashed var(--line); border-radius: 12rpx; padding: 14rpx 16rpx; font-size: 24rpx; background: var(--paper); line-height: 1.6; min-height: 88rpx; }
.chips { display: flex; gap: 8rpx; flex-wrap: wrap; margin-top: 10rpx; }.chip { font-size: 20rpx; background: var(--goodbg); color: var(--ink); border-radius: 999rpx; padding: 2rpx 12rpx; }
.prev { margin-top: 10rpx; font-size: 22rpx; color: var(--sub); }
.prev-em { color: var(--ink); }
.btnrow { display: flex; align-items: center; gap: 20rpx; margin-top: 12rpx; }
.save { background: var(--hero); color: var(--heroink); font-size: 24rpx; margin: 0; }
.reset { font-size: 22rpx; color: var(--sub); }
.filter { font-size: 26rpx; color: var(--ink); padding: 10rpx 20rpx; border: 2rpx solid var(--line); border-radius: 10rpx; display: inline-block; margin-bottom: 16rpx; }
.rec { display: flex; gap: 14rpx; padding: 14rpx 0; border-bottom: 2rpx dashed var(--line); }
.dot { width: 16rpx; height: 16rpx; border-radius: 50%; margin-top: 10rpx; flex-shrink: 0; }
.dot.sent { background: var(--good); } .dot.pending { background: var(--next); } .dot.failed { background: var(--bad); } .dot.cancelled { background: var(--line); }
.rec-main { flex: 1; }
.rec-top { font-size: 24rpx; }
.rec-type { font-weight: 600; }
.rec-why { font-size: 22rpx; color: var(--bad); margin-top: 4rpx; }
.rec-text { font-size: 24rpx; color: var(--ink); margin-top: 6rpx; line-height: 1.6; }
.empty { font-size: 26rpx; color: var(--sub); padding: 30rpx 0; text-align: center; }
