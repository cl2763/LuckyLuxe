.page { padding: 24rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 24rpx; }
.h { font-size: 32rpx; font-weight: 600; margin-bottom: 8rpx; }
.hint { font-size: 24rpx; color: #8a8a8e; margin-bottom: 16rpx; line-height: 1.5; }
.rule { padding: 16rpx 0; border-bottom: 1rpx solid #f0f0f2; }
.rule-main { display: flex; align-items: center; justify-content: space-between; }
.rule-label { font-size: 28rpx; }
.rule-field { font-size: 24rpx; color: #555; margin-top: 8rpx; display: flex; align-items: center; gap: 8rpx; }
.num { display: inline-block; width: 140rpx; border: 1rpx solid #d9d9de; border-radius: 8rpx; padding: 4rpx 12rpx; text-align: center; }
.save { margin-top: 24rpx; background: #111; color: #fff; font-size: 28rpx; }
.qhead { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; }
.filter { font-size: 26rpx; color: #555; padding: 8rpx 16rpx; border: 1rpx solid #d9d9de; border-radius: 8rpx; }
.task { padding: 16rpx 0; border-bottom: 1rpx solid #f0f0f2; }
.task-top { display: flex; align-items: center; justify-content: space-between; }
.task-type { font-size: 26rpx; font-weight: 500; }
.task-status { font-size: 22rpx; color: #8a8a8e; }
.task-status.failed { color: #b42318; }
.task-status.sent { color: #067647; }
.task-text { font-size: 26rpx; margin-top: 6rpx; }
.task-meta { font-size: 22rpx; color: #8a8a8e; margin-top: 4rpx; }
.empty { font-size: 26rpx; color: #8a8a8e; padding: 24rpx 0; text-align: center; }
