.page{padding:24rpx 24rpx 72rpx;background:var(--paper);min-height:100vh;color:var(--ink)}.card{padding:28rpx;margin-bottom:24rpx;border:1rpx solid var(--line);border-radius:12rpx;background:var(--card)}.row,.actions{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.title{font-size:32rpx;font-weight:600}.note{font-size:25rpx;line-height:1.6;color:var(--sub);margin-top:14rpx}.actions{margin-top:24rpx}.actions button{flex:1;margin:0;font-size:28rpx;padding:6rpx 14rpx}.primary{background:var(--hero);color:var(--heroink);border-radius:999rpx}.error{padding:24rpx;color:var(--bad);line-height:1.6}label{display:block;margin-top:24rpx;font-size:27rpx}input,.picker{padding:22rpx;margin-top:12rpx;border:1rpx solid var(--line);background:var(--paper);color:var(--ink);border-radius:12rpx;height:auto;min-height:44rpx}.check{padding:14rpx 0}.picker{margin:22rpx 0}
