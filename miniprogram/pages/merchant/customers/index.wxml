<view class="page">
  <!-- 拍板②:员工受限视图 —— 分层/金额/群发券整块不渲染(那些全靠金额算,员工既拿不到也不该看) -->
  <view wx:if="{{staffView}}" class="staffnote">{{scopeNote}}</view>
  <view wx:if="{{!staffView}}" class="sechead">
    <view class="sec">客户分层 · 按 最近到店/频率/累计消费 自动算</view>
    <view class="rulebtn" bindtap="openRules">⚙ 规则</view>
  </view>
  <view wx:if="{{!staffView}}" class="tiers">
    <view class="tcard a {{filter==='a'?'sel':''}}" data-t="a" bindtap="pickTier"><view class="tn">{{counts.a}}</view><view class="tt">高价值 A</view><view class="td">常来+能花</view></view>
    <view class="tcard b {{filter==='b'?'sel':''}}" data-t="b" bindtap="pickTier"><view class="tn">{{counts.b}}</view><view class="tt">回头客 B</view><view class="td">状态正常</view></view>
    <view class="tcard n {{filter==='n'?'sel':''}}" data-t="n" bindtap="pickTier"><view class="tn">{{counts.n}}</view><view class="tt">新客 N</view><view class="td">首访30天内</view></view>
    <view class="tcard s {{filter==='s'?'sel':''}}" data-t="s" bindtap="pickTier"><view class="tn">{{counts.s}}</view><view class="tt">沉睡 S</view><view class="td">超60天没来</view></view>
  </view>

  <view class="srch"><input class="inp" placeholder="搜姓名 / 手机号" placeholder-class="ph" value="{{kw}}" bindinput="onKw" /></view>

  <scroll-view scroll-x class="chips">
    <view wx:for="{{filters}}" wx:key="*this" class="chip {{filter===item?'on':''}}" data-f="{{item}}" bindtap="setFilter">
      {{filterLabels[item]}} {{item==='all' ? counts.total : counts[item]}}
    </view>
  </scroll-view>

  <!-- 名单动作条:选中某一层时出现 -->
  <view class="ops" wx:if="{{filter!=='all'}}">
    <view class="op o1" bindtap="copyList">📋 名单</view>
    <view wx:if="{{!staffView}}" class="op o1" bindtap="openCoupons">🎫 群发券</view>
    <view wx:if="{{aiEnabled}}" class="op o2 {{aiBusy?'dim':''}}" bindtap="aiRecall">✦ AI {{filter==='s' ? '召回' : '关怀'}}话术</view>
  </view>
  <view class="opshint" wx:if="{{filter==='s'}}">沉睡客已按「以前多能花」排序,先救最值钱的;AI 话术结合每人服务小记画像生成</view>

  <view class="sortbar" wx:if="{{filter!=='s'}}">
    排序:
    <text wx:for="{{sorts}}" wx:key="*this" class="sopt {{sort===item?'on':''}}" data-s="{{item}}" bindtap="setSort">{{sortLabels[item]}}</text>
  </view>

  <view wx:if="{{!list.length}}" class="empty">没有符合的客户</view>
  <view class="cust" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="open">
    <view class="av">{{item.av}}</view>
    <view class="cmain">
      <view class="cname">{{item.name}} <text wx:if="{{item.tierLabel}}" class="tbadge {{item.tier}}">{{item.tierLabel}}</text></view>
      <view wx:if="{{staffView}}" class="cmeta">到店{{item.visits}}次 · 最近{{item.last}}{{item.phone ? ' · ' + item.phone : ''}}</view>
      <view wx:else class="cmeta">到店{{item.visits}}次 · 最近{{item.last}} · 储值{{item.stored}}</view>
      <view class="ctags" wx:if="{{item.tags.length}}"><text wx:for="{{item.tags}}" wx:for-item="tg" wx:key="*this" class="tg">{{tg}}</text></view>
      <!-- 图 A-3 客户档案卡:爽约留存的定金 -->
      <view wx:if="{{item.depositRetained}}" class="cretain">{{item.depositRetained}}</view>
    </view>
    <view wx:if="{{!staffView}}" class="cm"><view class="m1">{{item.spend}}</view><view class="m2">累计消费</view></view>
  </view>

  <!-- 分层规则微调:每个数字都可改,存服务端 -->
  <view wx:if="{{ruleSheet}}" class="mask" bindtap="closeRules"></view>
  <view wx:if="{{ruleSheet}}" class="rsheet">
    <view class="rs-t">分层规则 · 每个数字都能改</view>
    <view class="rs-k">高价值 A(三条全满足)</view>
    <view class="rs-row"><text class="rl">最近到店 ≤</text><input class="rn" type="digit" value="{{rAdays}}" data-f="rAdays" bindinput="onRule" /><text class="ru">天</text></view>
    <view class="rs-row"><text class="rl">累计到店 ≥</text><input class="rn" type="digit" value="{{rAvisits}}" data-f="rAvisits" bindinput="onRule" /><text class="ru">次</text></view>
    <view class="rs-row"><text class="rl">累计消费 ≥ $</text><input class="rn" type="digit" value="{{rAspend}}" data-f="rAspend" bindinput="onRule" /><text class="ru"></text></view>
    <view class="rs-k">新客 N</view>
    <view class="rs-row"><text class="rl">首次到店在</text><input class="rn" type="digit" value="{{rNdays}}" data-f="rNdays" bindinput="onRule" /><text class="ru">天内</text></view>
    <view class="rs-k">沉睡 S</view>
    <view class="rs-row"><text class="rl">超过</text><input class="rn" type="digit" value="{{rSdays}}" data-f="rSdays" bindinput="onRule" /><text class="ru">天没来</text></view>
    <view class="rs-note">回头客 B = 其余到过店的客人,自动归入</view>
    <view class="rs-save" bindtap="saveRules">保存 · 立即重新分层</view>
  </view>

  <!-- 群发券:选一张,发给当前筛选层 -->
  <view wx:if="{{couponSheet}}" class="mask" bindtap="closeCoupons"></view>
  <view wx:if="{{couponSheet}}" class="rsheet">
    <view class="rs-t">选一张券 · 发给当前 {{list.length}} 位客人</view>
    <view class="cp-row" wx:for="{{coupons}}" wx:key="id" data-id="{{item.id}}" bindtap="grantCoupon">
      <view class="cp-info"><view class="cp-n">{{item.name}}</view><view class="cp-d">{{item.discountType === 'percent' ? (item.percentOff + '% off') : ('减 $' + (item.amountCents/100))}} · 有效 {{item.validDays}} 天</view></view>
      <view class="cp-go">发 ›</view>
    </view>
    <view class="rs-note">每人一张,已持有未用的自动跳过;顾客打开小程序「券包」即见</view>
  </view>
</view>
