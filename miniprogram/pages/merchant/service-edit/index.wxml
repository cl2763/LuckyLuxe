<view class="page {{themeClass}}">
 <view class="ai">{{system==='display'?'顾客展示价格仅供参考，实际结算按服务确认单。':'服务结算价格仅用于开单，会员价按顾客当前有效折扣计算。'}}</view>
 <view wx:if="{{loading}}" class="note">正在读取项目…</view>
 <view wx:if="{{error}}" class="error">{{error}}<button wx:if="{{!categories.length}}" bindtap="load">重新读取</button></view>
 <view wx:if="{{!loading}}" class="form">
  <view class="frow"><text class="lb">项目名称</text><input class="in" value="{{nameZh}}" data-field="nameZh" bindinput="input" maxlength="60"/></view>
  <view class="frow"><text class="lb">英文名称（选填）</text><input class="in" value="{{nameEn}}" data-field="nameEn" bindinput="input" maxlength="80"/></view>
  <view class="frow"><text class="lb">大类</text><picker class="pk" range="{{categories}}" range-key="name" value="{{categoryIndex}}" bindchange="category"><view class="pkv">{{categories[categoryIndex].name||'请先添加服务大类'}} ›</view></picker></view>
  <view wx:if="{{system==='settlement'}}" class="frow"><text class="lb">计费单位</text><picker class="pk" range="{{units}}" range-key="label" value="{{unitIndex}}" bindchange="unit"><view class="pkv">{{units[unitIndex].label}} ›</view></picker></view>
  <view wx:if="{{system==='display'}}" class="frow"><text class="lb">平台大类</text><picker class="pk" range="{{types}}" range-key="label" value="{{typeIndex}}" bindchange="platformType"><view class="pkv">{{types[typeIndex].label}} ›</view></picker></view>
  <price-system system="{{system}}" service-id="{{id}}" mode="prices" bindchange="onPrices"/>
  <view class="frow"><text class="lb">时长（分钟）</text><input class="in" type="number" value="{{duration}}" data-field="duration" bindinput="input"/></view>
  <view wx:if="{{system==='settlement'}}" class="frow"><text class="lb">需技师报价</text><switch checked="{{priceMode==='quote'}}" bindchange="quote" color="#b09164"/></view>
  <view wx:if="{{system==='display'}}" class="frow"><text class="lb">上架（顾客可见）</text><switch checked="{{storefront}}" bindchange="shelf" color="#b09164"/></view>
  <view wx:else class="frow"><text class="lb">启用项目</text><switch checked="{{active}}" bindchange="active" color="#b09164"/></view>
 </view>
 <button class="btn" disabled="{{loading||saving}}" loading="{{saving}}" bindtap="save">保存</button><button class="ghost" bindtap="cancel">取消</button>
</view>
