page{background:var(--paper)}
.page{padding:24rpx 26rpx 60rpx}
.ps{font-size:22rpx;color:var(--sub);margin-bottom:16rpx}
.mon{display:flex;align-items:center;justify-content:center;gap:26rpx;margin-bottom:16rpx}
.mon-btn{width:64rpx;height:64rpx;line-height:60rpx;text-align:center;background:var(--card);border:1rpx solid var(--line);border-radius:50%;font-size:34rpx;color:var(--brandd)}
.mon-btn.dis{opacity:.35}
.mon-t{font-size:29rpx;font-weight:700;color:var(--ink)}
.msum{display:flex;background:var(--card);border:1rpx solid var(--line);border-radius:20rpx;padding:20rpx 10rpx;margin-bottom:16rpx;text-align:center}
.ms{flex:1}
.ms-l{font-size:20rpx;color:var(--sub)}
.ms-n{font-size:30rpx;font-weight:700;color:var(--ink);margin-top:4rpx}
.ms-n.in{color:var(--good)}
.ms-n.out{color:var(--bad)}
.empty{text-align:center;font-size:24rpx;color:var(--sub);padding:60rpx 0}
.link{color:var(--brandd);text-decoration:underline}
.txn{background:var(--card);border:1rpx solid var(--line);border-radius:20rpx;overflow:hidden}
.trow{display:flex;align-items:center;gap:14rpx;padding:20rpx 22rpx;border-bottom:1rpx solid var(--line)}
.trow:last-child{border-bottom:none}
.tl{flex:1;min-width:0}
.tl-1{display:flex;align-items:center;gap:8rpx}
.tl-cat{font-size:26rpx;font-weight:600;color:var(--ink)}
.tl-2{font-size:20rpx;color:var(--sub);margin-top:4rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.tag{font-size:17rpx;font-weight:700;color:var(--sub);background:var(--wall);border-radius:8rpx;padding:2rpx 10rpx}
.tag.red{color:var(--bad);background:var(--badbg)}
.tv{flex:0 0 auto;font-size:27rpx;font-weight:700}
.tv.in{color:var(--good)}
.tv.out{color:var(--bad)}
.trow.dim .tl-cat,.trow.dim .tv{color:var(--sub);text-decoration:line-through}
.rev{flex:0 0 auto;font-size:21rpx;font-weight:700;color:var(--brandd);border:1rpx solid var(--line);border-radius:40rpx;padding:8rpx 20rpx}
.foot{text-align:center;font-size:20rpx;color:var(--sub);margin-top:18rpx;line-height:1.6}
