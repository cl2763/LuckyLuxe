<view class="page">
  <view class="ps">收支明细 · 点「冲销」纠错(生成一笔红字,原单保留)</view>

  <view class="mon">
    <view class="mon-btn" bindtap="prev">‹</view>
    <view class="mon-t">{{monthText}}</view>
    <view class="mon-btn {{isCurrent ? 'dis' : ''}}" bindtap="next">›</view>
  </view>

  <view class="msum">
    <view class="ms"><view class="ms-l">收入</view><view class="ms-n in">{{sum.income}}</view></view>
    <view class="ms"><view class="ms-l">支出</view><view class="ms-n out">{{sum.expense}}</view></view>
    <view class="ms"><view class="ms-l">净利</view><view class="ms-n">{{sum.net}}</view></view>
  </view>

  <view wx:if="{{loading}}" class="empty">加载中…</view>
  <view wx:elif="{{!rows.length}}" class="empty">本月还没有流水。<text class="link" bindtap="toEntry">去记一笔 ›</text></view>
  <view wx:else class="txn">
    <view class="trow {{item.isReversed ? 'dim' : ''}}" wx:for="{{rows}}" wx:key="id">
      <view class="tl">
        <view class="tl-1">
          <text class="tl-cat">{{item.cat}}</text>
          <text wx:if="{{item.isReversal}}" class="tag red">红字</text>
          <text wx:if="{{item.isReversed}}" class="tag">已冲销</text>
        </view>
        <view class="tl-2">{{item.date}}{{item.desc ? ' · ' + item.desc : ''}}{{item.channel ? ' · ' + item.channel : ''}}</view>
      </view>
      <view class="tv {{item.neg ? 'out' : 'in'}}">{{item.amountText}}</view>
      <view wx:if="{{item.canReverse}}" class="rev" data-id="{{item.id}}" data-cat="{{item.cat}}" data-amount="{{item.amountText}}" bindtap="reverse">冲销</view>
    </view>
  </view>

  <view class="foot">🔒 与网页端同一本账 · 导出 CSV 请在网页 财务→流水</view>
</view>
