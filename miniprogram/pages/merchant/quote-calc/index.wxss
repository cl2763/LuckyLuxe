.pg{padding:16rpx 24rpx 60rpx;background:#fbf8f5;min-height:100vh}
.hd{padding:8rpx 4rpx 16rpx}
.hd .t{font-size:36rpx;font-weight:800;color:#241f1d}
.hd .s{display:block;font-size:24rpx;color:#9a8c7c;margin-top:6rpx}
.loading,.empty{padding:60rpx 0;text-align:center;color:#9a8c7c;font-size:26rpx}
.card{background:#fff;border-radius:18rpx;padding:20rpx 18rpx;margin-bottom:16rpx;box-shadow:0 3rpx 10rpx rgba(92,70,48,.06)}
.ch{font-size:26rpx;font-weight:800;color:#241f1d;margin-bottom:12rpx}
.ch .hint{font-size:22rpx;font-weight:400;color:#9a8c7c;margin-left:10rpx}
.chiprow{display:flex;flex-wrap:wrap;gap:12rpx}
.chip{font-size:26rpx;padding:10rpx 24rpx;border-radius:999rpx;background:#f3ece2;color:#5c4630;flex:none}
.chip.on{background:#2d2826;color:#fff;font-weight:700}
.cattabs{white-space:nowrap;margin-bottom:8rpx}
.cattabs .chip{display:inline-block;margin-right:12rpx}
.item{display:flex;align-items:center;gap:12rpx;padding:16rpx 0;border-bottom:1rpx solid #f2ebe3}
.item:last-child{border-bottom:none}
.ck{width:38rpx;height:38rpx;flex:none;border-radius:10rpx;border:2rpx solid #e0d3c4;color:#fff;font-size:24rpx;display:flex;align-items:center;justify-content:center}
.ck.on{background:#2d2826;border-color:#2d2826}
.iname{flex:1;font-size:27rpx;color:#241f1d}
.now{font-size:28rpx;font-weight:800;color:#9b7655;flex:none}
.gh{font-size:22rpx;color:#c8a47e;font-weight:700;margin-top:14rpx;padding-bottom:4rpx}
.sw{width:78rpx;height:44rpx;border-radius:999rpx;background:#ded4ca;flex:none;position:relative}
.sw.on{background:#2f7d5c}
.sw .dot{position:absolute;top:5rpx;left:5rpx;width:34rpx;height:34rpx;border-radius:50%;background:#fff;transition:transform .2s}
.sw.on .dot{transform:translateX(34rpx)}
.total{background:#fff;border-radius:18rpx;padding:18rpx;box-shadow:0 3rpx 10rpx rgba(92,70,48,.06)}
.tl{display:flex;justify-content:space-between;align-items:center;padding:6rpx 0}
.tl.big{font-size:32rpx;font-weight:850;color:#241f1d}
.tl.note{font-size:21rpx;color:#a9a69d}
.tl .est{background:#f3ece2;color:#9b7655;border-radius:999rpx;padding:4rpx 16rpx;font-weight:700;flex:none;margin-left:12rpx}
.cta{margin-top:16rpx;background:#2d2826;color:#fff;text-align:center;padding:28rpx;border-radius:16rpx;font-size:30rpx;font-weight:800}
.cta.ghost{background:#fff;color:#5c4630;border:1rpx solid #e7d3b8}
.foot{margin-top:14rpx;font-size:21rpx;color:#b3a89c;line-height:1.6}
