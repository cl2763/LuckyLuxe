.gift-card{margin:24rpx 0;padding:32rpx;border:1rpx solid var(--line,#e7e2d8);border-radius:12rpx;background:var(--card,#fff);color:var(--ink,#292520)}.title{font-size:32rpx;font-weight:700}.hint{color:var(--sub,#746b60);font-size:25rpx;line-height:1.7;margin-top:12rpx;word-break:break-all}.gift-item{padding:28rpx 0;border-top:1rpx solid var(--line,#e7e2d8);margin-top:24rpx}.name{font-size:30rpx;font-weight:600;line-height:1.6;word-break:break-all}.counts,.event{font-size:26rpx;line-height:1.6;margin-top:16rpx}.event{border-top:1rpx solid var(--line,#e7e2d8);padding-top:20rpx}.action,.secondary{font-size:28rpx;min-height:88rpx;line-height:1.5;padding:24rpx;margin:24rpx 0 0;border-radius:999rpx;white-space:normal}.action{background:var(--ink,#292520);color:var(--paper,#faf8f2)}.secondary{background:var(--paper,#faf8f2);color:var(--ink,#292520);border:1rpx solid var(--line,#e7e2d8)}.mask{position:fixed;inset:0;z-index:1100;background:rgba(0,0,0,.5);display:flex;align-items:center;justify-content:center;padding:32rpx;box-sizing:border-box}.dialog{width:100%;max-width:650rpx;box-sizing:border-box;padding:32rpx;border-radius:12rpx;background:var(--card,#fff);color:var(--ink,#292520)}.dialog-head{display:flex;align-items:center;justify-content:space-between;gap:24rpx}.dialog-head .close{width:88rpx;max-width:88rpx;min-width:88rpx;flex:none;box-sizing:border-box;margin:0;padding:8rpx 24rpx;font-size:40rpx;background:transparent;color:inherit;line-height:1.4}.close::after{border:0}.dialog-content{max-height:55vh;margin:24rpx 0}.label{font-size:26rpx;margin:24rpx 0 12rpx}.dialog input,.dialog textarea{box-sizing:border-box;width:100%;padding:20rpx;border:1rpx solid var(--line,#d7d0c2);border-radius:12rpx;background:var(--paper,#faf8f2);color:var(--ink,#292520)}.dialog input{height:88rpx}.dialog textarea{height:160rpx}.error{font-size:26rpx;line-height:1.6;margin-top:20rpx;color:var(--ink,#292520)}

.gift-filters{display:flex;flex-wrap:wrap;gap:12rpx;margin:24rpx 0}.filter{box-sizing:border-box;width:calc((100% - 24rpx)/3);min-width:0;padding:14rpx 8rpx;margin:0;font-size:23rpx;line-height:1.5;border-radius:999rpx;background:var(--paper);color:var(--ink);border:1rpx solid var(--line)}.filter.selected{background:var(--ink);color:var(--paper)}.filter::after{border:0}.receipt-row{display:flex;justify-content:space-between;gap:24rpx;padding:28rpx 0;border-bottom:1rpx solid var(--line);font-size:28rpx;line-height:1.6}.receipt-row text:last-child{text-align:right;word-break:break-all}.receipt{max-height:85vh;overflow-y:auto}

.dialog>.action{width:100%;box-sizing:border-box}.dialog-head .title{min-width:0;line-height:1.5}

/* M06/M08 are real navigable pages; the shared component keeps one write path. */
.page-mode{position:static;display:block;padding:24rpx;background:var(--paper,#faf8f2);min-height:100vh;min-height:100dvh}.page-mode .dialog{max-width:none;padding:28rpx;border:1rpx solid var(--line,#e7e2d8);border-radius:12rpx}.page-mode .dialog-content{max-height:none;margin:0}.page-mode .dialog-head{margin-bottom:28rpx}.page-mode .dialog input{height:88rpx}.page-mode .dialog textarea{height:100rpx}.page-mode .receipt{max-height:none;overflow:visible}.page-notice{margin:24rpx;padding:24rpx;border:1rpx solid var(--line,#e7e2d8);border-radius:12rpx;background:var(--card-alt,#f0ede4);color:var(--sub,#746b60);font-size:25rpx;line-height:1.7}.page-mode>.page-notice{margin:24rpx 0}.page-mode checkbox-group{margin-top:24rpx}.page-mode .receipt-row text:last-child{font-weight:600;min-width:0}.page-mode .receipt-row text:first-child{flex-shrink:0}
