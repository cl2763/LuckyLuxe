<view wx:if="{{!pageMode && (enabled || error)}}" class="gift-card">
 <view class="title">赠送权益与领取</view><view class="hint">实物交给顾客后，由门店登记领取。服务权益在服务单签署后核销。</view>
 <view class="gift-filters"><button wx:for="{{filters}}" wx:key="key" class="filter {{filter===item.key?'selected':''}}" data-filter="{{item.key}}" bindtap="chooseFilter">{{item.label}}</button></view>
 <view wx:if="{{error}}" class="error">{{error}}<button bindtap="refresh">重新读取</button></view>
 <view wx:elif="{{loading}}" class="hint">正在核对权益…</view>
 <view wx:elif="{{!visibleGifts.length}}" class="hint">本分类暂无赠送权益</view>
 <view wx:for="{{visibleGifts}}" wx:for-item="g" wx:key="id" class="gift-item">
  <text class="hint">{{g.kindLabel}}</text><view class="name">{{g.name}}</view><view class="counts">剩余 {{g.remaining}} / {{g.quantity}} · 已用或已领 {{g.claimed}}<text wx:if="{{g.voided}}"> · 已作废 {{g.voided}}</text></view>
  <view class="hint">{{g.expiresOn?'有效至 '+g.expiresOn:'长期有效'}}{{g.expired?' · 已过期':''}}</view>
  <button wx:if="{{g.canClaim && !readonly && filter!=='history'}}" class="action" data-id="{{g.id}}" bindtap="open">登记领取</button>
  <view wx:for="{{g.records}}" wx:for-item="rec" wx:key="id" class="event"><view>{{rec.label}} · {{rec.createdText}}</view></view>
  <view wx:for="{{g.events}}" wx:for-item="ev" wx:key="id" class="event"><view>{{ev.label}} {{ev.quantityText}} · {{ev.createdText}}</view><view class="hint">{{ev.actor}} {{ev.reason}}</view><button wx:if="{{ev.returnable>0 && !readonly && isOwner}}" class="secondary" data-id="{{g.id}}" data-event="{{ev.id}}" bindtap="open">更正这笔领取</button></view>
 </view>
</view>
<view wx:if="{{pageMode && !dialog && !receipt}}" class="page-notice">{{error || '正在核对权益…'}}<button wx:if="{{error}}" bindtap="refresh">重新读取</button></view>
<view wx:if="{{dialog}}" class="mask {{pageMode?'page-mode':''}}" catchtap="noop" catchtouchmove="noop"><view class="dialog" catchtap="noop"><view class="dialog-head"><text class="title">{{dialog.action==='claim'?'登记实物领取':'更正领取记录'}}</text><button wx:if="{{!pageMode}}" class="close" bindtap="close" disabled="{{busy}}" aria-label="关闭">×</button></view><scroll-view scroll-y class="dialog-content"><view class="name">{{customerName}} · {{dialog.action==='claim'?'实物领取':'领取更正'}}</view><view class="receipt-row"><text>物品</text><text>{{dialog.name}}</text></view><view class="receipt-row"><text>剩余可领取</text><text>{{dialog.remaining}} 件</text></view><view class="hint">{{dialog.action==='claim'?'实际交付后确认，顾客无需扫码或签署。':'追加退回记录，保留原领取历史。'}}</view><view class="label">本次数量</view><input type="number" value="{{quantity}}" bindinput="quantityInput" disabled="{{busy}}"/><block><view class="label">{{dialog.action==='return'?'更正原因（必填）':'领取备注（选填）'}}</view><textarea placeholder="{{dialog.action==='claim'?'如：顾客到店领取':'请填写更正原因'}}" value="{{reason}}" bindinput="reasonInput" maxlength="300" disabled="{{busy}}"/></block><checkbox-group wx:if="{{dialog.action==='claim'}}" bindchange="deliveryChange"><label><checkbox value="yes" checked="{{delivered}}" disabled="{{busy}}"/>已核对物品和数量，顾客已实际领取</label></checkbox-group><view class="error" wx:if="{{formError}}">{{formError}}</view></scroll-view><button class="action" bindtap="confirm" loading="{{busy}}" disabled="{{busy}}">{{dialog.action==='claim'?'确认领取':'确认退回'}}</button></view><view wx:if="{{pageMode}}" class="page-notice">领取不涉及余额扣款。参考价值未填写，不影响领取。</view></view>

<view wx:if="{{receipt}}" class="mask receipt-mask {{pageMode?'page-mode':''}}" catchtap="noop" catchtouchmove="noop"><view class="dialog receipt"><view class="dialog-head"><text class="title">{{receipt.action==='claim'?'领取已登记':'退回已登记'}}</text></view><view class="receipt-row"><text>{{receipt.name}}</text><text>{{receipt.action==='claim'?'已领':'已退回'}} {{receipt.quantity}} 件</text></view><view class="receipt-row"><text>剩余待领取</text><text>{{receipt.remaining}} 件</text></view><view class="receipt-row"><text>领取顾客</text><text>{{customerName}}</text></view><view wx:if="{{receipt.actor}}" class="receipt-row"><text>操作员工</text><text>{{receipt.actor}}</text></view><view wx:if="{{receipt.createdText}}" class="receipt-row"><text>时间</text><text>{{receipt.createdText}}</text></view><view class="hint">原发放记录保留，可在客户档案查看领取记录。如登记错误，由老板办理退回。</view><button class="action" bindtap="closeReceipt">返回赠送权益</button></view></view>
