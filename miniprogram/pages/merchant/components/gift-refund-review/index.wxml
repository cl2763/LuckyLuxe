<view wx:if="{{open}}" class="mask" catchtap="noop" catchtouchmove="noop"><view class="dialog"><view class="head"><text class="title">核对退款赠送权益</text><button bindtap="cancel" class="close" aria-label="关闭">×</button></view><scroll-view scroll-y class="body"><view class="hint">已使用记录保留。实物只有实际收回才填写退回件数；参考价值不自动抵扣退款。</view><view wx:for="{{items}}" wx:key="id" class="item"><view class="name">{{item.kindLabel}} · {{item.name}}</view><view class="hint">剩余 {{item.remaining}} / {{item.quantity}} · 已用或已领 {{item.claimed}} · 已作废 {{item.voided}}</view><view class="hint">来源充值 {{item.sourceTxnId}}</view><picker range="{{choices}}" value="{{item.choice}}" data-i="{{index}}" bindchange="choose"><view class="input">{{choices[item.choice]}} ›</view></picker><block wx:if="{{item.kind==='physical' && item.claimed>0}}"><view class="hint">本次实际退回件数（0表示顾客保留）</view><input type="number" value="{{item.returnQuantity}}" data-i="{{index}}" bindinput="returned" class="input"/></block></view><view class="error" wx:if="{{error}}">{{error}}</view></scroll-view><button class="action" bindtap="confirm">确认权益并继续退款</button></view></view>
