.mask{position:fixed;inset:0;z-index:1200;padding:32rpx;background:rgba(0,0,0,.5);display:flex;align-items:center;box-sizing:border-box}.dialog{width:100%;padding:32rpx;box-sizing:border-box;border-radius:12rpx;background:var(--card,#fff);color:var(--ink,#292520)}.head{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.title{font-size:32rpx;font-weight:700}.close{margin:0;padding:8rpx 24rpx;line-height:1.5;background:transparent;color:inherit;font-size:40rpx}.close::after{border:0}.body{max-height:60vh;margin:20rpx 0}.hint{font-size:25rpx;line-height:1.7;color:var(--sub,#746b60);word-break:break-all;margin:12rpx 0}.name{font-size:28rpx;font-weight:600}.item{padding:28rpx 0;border-bottom:1rpx solid var(--line,#e7e2d8)}.input{padding:20rpx;min-height:48rpx;line-height:1.6;border:1rpx solid var(--line,#e7e2d8);border-radius:12rpx;font-size:28rpx;box-sizing:content-box}.action{background:var(--ink,#292520);color:var(--paper,#faf8f2);padding:24rpx;line-height:1.5;font-size:28rpx;border-radius:999rpx;margin-top:24rpx}.error{font-size:26rpx;line-height:1.6}
