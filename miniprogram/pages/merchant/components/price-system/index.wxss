.price-system{padding:28rpx;margin:24rpx 0;border:1rpx solid var(--line);border-radius:12rpx;background:var(--card);color:var(--ink)}.title{font-size:30rpx;font-weight:600}.hint{font-size:24rpx;color:var(--sub);line-height:1.6;margin:20rpx 0}.options{display:flex;flex-wrap:wrap;gap:24rpx;padding:24rpx 0}.choice{display:flex;align-items:center;font-size:26rpx;min-height:72rpx}.field{margin:24rpx 0;font-size:26rpx}.field input{margin-top:12rpx;border:1rpx solid var(--line);border-radius:12rpx;min-height:88rpx;padding:0 24rpx;box-sizing:border-box}.primary{background:var(--hero);color:var(--heroink);border-radius:999rpx;font-size:26rpx}.error{color:var(--bad);padding:16rpx 0}
.primary{width:100%;min-height:88rpx;line-height:1.4;padding:18rpx 24rpx;margin:16rpx 0 0}.choice{flex:0 0 auto}.error button{min-height:88rpx;padding:16rpx 24rpx;line-height:1.4}
