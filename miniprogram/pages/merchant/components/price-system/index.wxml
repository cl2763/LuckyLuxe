<view class="price-system"><view class="title">{{system==='display'?'顾客展示价格':'服务结算价格'}}{{mode==='config'?'类型':''}}</view><view wx:if="{{loading}}" class="hint">加载中…</view><view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重新读取</button></view><block wx:if="{{!loading && !error}}"><view wx:if="{{mode==='config'}}" class="options"><view wx:for="{{rows}}" wx:key="key" class="choice" data-key="{{item.key}}" bindtap="toggle"><checkbox checked="{{item.on}}" disabled="{{readOnly || item.required}}"/>{{item.label}}{{item.required?' · 必选':''}}</view></view><block wx:else><view wx:for="{{rows}}" wx:key="key" class="field"><text>{{item.label}} · {{currency}}{{item.key==='list'?' · 必填':''}}</text><input type="digit" value="{{item.value}}" disabled="{{readOnly}}" data-key="{{item.key}}" bindinput="input" placeholder="{{item.key==='list'?'原价必填':'留空不展示'}}"/></view></block><view class="hint">{{system==='display'?'只控制顾客展示，不更改结算单目录价格。':config.membershipEnabled?'仅用于开单。会员价按本人有效折扣计算；未设置个人折扣时沿用门店默认会员价。':'仅用于开单。本店未启用会员制度；会员价为可选价格类型。'}}</view><button wx:if="{{mode==='config' && !readOnly}}" class="primary" bindtap="save" loading="{{saving}}" disabled="{{saving}}">保存{{system==='display'?'展示':'结算'}}价格类型</button></block></view>
