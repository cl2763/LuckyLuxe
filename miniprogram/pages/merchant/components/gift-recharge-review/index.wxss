.review{position:fixed;inset:0;z-index:1000;background:var(--paper,#faf8f3);color:var(--ink,#241f1a);display:flex;flex-direction:column;padding:24rpx;box-sizing:border-box}.heading{display:flex;align-items:center;justify-content:space-between;gap:20rpx;font-size:34rpx;font-weight:700;padding:12rpx 0 24rpx}.close{margin:0;width:140rpx;max-width:140rpx;min-width:0;padding:12rpx 20rpx;font-size:26rpx;line-height:1.5;flex:0 0 auto}.heading>text{min-width:0;flex:1}.content{flex:1;min-height:0}.card{padding:28rpx;margin-bottom:24rpx;border:1rpx solid var(--line,#e2ddd3);border-radius:12rpx;background:var(--card,#fff);line-height:1.6;overflow-wrap:anywhere}.title{font-size:32rpx;font-weight:700;margin-bottom:20rpx}.row{display:flex;justify-content:space-between;gap:24rpx;padding:20rpx 0;border-bottom:1rpx solid var(--line,#e2ddd3)}.row>text:last-child{flex-shrink:0}.hint{color:var(--sub,#6f6055);font-size:25rpx;margin-top:14rpx}.actions{display:flex;gap:20rpx;padding:20rpx 0 calc(16rpx + env(safe-area-inset-bottom))}.actions button{flex:1;margin:0;font-size:28rpx;line-height:1.5;min-height:88rpx;display:flex;align-items:center;justify-content:center;padding:16rpx}.confirm{background:var(--hero,#2a2521);color:var(--heroink,#f5efe3)}

.close,.actions button{border-radius:999rpx;background:var(--wall);color:var(--ink)}.actions .confirm{background:var(--hero);color:var(--heroink)}
