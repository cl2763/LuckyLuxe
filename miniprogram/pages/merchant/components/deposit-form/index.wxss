.deposit-form{color:var(--ink);padding:16rpx 0}.row{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:20rpx 0;border-bottom:1rpx solid var(--line);font-size:25rpx}.row>text:first-child{flex:1}.row input{width:180rpx;padding:14rpx;border:1rpx solid var(--line);background:var(--paper);color:var(--ink);border-radius:12rpx;text-align:right}.row picker{max-width:55%;color:var(--ink)}.note{font-size:23rpx;color:var(--sub);line-height:1.6;padding:12rpx 0}.error{color:var(--bad);font-size:25rpx;padding:14rpx 0}.save{margin-top:24rpx;background:var(--hero);color:var(--heroink);border-radius:999rpx;padding:8rpx 24rpx}.summary{align-items:flex-start;font-size:23rpx}.summary>text:last-child{max-width:60%;text-align:right}
