.pg{padding:16rpx 24rpx 60rpx;background:#fbf8f5;min-height:100vh}
.pcard{background:linear-gradient(135deg,#fff,#fbf3ea);border-radius:18rpx;padding:18rpx;box-shadow:0 4rpx 14rpx rgba(92,70,48,.08);border:1rpx solid #e9dccb}
.pcard .top{display:flex;align-items:center;gap:14rpx}
.pcard .av{width:64rpx;height:64rpx;border-radius:50%;background:linear-gradient(135deg,#e7c9a4,#c8a47e);color:#fff;font-weight:800;display:flex;align-items:center;justify-content:center;font-size:28rpx}
.pcard .nm{font-size:34rpx;font-weight:800;color:#241f1d}
.pcard .st{font-size:22rpx;color:#9a8c7c;margin-top:2rpx}
.pstat{display:flex;gap:10rpx;margin-top:14rpx}
.pstat .s{flex:1;background:rgba(255,255,255,.7);border-radius:12rpx;padding:12rpx 6rpx;text-align:center}
.pstat .s .b{font-size:28rpx;color:#241f1d;font-weight:800;display:block}
.pstat .s .l{font-size:19rpx;color:#9a8c7c}
.ptags{margin-top:14rpx}
.ptags .th{font-size:22rpx;color:#c8a47e;font-weight:700;margin-bottom:8rpx}
.chips{display:flex;flex-wrap:wrap;gap:10rpx}
.chip{font-size:24rpx;padding:6rpx 18rpx;border-radius:999rpx;background:#f3ece2;color:#5c4630}
.chip.warn{background:#fdecec;color:#c0392b;font-weight:700}
.tlhead{display:flex;align-items:center;justify-content:space-between;margin:20rpx 4rpx 10rpx}
.tlhead text:first-child{font-size:28rpx;font-weight:800;color:#5c4630}
.tlhead .add{font-size:24rpx;color:#c8a47e;font-weight:700}
.empty{text-align:center;color:#9a8c7c;font-size:24rpx;padding:60rpx 0}
.titem{position:relative;padding-left:26rpx;padding-bottom:16rpx}
.titem::before{content:"";position:absolute;left:6rpx;top:6rpx;width:12rpx;height:12rpx;border-radius:50%;background:#c8a47e}
.titem::after{content:"";position:absolute;left:11rpx;top:18rpx;bottom:0;width:1rpx;background:#e9dccb}
.titem:last-child::after{display:none}
.tcard{background:#fff;border-radius:14rpx;padding:14rpx 16rpx;box-shadow:0 2rpx 8rpx rgba(92,70,48,.05)}
.tcard .d{font-size:21rpx;color:#9a8c7c}
.tcard .s{font-size:26rpx;font-weight:700;color:#241f1d;margin:3rpx 0 5rpx}
.tcard .n{font-size:25rpx;color:#5c4630;line-height:1.6}
.tcard .mini{display:flex;gap:8rpx;flex-wrap:wrap;margin-top:8rpx}
.tcard .mini .c{font-size:20rpx;padding:2rpx 12rpx;border-radius:999rpx;background:#f3ece2;color:#5c4630}
.tcard .mini .c.warn{background:#fdecec;color:#c0392b;font-weight:700}
