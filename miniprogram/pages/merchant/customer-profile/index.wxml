<view class="pg {{themeClass}}">
  <view class="pcard">
    <view class="top">
      <view class="av">{{customerName[0]}}</view>
      <view><view class="nm">{{customerName}}</view><view class="st">到店 {{profile.visitCount}} 次{{profile.topService ? ' · 常做 ' + profile.topService : ''}}</view></view>
    </view>
    <view class="pstat">
      <view class="s"><text class="b">{{profile.visitCount}}</text><text class="l">到店次数</text></view>
      <view class="s"><text class="b">{{profile.avgIntervalDays || '—'}}{{profile.avgIntervalDays ? '天' : ''}}</text><text class="l">平均间隔</text></view>
      <view class="s"><text class="b">{{profile.topService || '—'}}</text><text class="l">最常做</text></view>
    </view>
    <view class="ptags" wx:if="{{profile.safetyFlags.length || profile.personality.length || profile.preferences.length}}">
      <view class="th">✦ AI 画像标签</view>
      <view class="chips">
        <text wx:for="{{profile.safetyFlags}}" wx:key="*this" class="chip warn">{{item}}</text>
        <text wx:for="{{profile.personality}}" wx:key="*this" class="chip">{{item}}</text>
        <text wx:for="{{profile.preferences}}" wx:key="*this" class="chip">{{item}}</text>
        <text wx:for="{{profile.styles}}" wx:key="*this" class="chip">{{item}}</text>
        <text wx:for="{{profile.companions}}" wx:key="*this" class="chip">{{item}}</text>
      </view>
    </view>
  </view>

  <!-- 签署文件留档(10b 第一步 · 合同图 v2 屏1 两态)。🔴 句子全来自后端,这儿一句都没拼。 -->
  <view class="sdoc">
    <view class="sdoc-hd">
      <text class="sdoc-t">签署文件</text>
      <text class="sdoc-more" wx:if="{{docs.length}}">{{docsMoreText}} ›</text>
    </view>
    <view class="sdoc-empty" wx:if="{{!docs.length}}">{{docsEmptyText}}\n{{docsEmptyHint}}</view>
    <view class="sdoc-row {{item.status === 'voided' ? 'is-voided' : ''}}" wx:for="{{docs}}" wx:key="id" bindtap="openDoc" data-id="{{item.id}}">
      <view class="sdoc-th"></view>
      <view class="sdoc-tx">
        <view class="sdoc-nm">{{item.title}}</view>
        <view class="sdoc-mt">{{item.profileMetaText}}</view>
      </view>
      <!-- 🔴 空徽章律:边框小标签绑单个 {{}} 必须带 wx:if —— 值为空时**整个徽章不出现**,
           而不是留一个空的描边框(那看起来像「有个状态但没显示出来」)。判据 test-empty-pill ① 盯着。 -->
      <text wx:if="{{item.statusText}}" class="sdoc-pill {{item.status === 'voided' ? 'v' : 'ok'}}">{{item.statusText}}</text>
    </view>
    <button class="sdoc-add" bindtap="openUpload">+ 上传文件</button>
  </view>

  <!-- 屏2 + 屏3:先定类型,再拍 -->
  <view class="sdoc-mask" wx:if="{{uploading}}" bindtap="closeUpload"></view>
  <view class="sdoc-sheet" wx:if="{{uploading}}">
    <view class="sdoc-sheet-hd"><text>上传签署文件</text><text class="sdoc-cancel" bindtap="closeUpload">取消</text></view>
    <view class="sdoc-ask">这是哪一份?</view>
    <view class="sdoc-opt {{pickedType === item.key ? 'on' : ''}}" wx:for="{{docTypes}}" wx:key="key" bindtap="pickType" data-key="{{item.key}}">
      <text>{{item.label}}</text><view class="sdoc-k"></view>
    </view>
    <input class="sdoc-title" wx:if="{{pickedType === 'other'}}" maxlength="60" placeholder="自己写个名字" value="{{pickedTitle}}" bindinput="onTitle" />
    <view class="sdoc-vis"><switch checked="{{pickedVisible}}" bindchange="onVisible" /><text>给顾客看</text></view>
    <view class="sdoc-shots">
      <!-- 🔴 占位零回落律(B 类:有数据才渲染)。字段级守卫 `wx:if="{{im}}"` 照抄本页小记图片那一行 ——
           没有它,一个读失败的空串会渲成一个灰方块,看起来像「有图但坏了」。判据 test-image-placeholder ② 盯着。 -->
      <block wx:for="{{shots}}" wx:for-item="im" wx:key="*this" wx:for-index="i">
        <image wx:if="{{im}}" class="sdoc-shot" src="{{im}}" mode="aspectFill" bindtap="redoShot" data-i="{{i}}" />
      </block>
      <view class="sdoc-shot add" bindtap="addShots">{{shots.length ? '+ 加一页' : '拍照 / 相册'}}</view>
    </view>
    <view class="sdoc-hint">多页的价格表可以连着拍,存成同一份。</view>
    <button class="sdoc-save" disabled="{{!shots.length}}" bindtap="saveDoc">存进{{customerName}}的档案</button>
  </view>


  <view class="tlhead"><text>服务记录时间线</text><text class="add" bindtap="addNote">+ 写小记</text></view>
  <view wx:if="{{!notes.length && !loading}}" class="empty">还没有服务小记,做完顾客随手记一条吧</view>
  <view class="titem" wx:for="{{notes}}" wx:key="id">
    <view class="tcard">
      <view class="d">{{item.date}}{{item.technicianName ? ' · ' + item.technicianName : ''}}</view>
      <view class="s" wx:if="{{item.serviceName}}">{{item.serviceName}}</view>
      <view class="n">{{item.structured.summary || item.rawText}}</view>
      <!-- 小记图片(08-30f):无图=整块不出现(零占位假图) -->
      <view class="nimgs" wx:if="{{item.images.length}}">
        <block wx:for="{{item.images}}" wx:for-item="im" wx:key="*this"><image wx:if="{{im}}" class="nimg" src="{{im}}" mode="aspectFill" /></block>
      </view>
      <view class="mini">
        <text wx:for="{{item.structured.safetyFlags}}" wx:for-item="t" wx:key="*this" class="c warn">{{t}}</text>
        <text wx:for="{{item.structured.styles}}" wx:for-item="t" wx:key="*this" class="c">{{t}}</text>
        <text wx:for="{{item.structured.preferences}}" wx:for-item="t" wx:key="*this" class="c">{{t}}</text>
      </view>
    </view>
  </view>
</view>
