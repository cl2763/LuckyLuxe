page{background:#fbf8f5}
.page{padding:24rpx 26rpx 60rpx}
.monthbar{display:flex;align-items:center;justify-content:center;gap:26rpx}
.marrow{width:56rpx;height:56rpx;border-radius:50%;background:#fff;border:1rpx solid #eadfd7;display:flex;align-items:center;justify-content:center;font-size:30rpx;color:#5c4630}
.mtext{font-size:30rpx;font-weight:800;color:#241f1d}
.ps{font-size:20rpx;color:#9a8c7c;text-align:center;margin:10rpx 0 20rpx;line-height:1.6}

.lockcard{background:#fff;border:1rpx dashed #eadfd7;border-radius:22rpx;padding:50rpx 30rpx;text-align:center;margin-top:30rpx}
.li{font-size:60rpx}
.lt{font-size:29rpx;font-weight:800;color:#241f1d;margin-top:14rpx}
.ld{font-size:23rpx;color:#9a8c7c;margin-top:8rpx}
.lbtn{display:inline-block;margin-top:24rpx;background:#2d2826;color:#fff;font-size:26rpx;font-weight:700;border-radius:999rpx;padding:16rpx 44rpx}

.totalbar{display:flex;justify-content:space-between;align-items:center;background:#2d2826;color:#e7dccc;border-radius:16rpx;padding:20rpx 24rpx;font-size:26rpx;margin-bottom:16rpx}
.tb{font-size:34rpx;font-weight:800;color:#e8c9a0}

.paycard{background:#fff;border:1rpx solid #eadfd7;border-radius:18rpx;padding:20rpx 22rpx;margin-bottom:14rpx}
.ph{display:flex;align-items:center;gap:14rpx;margin-bottom:8rpx}
.av{width:56rpx;height:56rpx;border-radius:50%;background:#c8a47e;color:#fff;display:flex;align-items:center;justify-content:center;font-size:24rpx;font-weight:700}
.pn{flex:1;font-size:28rpx;font-weight:800;color:#241f1d}
.src{font-size:19rpx;color:#9a8c7c;font-weight:400}
.ptotal{font-size:30rpx;font-weight:800;color:#c0392b}
.pline{display:flex;justify-content:space-between;font-size:23rpx;padding:8rpx 0;border-bottom:1rpx dashed #f2ebe4}
.pline:last-child{border-bottom:none}
.pline .m{color:#9a8c7c}
.pline .v{color:#241f1d;font-weight:700}
.pline.hl .v{color:#c0392b}
.noplan{font-size:23rpx;color:#a5674c;padding:8rpx 0}
.lnk{color:#b5885d;font-weight:700}
.lockedbar{background:#e3eee8;border:1rpx solid #cfe3d8;color:#1f7a4d;border-radius:14rpx;padding:16rpx 20rpx;font-size:23rpx;font-weight:600;margin-bottom:14rpx}
.lockedbar.paidbar{background:#fbf1e4;border-color:#ecd9bd;color:#8a5a24}
.lockbtn.pay{background:linear-gradient(135deg,#c8a47e,#b5885d)}
.unlk{color:#b5885d;font-weight:700}
.lockbtn{margin-top:20rpx;background:#2d2826;color:#fff;text-align:center;padding:26rpx;border-radius:14rpx;font-size:28rpx;font-weight:800}
.lockbtn.dim{opacity:.6}
.lockhint{font-size:20rpx;color:#9a8c7c;text-align:center;margin-top:10rpx;line-height:1.6}
.adjbtn{font-size:22rpx;font-weight:700;color:#b5885d;border:1rpx dashed #d9bf9f;border-radius:999rpx;padding:4rpx 18rpx}
.attrbox{background:#fbf1e4;border:1rpx dashed #ecd9bd;border-radius:16rpx;padding:18rpx 20rpx;margin-top:16rpx}
.attr-t{font-size:23rpx;font-weight:700;color:#8a5a24;margin-bottom:8rpx}
.attr-row{padding:8rpx 0;border-bottom:1rpx solid #f0e2cd}
.attr-row:last-child{border-bottom:none}
.attr-m{display:block;font-size:22rpx;color:#5c4630;font-weight:600}
.attr-n{display:block;font-size:21rpx;color:#a5674c;margin-top:2rpx}
