<config-sync-banner changed="{{configSyncChanged}}" error="{{configSyncError}}" checked="{{configSyncChecked}}" bind:retry="configSyncRetry"/>
<setup-preview-banner id="setup-preview-banner" wx:if="{{setupPreviewActive}}" label="{{setupPreviewLabel}}" />
<view class="page {{themeClass}}">
  <view wx:if="{{loading}}" class="empty">加载中…</view>

  <block wx:else>
    <button wx:if="{{!setupPreviewActive}}" bindtap="goSetupReview">平台配置核对</button>
    <view class="gtitle">门店信息</view>
    <view class="card">
      <view class="row" data-key="name" bindtap="editField"><text class="k">名称</text><text class="v">{{name || '未设置'}}</text><text class="arr">›</text></view>
      <view class="row" data-key="address" bindtap="editField"><text class="k">地址</text><text class="v">{{address || '未设置'}}</text><text class="arr">›</text></view>
      <view class="row" data-key="phone" bindtap="editField"><text class="k">电话</text><text class="v">{{phone || '未设置'}}</text><text class="arr">›</text></view>
    </view>
    <view class="hint">地址/电话改后会同步到 AI 客服的回答口径。</view>

    <view class="gtitle">到店指引</view><view class="card navrow" bindtap="goGuide"><text>添加入口、停车及上楼路线的图片与说明</text><text>›</text></view>
    <view class="gtitle">门店专属小程序码</view>
    <view class="card store-code-card">
      <view class="hint">顾客扫码直接进入本店，会员与消费记录按门店独立保存。</view>
      <button class="btn" bindtap="showStoreCode" loading="{{qrLoading}}" disabled="{{qrLoading}}">{{qrUrl ? '重新获取门店码' : '查看门店码'}}</button>
      <image wx:if="{{qrUrl && !qrError}}" class="store-code-image" src="{{qrUrl}}" mode="aspectFit" bindload="codeLoaded" binderror="codeFailed" bindtap="previewCode" />
      <view wx:if="{{qrError}}" class="hint" bindtap="showStoreCode">{{qrError}}</view>
      <view wx:if="{{qrUrl && !qrError}}" class="hint">{{qrTrial ? '体验版门店码，仅供已获体验权限的微信测试，请勿对外印刷。' : '正式版门店码，可用于门店展示。'}} 点击图片可放大保存。</view>
    </view>
    <view class="gtitle">营业时间</view>
    <view class="card">
      <!-- 裁定2 收敛:与强制页同一份组件(改口=常驻入口,合同六) -->
      <hours-form config-revision="{{configRevision}}" store-id="{{storeId}}" acceptance="{{bookingAcceptance}}" initial="{{hours}}" txt="{{hoursTxt}}" saving="{{hoursSaving}}" save-label="{{hoursTxt.settingsSave}}" save-error="{{hoursSaveError}}" bind:save="onHoursSave" />
    </view>

    <view class="gtitle">特殊日期(节假日/临时)</view>
    <view class="card">
      <view class="srow" wx:for="{{specials}}" wx:key="date">
        <view class="sinfo"><text class="sdate">{{item.date}}</text><text class="stext">{{item.text}}{{item.note ? ' · ' + item.note : ''}}</text></view>
        <text class="del" data-date="{{item.date}}" bindtap="delSpecial">删除</text>
      </view>
      <view wx:if="{{!specials.length}}" class="none">暂无,按每周固定营业</view>
      <view class="add" bindtap="addSpecial">＋ 新增特殊日期</view>
    </view>

    <view class="gtitle">值日表</view>
    <view class="card navrow">
      <text>开启后今天台面底部出现「值日」行,点名勾选</text>
      <switch checked="{{dutyOn}}" bindchange="onDutyToggle" />
    </view>

    <view class="gtitle">通知与回访</view>
    <view class="card navrow" bindtap="goNotify">
      <text>预约通知 · 到店提醒 · 生日/回访 · 文案模板</text><text class="arrow">›</text>
    </view>

    <view class="gtitle">预约规则</view>
    <view class="card">
      <view class="rulename">定金与取消规则</view>
      <deposit-form />
    </view>
  </block>
</view>

<view wx:if="{{specialDraft}}" class="special-mask {{themeClass}}">
  <scroll-view scroll-y class="special-dialog">
    <view class="srow"><text class="sinfo">特殊日期</text><button size="mini" disabled="{{specialSaving}}" bindtap="closeSpecial">关闭 ×</button></view>
    <picker mode="date" value="{{specialDraft.date}}" data-key="date" bindchange="specialField" disabled="{{specialSaving}}"><view class="srow">日期：{{specialDraft.date || '请选择'}}</view></picker>
    <view class="srow"><text class="sinfo">当天休息</text><switch checked="{{specialDraft.isClosed}}" data-key="isClosed" bindchange="specialField" disabled="{{specialSaving}}"/></view>
    <block wx:if="{{!specialDraft.isClosed}}">
      <picker mode="time" value="{{specialDraft.openTime}}" data-key="openTime" bindchange="specialField" disabled="{{specialSaving}}"><view class="srow">开始营业：{{specialDraft.openTime || '请选择'}}</view></picker>
      <picker mode="time" value="{{specialDraft.closeTime}}" data-key="closeTime" bindchange="specialField" disabled="{{specialSaving}}"><view class="srow">结束营业：{{specialDraft.closeTime || '请选择'}}</view></picker>
      <picker wx:if="{{bookingAcceptance.mode === 'latest_start'}}" mode="time" value="{{specialDraft.latestStartTime}}" data-key="latestStartTime" bindchange="specialField" disabled="{{specialSaving}}"><view class="srow">最晚开始：{{specialDraft.latestStartTime || '跟随当天结束营业'}}</view></picker>
    </block>
    <input class="special-note" value="{{specialDraft.note}}" data-key="note" bindinput="specialField" placeholder="备注（选填）" maxlength="100" disabled="{{specialSaving}}"/>
    <view class="note">优先于每周安排。已保存排班和预约不会自动改动。</view>
    <view wx:if="{{specialError}}" class="note special-error">{{specialError}}</view>
    <button class="special-save" bindtap="saveSpecial" loading="{{specialSaving}}" disabled="{{specialSaving}}">保存特殊日期</button>
  </scroll-view>
</view>
