<view class="page {{themeClass}}">
  <view wx:if="{{loading}}" class="empty">加载中…</view>

  <block wx:else>
    <view class="gtitle">门店信息</view>
    <view class="card">
      <view class="row" data-key="name" bindtap="editField"><text class="k">名称</text><text class="v">{{name || '未设置'}}</text><text class="arr">›</text></view>
      <view class="row" data-key="address" bindtap="editField"><text class="k">地址</text><text class="v">{{address || '未设置'}}</text><text class="arr">›</text></view>
      <view class="row" data-key="phone" bindtap="editField"><text class="k">电话</text><text class="v">{{phone || '未设置'}}</text><text class="arr">›</text></view>
    </view>
    <view class="hint">地址/电话改后会同步到 AI 客服的回答口径。</view>

    <view class="gtitle">门店专属小程序码</view>
    <view class="card store-code-card">
      <view class="hint">顾客扫码直接进入本店，会员与消费记录按门店独立保存。</view>
      <button class="btn" bindtap="showStoreCode" loading="{{qrLoading}}" disabled="{{qrLoading}}">{{qrUrl ? '重新获取门店码' : '查看门店码'}}</button>
      <image wx:if="{{qrUrl && !qrError}}" class="store-code-image" src="{{qrUrl}}" mode="aspectFit" bindload="codeLoaded" binderror="codeFailed" bindtap="previewCode" />
      <view wx:if="{{qrError}}" class="hint" bindtap="showStoreCode">{{qrError}}</view>
      <view wx:if="{{qrUrl && !qrError}}" class="hint">{{qrTrial ? '体验版门店码，仅供已获体验权限的微信测试，请勿对外印刷。' : '正式版门店码，可用于门店展示。'}} 点击图片可放大保存。</view>
    </view>
    <view class="gtitle">营业时间</view>
    <view class="card">
      <!-- 裁定2 收敛:与强制页同一份组件(改口=常驻入口,合同六) -->
      <hours-form initial="{{hours}}" txt="{{hoursTxt}}" saving="{{hoursSaving}}" save-label="{{hoursTxt.settingsSave}}" save-error="{{hoursSaveError}}" bind:save="onHoursSave" />
    </view>

    <view class="gtitle">特殊日期(节假日/临时)</view>
    <view class="card">
      <view class="srow" wx:for="{{specials}}" wx:key="date">
        <view class="sinfo"><text class="sdate">{{item.date}}</text><text class="stext">{{item.text}}{{item.note ? ' · ' + item.note : ''}}</text></view>
        <text class="del" data-date="{{item.date}}" bindtap="delSpecial">删除</text>
      </view>
      <view wx:if="{{!specials.length}}" class="none">暂无,按每周固定营业</view>
      <view class="add" bindtap="addSpecial">＋ 新增休息日</view>
    </view>

    <view class="gtitle">值日表</view>
    <view class="card navrow">
      <text>开启后今天台面底部出现「值日」行,点名勾选</text>
      <switch checked="{{dutyOn}}" bindchange="onDutyToggle" />
    </view>

    <view class="gtitle">通知与回访</view>
    <view class="card navrow" bindtap="goNotify">
      <text>预约通知 · 到店提醒 · 生日/回访 · 文案模板</text><text class="arrow">›</text>
    </view>

    <view class="gtitle">预约规则</view>
    <view class="card">
      <!-- 旧的「线上定金」开关已删(2026-08-09):定金统一由「定金与取消规则」这一处管,
           两个开关并存会互相打架 —— 设计图屏 4 也是把定金收在定金规则卡里 -->
      <!-- 批④ S7 摘要件(店主 08-24):小程序不做编辑器,但**摘要要做全** ——
           7 项关键值逐行显示(全部来自后端 summaryRows,与顾客端同一份 config 推导),
           下面给一句明确的「去哪改」引导,而不是只写一句话让人猜。 -->
      <view class="rulename">定金与取消规则</view>
      <view wx:if="{{!depositRows.length}}" class="ruledesc">读取中…</view>
      <view class="drow" wx:for="{{depositRows}}" wx:key="key">
        <text class="dk">{{item.label}}</text>
        <text class="dv">{{item.value}}</text>
      </view>
      <view class="note">{{depositEditHint}}</view>
    </view>
  </block>
</view>
