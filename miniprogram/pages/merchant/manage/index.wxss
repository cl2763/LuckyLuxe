page{background:var(--card)}
.page{padding:20rpx 26rpx 160rpx}
.owner{display:flex;align-items:center;gap:14rpx;padding:8rpx 4rpx 18rpx}
.oav{width:80rpx;height:80rpx;border-radius:50%;background:var(--tagmbg);color:var(--brandd);display:flex;align-items:center;justify-content:center;font-weight:600;font-size:34rpx}
.oname{font-size:30rpx;font-weight:600;color:var(--ink)}
.oplan{font-size:22rpx;color:var(--ink);margin-top:6rpx}
.grp{font-size:22rpx;color:var(--ink);margin:16rpx 2rpx 10rpx}
.row{display:flex;align-items:center;gap:14rpx;background:var(--card);border:1rpx solid var(--line);border-radius:14rpx;padding:14rpx 16rpx;margin-bottom:12rpx}
.badge{width:60rpx;height:60rpx;border-radius:14rpx;background:var(--tagmbg);display:flex;align-items:center;justify-content:center;flex:0 0 auto}
.bic{width:34rpx;height:34rpx}
.rmain{flex:1;min-width:0}
.rt{font-size:26rpx;font-weight:500;color:var(--ink)}
.rd{font-size:21rpx;color:var(--ink);margin-top:4rpx}
.chev{color:var(--brandd);font-size:34rpx;flex:0 0 auto}
