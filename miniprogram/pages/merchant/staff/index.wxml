<setup-preview-banner id="setup-preview-banner" wx:if="{{setupPreviewActive}}" label="{{setupPreviewLabel}}" />
<view class="page {{themeClass}}">
<navigator wx:if="{{!setupPreviewActive}}" url="/pages/merchant/record-management/index?kind=technicians" style="padding:24rpx;margin-bottom:20rpx;">删除 / 归档管理 ›</navigator>
  <view class="topbar">
    <text class="h1">员工管理</text>
    <view class="addbtn" bindtap="addTech">＋ 新增员工</view>
  </view>

  <scroll-view class="tabs" scroll-x>
    <view class="t {{tab === it.key ? 'on' : ''}}" wx:for="{{tabs}}" wx:for-item="it" wx:key="key" data-k="{{it.key}}" bindtap="switchTab">{{it.label}}</view>
  </scroll-view>

  <!-- 屏 4a 排班板块：周视图直接铺在页签里（2026-08-09 去掉中间那层「计时排班 ›」卡片） -->
  <block wx:if="{{tab === 'schedule'}}">
    <view class="wkbar">
      <view class="nav" bindtap="prevWeek">‹</view>
      <text class="wk">{{sc.rangeText}}</text>
      <view class="nav" bindtap="nextWeek">›</view>
      <view class="btn" bindtap="thisWeek">本周</view>
    </view>
    <view class="splitbar" bindtap="editSplit">上下午分界 <text class="b">{{sc.afternoonStart}}</text> · 点这里改 ›</view>

    <view wx:if="{{sc.loading}}" class="empty">加载中…</view>
    <block wx:else>
      <view class="dayrow" wx:for="{{sc.days}}" wx:for-item="d" wx:key="date">
        <view class="dhead">
          <text class="dt">{{d.title}}<text wx:if="{{d.isToday}}" class="todaytag">今天</text></text>
          <text class="closed" wx:if="{{d.isClosed}}">店休</text>
          <text class="onduty">{{d.onDuty}}人</text>
        </view>
        <scroll-view class="caps" scroll-x>
          <view class="cap {{c.kind}}" wx:for="{{d.caps}}" wx:for-item="c" wx:key="techId"
                data-date="{{d.date}}" data-tech="{{c.techId}}" data-name="{{c.name}}" data-kind="{{c.kind}}" bindtap="openSheet">
            <text class="cn">{{c.name}}</text>
            <text class="cl">{{c.label}}</text>
            <text class="cc" wx:if="{{c.carryLabel}}">{{c.carryLabel}}</text>
            <text class="cc" wx:if="{{c.count}}">{{c.count}} 单</text>
          </view>
        </scroll-view>
      </view>
      <view class="applybtn" bindtap="applyWeekAhead">本周模式应用到未来 4 周</view>
      <view class="tip">半填色=半天班 · 虚线=休 · 点胶囊改时段</view>
    </block>

    <!-- 屏 4a-2 时段编辑弹层 -->
    <view wx:if="{{shiftSheet}}" class="mask"></view>
    <view wx:if="{{shiftSheet}}" class="sheet">
      <button bindtap="closeShiftSheet" disabled="{{saving}}">关闭 ×</button><view class="tip">{{shiftSheet.latestMode ? "班次结束为停止接客时间；服务可延长至次日。" : "服务须在营业与班次结束前完成。"}}</view><view class="sh">{{shiftSheet.name}} · {{shiftSheet.date}}（周{{shiftSheet.weekday}}）</view>
      <view class="shs">选择当天出勤方式</view>
      <view class="tip">门店营业：{{shiftSheet.isClosed ? '休息' : shiftSheet.businessOpen+'–'+shiftSheet.businessClose}}</view><view wx:if="{{shiftSheet.latestMode}}" class="tip">最晚开始：{{shiftSheet.cutoff}}</view><view class="tip">技师原班次：{{shiftSheet.originalRange}}。已保存班次不会随营业时间延长自动延长。</view><button bindtap="fillBusinessHours" disabled="{{saving || shiftReviewLoading || shiftSheet.isClosed}}">按当天营业／接客时间填入</button><view class="tip">填入后仍需保存，不会同时改动其他日期。</view><view class="kinds">
        <view class="k {{shiftSheet.kind === 'full' ? 'on' : ''}}" data-k="full" bindtap="pickKind">全天班</view>
        <view class="k {{shiftSheet.kind === 'am' ? 'on' : ''}}" data-k="am" bindtap="pickKind">上午班</view>
        <view class="k {{shiftSheet.kind === 'pm' ? 'on' : ''}}" data-k="pm" bindtap="pickKind">下午班</view>
        <view class="k {{shiftSheet.kind === 'custom' ? 'on' : ''}}" data-k="custom" bindtap="pickKind">自定义</view>
        <view class="k {{shiftSheet.kind === 'off' ? 'on' : ''}}" data-k="off" bindtap="pickKind">休息</view>
      </view>
      <view wx:if="{{shiftSheet.kind === 'custom'}}" class="times">
        <picker mode="time" value="{{shiftSheet.start}}" bindchange="onStart"><view class="tp">{{shiftSheet.start}}</view></picker>
        <text class="dash">–</text>
        <picker mode="time" value="{{shiftSheet.end}}" bindchange="onEnd"><view class="tp">{{shiftSheet.end}}</view></picker>
      </view>
      <view class="rep" bindtap="toggleRepeat">
        <view class="box {{shiftSheet.repeat ? 'on' : ''}}">{{shiftSheet.repeat ? '✓' : ''}}</view>
        <text>同步应用到之后每个周{{shiftSheet.weekday}}</text>
      </view>
      <view wx:if="{{scConflicts.length}}" class="conf">
        <view class="ct">这么排会有 {{scConflicts.length}} 单落在时段外(已保存,自己决定要不要改预约):</view>
        <view class="cr" wx:for="{{scConflicts}}" wx:key="bookingId">{{item.startTime}}–{{item.endTime}} {{item.customerName}} · {{item.serviceName}}</view>
      </view>
      <view class="tip">顾客时段预览（门店与班次交集）</view>
    <view class="times"><text>示例总时长（分钟）</text><input type="number" value="{{shiftDuration || 120}}" bindinput="shiftDuration" style="padding:16rpx;min-width:100rpx"/></view>
    <button bindtap="previewShift" loading="{{shiftReviewLoading}}" disabled="{{shiftReviewLoading}}">核对接客范围与冲突</button>
    <view wx:if="{{shiftReviewError}}" class="tip">{{shiftReviewError}}</view>
    <view wx:if="{{shiftPreview}}"><view class="tip">{{shiftPreview.note}}</view><view wx:for="{{shiftPreview.previews}}" wx:key="date" class="tip">{{item.date}} · 班次 {{item.startTime}}–{{item.endTime}} · {{item.earliestStart ? '可开始 '+item.earliestStart+'–'+item.latestStart : '没有完整可约时段'}} · 时段外预约 {{item.conflicts.length}} 单<view wx:for="{{item.warnings}}" wx:for-item="w" wx:key="date">{{w.message}}</view><view wx:for="{{item.conflicts}}" wx:for-item="c" wx:key="bookingId">{{c.code}} {{c.startTime}}–{{c.endTime}} {{c.customerName}}</view></view></view>
    <button class="savebtn" bindtap="saveShift" loading="{{saving}}" disabled="{{saving || shiftReviewLoading}}">{{shiftPreview ? "确认保存排班" : "核对后保存排班"}}</button>
    </view>
  </block>

  <!-- 业绩目标板块:上=新增的本月排行卡,下=原有的逐人设置区(位置交互不变) -->
  <block wx:if="{{tab === 'targets'}}">
    <view class="card" wx:if="{{!setupPreviewActive}}">
      <view class="cardhd">
        <text class="ct">业绩排行</text>
        <view class="seg">
          <view class="s {{metric === m.key ? 'on' : ''}}" wx:for="{{metrics}}" wx:for-item="m" wx:key="key" data-k="{{m.key}}" bindtap="pickMetric">{{m.label}}</view>
        </view>
      </view>
      <picker class="rank-month" mode="date" fields="month" value="{{month}}" bindchange="pickRankingMonth"><view>{{month}}　⌄</view></picker>
      <view class="rank" wx:for="{{ranking}}" wx:key="name">
        <text class="no {{item.rank <= 2 ? 'top' : ''}}">{{item.rank}}</text>
        <text class="rn">{{item.name}}</text>
        <view class="bar"><view class="fill" style="width:{{item.barPct}}%"></view></view>
        <text class="rv">{{item.value}}</text>
      </view>
      <view wx:if="{{!ranking.length}}" class="hint">还没有已确认的日结,排行是空的。</view>
      <view class="foot">口径=已确认日结 · 点技师行看逐日明细</view>
    </view>

    <view class="card">
      <view class="cardhd"><text class="ct">各技师目标</text></view>
      <view class="hint">原设置区,交互不变;每行新增左侧进度</view>
      <view class="prog" wx:for="{{targets}}" wx:key="technicianId">
        <text class="pn" data-id="{{item.technicianId}}" data-name="{{item.name}}" bindtap="goDetail">{{item.name}}</text>
        <block wx:if="{{item.hasTarget}}">
          <view class="pbar"><view class="pfill {{item.hit ? 'done' : ''}}" style="width:{{item.pct}}%"></view></view>
          <text class="pt {{item.hit ? 'ok' : ''}}">{{item.pctText}}</text>
        </block>
        <text wx:else class="none">未设目标</text>
        <view class="setbtn" data-id="{{item.technicianId}}" catchtap="openTargetSheet">设置</view>
      </view>
    </view>
  </block>

  <!-- 薪资方案板块:每人一行(模板名 + 入口) -->
  <block wx:if="{{tab === 'salary'}}">
    <view class="card">
      <view class="rowline" bindtap="goDefaultPlan">
        <text class="nm">全店默认</text><text class="lb">{{defaultPlanLabel}}</text><text class="chev">›</text>
      </view>
      <view class="rowline" wx:for="{{plans}}" wx:key="id" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="goPlan">
        <text class="nm">{{item.name}}</text><text class="lb">{{item.label}}</text><text class="chev">›</text>
      </view>
      <view class="foot">没单独设的员工按全店默认算;工资试算在「财务 → 工资试算」。</view>
    </view>
  </block>

  <!-- 账号管理板块:每人一行行内按钮 -->
  <block wx:if="{{tab === 'accounts'}}">
    <view class="card" wx:for="{{list}}" wx:key="id">
      <view class="top">
        <view class="av">{{item.av}}</view>
        <view class="info">
          <view class="name">{{item.name}} <text class="ttl" wx:if="{{item.title}}">{{item.title}}</text></view>
          <view class="acct" wx:if="{{item.acct}}">账号 {{item.acct.username}}{{item.acct.disabled ? ' · 已停用' : ''}}</view>
          <view class="acct none" wx:else>未开账号</view>
        </view>
        <view class="tag {{item.active ? 's' : 'n'}}">{{item.active ? '在职' : '已停用'}}</view>
      </view>
      <navigator wx:if="{{!setupPreviewActive}}" url="/pages/merchant/record-management/index?kind=technicians&id={{item.id}}" class="b">删除 / 办理离职 ›</navigator><view class="btns">
        <block wx:if="{{item.acct}}">
          <view class="b" data-acctid="{{item.acct.id}}" bindtap="resetPwd">重置密码</view>
          <view class="b {{item.acct.disabled ? 'p' : 'd'}}" data-acctid="{{item.acct.id}}" bindtap="toggleAcct">{{item.acct.disabled ? '启用账号' : '停用账号'}}</view>
        </block>
        <view wx:else class="b p full" data-id="{{item.id}}" bindtap="genAccount">生成登录账号</view>
      </view>
    </view>
    <view class="note">「停用」保留排班/业绩历史,账号即刻失效(离职用);员工首次登录会强制改密。</view>
  </block>

  <!-- 目标设置面板(= v6 屏 4b 原面板,一字未改) -->
  <view wx:if="{{sheet}}" class="mask" bindtap="closeSheet"></view>
  <view wx:if="{{sheet}}" class="sheet">
    <view class="sh">业绩目标 · {{sheet.name}} · {{month}}</view>
    <view class="fd">
      <text class="lab">设置口径</text>
      <view class="seg">
        <view class="s {{sheet.mode === 'total' ? 'on' : ''}}" data-field="mode" data-v="total" bindtap="sheetPick">总目标</view>
        <view class="s {{sheet.mode === 'split' ? 'on' : ''}}" data-field="mode" data-v="split" bindtap="sheetPick">分项目标</view>
      </view>
    </view>
    <view class="fd">
      <text class="lab">本月业绩目标</text>
      <input class="in" type="digit" value="{{sheet.perf}}" data-field="perf" bindinput="sheetInput" />
    </view>
    <block wx:if="{{sheet.mode === 'split'}}">
      <view class="fd">
        <text class="lab">卡耗目标</text>
        <input class="in" type="digit" value="{{sheet.card}}" data-field="card" bindinput="sheetInput" />
      </view>
      <view class="fd">
        <text class="lab">单量目标</text>
        <input class="in" type="number" value="{{sheet.orders}}" data-field="orders" bindinput="sheetInput" />
      </view>
    </block>
    <view class="fd">
      <text class="lab">员工端显示</text>
      <view class="seg">
        <view class="s {{sheet.displayMode === 'total_only' ? 'on' : ''}}" data-field="displayMode" data-v="total_only" bindtap="sheetPick">仅总进度</view>
        <view class="s {{sheet.displayMode === 'with_split' ? 'on' : ''}}" data-field="displayMode" data-v="with_split" bindtap="sheetPick">含分项</view>
      </view>
    </view>
    <view class="save" bindtap="saveTarget">保存</view>
    <view class="foot">显示=仅总进度时,员工端整页(含每日流水)不出现分项来源。</view>
  </view>
</view>
