<view class="page {{themeClass}}" wx:if="{{c}}">
<view wx:if="{{c.archived}}" class="card">已归档顾客 · 历史资料保留，办理新业务前请先恢复档案。</view><member-pricing wx:else user-id="{{c.id}}"/>
<navigator wx:if="{{!setupPreviewActive}}" class="hbtn" url="/pages/merchant/record-management/index?kind=customers&id={{c.id}}">管理这份档案 · 删除 / 归档 ›</navigator>

  <view class="hero">
    <view class="av">{{c.av}}</view>
    <view class="hmain">
      <view class="hname">{{c.name}} <text class="tier">{{c.tier}}</text></view>
      <view class="hsub">{{c.memberCode}}{{c.phone ? ' · ' + c.phone : ''}}</view>
    </view>
  </view>

  <view class="card"><view class="ct">本店备注名</view><view class="ohint">仅本店商家端可见，不改变顾客昵称。</view><view class="ohint">顾客昵称：{{c.nickname}}</view><input class="remark-input" maxlength="40" value="{{remarkDraft}}" bindinput="onRemark" placeholder="最多40字，留空可清除" disabled="{{remarkSaving}}"/><button class="hbtn" bindtap="saveRemark" loading="{{remarkSaving}}" disabled="{{remarkSaving}}">保存备注名</button></view>
  <gift-entitlements wx:if="{{c.id && !setupPreviewActive}}" user-id="{{c.id}}" customer-name="{{c.name}}" readonly="{{c.archived}}"/>
  <customer-binding wx:if="{{c.customerBindingEnabled && !c.archived && !setupPreviewActive}}" user-id="{{c.id}}"/>
  <view class="stats">
    <view class="st"><view class="sv">{{c.visits}}</view><view class="sl">到店次数</view></view>
    <view class="st"><view class="sv">{{c.spend}}</view><view class="sl">累计消费</view></view>
    <view class="st"><view class="sv">{{c.stored}}</view><view class="sl">储值余额</view></view>
    <view class="st"><view class="sv">{{c.last}}</view><view class="sl">最近到店</view></view>
  </view>

  <view class="card" wx:if="{{c.tags.length}}">
    <view class="ct">标签</view>
    <view class="tags"><text wx:for="{{c.tags}}" wx:key="*this" class="tg">{{item}}</text></view>
  </view>

  <view class="card" wx:if="{{c.notes}}">
    <view class="ct">技师须知 / 备注</view>
    <view class="notes">📌 {{c.notes}}</view>
  </view>

  <view class="card" wx:if="{{c.birthday}}">
    <view class="row-sb"><text class="ck">生日</text><text>{{c.birthday}}</text></view>
  </view>

  <view class="card"><view class="hbtn" bindtap="migrationArchive">来源、原系统资料与旧权益 ›</view></view>
  <!-- 一套按钮规格(店主 08-30 点名):四个动作全部用 hbtn 同形制,不再一个长条一个陷进去 -->
  <view class="row2btn">
    <view class="hbtn" bindtap="writeNote">＋ 写服务小记</view>
    <view class="hbtn ghost" bindtap="viewProfile">顾客画像 ›</view>
  </view>
  <view class="row2btn">
    <view wx:if="{{!c.archived}}" class="hbtn" bindtap="accountAdjust">账户调整 ›</view>
    <view wx:if="{{!c.archived}}" class="hbtn ghost" bindtap="sendCoupon">发优惠券 ›</view>
  </view>

  <view class="card">
    <view class="ct">订单历史 <text class="cnt">{{orders.length}}</text></view>
    <view wx:if="{{!ordersLoaded}}" class="ohint">加载中…</view>
    <view wx:elif="{{!orders.length}}" class="ohint">暂无订单</view>
    <view class="orow" wx:for="{{orders}}" wx:key="id" data-id="{{item.id}}" bindtap="openOrder">
      <view class="oi">
        <view class="os">{{item.service}}</view>
        <view class="od">{{item.date}}{{item.time ? ' ' + item.time : ''}}</view>
      </view>
      <view class="or">
        <text class="op">{{item.price}}</text>
        <text class="ost {{item.done ? 'done' : ''}}">{{item.statusLabel}}</text>
      </view>
      <text class="order-chevron">›</text>
    </view>
  </view>
</view>
