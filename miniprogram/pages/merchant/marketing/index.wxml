<view class="page {{themeClass}}">
  <view class="t2">一键出内容(AI 文案 + 作品图)</view>
  <view class="content" bindtap="content">
    <view class="crow">
      <view class="cthumb">图</view>
      <view class="cinfo"><view class="ct">从图库选一组作品图</view><view class="cd">自动配 AI 文案 · 一键发到渠道</view></view>
    </view>
    <view class="cquote">「这组重点是干净耐看,细节不抢日常穿搭…」<text class="cmut">— AI 生成 · 换一版</text></view>
    <view class="cbtns"><text class="cb">小红书</text><text class="cb">抖音</text><text class="cb p">一键发布</text></view>
  </view>

  <view class="t2">按渠道的营销措施</view>
  <view class="card">
    <view class="lrow" bindtap="wakeSleep">
      <view class="ic z">z</view>
      <view class="li"><view class="lt">沉睡卡唤醒</view><view class="ld">有余额但久未到店 · 专属优惠召回</view></view>
      <text class="tag g">{{sleepN}}</text>
    </view>
    <view class="lrow" bindtap="revisit">
      <view class="ic c">↻</view>
      <view class="li"><view class="lt">回访 / 补甲提醒</view><view class="ld">到期自动列名单 · AI 拟提示语</view></view>
      <text class="tag n">{{revisitN}}</text>
    </view>
    <view class="lrow" bindtap="coupon">
      <view class="ic d">%</view>
      <view class="li"><view class="lt">优惠券 / 会员日</view><view class="ld">发券 → 到店核销 → 计入效果</view></view>
      <text class="arr">›</text>
    </view>
  </view>
  <view wx:if="{{loading}}" class="note" role="status">正在加载本店名单…</view>
  <view wx:if="{{loadError}}" class="note">{{loadError}} <text bindtap="load">重试 ›</text></view>
  <view wx:if="{{panel==='sleep' && !loading}}" class="list-card">
    <view class="lt">沉睡储值卡名单 · {{sleepN}} 人</view>
    <view wx:if="{{!sleepers.length}}" class="list-empty">当前没有余额未动满 30 天的顾客</view>
    <view class="list-row" wx:for="{{sleepers}}" wx:key="id" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="openCustomer"><text>{{item.name}} ›</text><text class="ld">{{item.detail}}</text></view>
  </view>
  <view wx:if="{{panel==='revisit' && !loading}}" class="list-card">
    <view class="lt">待回访名单 · {{revisitN}} 人</view>
    <view wx:if="{{!revisits.length}}" class="list-empty">当前没有待发送的回访任务；可在通知设置查看回访规则</view>
    <view class="list-row" wx:for="{{revisits}}" wx:key="id" data-id="{{item.userId}}" data-name="{{item.name}}" bindtap="openCustomer"><text>{{item.name}} ›</text><text class="ld">{{item.detail}}</text></view>
  </view>
  <view class="note">名单来自本店储值账户与回访任务；当前页仅供查看，未触发推送。</view>
</view>
