page{background:var(--paper)}
.page{padding:20rpx 26rpx 60rpx;background:var(--paper);color:var(--ink)}
.t2{font-size:25rpx;color:var(--ink);font-weight:600;margin:8rpx 4rpx 12rpx}
.content{background:var(--card);border:1rpx solid var(--line);border-radius:16rpx;padding:18rpx}
.crow{display:flex;gap:14rpx;align-items:center}
.cthumb{width:88rpx;height:88rpx;background:var(--wall);border-radius:12rpx;display:flex;align-items:center;justify-content:center;color:var(--sub);font-size:24rpx;flex:0 0 auto}
.cinfo{flex:1;min-width:0}
.ct{font-size:25rpx;color:var(--ink)}
.cd{font-size:21rpx;color:var(--sub);margin-top:5rpx}
.cquote{font-size:22rpx;color:var(--ink);background:var(--wall);border-radius:12rpx;padding:14rpx;line-height:1.5;margin-top:12rpx}
.cmut{color:var(--sub)}
.cbtns{display:flex;gap:12rpx;margin-top:12rpx}
.cb{flex:1;text-align:center;font-size:23rpx;color:var(--sub);background:var(--card);border:1rpx solid var(--line);border-radius:12rpx;padding:12rpx 0}
.cb.p{background:var(--brand);color:var(--hero);border-color:var(--brand)}
.card{background:var(--card);border:1rpx solid var(--line);border-radius:16rpx;overflow:hidden}
.lrow{display:flex;align-items:center;gap:14rpx;padding:22rpx 20rpx;border-bottom:1rpx solid var(--wall)}
.lrow:last-child{border-bottom:none}
.ic{width:60rpx;height:60rpx;border-radius:12rpx;display:flex;align-items:center;justify-content:center;font-size:26rpx;flex:0 0 auto;background:var(--wall);color:var(--brandd)}
.li{flex:1;min-width:0}
.lt{font-size:26rpx;color:var(--ink)}
.ld{font-size:21rpx;color:var(--sub);margin-top:5rpx}
.tag{font-size:22rpx;border-radius:40rpx;padding:4rpx 16rpx;flex:0 0 auto}
.tag.g{background:var(--tagmbg);color:var(--brandd)}
.tag.n{background:var(--card);color:var(--sub);border:1rpx solid var(--line)}
.arr{color:var(--sub);font-size:30rpx}
.note{font-size:21rpx;color:var(--sub);line-height:1.6;margin-top:18rpx}
.list-card{background:var(--card);border:1rpx solid var(--line);border-radius:16rpx;padding:20rpx;margin-top:18rpx;color:var(--ink)}
.list-empty{font-size:23rpx;color:var(--sub);padding:24rpx 0}
.list-row{display:flex;flex-direction:column;gap:4rpx;padding:17rpx 0;border-top:1rpx solid var(--line);font-size:25rpx}
.list-row .ld{line-height:1.5}
