page{background:var(--paper)}
.page{padding:24rpx 26rpx 60rpx}
.pt{font-size:32rpx;font-weight:800;color:var(--ink)}
.ps{font-size:22rpx;color:var(--sub);margin-top:6rpx}
.lnk{color:var(--brandd);font-weight:700}
.k{font-size:23rpx;color:var(--sub);font-weight:700;margin:26rpx 2rpx 12rpx}

/* 模板三选 */
.tpl{display:flex;gap:12rpx}
.tp{flex:1;background:var(--card);border:2rpx solid var(--line);border-radius:16rpx;padding:18rpx 10rpx;text-align:center}
.tp.on{border-color:var(--brand);background:var(--paper)}
.tt{font-size:25rpx;font-weight:800;color:var(--ink)}
.td{font-size:18rpx;color:var(--sub);margin-top:4rpx;white-space:pre-line;line-height:1.4}

/* 填空行:数字全部 input */
.frow{display:flex;align-items:center;justify-content:space-between;background:var(--card);border:1rpx solid var(--line);border-radius:14rpx;padding:18rpx 20rpx;margin-bottom:12rpx}
.fl{font-size:26rpx;color:var(--ink);font-weight:600;flex:1}
.fs{font-size:19rpx;color:var(--sub);font-weight:400;display:block;margin-top:2rpx}
.fv{display:flex;align-items:center;gap:4rpx;flex:none}
.u{font-size:24rpx;color:var(--sub);font-weight:700}
.num{width:140rpx;height:64rpx;line-height:64rpx;background:var(--paper);border:1rpx solid var(--line);border-radius:10rpx;text-align:center;font-size:28rpx;font-weight:800;color:var(--brandd)}

/* 阶梯表:每格都是 input */
.ladder{background:var(--card);border:1rpx solid var(--line);border-radius:14rpx;overflow:hidden}
.lr{display:flex;align-items:center;gap:10rpx;padding:14rpx 16rpx;border-bottom:1rpx solid var(--line)}
.lr.hd{background:var(--paper);padding:12rpx 16rpx}
.lr.hd text{font-size:19rpx;color:var(--sub);font-weight:700}
.c1{flex:3}.c2{flex:3}.c3{flex:2}.c4{flex:none;width:44rpx}
.li{height:64rpx;line-height:64rpx;background:var(--paper);border:1rpx solid var(--line);border-radius:10rpx;text-align:center;font-size:26rpx;font-weight:700;color:var(--ink)}
.del{width:44rpx;height:44rpx;border-radius:50%;background:var(--badbg);color:var(--bad);display:flex;align-items:center;justify-content:center;font-size:22rpx}
.addrow{text-align:center;font-size:24rpx;color:var(--brandd);font-weight:700;padding:18rpx}/* 加班粒度 */ .seg {display:flex;background:var(--paper);border:1rpx solid var(--line);border-radius:999rpx;padding:4rpx}
.sopt{font-size:22rpx;padding:10rpx 18rpx;border-radius:8rpx;color:var(--sub)}
.sopt.on{background:var(--hero);color:var(--heroink);font-weight:700}

.cardnote{font-size:20rpx;color:var(--sub);margin:2rpx 4rpx 0;line-height:1.5}
.save{margin-top:30rpx;background:var(--hero);color:var(--heroink);text-align:center;padding:26rpx;border-radius:14rpx;font-size:29rpx;font-weight:800}
.save.dim{opacity:.6}
.hint{font-size:20rpx;color:var(--sub);text-align:center;margin-top:14rpx;line-height:1.6}

/* 屏 3b/3c:阶段/阶梯段选 + 卡提成自定义行(2026-08-09) */
.modeseg{display:flex;align-items:center;gap:10rpx;flex-wrap:wrap;margin-bottom:12rpx}
.modeseg .ms{font-size:24rpx;padding:10rpx 26rpx;border-radius:999rpx;background:var(--wall);color:var(--sub);font-weight:700}
.modeseg .ms.on{background:var(--hero);color:var(--heroink)}
.modeseg .msn{width:100%;font-size:20rpx;color:var(--sub);line-height:1.7}
.crow{display:flex;align-items:center;gap:10rpx;padding:10rpx 0}
.crow .cin{flex:1;background:var(--paper);border:1rpx solid var(--line);border-radius:10rpx;padding:12rpx;font-size:24rpx}
.crow .cpct{width:110rpx;text-align:right;background:var(--paper);border:1rpx solid var(--line);border-radius:10rpx;padding:12rpx;font-size:24rpx;font-weight:700}
.crow .del{font-size:21rpx;color:var(--bad)}
.addrow{margin-top:8rpx;font-size:24rpx;color:var(--brandd);font-weight:700;border:1rpx dashed var(--line);border-radius:12rpx;padding:14rpx;text-align:center}

/* 屏 3b/3c 按设计图重做(2026-08-09):卡片式分区 + 基础项开关 + 常驻三模式对比 */
.card{background:var(--card);border:1rpx solid var(--line);border-radius:16rpx;padding:18rpx 18rpx 14rpx;margin-bottom:16rpx}
.ch{font-size:27rpx;font-weight:800;color:var(--ink);margin-bottom:14rpx;display:flex;align-items:baseline;gap:10rpx}
.ch .chs{font-size:20rpx;font-weight:400;color:var(--sub)}
.card .frow{border:none;background:transparent;padding:14rpx 2rpx;margin-bottom:0;border-bottom:1rpx solid var(--line)}
.card .frow:last-child{border-bottom:none}
.card .frow.sub{padding-left:18rpx;background:var(--paper);border-radius:10rpx;margin:6rpx 0}
.fl{font-size:26rpx;color:var(--ink)}
.fl .fs{display:block;font-size:20rpx;color:var(--sub);margin-top:4rpx}
.fv{display:flex;align-items:center;gap:8rpx}
.sw{width:78rpx;height:44rpx;border-radius:999rpx;background:var(--wall);flex:none;position:relative;transition:background .2s}
.sw.on{background:var(--good)}
.sw .dot{position:absolute;top:5rpx;left:5rpx;width:34rpx;height:34rpx;border-radius:50%;background:#fff;transition:transform .2s}
.sw.on .dot{transform:translateX(34rpx)}
.pvbar{background:var(--hero);color:var(--heroink);border-radius:16rpx;padding:18rpx 20rpx;margin-bottom:8rpx}
.pvbar .pvt{font-size:22rpx;color:var(--sub);margin-bottom:10rpx}
.pvbar .pvrow{display:flex;gap:10rpx;flex-wrap:wrap}
.pvbar .pv{font-size:24rpx;color:var(--sub);background:var(--card);border-radius:999rpx;padding:8rpx 18rpx}
.pvbar .pv.on{background:var(--brand);color:var(--hero);font-weight:800}
.pvbar .pvd{font-size:20rpx;color:var(--brandd);margin-top:10rpx}
