<view class="page">
  <view class="pt">{{isDefault ? '全店默认薪资方案' : '薪资方案 · ' + techName}}</view>
  <view class="ps" wx:if="{{isDefault}}">没单独设方案的员工都按这套算</view>
  <view class="ps" wx:elif="{{source === 'custom'}}">该员工使用专属方案 · <text class="lnk" bindtap="resetToDefault">恢复跟随全店默认</text></view>
  <view class="ps" wx:else>当前跟随全店默认 · 下面改动并保存后变为专属方案</view>

  <view class="k">① 选模板</view>
  <view class="tpl">
    <view class="tp {{template==='commission'?'on':''}}" data-t="commission" bindtap="pickTpl"><view class="tt">纯提成</view><view class="td">无底薪\n提成拿大头</view></view>
    <view class="tp {{template==='base_ladder'?'on':''}}" data-t="base_ladder" bindtap="pickTpl"><view class="tt">底薪+阶梯</view><view class="td">保底安心\n多劳多得</view></view>
    <view class="tp {{template==='base_flat'?'on':''}}" data-t="base_flat" bindtap="pickTpl"><view class="tt">底薪+固定提成</view><view class="td">最简单\n一个提点</view></view>
  </view>

  <view class="k">② 基础(直接点数字改)</view>
  <view class="frow" wx:if="{{template!=='commission'}}">
    <view class="fl">月底薪</view>
    <view class="fv"><text class="u">$</text><input class="num" type="digit" value="{{base}}" placeholder="0" bindinput="onBase" /></view>
  </view>
  <view class="frow">
    <view class="fl">手工费 / 单<text class="fs">每完成一单固定给</text></view>
    <view class="fv"><text class="u">$</text><input class="num" type="digit" value="{{handwork}}" placeholder="0" bindinput="onHandwork" /></view>
  </view>
  <view class="frow" wx:if="{{template!=='base_ladder'}}">
    <view class="fl">提成比例<text class="fs">当月业绩 × 此提点</text></view>
    <view class="fv"><input class="num" type="digit" value="{{flatPct}}" placeholder="0" bindinput="onFlatPct" /><text class="u">%</text></view>
  </view>

  <block wx:if="{{template==='base_ladder'}}">
    <view class="k">③ 业绩阶梯(每个数字都能改;最后一档上限留空=不封顶)</view>
    <view class="ladder">
      <view class="lr hd"><text class="c1">业绩从($)</text><text class="c2">到($)</text><text class="c3">提成%</text><text class="c4"></text></view>
      <view class="lr" wx:for="{{ladder}}" wx:key="index">
        <input class="li c1" type="digit" value="{{item.min}}" placeholder="0" data-i="{{index}}" data-f="min" bindinput="onLadder" />
        <input class="li c2" type="digit" value="{{item.max}}" placeholder="不封顶" data-i="{{index}}" data-f="max" bindinput="onLadder" />
        <input class="li c3" type="digit" value="{{item.pct}}" placeholder="%" data-i="{{index}}" data-f="pct" bindinput="onLadder" />
        <view class="del c4" data-i="{{index}}" bindtap="delTier">✕</view>
      </view>
      <view class="addrow" bindtap="addTier">＋ 加一档</view>
    </view>
  </block>

  <view class="k">{{template==='base_ladder' ? '④' : '③'}} 加班费(自动吃打卡考勤的加班时长)</view>
  <view class="frow">
    <view class="fl">加班费率<text class="fs">每满一段计一次,不足不计</text></view>
    <view class="fv"><text class="u">$</text><input class="num" type="digit" value="{{otRate}}" placeholder="0" bindinput="onOtRate" /></view>
  </view>
  <view class="frow">
    <view class="fl">计段粒度</view>
    <view class="seg">
      <view class="sopt {{otUnit===30?'on':''}}" data-u="30" bindtap="setOtUnit">每满30分钟</view>
      <view class="sopt {{otUnit===60?'on':''}}" data-u="60" bindtap="setOtUnit">每满1小时</view>
    </view>
  </view>

  <view class="k">{{template==='base_ladder' ? '⑤' : '④'}} 卡提成(充值和耗卡分开配;填 0 = 不启用)</view>
  <view class="frow">
    <view class="fl">充值提成<text class="fs">员工促成顾客充卡,按充值额提</text></view>
    <view class="fv"><input class="num" type="digit" value="{{rechargePct}}" placeholder="0" bindinput="onRechargePct" /><text class="u">%</text></view>
  </view>
  <view class="frow">
    <view class="fl">耗卡提成<text class="fs">顾客用卡付款,按消耗额提</text></view>
    <view class="fv"><input class="num" type="digit" value="{{cardPct}}" placeholder="0" bindinput="onCardPct" /><text class="u">%</text></view>
  </view>
  <view class="cardnote">两项归属流水(哪次充值/耗卡算谁的)接通后自动生效,现在先把提点配好</view>

  <view class="save {{saving?'dim':''}}" bindtap="save">{{saving ? '保存中…' : '保存方案 · 立即生效'}}</view>
  <view class="hint">工资 = 底薪 + 手工费×单数 + 业绩×落档提点 + 卡耗提成 + 加班费;月底在财务→工资试算里一键出全员明细</view>
</view>
