<view class="page">
  <view wx:if="{{loading}}" class="empty">加载中…</view>
  <block wx:else>
    <view wx:if="{{alertText}}" class="alertbar">⏰ {{alertText}}</view>
    <view wx:if="{{pendingReq}}" class="reqbar">✓ {{pendingReq}}</view>

    <view class="plan {{statusCls === 'warn' ? 'warn' : ''}}">
      <view class="pl-top"><text class="pl-name">{{planName}}</text><text class="pl-tag {{statusCls}}">{{statusTag}}</text></view>
      <view class="pl-exp" wx:if="{{expiresAt}}">有效期至 {{expiresAt}}</view>
      <view class="pl-exp" wx:else>长期授权(内部/旗舰店,无需续费)</view>
      <view class="pl-days" wx:if="{{daysLeft !== null && daysLeft > 0}}">剩余 {{daysLeft}} 天</view>
      <view class="pl-days" wx:if="{{status === 'grace'}}">宽限期内数据只读:能看数据,不能接新单</view>
      <view class="pl-bar" wx:if="{{expiresAt}}"><view class="pl-bar-in" style="width:{{barPct}}%"></view></view>
    </view>

    <view class="arow" bindtap="toggleAuto" wx:if="{{canRenew || autoRenew}}">
      <view class="ar-l">
        <view class="ar-t">自动续费</view>
        <view class="ar-s">{{autoRenew ? '到期前 3 天自动生成续费单并连续提醒,点一下完成支付' : '关闭中:到期前仅提醒,需手动续费'}}</view>
      </view>
      <view class="tg {{autoRenew ? 'on' : 'off'}}"></view>
    </view>

    <block wx:if="{{canRenew}}">
      <view class="k">续费(当前档位)</view>
      <view class="seg2">
        <view class="seg2-b {{period === 'year' ? 'on' : ''}}" data-p="year" bindtap="setPeriod">按年付(更省 · 约 8 折)</view>
        <view class="seg2-b {{period === 'month' ? 'on' : ''}}" data-p="month" bindtap="setPeriod">按月付</view>
      </view>
      <view class="paybtn" bindtap="renew">{{mockPay ? '模拟支付(沙盘)' : '立即续费'}} {{payText}}</view>
      <view class="tip">续费后到期日按「原到期日」顺延,早续不吃亏;到期前 7/3/1 天提醒,到期后 7 天宽限(只读),数据保留 90 天。</view>
    </block>

    <view class="k">全部档位</view>
    <view class="tier {{item.current ? 'cur' : ''}}" wx:for="{{tiers}}" wx:key="id">
      <view class="tr-l">
        <view class="tr-name">{{item.name}}<text wx:if="{{item.current}}" class="tr-tag">当前</text></view>
        <view class="tr-fit">{{item.fit}}</view>
        <view class="tr-setup" wx:if="{{item.note}}">{{item.note}}</view>
      </view>
      <view class="tr-r">
        <view class="tr-p">{{item.priceText}}</view>
        <view class="tr-sub" wx:if="{{item.subText}}">{{item.subText}}</view>
        <view wx:if="{{!item.current}}" class="tr-btn" data-plan="{{item.id}}" data-name="{{item.name}}" bindtap="reqChange">申请变更</view>
      </view>
    </view>
    <view class="k">AI 智能包(单独订阅)</view>
    <view class="aicard">
      <view class="ai-top">
        <view class="ai-l">
          <view class="ai-t">AI 智能包<text class="ai-badge {{ai.badgeCls}}" wx:if="{{ai.badge}}">{{ai.badge}}</text></view>
          <view class="ai-s">AI 接待 · 自动报价 · 话术生成;基础订阅功能齐全但不含 AI</view>
          <view class="ai-exp" wx:if="{{ai.expText}}">{{ai.expText}}</view>
        </view>
        <view class="ai-p" wx:if="{{!ai.includedInPlan}}">¥{{ai.monthY}}/月<view class="ai-py">¥{{ai.yearY}}/年</view></view>
      </view>
      <view class="ai-btns" wx:if="{{!ai.includedInPlan}}">
        <view wx:if="{{ai.trialPending}}" class="ai-btn wait">申请处理中</view>
        <view wx:elif="{{ai.trialAvailable}}" class="ai-btn hl" bindtap="aiTrial">申请免费试用 3 个月</view>
        <view class="ai-btn" data-p="year" bindtap="aiSubscribe">订阅一年 ¥{{ai.yearY}}</view>
        <view class="ai-btn" data-p="month" bindtap="aiSubscribe">按月 ¥{{ai.monthY}}</view>
      </view>
    </view>

    <view class="k" wx:if="{{orders.length}}">续费记录</view>
    <view class="hist" wx:if="{{orders.length}}">
      <view class="hrow" wx:for="{{orders}}" wx:key="id">
        <view class="hl">{{item.title}}<view class="hd">{{item.date}} · {{item.statusText}}</view></view>
        <view class="hv {{item.pending ? 'pend' : ''}}">{{item.amount}}</view>
      </view>
    </view>

    <view class="foot">只收订阅费 · 不抽客单佣金。订阅费为软件服务费,发票可联系客服开具;微信认证/商户号/短信等第三方费用另计。iPhone 端如无法拉起支付属苹果对小程序虚拟服务的限制,请走客服通道,服务不会中断。</view>
  </block>
</view>
