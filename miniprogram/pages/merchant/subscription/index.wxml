<view class="page {{themeClass}}">
  <view wx:if="{{loading}}" class="empty">加载中…</view>
  <block wx:else>
    <view wx:if="{{alertText}}" class="alertbar">⏰ {{alertText}}</view>
    <view wx:if="{{pendingReq}}" class="reqbar">✓ {{pendingReq}}</view>

    <view class="plan {{statusCls === 'warn' ? 'warn' : ''}}">
      <view class="pl-top"><text class="pl-name">{{planName}}</text><text class="pl-tag {{statusCls}}" wx:if="{{statusTag}}">{{statusTag}}</text></view>
      <view class="pl-exp" wx:if="{{expiresAt}}">有效期至 {{expiresAt}}</view>
      <view class="pl-exp" wx:else>长期授权(内部/旗舰店,无需续费)</view>
      <view class="pl-days" wx:if="{{daysLeft !== null && daysLeft > 0}}">剩余 {{daysLeft}} 天</view>
      <view class="pl-days" wx:if="{{status === 'grace'}}">宽限期内数据只读:能看数据,不能接新单</view>
      <view class="pl-bar" wx:if="{{expiresAt}}"><view class="pl-bar-in" style="width:{{barPct}}%"></view></view>
    </view>

    <view class="k">已开通功能</view>
    <view class="aicard">
      <view class="ai-t">AI 智能包<text class="ai-badge {{ai.badgeCls}}" wx:if="{{ai.badge}}">{{ai.badge}}</text></view>
      <view class="ai-exp" wx:if="{{ai.expText}}">{{ai.expText}}</view>
    </view>

    <view class="k" wx:if="{{orders.length}}">续费记录</view>
    <view class="hist" wx:if="{{orders.length}}">
      <view class="hrow" wx:for="{{orders}}" wx:key="id">
        <view class="hl">{{item.title}}<view class="hd">{{item.date}} · {{item.statusText}}</view></view>
        <view class="hv {{item.pending ? 'pend' : ''}}">{{item.amount}}</view>
      </view>
    </view>

    <view class="foot">此页用于查看现有软件授权及历史记录，不提供软件套餐购买、续费或支付功能。门店顾客的服务消费与充值均在线下收款，线上仅记录。</view>
  </block>
</view>
