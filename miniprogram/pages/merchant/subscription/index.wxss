page{background:var(--paper)}
.page{padding:24rpx 26rpx 60rpx}
.empty{text-align:center;font-size:24rpx;color:var(--sub);padding:80rpx 0}
.alertbar{background:var(--badbg);border:1rpx solid var(--line);border-radius:16rpx;padding:16rpx 22rpx;font-size:23rpx;color:var(--bad);font-weight:700;margin-bottom:14rpx;line-height:1.5}
.plan{border-radius:24rpx;padding:26rpx 28rpx;color:var(--herogold);margin-bottom:14rpx;background:linear-gradient(135deg,var(--hero),var(--line))}
.plan.warn{background:linear-gradient(135deg,var(--hero),var(--bad))}
.pl-top{display:flex;justify-content:space-between;align-items:baseline}
.pl-name{font-size:36rpx;font-weight:800;color:var(--brandd)}
.pl-tag{font-size:19rpx;font-weight:700;border-radius:40rpx;padding:5rpx 18rpx}
.pl-tag.ok{background:var(--goodbg);color:var(--good)}
.pl-tag.warn{background:var(--badbg);color:var(--bad)}
.pl-exp{font-size:23rpx;color:var(--brandd);margin-top:14rpx}
.pl-days{font-size:20rpx;color:var(--sub);margin-top:4rpx;line-height:1.5}
.pl-bar{height:10rpx;border-radius:999rpx;background:var(--line);margin-top:16rpx;overflow:hidden}
.pl-bar-in{height:100%;border-radius:999rpx;background:var(--wall);transition:width 1.2s cubic-bezier(.22,1,.36,1)}
.plan.warn .pl-bar-in{background:var(--badbg)}
.arow{background:var(--card);border:1rpx solid var(--line);border-radius:20rpx;padding:22rpx 24rpx;display:flex;justify-content:space-between;align-items:center;margin-bottom:8rpx}
.ar-l{flex:1;min-width:0;margin-right:16rpx}
.ar-t{font-size:27rpx;font-weight:700;color:var(--ink)}
.ar-s{font-size:20rpx;color:var(--sub);margin-top:4rpx;line-height:1.5}
.tg{width:88rpx;height:50rpx;border-radius:999rpx;position:relative;flex:none}
.tg.on{background:var(--good)}
.tg.on::after{content:"";position:absolute;right:5rpx;top:5rpx;width:40rpx;height:40rpx;border-radius:50%;background:var(--card)}
.tg.off{background:var(--wall)}
.tg.off::after{content:"";position:absolute;left:5rpx;top:5rpx;width:40rpx;height:40rpx;border-radius:50%;background:var(--card)}
.k{font-size:22rpx;color:var(--sub);font-weight:700;margin:20rpx 0 12rpx}
.reqbar{background:var(--goodbg);border:1rpx solid var(--line);border-radius:16rpx;padding:14rpx 22rpx;font-size:22rpx;color:var(--good);margin-bottom:14rpx;line-height:1.5}
.seg2{display:flex;background:var(--wall);border-radius:16rpx;padding:5rpx;margin-bottom:14rpx}
.seg2-b{flex:1;text-align:center;font-size:25rpx;font-weight:700;padding:14rpx 0;border-radius:12rpx;color:var(--sub)}
.seg2-b.on{background:var(--card);color:var(--brandd);box-shadow:0 2rpx 8rpx rgba(0,0,0,.08)}
.tier{display:flex;justify-content:space-between;align-items:center;gap:14rpx;background:var(--card);border:3rpx solid var(--line);border-radius:20rpx;padding:20rpx 22rpx;margin-bottom:12rpx}
.tier.cur{border-color:var(--brand);background:var(--paper)}
.tr-l{flex:1;min-width:0}
.tr-name{font-size:27rpx;font-weight:800;color:var(--ink)}
.tr-tag{font-size:17rpx;font-weight:700;color:var(--hero);background:var(--brand);border-radius:40rpx;padding:3rpx 12rpx;margin-left:10rpx;vertical-align:2rpx}
.tr-fit{font-size:20rpx;color:var(--sub);margin-top:4rpx;line-height:1.5}
.tr-setup{font-size:18rpx;color:var(--brandd);margin-top:2rpx}
.tr-r{flex:0 0 auto;text-align:right}
.tr-p{font-size:26rpx;font-weight:800;color:var(--brandd);line-height:1.4}
.tr-sub{font-size:18rpx;color:var(--sub);margin-top:2rpx}
.aicard{background:linear-gradient(135deg,var(--paper),var(--wall));border:1rpx solid var(--line);border-radius:20rpx;padding:22rpx 24rpx;margin-bottom:12rpx}
.ai-top{display:flex;justify-content:space-between;gap:16rpx}
.ai-l{flex:1;min-width:0}
.ai-t{font-size:27rpx;font-weight:800;color:var(--ink)}
.ai-badge{font-size:17rpx;font-weight:700;border-radius:40rpx;padding:3rpx 12rpx;margin-left:10rpx;vertical-align:3rpx}
.ai-badge.on{background:var(--goodbg);color:var(--good)}
.ai-badge.trial{background:var(--badbg);color:var(--bad)}
.ai-badge.off{background:var(--wall);color:var(--sub)}
.ai-s{font-size:20rpx;color:var(--sub);margin-top:4rpx;line-height:1.5}
.ai-exp{font-size:20rpx;color:var(--brandd);margin-top:6rpx;font-weight:600}
.ai-p{flex:0 0 auto;text-align:right;font-size:26rpx;font-weight:800;color:var(--brandd)}
.ai-py{font-size:19rpx;color:var(--sub);font-weight:600;margin-top:2rpx}
.ai-btns{display:flex;gap:12rpx;margin-top:16rpx;flex-wrap:wrap}.ai-btn {flex:1;min-width:180rpx;text-align:center;font-size:22rpx;font-weight:700;color:var(--brandd);border:1rpx solid var(--line);border-radius:999rpx;padding:14rpx 10rpx;background:var(--card)}
.ai-btn.hl{background:var(--hero);color:var(--heroink);border-color:var(--hero)}
.ai-btn.wait{background:var(--wall);color:var(--brandd);border-color:var(--line)}.tr-btn {display:inline-block;margin-top:8rpx;font-size:20rpx;font-weight:700;color:var(--brandd);border:1rpx solid var(--line);border-radius:999rpx;padding:7rpx 18rpx}.paybtn {height:92rpx;line-height:92rpx;text-align:center;background:var(--good);color:var(--paper);border-radius:999rpx;font-size:30rpx;font-weight:800}
.tip{font-size:20rpx;color:var(--sub);line-height:1.7;margin-top:14rpx}
.hist{background:var(--card);border:1rpx solid var(--line);border-radius:20rpx;overflow:hidden}
.hrow{display:flex;justify-content:space-between;align-items:center;padding:20rpx 24rpx;border-bottom:1rpx solid var(--line)}
.hrow:last-child{border-bottom:none}
.hl{font-size:24rpx;color:var(--ink);font-weight:600}
.hd{font-size:19rpx;color:var(--sub);font-weight:400;margin-top:2rpx}
.hv{font-size:26rpx;font-weight:800;color:var(--ink)}
.hv.pend{color:var(--bad)}
.foot{font-size:19rpx;color:var(--sub);line-height:1.7;margin-top:18rpx}
