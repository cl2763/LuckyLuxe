@import "../../../templates/media-privacy.wxss";
.guide-editor{padding-bottom:180rpx}.guide-intro{font-size:25rpx;color:var(--sub);line-height:1.6;margin:24rpx 0}.guide-card{padding:24rpx}.guide-step{padding:24rpx 0;border-bottom:1rpx solid var(--line)}.guide-heading{display:flex;gap:12rpx;align-items:center;font-size:26rpx;margin-bottom:24rpx}.guide-number{background:var(--brandd);color:var(--card);border-radius:50%;width:40rpx;height:40rpx;text-align:center;line-height:40rpx}.guide-heading button{margin:0;padding:0 10rpx;font-size:23rpx;background:transparent;color:var(--brandd)}.guide-heading button:first-of-type{margin-left:auto}.guide-heading .guide-delete{color:var(--danger)}.guide-fields{display:flex;gap:18rpx}.guide-fields image{width:160rpx;height:160rpx;border-radius:12rpx;flex-shrink:0}.guide-input{flex:1;border:1rpx solid var(--line);border-radius:12rpx;padding:14rpx;min-width:0}.guide-input textarea{width:100%;height:110rpx;font-size:25rpx}.guide-input text{display:block;text-align:right;font-size:20rpx;color:var(--sub)}.guide-sort{display:flex;flex-direction:column;gap:12rpx}.guide-sort button{padding:0 14rpx;background:var(--wall);color:var(--ink)}.guide-add{margin-top:24rpx;padding:24rpx;border:2rpx dashed var(--line);background:transparent;color:var(--brandd);font-size:27rpx}.guide-footer{position:fixed;bottom:0;left:0;right:0;display:flex;gap:20rpx;background:var(--card);padding:24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));border-top:1rpx solid var(--line)}.guide-footer button{flex:1;margin:0}.guide-preview{display:block}.guide-preview image{width:100%;height:300rpx}.guide-description{display:block;margin-top:16rpx;font-size:27rpx;white-space:pre-wrap}.guide-error{color:var(--danger);font-size:25rpx;padding:18rpx}
