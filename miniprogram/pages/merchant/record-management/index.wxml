<view class="page {{themeClass}}"><view class="error" wx:if="{{error}}">{{error}}</view><view wx:if="{{loading}}" class="card">正在读取…</view>
 <block wx:if="{{!review}}"><view class="card"><picker range="{{kinds}}" range-key="label" value="{{kindIndex}}" bindchange="kind"><view class="title">{{kinds[kindIndex].label}} ›</view></picker><view class="actions"><button bindtap="tab" data-archived="0" disabled="{{!archived}}">日常资料</button><button bindtap="tab" data-archived="1" disabled="{{archived}}">已归档</button></view><input placeholder="搜索名称" value="{{query}}" bindinput="search"/></view><view class="card row" wx:for="{{filtered}}" wx:key="id"><view><text>{{item.name}}</text><view class="note" wx:if="{{kind==='customers'}}">余额 {{item.balanceText}} · {{item.pendingCount}} 个预约 / 售后</view><view class="note" wx:if="{{kind==='technicians'}}">{{archived?'已离职':item.isActive?'在职':'已停用接客'}} · 待服务 {{item.pendingCount}} 个</view></view><button data-id="{{item.id}}" bindtap="inspect">{{archived?'查看 / 恢复':'检查关联 / 管理'}}</button></view><view class="note" wx:if="{{!loading && !filtered.length}}">暂无符合条件的资料</view><view class="note">历史预约、账目、签署及已发权益保留。只有未使用资料可以永久删除。</view><button wx:if="{{error}}" bindtap="load">重新加载</button></block>
 <block wx:else><button bindtap="back" disabled="{{saving}}">← 返回列表</button><view class="card"><view class="title">{{review.name}}</view><view class="line" wx:if="{{kind==='customers'}}">余额 {{review.balanceText}} · 待处理预约 / 售后 {{review.summary.pendingCount}} 个</view><navigator wx:if="{{kind==='customers'}}" url="/pages/merchant/customer/index?id={{review.id}}&archived=1">查看顾客档案与历史单据 ›</navigator><view class="note">{{review.status==='archived'?(kind==='customers'?'已归档。恢复后可再次办理新业务，历史资料保留。':kind==='technicians'?'已离职归档。恢复后，接客状态及员工登录仍需另行启用。':'已归档。恢复后，上架状态仍需另行启用。'):'请核对关联情况。历史业务记录会保留。'}}</view><view wx:if="{{review.blockers.length}}" class="title">需要先处理</view><view class="line" wx:for="{{review.blockers}}" wx:key="label">{{item.label}} · {{item.count}}</view><view wx:if="{{review.references.length}}" class="title">已有相关记录</view><view class="line" wx:for="{{review.references}}" wx:key="index">{{item.label}} · {{item.count}}</view></view><view class="card" wx:if="{{review.actions.length}}"><label>操作原因（必填）<textarea value="{{reason}}" bindinput="reason" maxlength="200"/></label><checkbox-group wx:if="{{review.requiresSalaryReview && review.status!=='archived'}}" bindchange="salary"><label><checkbox value="yes" checked="{{salaryReviewed}}"/>已核对离职薪酬及交接，未结事项已处理</label></checkbox-group><button wx:for="{{review.actions}}" wx:key="key" bindtap="act" data-action="{{item.key}}" disabled="{{saving}}">{{item.label}}</button></view><button bindtap="inspect" disabled="{{saving}}">重新检查关联</button></block>
</view>
