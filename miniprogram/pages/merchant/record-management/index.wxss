.page{padding:24rpx 24rpx 72rpx;color:var(--ink);background:var(--paper);min-height:100vh}.card{padding:28rpx;margin-bottom:24rpx;border:1rpx solid var(--line);border-radius:12rpx;background:var(--card)}.row,.actions{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.title{font-size:32rpx;font-weight:600;margin:16rpx 0}.note{font-size:25rpx;line-height:1.6;color:var(--sub);margin:20rpx 0}.line{font-size:27rpx;padding:14rpx 0}.actions{margin-top:24rpx}button{font-size:26rpx;margin:18rpx 0;padding:8rpx 16rpx}.actions button{flex:1}.error{padding:24rpx;color:var(--bad);line-height:1.6}input,textarea{box-sizing:border-box;width:100%;padding:22rpx;margin:20rpx 0;border:1rpx solid var(--line);background:var(--paper);color:var(--ink);border-radius:12rpx;min-height:44rpx;height:auto}textarea{height:150rpx}.row text{flex:1}.row button{flex:none}
