<view class="page">
  <view class="seg">
    <text class="s {{seg===0?'on':''}}" data-i="0" bindtap="onSeg">充值套餐</text>
    <text class="s {{seg===1?'on':''}}" data-i="1" bindtap="onSeg">会员次卡</text>
    <text class="s {{seg===2?'on':''}}" data-i="2" bindtap="onSeg">优惠券</text>
  </view>

  <!-- 充值套餐 -->
  <block wx:if="{{seg===0}}">
    <view class="card" wx:for="{{recharges}}" wx:key="id">
      <view class="crow" data-id="{{item.id}}" data-type="recharge" bindtap="edit">
        <view class="ci"><view class="cn {{item.active?'':'off'}}">{{item.name}}</view><view class="cs">{{item.sub}}</view></view>
        <switch class="sw" checked="{{item.active}}" color="#c8a47e" data-id="{{item.id}}" data-type="recharge" data-active="{{item.active}}" catchchange="toggle" />
      </view>
    </view>
    <view wx:if="{{!recharges.length}}" class="empty">还没有充值套餐</view>
  </block>

  <!-- 会员次卡 -->
  <block wx:elif="{{seg===1}}">
    <view class="card" wx:for="{{timesCards}}" wx:key="id">
      <view class="crow" data-id="{{item.id}}" data-type="times" bindtap="edit">
        <view class="ci"><view class="cn {{item.active?'':'off'}}">{{item.name}}</view><view class="cs">{{item.sub}}</view></view>
        <switch class="sw" checked="{{item.active}}" color="#c8a47e" data-id="{{item.id}}" data-type="times" data-active="{{item.active}}" catchchange="toggle" />
      </view>
    </view>
    <view wx:if="{{!timesCards.length}}" class="empty">还没有会员次卡</view>
  </block>

  <!-- 优惠券 -->
  <block wx:else>
    <view class="redeem" bindtap="redeemCode">扫码/输码 核销顾客的券</view>
    <view class="card" wx:for="{{coupons}}" wx:key="id">
      <view class="crow" data-id="{{item.id}}" data-type="coupon" bindtap="edit">
        <view class="ci"><view class="cn {{item.active?'':'off'}}">{{item.name}}</view><view class="cs">{{item.sub}}</view></view>
        <switch class="sw" checked="{{item.active}}" color="#c8a47e" data-id="{{item.id}}" data-type="coupon" data-active="{{item.active}}" catchchange="toggle" />
      </view>
    </view>
    <view wx:if="{{!coupons.length}}" class="empty">还没有优惠券</view>

    <!-- 屏 C3 自定义发放(小程序老板版,与网页同布局:搜顾客 → 发放 → 记录) -->
    <view class="gsec">自定义发放<text class="gsub">仅老板 · 原因必填,记录只追加</text></view>
    <view class="gcard">
      <view class="gline">
        <input class="gin" placeholder="搜索顾客(姓名或手机号)" value="{{grantQuery}}" bindinput="onGrantSearch" />
      </view>
      <view wx:if="{{grantPicked}}" class="ghit on">
        <text class="gn">{{grantPicked.displayName}}</text><text class="gp">{{grantPicked.phone}}</text>
        <text class="gswap" bindtap="unpickGrant">换一位</text>
      </view>
      <block wx:else>
        <view class="ghit" wx:for="{{grantResults}}" wx:key="id" data-id="{{item.id}}" bindtap="pickGrant">
          <text class="gn">{{item.displayName}}</text><text class="gp">{{item.phone}}</text>
        </view>
        <view wx:if="{{grantQuery && !grantResults.length}}" class="empty">没搜到这位顾客</view>
      </block>
      <view wx:if="{{grantPicked}}" class="gbtns">
        <view class="gbtn" bindtap="grantCustom">发自定义金额券</view>
        <view class="gbtn ghost" bindtap="grantTemplate">发一张券模板</view>
      </view>
    </view>

    <view class="gsec">发放记录<text class="gsub">审计 · 只追加不可删</text></view>
    <view class="gcard">
      <view class="grow" wx:for="{{grants}}" wx:key="id">
        <view class="gr1"><text class="gname">{{item.name}}</text><text class="gkind {{item.grantKind === 'custom' ? 'sp' : ''}}">{{item.grantKind === 'custom' ? '特批' : '模板'}}</text><text class="gval">{{item.valueText}}</text></view>
        <view class="gr2">发给 {{item.userName}} · {{item.grantedBy}}{{item.grantReason ? ' · ' + item.grantReason : ''}}</view>
        <view class="gr2">{{item.statusText}}{{item.settlementCode ? ' · ' + item.settlementCode : ''}}</view>
      </view>
      <view wx:if="{{!grants.length}}" class="empty">还没有发放记录</view>
    </view>
  </block>

  <view class="add" bindtap="add">＋ 新增{{segs[seg]}}</view>

  <view class="divider"></view>
  <view class="manual" bindtap="manualRecharge">给会员加储值(手动 / 线下)</view>
  <view class="note"><text class="b">两种到账:</text>①顾客小程序在线直充(微信支付,自动到账,待上线);②线下 / 现金,老板在这里手动补录。均记为储值负债,耗卡时才确认收入。手动加储值需先在财务页解锁。</view>
</view>
