page{background:#fbf8f5}
.page{padding:20rpx 26rpx 60rpx}
.seg{display:flex;background:#f1e7df;border-radius:12rpx;padding:5rpx;margin-bottom:18rpx}
.s{flex:1;text-align:center;font-size:24rpx;color:#8c8279;padding:14rpx 0;border-radius:9rpx}
.s.on{background:#fff;color:#2d2826;font-weight:600}
.card{background:#fff;border:1rpx solid #e7ddd4;border-radius:16rpx;margin-bottom:12rpx}
.crow{display:flex;align-items:center;gap:14rpx;padding:20rpx 20rpx}
.ci{flex:1;min-width:0}
.cn{font-size:27rpx;font-weight:600;color:#2d2826}
.cn.off{color:#b6a99b}
.cs{font-size:22rpx;color:#8c8279;margin-top:6rpx}
.sw{transform:scale(.8);flex:0 0 auto}
.empty{text-align:center;color:#b6a99b;font-size:23rpx;padding:40rpx 0}
.redeem{text-align:center;font-size:25rpx;color:#fff;background:#2d2826;border-radius:14rpx;padding:22rpx 0;margin-bottom:14rpx;letter-spacing:1rpx}
.add{text-align:center;color:#9b7655;font-size:25rpx;border:1rpx dashed #d8c6b3;border-radius:14rpx;padding:22rpx 0;margin-top:4rpx}
.divider{height:1rpx;background:#e7ddd4;margin:26rpx 0}
.note{font-size:21rpx;color:#8c8279;line-height:1.7;margin-top:16rpx}
.note .b{color:#2d2826;font-weight:600}

/* 屏 C3 自定义发放(小程序老板版,2026-08-09) */
.gsec{font-size:26rpx;font-weight:800;color:#241f1d;margin:24rpx 4rpx 12rpx;display:flex;align-items:baseline;gap:10rpx}
.gsec .gsub{font-size:20rpx;font-weight:400;color:#9a8c7c}
.gcard{background:#fff;border:1rpx solid #eadfd7;border-radius:16rpx;padding:16rpx;margin-bottom:12rpx}
.gline{margin-bottom:10rpx}
.gin{background:#faf6f1;border:1rpx solid #ece2d6;border-radius:12rpx;padding:18rpx;font-size:26rpx}
.ghit{display:flex;align-items:center;gap:12rpx;border:1rpx solid #eadfd7;border-radius:12rpx;padding:16rpx;margin-bottom:8rpx}
.ghit.on{border-color:#2f7d5c;background:#eef5f1}
.ghit .gn{font-size:26rpx;font-weight:700;color:#241f1d}
.ghit .gp{font-size:22rpx;color:#9a8c7c}
.ghit .gswap{margin-left:auto;font-size:22rpx;color:#b5885d}
.gbtns{display:flex;gap:10rpx;margin-top:10rpx}
.gbtn{flex:1;text-align:center;background:#2d2826;color:#fff;border-radius:12rpx;padding:22rpx;font-size:25rpx;font-weight:700}
.gbtn.ghost{background:#fff;color:#9b7655;border:1rpx solid #e7d3b8}
.grow{padding:14rpx 4rpx;border-bottom:1rpx solid #f4eee7}
.grow:last-child{border-bottom:none}
.gr1{display:flex;align-items:center;gap:10rpx}
.gr1 .gname{font-size:25rpx;font-weight:700;color:#241f1d}
.gr1 .gkind{font-size:19rpx;color:#8c8279;background:#f3ece2;border-radius:6rpx;padding:2rpx 10rpx}
.gr1 .gkind.sp{color:#2f7d5c;background:#e7f0ea;font-weight:700}
.gr1 .gval{margin-left:auto;font-size:24rpx;font-weight:800;color:#9b7655}
.gr2{font-size:21rpx;color:#9a8c7c;margin-top:4rpx;line-height:1.5}

/* F4 给会员加储值(平铺块):沿用自定义发放的 g* 皮肤,只补三个新控件 */
.gline{display:flex;align-items:center;gap:12rpx;margin-bottom:10rpx}
.glab{flex:0 0 140rpx;font-size:25rpx;color:#8a7a6b}
.gin.amt{flex:1}
.gpick{flex:1}
.gpickv{background:#faf6f1;border:1rpx solid #ece2d6;border-radius:12rpx;padding:18rpx;font-size:26rpx;color:#2d2826}
.gbtn.dis{opacity:.4}

/* D25:未绑定档案禁充提示行 */
.gnote{font-size:22rpx;color:#b5541f;background:#fdf1e7;border-radius:10rpx;padding:10rpx 16rpx;margin:8rpx 0}
