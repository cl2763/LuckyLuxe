page{background:var(--paper)}
.page{padding:24rpx 26rpx 80rpx}.seg {display:flex;background:var(--wall);border-radius:999rpx;padding:5rpx;margin:0 0 24rpx;gap:4rpx}
.s{flex:1;min-width:0;text-align:center;font-size:23rpx;color:var(--ink);background:var(--card);border:1rpx solid var(--line);padding:16rpx 2rpx;border-radius:12rpx;white-space:nowrap}
.s.on{background:var(--hero);color:var(--heroink);border-color:var(--hero);font-weight:600}
.card{background:var(--card);border:1rpx solid var(--line);border-radius:16rpx;margin-bottom:16rpx;padding:8rpx 20rpx}
.crow{display:flex;align-items:center;gap:14rpx;padding:20rpx 0}
.ci{flex:1;min-width:0}
.cn{font-size:27rpx;font-weight:600;color:var(--ink)}
.cn.off{color:var(--sub)}
.cs{font-size:22rpx;color:var(--sub);margin-top:6rpx}
.sw{transform:scale(.8);flex:0 0 auto}
.empty{text-align:center;color:var(--sub);font-size:23rpx;padding:40rpx 0}
.redeem{text-align:center;font-size:25rpx;color:var(--heroink);background:var(--hero);border-radius:14rpx;padding:22rpx 0;margin-bottom:14rpx;letter-spacing:1rpx}
.add{text-align:center;color:var(--brandd);font-size:25rpx;border:1rpx dashed var(--line);border-radius:14rpx;padding:22rpx 0;margin-top:4rpx}
.divider{height:1rpx;background:var(--line);margin:26rpx 0}
.note{font-size:21rpx;color:var(--sub);line-height:1.7;margin-top:16rpx}
.note .b{color:var(--ink);font-weight:600}

/* 屏 C3 自定义发放(小程序老板版,2026-08-09) */
.gsec{font-size:26rpx;font-weight:800;color:var(--ink);margin:24rpx 4rpx 12rpx;display:flex;align-items:baseline;gap:10rpx}
.gsec .gsub{font-size:20rpx;font-weight:400;color:var(--sub)}
.gcard{background:var(--card);border:1rpx solid var(--line);border-radius:16rpx;padding:16rpx;margin-bottom:12rpx}
.gline{margin-bottom:10rpx}
.gin{background:var(--paper);color:var(--ink);border:1rpx solid var(--line);border-radius:12rpx;padding:18rpx;font-size:26rpx}
.ghit{display:flex;align-items:center;gap:12rpx;border:1rpx solid var(--line);border-radius:12rpx;padding:16rpx;margin-bottom:8rpx}
.ghit.on{border-color:var(--good);background:var(--goodbg)}
.ghit .gn{font-size:26rpx;font-weight:700;color:var(--ink)}
.ghit .gp{font-size:22rpx;color:var(--sub)}
.ghit .gswap{margin-left:auto;font-size:22rpx;color:var(--brand)}
.gbtns{display:flex;gap:10rpx;margin-top:10rpx}.gbtn {flex:1;text-align:center;background:var(--hero);color:var(--heroink);border-radius:999rpx;padding:22rpx;font-size:25rpx;font-weight:700}
.gbtn.ghost{background:var(--card);color:var(--brandd);border:1rpx solid var(--line)}
.grow{padding:14rpx 4rpx;border-bottom:1rpx solid var(--line)}
.grow:last-child{border-bottom:none}
.gr1{display:flex;align-items:center;gap:10rpx}
.gr1 .gname{font-size:25rpx;font-weight:700;color:var(--ink)}
.gr1 .gkind{font-size:19rpx;color:var(--sub);background:var(--wall);border-radius:6rpx;padding:2rpx 10rpx}
.gr1 .gkind.sp{color:var(--good);background:var(--goodbg);font-weight:700}
.gr1 .gval{margin-left:auto;font-size:24rpx;font-weight:800;color:var(--brand)}
.gr2{font-size:21rpx;color:var(--sub);margin-top:4rpx;line-height:1.5}

/* F4 给会员加储值(平铺块):沿用自定义发放的 g* 皮肤,只补三个新控件 */
.gline{display:flex;align-items:center;gap:12rpx;margin-bottom:10rpx}
.glab{flex:0 0 140rpx;font-size:25rpx;color:var(--sub)}
.gin.amt{flex:1}
.gpick{flex:1}
.gpickv{background:var(--paper);border:1rpx solid var(--line);border-radius:12rpx;padding:18rpx;font-size:26rpx;color:var(--ink)}
.gbtn.dis{opacity:.4}

/* D25:未绑定档案禁充提示行 */
.gnote{font-size:22rpx;color:var(--tagm);background:var(--tagmbg);border-radius:10rpx;padding:10rpx 16rpx;margin:8rpx 0}

/* 批④ S9:会员体系只读展示 */
.mrow{display:flex;align-items:flex-start;justify-content:space-between;gap:20rpx;padding:20rpx 0;border-bottom:1rpx solid var(--line)}
.mrow:last-child{border-bottom:0}
.mk{color:var(--sub);font-size:24rpx;flex:none}
.mv{color:var(--ink);font-size:24rpx;font-weight:650;text-align:right;min-width:0}
.mnote{color:var(--sub);font-size:22rpx;line-height:1.7;padding:16rpx 22rpx}
