.page{background:var(--paper);min-height:100vh;box-sizing:border-box}
.page{padding:20rpx 26rpx 60rpx}
.form{background:var(--card);border:1rpx solid var(--line);border-radius:18rpx;overflow:hidden}
.frow{display:flex;align-items:center;padding:22rpx 24rpx;border-bottom:1rpx solid var(--line);gap:16rpx}
.frow:last-child{border-bottom:none}
.lb{font-size:25rpx;color:var(--ink);flex:0 0 220rpx}
.in{flex:1;font-size:25rpx;color:var(--ink);text-align:right}.btn {margin-top:26rpx;text-align:center;font-size:28rpx;color:var(--heroink);background:var(--hero);border-radius:999rpx;padding:26rpx 0;letter-spacing:2rpx}
.btn.off{opacity:.5}
.note{font-size:21rpx;color:var(--sub);line-height:1.6;margin-top:16rpx;text-align:center}

.gifts{padding:24rpx;color:var(--ink)}.gift-title{font-size:28rpx;font-weight:700}.gift-hint{font-size:22rpx;color:var(--sub);line-height:1.6;margin-top:14rpx;font-weight:400}.gift-row{display:grid;grid-template-columns:minmax(100rpx,1fr) 72rpx 128rpx 40rpx;gap:10rpx;align-items:center;margin-top:16rpx}.gift-row input{width:100%;min-width:0;height:72rpx;box-sizing:border-box;border:1rpx solid var(--line);border-radius:12rpx;padding:8rpx;background:var(--paper);font-size:24rpx;color:var(--ink)}.gift-head{font-size:22rpx;color:var(--sub)}.gift-remove{width:40rpx;padding:0;margin:0;color:var(--sub);background:transparent;line-height:60rpx}.gift-remove::after{border:0}.gift-add{margin:20rpx 0 0;padding:12rpx 20rpx;width:max-content;max-width:100%;font-size:25rpx;line-height:1.5;border-radius:999rpx;color:var(--ink);background:var(--wall)}
