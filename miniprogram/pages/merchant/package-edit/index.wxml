<view class="page {{themeClass}}">
  <view class="form">
    <view class="frow"><text class="lb">套餐名称</text><input class="in" value="{{name}}" placeholder="{{kind==='times'?'如 纯色×5次卡':'如 充1000送50'}}" bindinput="onName" /></view>
    <view class="frow"><text class="lb">售价 ({{currency}})</text><input class="in" type="digit" value="{{price}}" placeholder="顾客支付" bindinput="onPrice" /></view>

    <block wx:if="{{kind==='recharge'}}">
      <view class="frow"><text class="lb">赠送金额 ({{currency}})</text><input class="in" type="digit" value="{{bonus}}" placeholder="选填,如 50" bindinput="onBonus" /></view>
    </block>
    <block wx:else>
      <view class="frow"><text class="lb">包含次数</text><input class="in" type="number" value="{{times}}" placeholder="如 5" bindinput="onTimes" /></view>
      <view class="frow"><text class="lb">适用范围</text><input class="in" value="{{scope}}" placeholder="选填,如 纯色美甲" bindinput="onScope" /></view>
    </block>

    <view wx:if="{{kind==='recharge'}}" class="gifts">
      <view class="gift-title">赠送物品 <text class="gift-hint">选填，可多件</text></view>
      <view class="gift-row gift-head"><text>物品名称</text><text>数量</text><text>单件价值</text><text></text></view>
      <view class="gift-row" wx:for="{{giftItems}}" wx:key="index">
        <input value="{{item.name}}" maxlength="80" placeholder="物品名称" data-i="{{index}}" data-field="name" bindinput="onGift" />
        <input value="{{item.quantity}}" type="number" placeholder="1" data-i="{{index}}" data-field="quantity" bindinput="onGift" />
        <input value="{{item.value}}" type="digit" placeholder="{{currency}}" data-i="{{index}}" data-field="value" bindinput="onGift" />
        <button class="gift-remove" data-i="{{index}}" bindtap="removeGift" aria-label="删除赠品">×</button>
      </view>
      <button class="gift-add" bindtap="addGift" disabled="{{giftItems.length >= 20}}">＋ 再加一行</button>
      <view class="gift-hint">价值用于展示，不计入储值余额、营业收入或技师业绩。物品领取请联系门店，此清单不代表已领取。</view>
    </view>
    <view class="frow"><text class="lb">权益说明</text><input class="in" value="{{benefits}}" placeholder="选填,如 赠免费卸甲" bindinput="onBenefits" /></view>
    <view class="frow"><text class="lb">上架(顾客可购)</text><switch checked="{{active}}" color="#c8a47e" bindchange="onActive" /></view>
  </view>

  <view class="btn {{saving?'off':''}}" bindtap="save">{{saving?'保存中…':(isNew?'新增':'保存')}}</view>
  <view class="note">套餐售出、次卡核销等发生在顾客端;这里只做定义与上下架。</view>
</view>
