page{background:var(--paper)}
.page{padding:24rpx 26rpx 60rpx}
.pt{font-size:32rpx;font-weight:800;color:var(--ink)}
.ps{font-size:22rpx;color:var(--sub);margin-top:6rpx;line-height:1.5}.addbtn {margin:20rpx 0 16rpx;text-align:center;font-size:26rpx;color:var(--brandd);font-weight:700;border:1rpx dashed var(--line);border-radius:999rpx;padding:20rpx;background:var(--card)}
.empty{text-align:center;color:var(--sub);font-size:24rpx;padding:40rpx 0}
.pcard{display:flex;align-items:center;gap:16rpx;background:var(--card);border:1rpx solid var(--line);border-radius:18rpx;padding:20rpx 22rpx;margin-bottom:12rpx}
.pcard.off{opacity:.55}
.pinfo{flex:1;min-width:0}
.pname{font-size:28rpx;font-weight:700;color:var(--ink)}
.offtag{font-size:18rpx;color:var(--sub);background:var(--line);border-radius:6rpx;padding:2rpx 10rpx;margin-left:10rpx}
.pmeta{font-size:21rpx;color:var(--sub);margin-top:4rpx}
.pright{flex:none;text-align:center}
.pcost{font-size:26rpx;font-weight:800;color:var(--brandd)}
.ptog{margin-top:8rpx;font-size:21rpx;font-weight:700;color:var(--brandd);background:var(--paper);border:1rpx solid var(--line);border-radius:999rpx;padding:6rpx 20rpx}
.revoke{margin-top:24rpx;text-align:center;font-size:23rpx;color:var(--brandd);font-weight:600}

.mask{position:fixed;left:0;top:0;right:0;bottom:0;background:rgba(36,26,18,.45);z-index:1999}
.sheet{position:fixed;left:0;right:0;bottom:0;background:var(--card);border-radius:24rpx 24rpx 0 0;padding:28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));z-index:2000;max-height:80vh;overflow-y:auto}
.sh-t{font-size:30rpx;font-weight:800;color:var(--ink);margin-bottom:10rpx}
.k{font-size:22rpx;color:var(--sub);font-weight:700;margin:14rpx 0 8rpx}
.pick{background:var(--paper);border:1rpx solid var(--line);border-radius:12rpx;padding:18rpx;font-size:27rpx;color:var(--ink);display:flex;justify-content:space-between}
.pick.dis{opacity:.6}
.pick .g{color:var(--brandd);font-size:23rpx}
.frow{display:flex;align-items:center;justify-content:space-between;background:var(--paper);border:1rpx solid var(--line);border-radius:12rpx;padding:14rpx 18rpx;margin-top:12rpx}
.fl{font-size:26rpx;color:var(--ink);font-weight:600;flex:1}
.fs{font-size:19rpx;color:var(--sub);font-weight:400;display:block;margin-top:2rpx}
.num{width:160rpx;height:60rpx;line-height:60rpx;background:var(--card);border:1rpx solid var(--line);border-radius:10rpx;text-align:center;font-size:27rpx;font-weight:800;color:var(--brandd)}
.tog{width:88rpx;height:48rpx;border-radius:999rpx;background:var(--wall);position:relative;transition:.2s}
.tog .dot{position:absolute;left:6rpx;top:6rpx;width:36rpx;height:36rpx;border-radius:50%;background:#fff;transition:.2s}
.tog.on{background:var(--good)}
.tog.on .dot{left:46rpx}
.save{margin-top:24rpx;background:var(--hero);color:var(--heroink);text-align:center;padding:24rpx;border-radius:14rpx;font-size:28rpx;font-weight:800}
.save.dim{opacity:.6}/* 券来源模式/类型切换/文本输入 */ .modeseg {display:flex;background:var(--paper);border:1rpx solid var(--line);border-radius:999rpx;padding:4rpx}
.mopt{flex:1;text-align:center;font-size:24rpx;padding:14rpx 0;border-radius:10rpx;color:var(--sub)}
.mopt.on{background:var(--hero);color:var(--heroink);font-weight:700}
.typeseg{display:flex;gap:10rpx}
.topt{flex:1;text-align:center;font-size:23rpx;padding:14rpx 0;border-radius:12rpx;background:var(--paper);border:1rpx solid var(--line);color:var(--brandd)}
.topt.on{background:var(--brand);color:var(--hero);border-color:var(--brand);font-weight:700}
.txt{flex:none;width:340rpx;height:60rpx;line-height:60rpx;background:var(--card);border:1rpx solid var(--line);border-radius:10rpx;padding:0 14rpx;font-size:25rpx;color:var(--ink)}
.freehint{font-size:20rpx;color:var(--brandd);background:var(--paper);border:1rpx dashed var(--line);border-radius:10rpx;padding:12rpx 16rpx;margin-top:12rpx;line-height:1.5}
