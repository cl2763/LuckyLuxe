/* 账户调整(与网页 account-adjust 面板同形;视觉沿用商家端既有卡片风)
   五(08-30c):所有输入框整行铺满 —— 真机宽度下一行字完整可见,不许滚动看字。 */
.pg { padding: 24rpx; }
.hd { display: flex; align-items: baseline; gap: 16rpx; margin-bottom: 20rpx; }
.hd .t { font-size: 36rpx; font-weight: 700; }
.hd .nm { font-size: 28rpx; color: #6b645d; }
/* 五:四数 2×2(四格挤一行时「顾客实付累计」这类长标签会被截) */
.facts { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 12rpx; }
.fact { flex: 1 1 40%; background: #fff; border: 1rpx solid #ece7e1; border-radius: 10rpx; padding: 14rpx 10rpx; text-align: center; }
.fact.hi { border-color: #b08d57; }
.fl { display: block; font-size: 22rpx; color: #9a938c; }
.fv { display: block; font-size: 30rpx; font-weight: 700; margin-top: 4rpx; }
.fv.small { font-size: 22rpx; }
.split, .hint { font-size: 22rpx; color: #9a938c; margin: 6rpx 0; }
/* 六:选中=黑底白字,未选=白底黑字描边(店主规格) */
.seg { display: flex; gap: 10rpx; margin: 16rpx 0; }.segbtn { flex: 1; text-align: center; padding: 12rpx 0; border: 1rpx solid #2d2a26; border-radius: 999rpx; font-size: 26rpx; background: #fff; color: #2d2a26; }
.segbtn.on { background: #2d2a26; color: #fff; border-color: #2d2a26; }
.card { background: #fff; border: 1rpx solid #ece7e1; border-radius: 12rpx; padding: 20rpx; }
.sub { display: flex; flex-wrap: wrap; gap: 10rpx; margin-bottom: 16rpx; }.subbtn { padding: 8rpx 20rpx; border: 1rpx solid #2d2a26; border-radius: 999rpx; font-size: 24rpx; background: #fff; color: #2d2a26; }
.subbtn.on { background: #2d2a26; color: #fff; border-color: #2d2a26; }
.fld { margin: 16rpx 0; }
.fldl { font-size: 24rpx; color: #6b645d; display: block; margin-bottom: 6rpx; }
/* 五:整行输入(width 100% + border-box),字多不截、不横滚 */
.in { display: block; width: 100%; box-sizing: border-box; border: 1rpx solid #ece7e1; border-radius: 8rpx; padding: 14rpx 16rpx; font-size: 28rpx; }
.pk { display: block; width: 100%; box-sizing: border-box; border: 1rpx solid #ece7e1; border-radius: 8rpx; padding: 14rpx 16rpx; font-size: 26rpx; }
.fldem { font-size: 20rpx; color: #9a938c; margin-top: 6rpx; }
.fldem.lead { margin: 0 0 12rpx; line-height: 1.6; }
.link { color: #b08d57; }
.warn { border-left: 4rpx solid #b08d57; background: rgba(176,141,87,.08); padding: 10rpx 14rpx; font-size: 22rpx; color: #6b5432; margin: 10rpx 0; }
.calc { border-top: 1rpx solid #ece7e1; margin-top: 14rpx; padding-top: 10rpx; }
.crow { display: flex; justify-content: space-between; font-size: 26rpx; padding: 4rpx 0; }
.crow.tot { font-weight: 700; font-size: 28rpx; }.cta { margin-top: 16rpx; background: #2d2a26; color: #fff; border-radius: 999rpx; text-align: center; padding: 18rpx 0; font-size: 28rpx; }
.cta.ing { opacity: .6; }
/* 充值套餐 chips(label=后端句) */
.chips { display: flex; flex-wrap: wrap; gap: 10rpx; }.chip { border: 1rpx solid #2d2a26; border-radius: 999rpx; padding: 8rpx 20rpx; font-size: 24rpx; background: #fff; color: #2d2a26; }
.chip.on { background: #2d2a26; color: #fff; }
/* 冲销列表 */
.mrow { display: flex; align-items: center; justify-content: center; gap: 28rpx; margin: 8rpx 0 14rpx; }
.mnav { font-size: 34rpx; color: #6b645d; padding: 0 20rpx; }
.mcur { font-size: 28rpx; font-weight: 700; }
.trow { display: flex; align-items: center; gap: 12rpx; padding: 14rpx 0; border-bottom: 1rpx dashed #ece7e1; }
.trow.rev { opacity: .65; }
.tinfo { flex: 1; min-width: 0; }
.tdate { display: block; font-size: 20rpx; color: #9a938c; }
.tnote { display: block; font-size: 24rpx; }
.tamt { font-size: 26rpx; font-weight: 700; }
.tamt.neg { color: #a6352b; }.tbtn { border: 1rpx solid #2d2a26; border-radius: 999rpx; padding: 8rpx 18rpx; font-size: 22rpx; color: #2d2a26; }
