<view class="page">
  <view class="seg">
    <view class="seg-i {{mode==='today'?'on':''}}" data-m="today" bindtap="switchMode">今日台面</view>
    <view class="seg-i {{mode==='all'?'on':''}}" data-m="all" bindtap="switchMode">全部订单</view>
    <view class="seg-i {{mode==='aftersales'?'on':''}}" data-m="aftersales" bindtap="switchMode">售后订单</view>
  </view>

  <!-- ===== 今日台面:技师维度日视图 ===== -->
  <block wx:if="{{mode==='today'}}">
    <view class="dv-datebar">
      <view class="dv-nav" bindtap="dvPrev">‹</view>
      <text class="dv-date">{{dv.dateText}}</text>
      <view class="dv-nav" bindtap="dvNext">›</view>
      <!-- D3/D4/D5(店主 2026-08-10 开检):当期就说「今天/本周」,非当期要说「返回今天/返回本周」——
       以前每一天都写着「今天」,翻到 8/03 那页按钮还叫「今天」,根本看不出自己在哪一天。 -->
      <view class="dv-today {{dv.isToday ? 'cur' : ''}}" bindtap="dvToday">{{dv.isToday ? '今天' : '返回今天'}}</view>
    </view>
    <view class="dv-summary" wx:if="{{dv && !dv.isClosed}}">
      <text class="dv-pill">今日 <text class="b">{{dv.total}}</text> 单</text>
      <text class="dv-pill live" wx:if="{{dv.activeCount}}">在做 <text class="b">{{dv.activeCount}}</text> 人</text>
      <text class="dv-pill">在岗 <text class="b">{{dv.working}}</text> 人</text>
      <text class="dv-pill">空档 <text class="b">{{dv.freeHours}}</text> h</text>
      <text class="dv-pill hot" wx:if="{{isOwner && v && v.pending.length}}" bindtap="scrollToClose">待日结 <text class="b">{{v.pending.length}}</text></text>
      <view class="dv-share" bindtap="shareSchedule">⤴ 分享</view>
    </view>
    <!-- D2:台面空态与日结自洽 —— 「本日休息」但日结里有单时,这里就把原因说出来,
         别让店主在两个地方看到互相矛盾的两句话(文案后端下发)。 -->
    <view wx:if="{{dv && dv.isClosed}}" class="dv-closed">
      本日休息{{dv.specialNote ? ' · ' + dv.specialNote : ''}}
      <!-- D34(2026-08-12):休息日不可开单已成口径 —— 历史单照服务发生日留痕,提示改写;
           旧称谓字样按口径变更全仓移除。 -->
      <view wx:if="{{v.orderCount}}" class="dv-crossday">该日有 {{v.orderCount}} 单历史单据,见下方日结</view>
    </view>
    <view wx:elif="{{dv && !dv.cols.length}}" class="empty">本日无在岗技师</view>
    <block wx:elif="{{dv}}">
      <view class="dv-grid">
        <view class="dv-left">
          <view class="dv-corner"></view>
          <view class="dv-gutter" style="height:{{dv.gridH}}rpx">
            <view wx:for="{{dv.hours}}" wx:key="label" class="dv-hr {{item.off ? 'off' : ''}}">{{item.label}}</view>
          </view>
        </view>
        <scroll-view scroll-x class="dv-right" show-scrollbar="{{false}}">
          <view class="dv-rin" style="width:{{dv.colW*dv.cols.length}}rpx">
            <view class="dv-heads">
              <view wx:for="{{dv.cols}}" wx:key="id" class="dv-th {{item.id===myTechId?'mine':''}}" style="width:{{dv.colW}}rpx">
                <view class="dv-nm">{{item.name}}<text wx:if="{{item.id===myTechId}}" class="dv-me">我</text></view>
                <view class="dv-rl">{{item.role}}</view>
                <view class="dv-st {{item.busy?'busy':'free'}}">{{item.busy?'忙':'空'}}</view>
              </view>
            </view>
            <view class="dv-cols" style="height:{{dv.gridH}}rpx">
              <view wx:for="{{dv.cols}}" wx:key="id" wx:for-item="col" class="dv-col {{col.id===myTechId?'mine':''}}" style="width:{{dv.colW}}rpx">
                <view wx:for="{{dv.hours}}" wx:key="label" wx:for-item="hl" class="dv-line {{hl.off ? 'off' : ''}}"></view>
                <view wx:for="{{col.frees}}" wx:key="startTime" wx:for-item="f" class="dv-blk free" style="top:{{f.top}}rpx;height:{{f.height}}rpx" data-tech="{{col.id}}" data-time="{{f.startTime}}" bindtap="tapFree"><text>+ 直接排单</text></view>
                <view wx:for="{{col.blocks}}" wx:key="id" wx:for-item="b" class="dv-blk {{b.cls}}" style="top:{{b.top}}rpx;height:{{b.height}}rpx" data-id="{{b.id}}" bindtap="tapBlock">
                  <view class="dv-bt"><text wx:if="{{b.stateGlyph}}" class="dv-sdot {{b.state}}">{{b.stateGlyph}}</text>{{b.startTime}}–{{b.endTime}}</view>
                  <view class="dv-bn">{{b.customerName}}</view>
                  <view class="dv-bs">{{b.serviceName}}</view>
                  <text wx:if="{{b.ownerDirect}}" class="dv-tag owner">老板排</text>
                  <text wx:elif="{{b.isDesignated}}" class="dv-tag zhi">指定</text>
                  <text wx:elif="{{b.isNewCustomer}}" class="dv-tag xin">新客</text>
                  <text wx:if="{{b.depositUnpaid}}" class="dv-unpaid">未付定金</text>
                </view>
              </view>
            </view>
          </view>
        </scroll-view>
      </view>
      <view class="dv-legend top">
        <text class="dv-legend-hd">图例 · 平时不用看</text>
        <text><text class="lg hand"></text>手部美甲</text>
        <text><text class="lg foot"></text>足部美甲</text>
        <text><text class="lg lash"></text>美睫</text>
        <text><text class="lg care"></text>护理</text>
        <text><text class="lg free"></text>空档·点排</text>
      </view>
      <view class="dv-legend">
        <text>淡色=未到 · <text class="dv-sdot active">●</text>进行中 · <text class="dv-sdot done">✓</text>完成 · <text class="lg settled"></text>已结算 · 点空档=直接排单</text>
      </view>
    </block>

    <!-- ===== 屏 1 下半:日结板块(与「财务→日结」同一份实现,仅老板可见) ===== -->
    <block wx:if="{{isOwner && v}}">
      <view class="dcwrap" id="dcBlock">
        <view class="dch"><text class="dct">日结 · {{v.date}}</text>
          <text wx:if="{{v.confirmed}}" class="dcok">已确认{{v.reopenCount ? ' · 重开过 ' + v.reopenCount + ' 次' : ''}}<text class="lnk" bindtap="reopen">重开</text></text>
        </view>

        <block wx:if="{{!correcting}}">
          <view class="dcsub" wx:if="{{v.pending.length}}">待分配 {{v.pending.length}} 单 · 逐单点开</view>
          <view class="card" wx:for="{{v.pending}}" wx:for-item="p" wx:key="id">
            <view class="ah" data-id="{{p.id}}" bindtap="toggleOpen">
              <text class="code"><text class="tm">{{p.timeText}}</text>{{p.who}} · {{p.techLabel}}<text wx:if="{{p.crossDayNote}}" class="xday">{{p.crossDayNote}}</text></text>
              <text class="amt">{{p.total}}<text wx:if="{{p.couponNote}}" class="arr"> {{p.couponNote}}</text> <text class="arr">{{open[p.id] ? '收起 ∧' : '点开分配 ∨'}}</text></text>
            </view>
            <!-- D59 案二提示句:含未归属充值的待分配单,行上明说(句后端唯一) -->
            <view wx:if="{{p.rechargeNote}}" class="dcsub" style="color:#8a3a33">{{p.rechargeNote}}</view>
            <block wx:if="{{open[p.id]}}">
              <view class="aline" wx:for="{{p.techs}}" wx:for-item="t" wx:key="id">
                <text class="nm">{{t.name}}</text>
                <text class="wn">{{t.role}} · {{t.nos}}</text>
                <input class="pct" type="number" value="{{shares[p.id + '|' + t.id]}}" data-sid="{{p.id}}" data-tid="{{t.id}}" bindinput="onShare" />
                <text class="pcts">%</text>
              </view>
              <view class="links">
                <text wx:if="{{p.hasSnapshot}}" class="lnk" data-code="{{p.code}}" bindtap="viewSnapshot">查看签署单</text>
                <text class="lnk" data-code="{{p.code}}" bindtap="startCorrect">金额有误?发起更正</text>
                <view class="savebtn" data-id="{{p.id}}" bindtap="saveAlloc">保存分配</view>
              </view>
            </block>
          </view>


          <view class="dcsub" wx:if="{{v.awaiting.length}}">无需分配 · 待确认 {{v.awaiting.length}} 单</view>
          <view class="card awaitcard" wx:for="{{v.awaiting}}" wx:for-item="a" wx:key="id">
            <view class="ah">
              <text class="code"><text class="tm">{{a.timeText}}</text>{{a.who}} · {{a.techs}}<text wx:if="{{a.crossDayNote}}" class="xday">{{a.crossDayNote}}</text></text>
              <text class="amt">{{a.amount}} <text class="arr">{{a.reason}}</text></text>
            </view>
            <view class="links">
              <text wx:if="{{a.hasSnapshot}}" class="lnk" data-code="{{a.code}}" bindtap="viewSnapshot">查看签署单</text>
              <text class="lnk" data-code="{{a.code}}" bindtap="startCorrect">金额有误?发起更正</text>
            </view>
          </view>
          <view class="card">
            <view class="th"><text class="c1">技师</text><text class="c2">单数</text><text class="c3">业绩</text><text class="c3">卡耗</text><text class="c3">冲卡</text><text class="c4">目标</text></view>
            <view class="tr" wx:for="{{v.techs}}" wx:key="name">
              <text class="c1 nm">{{item.name}}</text>
              <text class="c2">{{item.orderCount}}</text>
              <text class="c3">{{item.perf}}</text>
              <text class="c3">{{item.card}}</text>
              <text class="c3">{{item.recharge}}</text>
              <text class="c4 {{item.hit ? 'ok' : ''}}">{{item.target}}</text>
            </view>
          </view>

          <view class="card anom">
            <view>价档异常 <text class="badge {{v.tierChanges.length ? 'warn' : ''}}">{{v.tierChanges.length}}</text>
              <text class="sub" wx:for="{{v.tierChanges}}" wx:key="*this">{{item}}</text>
            </view>
            <view>免卸甲/免卸睫 <text class="badge">{{v.freeRemoval}} 笔</text></view>
          </view>

          <!-- D57/D58:未签单=可点行(点开出码重推),不再锁确认钮 -->
          <view class="card deduct-card" wx:if="{{v.unsigned.length}}">
            <view class="deduct-title">未签署 {{v.unsigned.length}} 单(不计入本日账,点行出码重推)</view>
            <view class="deduct-row tap" wx:for="{{v.unsigned}}" wx:key="id" data-id="{{item.id}}" bindtap="goUnsigned">
              <text>{{item.label}}</text><text class="lnk">出码 ›</text>
            </view>
          </view>
          <view class="warn" wx:for="{{v.blockers}}" wx:key="*this">{{item}}</view>
          <view wx:if="{{!v.confirmed}}" class="cta {{v.canConfirm ? '' : 'dis'}}" bindtap="{{v.canConfirm ? 'confirmClose' : ''}}">
            {{v.canConfirm ? '确认日结' : '确认日结(' + v.blockers.length + ' 项待办)'}}
          </view>
        </block>

        <!-- 屏 1b 金额更正 -->
        <block wx:else>
          <view class="ch">金额更正 · {{correcting.code}}<text class="lnk back" bindtap="cancelCorrect">返回日结</text></view>
          <view class="ro">
            <view class="rot"><text>顾客已签存档单(只读)</text><text class="lock">不可修改</text></view>
            <view class="rol">{{correcting.who}}{{correcting.proxy ? '(代付)' : ''}} · {{correcting.signedAt}} · {{correcting.techs}}</view>
            <view class="rol" wx:for="{{correcting.items}}" wx:key="*this">{{item}}</view>
            <view class="rol"><text wx:if="{{correcting.deposit}}">定金抵扣 {{correcting.deposit}} · </text><text class="b">合计 {{correcting.total}}</text></view>
          </view>
          <view class="card">
            <view class="fh">更正内容</view>
            <view class="fd"><text class="lab">更正后合计</text><input class="in" type="digit" value="{{newTotal}}" bindinput="onNewTotal" /></view>
            <textarea class="ta" placeholder="原因(必填):例「实际只补了 1 指,技师勾多了」" value="{{reason}}" bindinput="onReason"></textarea>
            <view class="note">提交后:① 原签署单保持原样,顾客服务记录追加一条更正记录 ② 用卡付过的单,储值差额由系统自动补配 ③ 更正进当日日结留痕</view>
            <view class="cta" bindtap="submitCorrect">提交更正</view>
          </view>
        </block>
      </view>
    </block>
  </block>

  <!-- ===== 全部订单 ===== -->
  <block wx:if="{{mode==='all'}}">
    <scroll-view scroll-x class="filters">
      <view wx:for="{{filters}}" wx:key="*this" class="fchip {{filter===item?'on':''}}" data-f="{{item}}" bindtap="setFilter">{{filterLabels[item]}}</view>
    </scroll-view>
    <view wx:if="{{!groups.length}}" class="empty">暂无订单</view>
    <view class="ogroup" wx:for="{{groups}}" wx:key="date">
      <view class="oghead">{{item.title}}</view>
      <view class="orow" wx:for="{{item.items}}" wx:for-item="it" wx:key="id" data-id="{{it.id}}" data-status="{{it.status}}" data-userid="{{it.userId}}" data-customer="{{it.customer}}" data-service="{{it.serviceName}}" data-serviceid="{{it.serviceId}}" data-tech="{{it.tech}}" bindtap="orderActions">
        <view class="otime">{{it.time}}</view>
        <view class="omain"><view class="oname">{{it.customer}}<text class="ostatus {{it.statusCls}}">{{it.statusLabel}}</text><text wx:if="{{it.ddBadge}}" class="ostatus {{it.ddCls}}">{{it.ddBadge}}</text></view><view class="oline">{{it.line}}{{it.tech ? ' · ' + it.tech : ''}}</view></view>
        <text class="ochev">›</text>
      </view>
    </view>
  </block>

  <!-- ===== 售后订单 ===== -->
  <block wx:if="{{mode==='aftersales'}}">
    <view wx:if="{{!aftersalesList.length}}" class="empty">暂无售后订单</view>
    <!-- 🔴 D12 修复:这一行原来**没有 bindtap**,所以员工点它没有任何反应(店主报的"点不进去")。
         现在可进入可看:原因 + 处理情况**只读**。写入/完成态等 Cowork 出图,这里不做。 -->
    <view class="orow" wx:for="{{aftersalesList}}" wx:key="id" data-id="{{item.id}}" bindtap="openAfterSales">
      <view class="otime">{{item.time}}</view>
      <view class="omain"><view class="oname">{{item.customer}}<text class="ostatus d">{{item.asStatusText || '售后'}}</text></view><view class="oline">{{item.line}}{{item.tech ? ' · ' + item.tech : ''}} · {{item.date}}</view></view>
      <text class="ochev">›</text>
    </view>
  </block>

  <!-- ===== 售后详情(图 B-1 写入版:D12 只读版 + 写入按钮)===== -->
  <view wx:if="{{asPanel}}" class="mask" bindtap="closeAfterSales"></view>
  <view wx:if="{{asPanel}}" class="dsheet">
    <view class="ds-head">
      <view class="ds-t">售后 · {{asPanel.customer}} <text class="as-badge as-{{asPanel.status}}">{{asPanel.statusText}}</text></view>
      <view class="ds-x" bindtap="closeAfterSales">✕</view>
    </view>
    <scroll-view scroll-y class="ds-body">
      <view class="ds-k">订单</view>
      <view class="as-line">{{asPanel.line}}{{asPanel.tech ? ' · ' + asPanel.tech : ''}} · {{asPanel.date}} {{asPanel.time}}</view>

      <view class="ds-k">售后原因</view>
      <view wx:if="{{asPanel.reason}}" class="as-line">{{asPanel.reason}}</view>
      <view wx:else class="as-empty">转售后时没有留原因</view>

      <!-- B④ 时间线:append-only,每条带时间+操作人 -->
      <view class="ds-k">处理时间线</view>
      <view wx:if="{{asPanel.timeline.length}}" class="as-steps">
        <view wx:for="{{asPanel.timeline}}" wx:key="index" class="as-step on">
          <text class="as-dot">●</text>
          <text class="as-lab">{{item.actor ? item.actor + ':' : ''}}{{item.text}}</text>
          <text class="as-at">{{item.at}}</text>
        </view>
      </view>
      <view wx:else class="as-empty">还没有处理记录</view>
      <view wx:if="{{asPanel.resultText}}" class="as-line as-result">处理结果:{{asPanel.resultText}}</view>
      <view wx:if="{{asPanel.footnote}}" class="ds-hint">{{asPanel.footnote}}</view>
      <view class="ds-warn">涉及退款/差额一律走「发起更正」,售后单只关联不动钱(图 B②)</view>
    </scroll-view>
    <!-- B① 权限:写进展/标已解决=当单技师+老板;关闭=仅老板;终态后按钮整体消失 -->
    <view wx:if="{{asPanel.canWrite || asPanel.canClose}}" class="as-actions">
      <view wx:if="{{asPanel.canWrite}}" class="as-btn pri" bindtap="asWriteProgress">写进展</view>
      <view wx:if="{{asPanel.canWrite}}" class="as-btn" bindtap="asResolve">标记已解决</view>
      <view wx:if="{{asPanel.canClose}}" class="as-btn ghost" bindtap="asClose">关闭</view>
    </view>
  </view>

  <!-- ===== 爽约定金处置弹层(图 A-2,仅老板可见入口)===== -->
  <view wx:if="{{dispPanel}}" class="mask" bindtap="closeDisposal"></view>
  <view wx:if="{{dispPanel}}" class="dsheet">
    <view class="ds-head">
      <view class="ds-t">处置爽约定金 · {{dispPanel.amountText}}</view>
      <view class="ds-x" bindtap="closeDisposal">✕</view>
    </view>
    <scroll-view scroll-y class="ds-body">
      <view class="as-line">{{dispPanel.customer}} · 已爽约{{dispPanel.receiptText ? ' · ' + dispPanel.receiptText : ''}}</view>
      <!-- 图 A-2:二选一必选其一才能确认;默认①留存 -->
      <view class="dp-opt {{dispPanel.action === 'retain' ? 'on' : ''}}" data-a="retain" bindtap="dispPick">
        <view class="dp-t">① 留存到客户档案</view>
        <view class="dp-d">{{dispPanel.amountText}} 记入该顾客的定金留存,下次预约自动带出可用</view>
      </view>
      <view class="dp-opt {{dispPanel.action === 'forfeit' ? 'on' : ''}}" data-a="forfeit" bindtap="dispPick">
        <view class="dp-t">② 没收入账</view>
        <view class="dp-d">{{dispPanel.amountText}} 全额计入当期收入(独立「定金收入·爽约没收」行,不进业绩)</view>
      </view>
      <input class="ds-inp" placeholder="备注(选填),如:顾客临时有事,留存下次用" value="{{dispPanel.note}}" bindinput="onDispNote" />
      <view class="ds-hint">经手人=当前登录老板,自动记;误处置可撤销(留痕冲销,不删历史)</view>
    </scroll-view>
    <view class="ds-confirm" bindtap="submitDisposal">确认处置</view>
  </view>

  <!-- 直接排单弹窗 -->
  <view wx:if="{{directSheet}}" class="mask" bindtap="closeDirect"></view>
  <view wx:if="{{directSheet}}" class="dsheet">
    <view class="ds-head">
      <view class="ds-t">现场排单 · {{directTechName}}</view>
      <view class="ds-x" bindtap="closeDirect">✕</view>
    </view>
    <scroll-view scroll-y class="ds-body">
      <!-- 屏 S1 顾客区 · D9 根治(图 v1.1,店主已确认):「新客·输手机号」页签**整体删除**——
           它与「找人」逻辑同源(搜索无匹配→建轻档案→签署码/会员码绑定),两个页签做同一件事,
           多出来的框=多出来的故障面(手机号 undefined 一案的案发现场就是它)。
           合并为:一框受控即搜 + 无匹配一键建档(不弹确认) + 扫会员码原样。 -->
      <view class="ds-k">顾客 <text class="ds-ksub">老顾客扫会员码直接带出</text><text class="ds-scan ds-scan-r" bindtap="scanMemberCode">扫会员码</text></view>
      <input class="ds-inp" placeholder="姓名或手机号，输入即搜；新客直接输" value="{{custQuery}}" bindinput="onCustSearch" />
      <view wx:if="{{selectedCustName}}" class="ds-picked">已选:{{selectedCustName}} <text class="ds-clear" bindtap="clearCust">✕</text></view>
      <view wx:if="{{custMatches.length}}" class="ds-matches">
        <view wx:for="{{custMatches}}" wx:key="id" class="ds-match" data-id="{{item.id}}" bindtap="pickCust">
          <text class="ds-mn">{{item.name}}</text><text class="ds-mp">{{item.phoneMasked}}{{item.phoneMasked && item.visits ? ' · ' : ''}}{{item.visits ? '到店' + item.visits + '次' : ''}}</text>
        </view>
      </view>
      <!-- 规则①②:无论有没有命中,只要还没选人,都给一条「＋建档并排单」——
           点了直接选中(一步到位,店主拍板不弹确认;建错在档案改名即可)。
           ≥7 位纯数字存手机号(姓名记「未命名」),否则存姓名;空输入=「未命名顾客」。 -->
      <view wx:if="{{!selectedCustId && !selectedCustName}}" class="ds-newrow" bindtap="pickNewCust">
        <text>{{custQuery ? '没找到?为「' + custQuery + '」新建轻档案' : '不留名?新建「未命名顾客」轻档案'}}</text>
        <text class="ds-newbtn">＋建档并排单</text>
      </view>
      <view class="ds-warn">不填手机号也能建单;身份绑定不依赖手机号(靠签署码/会员码),手机号只用于找档案和联系</view>

      <view class="ds-k">时段 · 开始时间</view>
      <view class="ds-timerow">
        <view class="ds-now" bindtap="dsNow">现在开始</view>
        <picker class="ds-pick" mode="time" value="{{directTime}}" bindchange="onDirectTime"><view class="ds-time">{{directTime}} <text class="ds-cal">选时段 ›</text></view></picker>
      </view>
      <view class="ds-durrow">
        <view class="ds-durbtn" bindtap="durMinus">−30分</view>
        <view class="ds-durval">占用 {{directDurH}} 小时<text class="ds-durend" wx:if="{{directEndTime}}"> · 到 {{directEndTime}}</text></view>
        <view class="ds-durbtn" bindtap="durPlus">＋30分</view>
        <view class="ds-durstd" bindtap="durReset">标准</view>
      </view>
      <view class="ds-endhint">默认按所选服务时长;这次要多做/少做点上面调</view>

      <view class="ds-k">服务 <text class="ds-ksub">与结算单同一份目录,先选大类再选项目</text></view>
      <scroll-view scroll-x class="ds-svcs ds-cats"><view wx:for="{{directCats}}" wx:key="id" class="ds-c {{directCatId===item.id?'on':''}}" data-id="{{item.id}}" bindtap="pickDirectCat">{{item.name}}</view></scroll-view>
      <scroll-view scroll-x class="ds-svcs"><view wx:for="{{directServices}}" wx:key="id" class="ds-c {{directServiceId===item.id?'on':''}}" data-id="{{item.id}}" bindtap="pickDirectSvc">{{item.name}}</view></scroll-view>

      <block wx:if="{{depositCfg.enabled}}">
        <view class="ds-k">定金 <text class="ds-ksub">按店配 {{depositCfg.amountText}} · 可选</text></view>
        <view class="ds-toggle">
          <view class="ds-opt {{directDeposit?'on':''}}" data-v="paid" bindtap="setDeposit">已收定金 {{depositCfg.amountText}}</view>
          <view class="ds-opt {{!directDeposit?'on':''}}" data-v="unpaid" bindtap="setDeposit">未收</view>
        </view>
        <view class="ds-hint">选「已收」=走「标记已收定金」同一动作(记经手人、入定金预收);现场即时单通常不收</view>
      </block>
    </scroll-view>
    <view class="ds-confirm" bindtap="submitDirect">建单，进入今日台面</view>
  </view>

  <merchant-tabbar wx:if="{{!directSheet}}" active="orders"></merchant-tabbar>

  <!-- 屏 0 操作面板:顶部订单摘要 + 按钮 + 关闭(图上就是这张卡,不是系统列表) -->
  <view wx:if="{{actPanel}}" class="actmask" bindtap="closeActPanel"></view>
  <view wx:if="{{actPanel}}" class="actpanel">
    <view class="actt">{{actPanel.title}}</view>
    <view class="actb" wx:for="{{actPanel.opts}}" wx:for-item="o" wx:key="i" data-i="{{o.i}}" bindtap="tapAct">{{o.label}}</view>
    <view class="actclose" bindtap="closeActPanel">关闭</view>
  </view>
</view>

<sheet-preview sheet-id="{{previewSheet}}" bind:close="closePreview" />
