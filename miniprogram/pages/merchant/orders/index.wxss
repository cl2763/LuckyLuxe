.empty{text-align:center;color:#9a8c7c;font-size:25rpx;padding:80rpx 0}
/* ===== 技师维度日视图 ===== */
.dv-datebar{display:flex;align-items:center;gap:14rpx;padding:8rpx 24rpx}
.dv-nav{width:44rpx;height:44rpx;border-radius:50%;background:#fff;border:1rpx solid #eadfd7;display:flex;align-items:center;justify-content:center;color:#8a7f78;font-size:26rpx}
.dv-date{font-size:28rpx;font-weight:800;color:#5c4630}
.dv-today{margin-left:auto;font-size:22rpx;color:#c8a47e;border:1rpx solid #c8a47e;border-radius:999rpx;padding:5rpx 18rpx}
.dv-summary{display:flex;align-items:center;gap:12rpx;padding:6rpx 24rpx 12rpx}
.dv-pill{font-size:22rpx;color:#5c4630;background:#fff;border:1rpx solid #eadfd7;border-radius:12rpx;padding:6rpx 14rpx}
