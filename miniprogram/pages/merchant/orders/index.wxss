page{background:var(--paper)}
.page{padding:16rpx 0 160rpx}
.seg{display:flex;background:var(--card);border:1rpx solid var(--line);border-radius:999rpx;padding:4rpx;margin:8rpx 24rpx 12rpx}
.seg-i{flex:1;text-align:center;font-size:24rpx;padding:10rpx 0;border-radius:999rpx;color:var(--sub)}
.seg-i.on{background:var(--hero);color:var(--heroink);font-weight:700}
.empty{text-align:center;color:var(--sub);font-size:25rpx;padding:80rpx 0}
/* ===== 技师维度日视图 ===== */
.dv-datebar{display:flex;align-items:center;gap:14rpx;padding:8rpx 24rpx}
.dv-nav{width:44rpx;height:44rpx;border-radius:50%;background:var(--card);border:1rpx solid var(--line);display:flex;align-items:center;justify-content:center;color:var(--sub);font-size:26rpx}
.dv-date{font-size:28rpx;font-weight:800;color:var(--ink)}
.dv-today{margin-left:auto;font-size:22rpx;color:var(--brandd);border:1rpx solid var(--brand);border-radius:999rpx;padding:5rpx 18rpx}
.dv-summary{display:flex;align-items:center;gap:12rpx;padding:6rpx 24rpx 12rpx}.dv-pill {font-size:22rpx;color:var(--ink);background:var(--card);border:1rpx solid var(--line);border-radius:999rpx;padding:6rpx 14rpx}
.dv-pill .b{color:var(--ink);font-weight:800}
.dv-pill.live{background:var(--goodbg);border-color:var(--line)}
.dv-pill.live .b{color:var(--good)}
.dv-share{margin-left:auto;font-size:22rpx;color:var(--brandd);font-weight:700}
.dv-closed{margin:20rpx 24rpx;padding:40rpx;text-align:center;color:var(--sub);font-size:26rpx;background:var(--card);border-radius:16rpx}

.dv-grid{display:flex;margin:0 16rpx;background:var(--card);border:1rpx solid var(--line);border-radius:20rpx;overflow:hidden}
.dv-left{flex:none;width:64rpx;border-right:1rpx solid var(--line);background:var(--paper)}
.dv-corner{height:104rpx;border-bottom:1rpx solid var(--line)}
.dv-gutter{position:relative}
.dv-hr{height:120rpx;font-size:19rpx;color:var(--sub);text-align:center;padding-top:4rpx;box-sizing:border-box}
.dv-right{flex:1;min-width:0}
.dv-rin{position:relative}
.dv-heads{display:flex;height:104rpx;background:var(--paper);border-bottom:1rpx solid var(--line)}
.dv-th{flex:none;text-align:center;padding:10rpx 4rpx;border-right:1rpx solid var(--line);box-sizing:border-box;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2rpx;overflow:hidden}
.dv-nm{font-size:24rpx;font-weight:800;color:var(--ink)}
.dv-rl{font-size:17rpx;color:var(--sub);margin-top:1rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.dv-st{font-size:17rpx;margin-top:3rpx;display:inline-block;padding:1rpx 12rpx;border-radius:999rpx;background:var(--wall);color:var(--brandd)}
.dv-st.free{background:var(--goodbg);color:var(--good)}
.dv-cols{display:flex;position:relative}
.dv-col{flex:none;border-right:1rpx solid var(--line);position:relative;box-sizing:border-box}
.dv-th.mine{background:var(--wall);border-bottom:3rpx solid var(--brand)}
.dv-col.mine{background:rgba(200,164,126,.10)}
.dv-me{display:inline-block;margin-left:6rpx;font-size:16rpx;background:var(--brand);color:var(--hero);border-radius:999rpx;padding:0 8rpx;vertical-align:middle}
.dv-line{height:120rpx;border-bottom:1rpx dashed var(--line);box-sizing:border-box}
.dv-blk{position:absolute;left:6rpx;right:6rpx;border-radius:12rpx;padding:7rpx 9rpx;overflow:hidden;box-shadow:0 1rpx 4rpx rgba(92,70,48,.12);box-sizing:border-box}
.dv-bt{font-size:17rpx;opacity:.72;font-weight:600}
.dv-bn{font-size:22rpx;font-weight:800;margin-top:2rpx}
.dv-bs{font-size:18rpx;margin-top:1rpx;opacity:.85}
.dv-tag{position:absolute;top:6rpx;right:6rpx;font-size:16rpx;border-radius:6rpx;padding:1rpx 7rpx;font-weight:700;color:var(--heroink)}
.dv-tag.zhi{background:var(--hero)}
.dv-tag.xin{background:var(--brand);color:var(--hero)}
/* ===== 色相=服务类型 × 状态=到店进度 ===== */
/* 未到店(默认):淡色 + 虚线边 */
.dv-blk.hand{background:var(--wall);color:var(--brandd);border:1rpx dashed rgba(122,90,46,.3)}
.dv-blk.foot{background:var(--wall);color:var(--brandd);border:1rpx dashed rgba(138,80,48,.32)}
.dv-blk.lash{background:var(--wall);color:var(--tagw);border:1rpx dashed rgba(91,67,112,.28)}
.dv-blk.care{background:var(--goodbg);color:var(--good);border:1rpx dashed rgba(63,107,82,.28)}
/* 到店·进行中:满色点亮 + 绿框 + 左绿条 */
.dv-blk.active{border:none;box-shadow:0 0 0 3rpx rgba(31,122,77,.5),0 3rpx 10rpx rgba(92,70,48,.16);padding-left:16rpx}
.dv-blk.active::before{content:'';position:absolute;left:0;top:0;bottom:0;width:8rpx;background:var(--good);border-radius:12rpx 0 0 12rpx}
.dv-blk.hand.active{background:var(--wall);color:var(--ink)}
.dv-blk.foot.active{background:var(--wall);color:var(--brandd)}
.dv-blk.lash.active{background:var(--wall);color:var(--ink)}
/* J-54:语义=「进行中 / 选中」。不跟品类色走(那是身份),走「正常/进行」那一对。
   ⚠️ 注释里**不写色值** —— wxss 写死色那把尺子连注释一起数,写一个 hex 棘轮就涨一个(现测踩过)。
   换前只有 4.45(差 0.05 不到 AA);换 --good/--goodbg 后 浅 4.68 / 深 7.79,数在 07d 回执 §三 */
.dv-blk.care.active{background:var(--goodbg);color:var(--good)}
/* 已完成:灰掉 + 勾 */
.dv-blk.done{background:var(--wall) !important;color:var(--sub) !important;border:1rpx solid var(--line)}
/* 时间行到店小标 */
.dv-sdot{display:inline-block;margin-right:4rpx;font-size:16rpx}
.dv-sdot.active{color:var(--good);font-weight:800}
.dv-sdot.done{color:var(--sub)}
.dv-blk.free{background:repeating-linear-gradient(45deg,var(--wall),var(--wall) 10rpx,var(--wall) 10rpx,var(--wall) 20rpx);border:1rpx dashed var(--line);box-shadow:none;display:flex;align-items:center;justify-content:center}
.dv-blk.free text{font-size:19rpx;color:var(--brandd)}
.dv-legend{display:flex;flex-wrap:wrap;gap:16rpx;justify-content:center;padding:12rpx 24rpx 0;font-size:18rpx;color:var(--sub)}
.dv-legend.top{margin-top:48rpx;padding-top:20rpx;border-top:1rpx dashed var(--line)}
.dv-legend-hd{width:100%;text-align:center;font-size:17rpx;color:var(--sub);margin-bottom:2rpx}
.dv-legend .lg{display:inline-block;width:18rpx;height:18rpx;border-radius:4rpx;vertical-align:-2rpx;margin-right:5rpx}
.dv-legend .lg.hand{background:var(--wall)}
.dv-legend .lg.foot{background:var(--wall)}
.dv-legend .lg.lash{background:var(--wall)}
.dv-legend .lg.care{background:var(--goodbg)}
.dv-legend .lg.free{background:var(--wall);border:1rpx dashed var(--line)}
.dv-tag.owner{background:var(--tagwbg);color:var(--tagw)}
/* J-54:语义=「提示 / 信息」(不是「新客」那个身份)。接合同图里现成的蓝那一对。
   换前 5.30 且无深色档;换 --tagw/--tagwbg 后 浅 7.20 / 深 7.05(同上:注释里不写色值) */
.dv-tag.as-blue{background:var(--tagwbg);color:var(--tagw)} /* 裁C:售后单蓝徽标 */
.dv-unpaid{position:absolute;left:14rpx;bottom:6rpx;font-size:15rpx;background:var(--badbg);color:var(--bad);border-radius:5rpx;padding:1rpx 8rpx;font-weight:700}
.dv-blk.active .dv-unpaid{left:20rpx}
/* 列表 */
.filters{white-space:nowrap;padding:4rpx 24rpx 10rpx}
.fchip{display:inline-block;font-size:24rpx;padding:8rpx 22rpx;border-radius:999rpx;background:var(--card);border:1rpx solid var(--line);color:var(--ink);margin-right:12rpx}
.fchip.on{background:var(--hero);color:var(--heroink);font-weight:700}
.ogroup{margin:0 24rpx}
.oghead{font-size:22rpx;color:var(--sub);margin:14rpx 0 6rpx}
.orow{display:flex;align-items:center;gap:12rpx;background:var(--card);border-radius:14rpx;padding:14rpx 16rpx;margin:0 24rpx 10rpx;box-shadow:0 2rpx 8rpx rgba(92,70,48,.05)}
.ogroup .orow{margin:0 0 10rpx}
.otime{font-size:24rpx;font-weight:800;color:var(--ink);width:80rpx;flex:none}
.omain{flex:1;min-width:0}
.oname{font-size:27rpx;font-weight:800;color:var(--ink);display:flex;align-items:center;gap:8rpx}
.ostatus{font-size:18rpx;padding:2rpx 10rpx;border-radius:999rpx;font-weight:700}
.ostatus.g{background:var(--goodbg);color:var(--good)}.ostatus.s{background:var(--wall);color:var(--tagw)}.ostatus.n{background:var(--wall);color:var(--sub)}.ostatus.d{background:var(--wall);color:var(--brandd)}
.oline{font-size:22rpx;color:var(--sub);margin-top:3rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ochev{color:var(--sub);font-size:30rpx}
/* 直接排单弹窗 */
.mask{position:fixed;inset:0;background:rgba(45,40,38,.4);z-index:20}
.dsheet{position:fixed;left:0;right:0;bottom:0;background:var(--card);border-radius:24rpx 24rpx 0 0;padding:20rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));z-index:2000;box-shadow:0 -8rpx 30rpx rgba(92,70,48,.2);display:flex;flex-direction:column;max-height:82vh}
.ds-head{display:flex;align-items:center;justify-content:space-between;padding-bottom:10rpx}
.ds-t{font-size:30rpx;font-weight:800;color:var(--ink)}
.ds-x{font-size:32rpx;color:var(--sub);padding:0 8rpx}
.ds-body{flex:1;overflow-y:auto}
.ds-s{font-size:22rpx;color:var(--sub);margin:2rpx 0 14rpx}
.ds-k{font-size:22rpx;color:var(--sub);margin:14rpx 0 6rpx}
.ds-inp{background:var(--paper);border:1rpx solid var(--line);border-radius:12rpx;padding:0 18rpx;height:88rpx;line-height:88rpx;font-size:28rpx;box-sizing:border-box;width:100%}
.ds-picked{margin-top:8rpx;font-size:24rpx;color:var(--ink);font-weight:700}
.ds-clear{color:var(--bad);margin-left:8rpx}
.ds-matches{margin-top:8rpx;border:1rpx solid var(--line);border-radius:12rpx;overflow:hidden}
.ds-match{display:flex;align-items:center;justify-content:space-between;padding:16rpx 18rpx;border-bottom:1rpx solid var(--line)}
.ds-match:last-child{border-bottom:none}
.ds-mn{font-size:27rpx;color:var(--ink);font-weight:600}
.ds-mp{font-size:22rpx;color:var(--sub)}
/* D9 根治:.ds-newhint 已被 .ds-newrow 取代 */
.ds-time{background:#fbf8f5;border:1rpx solid var(--line);border-radius:12rpx;padding:16rpx 18rpx;font-size:28rpx;color:var(--ink);display:flex;justify-content:space-between}
.ds-cal{color:var(--brandd)}
.ds-endhint{margin-top:8rpx;font-size:22rpx;color:var(--sub)}
.ds-endhint .b{color:var(--ink);font-weight:700}
.ds-durrow{display:flex;align-items:center;gap:12rpx;margin-top:12rpx}
.ds-durbtn{flex:none;font-size:24rpx;font-weight:700;color:var(--ink);background:var(--paper);border:1rpx solid var(--line);border-radius:999rpx;padding:10rpx 24rpx}
.ds-durval{flex:1;text-align:center;font-size:25rpx;font-weight:700;color:var(--ink)}
.ds-durend{color:var(--brandd);font-weight:600}
.ds-durstd{flex:none;font-size:22rpx;color:var(--brandd);font-weight:700;padding:10rpx 8rpx}
.ds-svcs{white-space:nowrap}
.ds-c{display:inline-block;font-size:24rpx;padding:8rpx 20rpx;border-radius:999rpx;background:var(--paper);border:1rpx solid var(--line);color:var(--ink);margin-right:12rpx}
.ds-c.on{background:var(--brand);color:var(--hero);border-color:var(--brand);font-weight:700}
.ds-toggle{display:flex;background:var(--paper);border:1rpx solid var(--line);border-radius:12rpx;padding:4rpx}
.ds-opt{flex:1;text-align:center;font-size:25rpx;padding:14rpx 0;border-radius:10rpx;color:var(--sub)}
.ds-opt.on{background:var(--hero);color:var(--heroink);font-weight:700}
.ds-opt.on.warn{background:var(--badbg);color:var(--bad)}.ds-confirm {margin-top:16rpx;background:var(--hero);color:var(--heroink);text-align:center;padding:26rpx;border-radius:999rpx;font-size:30rpx;font-weight:700}
.ds-hint{font-size:20rpx;color:var(--sub);text-align:center;margin-top:10rpx}
.pg{padding:16rpx 24rpx 60rpx;background:var(--paper);min-height:100vh}
.datebar{display:flex;align-items:center;gap:14rpx;padding:8rpx 0 16rpx}
.datebar .nav{width:52rpx;height:52rpx;border-radius:50%;background:var(--wall);color:var(--ink);font-size:28rpx;display:flex;align-items:center;justify-content:center;flex:0 0 auto}
.datebar .d{font-size:32rpx;font-weight:800;color:var(--ink)}
.datebar .today{margin-left:auto;font-size:23rpx;color:var(--brandd);border:1rpx solid var(--line);border-radius:999rpx;padding:8rpx 22rpx}
.empty{padding:80rpx 0;text-align:center;color:var(--sub);font-size:26rpx}
.okbar{background:var(--goodbg);border:1rpx solid var(--line);color:var(--good);border-radius:12rpx;padding:14rpx 16rpx;font-size:23rpx;margin-bottom:14rpx}
.pills{display:flex;gap:12rpx;flex-wrap:wrap;margin-bottom:14rpx}
.pill{font-size:23rpx;background:var(--card);border:1rpx solid var(--line);border-radius:999rpx;padding:8rpx 20rpx;color:var(--ink)}
.pill.hot{background:var(--badbg);border-color:var(--line);color:var(--bad)}
.pill .b{font-weight:800;color:var(--ink)}
.card{background:var(--card);border-radius:18rpx;padding:24rpx 22rpx;margin-bottom:18rpx;box-shadow:0 3rpx 10rpx rgba(92,70,48,.06)}
.ah{display:flex;justify-content:space-between;align-items:center;font-size:25rpx;font-weight:700;color:var(--ink)}
.ah .arr{font-size:21rpx;color:var(--sub);font-weight:400;margin-left:8rpx}
.ah .amt{font-weight:800}
.aline{display:flex;align-items:center;gap:14rpx;padding:18rpx 0;border-bottom:1rpx solid var(--line)}
.aline .nm{width:132rpx;flex:none;font-size:25rpx;font-weight:700;color:var(--ink);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.aline .wn{flex:1;font-size:21rpx;color:var(--sub)}
.aline .pct{width:100rpx;text-align:right;font-size:26rpx;font-weight:700;background:var(--wall);border:1rpx solid var(--line);border-radius:10rpx;padding:8rpx 12rpx}
.aline .pcts{font-size:23rpx;color:var(--sub)}
.links{display:flex;align-items:center;gap:18rpx;margin-top:14rpx;flex-wrap:wrap}
.lnk{font-size:22rpx;color:var(--brandd);font-weight:700}
.lnk.back{margin-left:auto}.savebtn {margin-left:auto;background:var(--hero);color:var(--heroink);border-radius:999rpx;padding:12rpx 26rpx;font-size:23rpx;font-weight:700}
.th,.tr{display:flex;align-items:center;padding:16rpx 0;font-size:22rpx}
.th{color:var(--sub);font-weight:700;border-bottom:1rpx solid var(--line)}
.tr{border-bottom:1rpx solid var(--line);color:var(--ink)}
.tr:last-child{border-bottom:none}
.c1{width:140rpx;flex:none;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.c2{width:64rpx;flex:none}.c3{flex:1;text-align:right}.c4{width:130rpx;flex:none;text-align:right}
.tr .nm{font-weight:700}
.c4.ok{color:var(--good);font-weight:700}
.anom{font-size:22rpx;color:var(--ink);line-height:2}
.anom .sub{display:block;color:var(--sub);font-size:21rpx}
.badge{font-size:20rpx;background:var(--wall);color:var(--sub);border-radius:999rpx;padding:2rpx 14rpx;margin-left:8rpx}
.badge.warn{background:var(--badbg);color:var(--bad)}
.warn{background:var(--badbg);border:1rpx solid var(--line);border-radius:12rpx;padding:14rpx 16rpx;font-size:23rpx;color:var(--bad);margin-bottom:12rpx}.cta {margin-top:8rpx;background:var(--hero);color:var(--heroink);text-align:center;padding:28rpx;border-radius:999rpx;font-size:29rpx;font-weight:800}
.cta.dis{background:var(--wall)}
.ch{font-size:29rpx;font-weight:800;color:var(--ink);display:flex;align-items:center;padding:8rpx 0 16rpx}
.ro{background:var(--wall);border:1rpx dashed var(--line);border-radius:14rpx;padding:16rpx;font-size:22rpx;line-height:1.9;color:var(--ink);margin-bottom:14rpx}
.ro .rot{display:flex;justify-content:space-between;font-weight:800;color:var(--ink);margin-bottom:8rpx}
.ro .lock{font-size:20rpx;color:var(--sub);font-weight:400}
.ro .b{font-weight:800;color:var(--ink)}
.fh{font-size:25rpx;font-weight:800;color:var(--ink);margin-bottom:12rpx}
.fd{display:flex;align-items:center;justify-content:space-between;gap:14rpx;padding:12rpx 0}
.fd .lab{font-size:25rpx;color:var(--ink)}
.fd .in{flex:1;max-width:280rpx;text-align:right;font-size:28rpx;font-weight:800;background:var(--wall);border:1rpx solid var(--line);border-radius:12rpx;padding:14rpx 16rpx}
.ta{width:100%;min-height:140rpx;background:var(--wall);border:1rpx solid var(--line);border-radius:12rpx;padding:14rpx;font-size:24rpx;color:var(--ink);margin-top:8rpx}
.note{font-size:21rpx;color:var(--sub);line-height:1.8;margin:12rpx 0}

/* 屏 1 下半:日结板块长在今日台面网格下方(2026-08-09 归位) */
.dcwrap{margin:18rpx 16rpx 0;padding-top:18rpx;border-top:2rpx solid var(--line)}
.dch{display:flex;align-items:baseline;justify-content:space-between;padding:0 4rpx 12rpx}
.dch .dct{font-size:30rpx;font-weight:800;color:var(--ink)}
.dch .dcok{font-size:21rpx;color:var(--good)}
.dch .dcok .lnk{margin-left:12rpx;color:var(--brandd);text-decoration:underline}
.dcsub{font-size:22rpx;color:var(--sub);padding:0 4rpx 10rpx}
.dv-pill.hot{background:var(--badbg);color:var(--bad);font-weight:700}
.lg.settled{background:repeating-linear-gradient(45deg,var(--wall),var(--wall) 4rpx,var(--card) 4rpx,var(--card) 8rpx)}

/* 屏 0 操作面板(2026-08-09 从系统 ActionSheet 换成图上那张自建卡) */
.actmask{position:fixed;left:0;right:0;top:0;bottom:0;background:rgba(35,30,28,.42);z-index:70}
.actpanel{position:fixed;left:0;right:0;bottom:0;z-index:71;background:var(--card);border-radius:24rpx 24rpx 0 0;padding:22rpx 24rpx calc(22rpx + env(safe-area-inset-bottom))}
.actpanel .actt{font-size:24rpx;color:var(--sub);padding:4rpx 4rpx 16rpx;border-bottom:1rpx solid var(--line);margin-bottom:12rpx}
.actpanel .actb{text-align:center;font-size:29rpx;color:var(--ink);padding:26rpx;border-radius:14rpx;background:var(--wall);margin-bottom:10rpx}
.actpanel .actclose{text-align:center;font-size:28rpx;color:var(--sub);padding:24rpx;margin-top:6rpx}

/* 无需分配但要店长点确认的单(F1) */
.awaitcard .ah{border-bottom:none}
.awaitcard .arr{color:var(--sub);font-size:21rpx;margin-left:8rpx}

/* 屏 S1 现场排单面板增强(2026-08-09 图) */
.ds-ksub{font-size:21rpx;color:var(--sub);font-weight:400;margin-left:10rpx}
/* D9 根治:ds-tabs/ds-tab/ds-mt/ds-hit/ds-light 随「新客·输手机号」页签整体删除 */
.ds-scan{font-size:23rpx;font-weight:700;color:var(--brandd);border:1rpx solid var(--line);border-radius:999rpx;padding:10rpx 20rpx}
.ds-scan-r{float:right;margin-top:-6rpx}
/* 「＋建档并排单」行(图 v1.1 虚线框) */
.ds-newrow{display:flex;justify-content:space-between;align-items:center;margin-top:10rpx;font-size:23rpx;color:var(--sub);border:1rpx dashed var(--line);border-radius:12rpx;padding:14rpx 16rpx}
.ds-newbtn{color:var(--tagw);font-weight:700;white-space:nowrap;margin-left:12rpx}
.ds-warn{margin-top:10rpx;font-size:21rpx;color:var(--bad);background:var(--badbg);border-radius:12rpx;padding:12rpx 16rpx;line-height:1.6}
.ds-timerow{display:flex;align-items:center;gap:12rpx}
.ds-now{font-size:24rpx;font-weight:700;color:var(--heroink);background:var(--hero);border-radius:12rpx;padding:16rpx 26rpx;flex:0 0 auto}
.ds-pick{flex:1}

/* 营业时段外的整点行:沿用网格现有语言,只淡一档 + 底纹,不引入新设计 */
.dv-hr.off{color:#c4b8ab}
.dv-line.off{background:repeating-linear-gradient(45deg,rgba(154,140,124,.05) 0,rgba(154,140,124,.05) 6rpx,transparent 6rpx,transparent 14rpx)}

/* 日结行主标识:时间打头(店主 2026-08-09 修订 v6);单号退到签署单弹窗/详情里 */
.ah .code .tm{font-weight:800;color:var(--ink);margin-right:12rpx;font-variant-numeric:tabular-nums}

/* 跨零点单的自解释标注:昨天做的、今晨签的,记在今天的账上 */
.ah .code .xday{margin-left:12rpx;font-size:20rpx;font-weight:600;color:var(--bad);background:var(--badbg);border-radius:8rpx;padding:2rpx 10rpx}

/* D2:台面「本日休息」下的跨零点说明 —— 两处自洽,不让人对着矛盾的两句话发懵 */
.dv-closed .dv-crossday{margin-top:8rpx;font-size:22rpx;color:var(--bad);background:var(--badbg);border-radius:8rpx;padding:6rpx 12rpx;display:inline-block;font-weight:400}

/* D12 售后详情(只读)。⬜ 无图,复用 dsheet 的留白与字号,不自创视觉 */
.as-line{font-size:27rpx;color:var(--ink);line-height:1.6;padding:2rpx 0}
.as-empty{font-size:26rpx;color:var(--sub);padding:2rpx 0}
.as-steps{padding:4rpx 0}
.as-step{display:flex;align-items:center;gap:12rpx;font-size:26rpx;color:var(--sub);padding:8rpx 0}
.as-step.on{color:var(--ink)}
.as-dot{color:var(--brandd);font-size:22rpx}
.as-lab{flex:1}
.as-at{color:var(--sub);font-size:24rpx}

/* 图 B 部:售后状态徽标与写入按钮 */
.as-badge{display:inline-block;font-size:20rpx;padding:2rpx 14rpx;border-radius:999rpx;margin-left:12rpx;vertical-align:4rpx}
.as-pending{background:var(--badbg);color:var(--bad);border:1rpx solid var(--bad)}
.as-processing{background:var(--wall);color:var(--brandd);border:1rpx solid var(--brand)}
.as-resolved{background:var(--goodbg);color:var(--good);border:1rpx solid var(--good)}
.as-closed{background:var(--wall);color:var(--sub);border:1rpx solid var(--line)}
.as-result{margin-top:8rpx;font-weight:700}
.as-actions{display:flex;gap:14rpx;padding:16rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));border-top:1rpx solid var(--line)}.as-btn {flex:1;text-align:center;font-size:26rpx;font-weight:700;padding:18rpx 0;border-radius:999rpx;background:var(--wall);color:var(--ink)}
.as-btn.pri{background:var(--hero);color:var(--heroink)}
.as-btn.ghost{background:var(--card);border:1rpx solid var(--line);color:var(--sub)}

/* 图 A-2:爽约定金处置弹层的二选一卡 */
.dp-opt{border:1rpx solid #e8e0d8;border-radius:14rpx;padding:16rpx 18rpx;margin:12rpx 0;background:var(--card)}
.dp-opt.on{border-color:var(--good);background:var(--goodbg)}
.dp-t{font-size:26rpx;font-weight:700;color:var(--ink)}
.dp-d{font-size:22rpx;color:var(--sub);margin-top:4rpx;line-height:1.5}

/* D24:排单两级选择 —— 大类行比小类行淡一档,视觉分层 */
.ds-cats{margin-bottom:8rpx}
.ds-cats .ds-c{background:var(--wall);border:none}
.ds-cats .ds-c.on{background:var(--hero);color:var(--heroink)}

/* D57 未签单可点卡(内嵌日结区;样式与独立日结页同款) */
.deduct-card{background:var(--badbg);border:1rpx solid var(--line)}
.deduct-title{font-size:24rpx;font-weight:700;color:var(--bad);margin-bottom:8rpx}
.deduct-row{display:flex;justify-content:space-between;font-size:24rpx;padding:4rpx 0}
.deduct-row.tap{padding:10rpx 0}

/* D84 引导墙:未设置营业时间(≠休息,空态说真话) */
.dv-setupwall { border: 2rpx dashed #b08d57; border-radius:14rpx; padding:40rpx 24rpx; text-align:center; margin:20rpx 0; }
.dv-sw-t { font-size:30rpx; font-weight:700; }
.dv-sw-p { font-size:22rpx; color:var(--sub); margin:12rpx 0 20rpx; line-height:1.6; }.dv-sw-btn { display:inline-block; background:var(--hero); color:var(--heroink); border-radius:999rpx; padding:14rpx 40rpx; font-size:26rpx; }

/* 31l 值日行 */
.dv-duty { display:flex; align-items:center; gap:14rpx; row-gap:12rpx; flex-wrap:wrap; margin:24rpx 0 8rpx; padding:16rpx 24rpx; border-top:1rpx dashed var(--line); font-size:24rpx; }
.dv-duty-lab { font-weight:700; padding:4rpx 0; }
/* D94 + UI规范:chips=胶囊 999rpx,选中=黑底白字(台面黑白规格),行距给呼吸(照图例区留白) */
.dv-duty-chip { border: 2rpx solid #d9d9de; background:var(--card); color:var(--ink); border-radius:999rpx; padding:8rpx 24rpx; font-size:22rpx; line-height:1.4; }
.dv-duty-chip.on { background:var(--hero); color:var(--heroink); border-color:var(--hero); font-weight:700; }
.dv-duty-chip.ro { opacity:.7; }
.dv-duty-note { width:100%; color:var(--sub); font-size:20rpx; }

/* D97 待写小记 pill(warn 色与网页同语) */
.dv-pill.warn{background:var(--wall);color:var(--brandd);border:1rpx solid var(--line)}

/* 补录小合同(01v):弹窗里两句(提示 + 后端出的归属确认句) */
.ds-bf{font-size:22rpx;color:var(--sub);line-height:1.6;padding:8rpx 24rpx}
.ds-bf.note{color:var(--brandd);background:var(--wall);margin:0 24rpx 8rpx;border-radius:12rpx;padding:14rpx 18rpx}

/* D105:值日块内就地「回到今天」—— 与 .dv-duty-note 同排,做成可点的文字链 */
.dv-duty-back {
  margin-left: 12rpx;
  color:var(--brandd);
  text-decoration:underline;
}
