.dv-pill.live{background:#e3eee8;border-color:#cfe6d8}
.dv-pill.live .b{color:#1f7a4d}
.dv-share{margin-left:auto;font-size:22rpx;color:#c8a47e;font-weight:700}
.dv-closed{margin:20rpx 24rpx;padding:40rpx;text-align:center;color:#9a8c7c;font-size:26rpx;background:#fff;border-radius:16rpx}

.dv-grid{display:flex;margin:0 16rpx;background:#fff;border:1rpx solid #e9dccb;border-radius:20rpx;overflow:hidden}
.dv-left{flex:none;width:64rpx;border-right:1rpx solid #e9dccb;background:#fbf8f5}
.dv-corner{height:104rpx;border-bottom:1rpx solid #e9dccb}
.dv-gutter{position:relative}
.dv-hr{height:120rpx;font-size:19rpx;color:#9a8c7c;text-align:center;padding-top:4rpx;box-sizing:border-box}
.dv-right{flex:1;min-width:0}
.dv-rin{position:relative}
.dv-heads{display:flex;height:104rpx;background:#fbf8f5;border-bottom:1rpx solid #e9dccb}
.dv-th{flex:none;text-align:center;padding:10rpx 4rpx;border-right:1rpx solid #e9dccb;box-sizing:border-box;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2rpx;overflow:hidden}
.dv-nm{font-size:24rpx;font-weight:800;color:#241f1d}
.dv-rl{font-size:17rpx;color:#9a8c7c;margin-top:1rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.dv-st{font-size:17rpx;margin-top:3rpx;display:inline-block;padding:1rpx 12rpx;border-radius:999rpx;background:#fbe9d6;color:#b5731f}
.dv-st.free{background:#e3eee8;color:#1f7a4d}
.dv-cols{display:flex;position:relative}
.dv-col{flex:none;border-right:1rpx solid #e9dccb;position:relative;box-sizing:border-box}
.dv-th.mine{background:#fbf1e4;border-bottom:3rpx solid #c8a47e}
.dv-col.mine{background:rgba(200,164,126,.10)}
.dv-me{display:inline-block;margin-left:6rpx;font-size:16rpx;background:#c8a47e;color:#fff;border-radius:999rpx;padding:0 8rpx;vertical-align:middle}
.dv-line{height:120rpx;border-bottom:1rpx dashed #f2ebe1;box-sizing:border-box}
.dv-blk{position:absolute;left:6rpx;right:6rpx;border-radius:12rpx;padding:7rpx 9rpx;overflow:hidden;box-shadow:0 1rpx 4rpx rgba(92,70,48,.12);box-sizing:border-box}
.dv-bt{font-size:17rpx;opacity:.72;font-weight:600}
.dv-bn{font-size:22rpx;font-weight:800;margin-top:2rpx}
.dv-bs{font-size:18rpx;margin-top:1rpx;opacity:.85}
.dv-tag{position:absolute;top:6rpx;right:6rpx;font-size:16rpx;border-radius:6rpx;padding:1rpx 7rpx;font-weight:700;color:#fff}
.dv-tag.zhi{background:#5c4630}
.dv-tag.xin{background:#b5731f}
/* ===== 色相=服务类型 × 状态=到店进度 ===== */
/* 未到店(默认):淡色 + 虚线边 */
.dv-blk.hand{background:#f6ecdc;color:#9c8158;border:1rpx dashed rgba(122,90,46,.3)}
.dv-blk.foot{background:#f7e5da;color:#a5764f;border:1rpx dashed rgba(138,80,48,.32)}
.dv-blk.lash{background:#efe8f2;color:#8574a0;border:1rpx dashed rgba(91,67,112,.28)}
.dv-blk.care{background:#e6efe9;color:#6a9078;border:1rpx dashed rgba(63,107,82,.28)}
/* 到店·进行中:满色点亮 + 绿框 + 左绿条 */
.dv-blk.active{border:none;box-shadow:0 0 0 3rpx rgba(31,122,77,.5),0 3rpx 10rpx rgba(92,70,48,.16);padding-left:16rpx}
.dv-blk.active::before{content:'';position:absolute;left:0;top:0;bottom:0;width:8rpx;background:#1f9d57;border-radius:12rpx 0 0 12rpx}
.dv-blk.hand.active{background:#e8d3b0;color:#7a5a2e}
.dv-blk.foot.active{background:#e0b39a;color:#8a5030}
.dv-blk.lash.active{background:#d9c8e0;color:#5b4370}
.dv-blk.care.active{background:#cfe0d6;color:#3f6b52}
/* 已完成:灰掉 + 勾 */
.dv-blk.done{background:#efeae4 !important;color:#a79f95 !important;border:1rpx solid #e4ddd3}
/* 时间行到店小标 */
.dv-sdot{display:inline-block;margin-right:4rpx;font-size:16rpx}
.dv-sdot.active{color:#1f9d57;font-weight:800}
.dv-sdot.done{color:#8a8178}
.dv-blk.free{background:repeating-linear-gradient(45deg,#faf6f0,#faf6f0 10rpx,#f3ece2 10rpx,#f3ece2 20rpx);border:1rpx dashed #dcc9ad;box-shadow:none;display:flex;align-items:center;justify-content:center}
.dv-blk.free text{font-size:19rpx;color:#b39468}
.dv-legend{display:flex;flex-wrap:wrap;gap:16rpx;justify-content:center;padding:12rpx 24rpx 0;font-size:18rpx;color:#9a8c7c}
.dv-legend.top{margin-top:48rpx;padding-top:20rpx;border-top:1rpx dashed #e4dccf}
.dv-legend-hd{width:100%;text-align:center;font-size:17rpx;color:#b8ab9c;margin-bottom:2rpx}
.dv-legend .lg{display:inline-block;width:18rpx;height:18rpx;border-radius:4rpx;vertical-align:-2rpx;margin-right:5rpx}
.dv-legend .lg.hand{background:#e8d3b0}
.dv-legend .lg.foot{background:#e0b39a}
.dv-legend .lg.lash{background:#d9c8e0}
.dv-legend .lg.care{background:#cfe0d6}
.dv-legend .lg.free{background:#f3ece2;border:1rpx dashed #dcc9ad}
.dv-tag.owner{background:#7a5cff}
.dv-unpaid{position:absolute;left:14rpx;bottom:6rpx;font-size:15rpx;background:#fdecec;color:#c0392b;border-radius:5rpx;padding:1rpx 8rpx;font-weight:700}
.dv-blk.active .dv-unpaid{left:20rpx}
/* 列表 */
.filters{white-space:nowrap;padding:4rpx 24rpx 10rpx}
.fchip{display:inline-block;font-size:24rpx;padding:8rpx 22rpx;border-radius:999rpx;background:#fff;border:1rpx solid #eadfd7;color:#5c4630;margin-right:12rpx}
.fchip.on{background:#2d2826;color:#fff;font-weight:700}
.ogroup{margin:0 24rpx}
.oghead{font-size:22rpx;color:#9a8c7c;margin:14rpx 0 6rpx}
.orow{display:flex;align-items:center;gap:12rpx;background:#fff;border-radius:14rpx;padding:14rpx 16rpx;margin:0 24rpx 10rpx;box-shadow:0 2rpx 8rpx rgba(92,70,48,.05)}
.ogroup .orow{margin:0 0 10rpx}
.otime{font-size:24rpx;font-weight:800;color:#5c4630;width:80rpx;flex:none}
.omain{flex:1;min-width:0}
.oname{font-size:27rpx;font-weight:800;color:#241f1d;display:flex;align-items:center;gap:8rpx}
.ostatus{font-size:18rpx;padding:2rpx 10rpx;border-radius:999rpx;font-weight:700}
.ostatus.g{background:#e3eee8;color:#1f7a4d}.ostatus.s{background:#eef1f8;color:#5566b5}.ostatus.n{background:#f1ece5;color:#9a8c7c}.ostatus.d{background:#fbe9d6;color:#b5731f}
.oline{font-size:22rpx;color:#8a7f78;margin-top:3rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ochev{color:#c9bdb0;font-size:30rpx}
/* 直接排单弹窗 */
.mask{position:fixed;inset:0;background:rgba(45,40,38,.4);z-index:20}
.dsheet{position:fixed;left:0;right:0;bottom:0;background:#fff;border-radius:24rpx 24rpx 0 0;padding:20rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));z-index:2000;box-shadow:0 -8rpx 30rpx rgba(92,70,48,.2);display:flex;flex-direction:column;max-height:82vh}
.ds-head{display:flex;align-items:center;justify-content:space-between;padding-bottom:10rpx}
.ds-t{font-size:30rpx;font-weight:800;color:#241f1d}
.ds-x{font-size:32rpx;color:#9a8c7c;padding:0 8rpx}
.ds-body{flex:1;overflow-y:auto}
.ds-s{font-size:22rpx;color:#9a8c7c;margin:2rpx 0 14rpx}
.ds-k{font-size:22rpx;color:#9a8c7c;margin:14rpx 0 6rpx}
.ds-inp{background:#fbf8f5;border:1rpx solid #eadfd7;border-radius:12rpx;padding:0 18rpx;height:88rpx;line-height:88rpx;font-size:28rpx;box-sizing:border-box;width:100%}
.ds-picked{margin-top:8rpx;font-size:24rpx;color:#5c4630;font-weight:700}
.ds-clear{color:#c0392b;margin-left:8rpx}
.ds-matches{margin-top:8rpx;border:1rpx solid #eadfd7;border-radius:12rpx;overflow:hidden}
.ds-match{display:flex;align-items:center;justify-content:space-between;padding:16rpx 18rpx;border-bottom:1rpx solid #f0e8e1}
.ds-match:last-child{border-bottom:none}
.ds-mn{font-size:27rpx;color:#241f1d;font-weight:600}
.ds-mp{font-size:22rpx;color:#9a8c7c}
/* D9 根治:.ds-newhint 已被 .ds-newrow 取代 */
.ds-time{background:#fbf8f5;border:1rpx solid #eadfd7;border-radius:12rpx;padding:16rpx 18rpx;font-size:28rpx;color:#241f1d;display:flex;justify-content:space-between}
.ds-cal{color:#c8a47e}
.ds-endhint{margin-top:8rpx;font-size:22rpx;color:#8a7f78}
.ds-endhint .b{color:#5c4630;font-weight:700}
.ds-durrow{display:flex;align-items:center;gap:12rpx;margin-top:12rpx}
.ds-durbtn{flex:none;font-size:24rpx;font-weight:700;color:#5c4630;background:#fbf8f5;border:1rpx solid #eadfd7;border-radius:999rpx;padding:10rpx 24rpx}
.ds-durval{flex:1;text-align:center;font-size:25rpx;font-weight:700;color:#241f1d}
.ds-durend{color:#b5885d;font-weight:600}
.ds-durstd{flex:none;font-size:22rpx;color:#b5885d;font-weight:700;padding:10rpx 8rpx}
.ds-svcs{white-space:nowrap}
.ds-c{display:inline-block;font-size:24rpx;padding:8rpx 20rpx;border-radius:999rpx;background:#fbf8f5;border:1rpx solid #eadfd7;color:#5c4630;margin-right:12rpx}
.ds-c.on{background:#c8a47e;color:#fff;border-color:#c8a47e;font-weight:700}
.ds-toggle{display:flex;background:#fbf8f5;border:1rpx solid #eadfd7;border-radius:12rpx;padding:4rpx}
.ds-opt{flex:1;text-align:center;font-size:25rpx;padding:14rpx 0;border-radius:10rpx;color:#8a7f78}
.ds-opt.on{background:#2d2826;color:#fff;font-weight:700}
.ds-opt.on.warn{background:#c0392b}
.ds-confirm{margin-top:16rpx;background:#2d2826;color:#fff;text-align:center;padding:26rpx;border-radius:14rpx;font-size:30rpx;font-weight:700}
.ds-hint{font-size:20rpx;color:#9a8c7c;text-align:center;margin-top:10rpx}
.pg{padding:16rpx 24rpx 60rpx;background:#fbf8f5;min-height:100vh}
.datebar{display:flex;align-items:center;gap:14rpx;padding:8rpx 0 16rpx}
.datebar .nav{width:52rpx;height:52rpx;border-radius:50%;background:#f3ece2;color:#5c4630;font-size:28rpx;display:flex;align-items:center;justify-content:center;flex:0 0 auto}
.datebar .d{font-size:32rpx;font-weight:800;color:#241f1d}
.datebar .today{margin-left:auto;font-size:23rpx;color:#9b7655;border:1rpx solid #e7d3b8;border-radius:999rpx;padding:8rpx 22rpx}
.empty{padding:80rpx 0;text-align:center;color:#9a8c7c;font-size:26rpx}
.okbar{background:#e3eee8;border:1rpx solid #bcdccd;color:#2f7d5c;border-radius:12rpx;padding:14rpx 16rpx;font-size:23rpx;margin-bottom:14rpx}
.pills{display:flex;gap:12rpx;flex-wrap:wrap;margin-bottom:14rpx}
.pill{font-size:23rpx;background:#fff;border:1rpx solid #ece3da;border-radius:999rpx;padding:8rpx 20rpx;color:#5c4630}
.pill.hot{background:#fdf3ec;border-color:#f0d9c4;color:#a8551f}
.pill .b{font-weight:800;color:#241f1d}
.card{background:#fff;border-radius:18rpx;padding:24rpx 22rpx;margin-bottom:18rpx;box-shadow:0 3rpx 10rpx rgba(92,70,48,.06)}
.ah{display:flex;justify-content:space-between;align-items:center;font-size:25rpx;font-weight:700;color:#241f1d}
.ah .arr{font-size:21rpx;color:#8c8279;font-weight:400;margin-left:8rpx}
.ah .amt{font-weight:800}
.aline{display:flex;align-items:center;gap:14rpx;padding:18rpx 0;border-bottom:1rpx solid #f4ede6}
.aline .nm{width:132rpx;flex:none;font-size:25rpx;font-weight:700;color:#241f1d;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.aline .wn{flex:1;font-size:21rpx;color:#8c8279}
.aline .pct{width:100rpx;text-align:right;font-size:26rpx;font-weight:700;background:#faf6f1;border:1rpx solid #ece2d6;border-radius:10rpx;padding:8rpx 12rpx}
.aline .pcts{font-size:23rpx;color:#8c8279}
.links{display:flex;align-items:center;gap:18rpx;margin-top:14rpx;flex-wrap:wrap}
.lnk{font-size:22rpx;color:#9b7655;font-weight:700}
.lnk.back{margin-left:auto}
.savebtn{margin-left:auto;background:#2d2826;color:#fff;border-radius:12rpx;padding:12rpx 26rpx;font-size:23rpx;font-weight:700}
.th,.tr{display:flex;align-items:center;padding:16rpx 0;font-size:22rpx}
.th{color:#8c8279;font-weight:700;border-bottom:1rpx solid #ece3da}
.tr{border-bottom:1rpx solid #f4ede6;color:#241f1d}
.tr:last-child{border-bottom:none}
.c1{width:140rpx;flex:none;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.c2{width:64rpx;flex:none}.c3{flex:1;text-align:right}.c4{width:130rpx;flex:none;text-align:right}
.tr .nm{font-weight:700}
.c4.ok{color:#2f7d5c;font-weight:700}
.anom{font-size:22rpx;color:#4a3c2c;line-height:2}
.anom .sub{display:block;color:#8c8279;font-size:21rpx}
.badge{font-size:20rpx;background:#f1e7df;color:#8c8279;border-radius:999rpx;padding:2rpx 14rpx;margin-left:8rpx}
.badge.warn{background:#fdecec;color:#c0392b}
.warn{background:#fdf3ec;border:1rpx solid #f0d9c4;border-radius:12rpx;padding:14rpx 16rpx;font-size:23rpx;color:#a8551f;margin-bottom:12rpx}
.cta{margin-top:8rpx;background:#2d2826;color:#fff;text-align:center;padding:28rpx;border-radius:16rpx;font-size:29rpx;font-weight:800}
.cta.dis{background:#c8bfb6}
.ch{font-size:29rpx;font-weight:800;color:#241f1d;display:flex;align-items:center;padding:8rpx 0 16rpx}
.ro{background:#faf6f1;border:1rpx dashed #e0d3c4;border-radius:14rpx;padding:16rpx;font-size:22rpx;line-height:1.9;color:#4a3c2c;margin-bottom:14rpx}
.ro .rot{display:flex;justify-content:space-between;font-weight:800;color:#241f1d;margin-bottom:8rpx}
.ro .lock{font-size:20rpx;color:#8c8279;font-weight:400}
.ro .b{font-weight:800;color:#241f1d}
.fh{font-size:25rpx;font-weight:800;color:#241f1d;margin-bottom:12rpx}
.fd{display:flex;align-items:center;justify-content:space-between;gap:14rpx;padding:12rpx 0}
.fd .lab{font-size:25rpx;color:#5c4630}
.fd .in{flex:1;max-width:280rpx;text-align:right;font-size:28rpx;font-weight:800;background:#faf6f1;border:1rpx solid #ece2d6;border-radius:12rpx;padding:14rpx 16rpx}
.ta{width:100%;min-height:140rpx;background:#faf6f1;border:1rpx solid #ece2d6;border-radius:12rpx;padding:14rpx;font-size:24rpx;color:#241f1d;margin-top:8rpx}
.note{font-size:21rpx;color:#9a8c7c;line-height:1.8;margin:12rpx 0}

/* 屏 1 下半:日结板块长在今日台面网格下方(2026-08-09 归位) */
.dcwrap{margin:18rpx 16rpx 0;padding-top:18rpx;border-top:2rpx solid #ece3da}
.dch{display:flex;align-items:baseline;justify-content:space-between;padding:0 4rpx 12rpx}
.dch .dct{font-size:30rpx;font-weight:800;color:#241f1d}
.dch .dcok{font-size:21rpx;color:#2f7d5c}
.dch .dcok .lnk{margin-left:12rpx;color:#b5885d;text-decoration:underline}
.dcsub{font-size:22rpx;color:#9a8c7c;padding:0 4rpx 10rpx}
.dv-pill.hot{background:#fdf0e6;color:#a8551f;font-weight:700}
.lg.settled{background:repeating-linear-gradient(45deg,#e7ddd4,#e7ddd4 4rpx,#fff 4rpx,#fff 8rpx)}

/* 屏 0 操作面板(2026-08-09 从系统 ActionSheet 换成图上那张自建卡) */
.actmask{position:fixed;left:0;right:0;top:0;bottom:0;background:rgba(35,30,28,.42);z-index:70}
.actpanel{position:fixed;left:0;right:0;bottom:0;z-index:71;background:#fff;border-radius:24rpx 24rpx 0 0;padding:22rpx 24rpx calc(22rpx + env(safe-area-inset-bottom))}
.actpanel .actt{font-size:24rpx;color:#9a8c7c;padding:4rpx 4rpx 16rpx;border-bottom:1rpx solid #f2ebe3;margin-bottom:12rpx}
.actpanel .actb{text-align:center;font-size:29rpx;color:#241f1d;padding:26rpx;border-radius:14rpx;background:#faf6f1;margin-bottom:10rpx}
.actpanel .actclose{text-align:center;font-size:28rpx;color:#8c8279;padding:24rpx;margin-top:6rpx}

/* 无需分配但要店长点确认的单(F1) */
.awaitcard .ah{border-bottom:none}
.awaitcard .arr{color:#9a8c7c;font-size:21rpx;margin-left:8rpx}

/* 屏 S1 现场排单面板增强(2026-08-09 图) */
.ds-ksub{font-size:21rpx;color:#a99d92;font-weight:400;margin-left:10rpx}
/* D9 根治:ds-tabs/ds-tab/ds-mt/ds-hit/ds-light 随「新客·输手机号」页签整体删除 */
.ds-scan{font-size:23rpx;font-weight:700;color:#9b7655;border:1rpx solid #e7d3b8;border-radius:999rpx;padding:10rpx 20rpx}
.ds-scan-r{float:right;margin-top:-6rpx}
/* 「＋建档并排单」行(图 v1.1 虚线框) */
.ds-newrow{display:flex;justify-content:space-between;align-items:center;margin-top:10rpx;font-size:23rpx;color:#8c8279;border:1rpx dashed #d8cec4;border-radius:12rpx;padding:14rpx 16rpx}
.ds-newbtn{color:#5b7a99;font-weight:700;white-space:nowrap;margin-left:12rpx}
.ds-warn{margin-top:10rpx;font-size:21rpx;color:#a8551f;background:#fdf3ec;border-radius:12rpx;padding:12rpx 16rpx;line-height:1.6}
.ds-timerow{display:flex;align-items:center;gap:12rpx}
.ds-now{font-size:24rpx;font-weight:700;color:#fff;background:#2d2826;border-radius:12rpx;padding:16rpx 26rpx;flex:0 0 auto}
.ds-pick{flex:1}

/* 营业时段外的整点行:沿用网格现有语言,只淡一档 + 底纹,不引入新设计 */
.dv-hr.off{color:#c4b8ab}
.dv-line.off{background:repeating-linear-gradient(45deg,rgba(154,140,124,.05) 0,rgba(154,140,124,.05) 6rpx,transparent 6rpx,transparent 14rpx)}

/* 日结行主标识:时间打头(店主 2026-08-09 修订 v6);单号退到签署单弹窗/详情里 */
.ah .code .tm{font-weight:800;color:#241f1d;margin-right:12rpx;font-variant-numeric:tabular-nums}

/* 跨零点单的自解释标注:昨天做的、今晨签的,记在今天的账上 */
.ah .code .xday{margin-left:12rpx;font-size:20rpx;font-weight:600;color:#a8551f;background:#fdf3ec;border-radius:8rpx;padding:2rpx 10rpx}

/* D2:台面「本日休息」下的跨零点说明 —— 两处自洽,不让人对着矛盾的两句话发懵 */
.dv-closed .dv-crossday{margin-top:8rpx;font-size:22rpx;color:#a8551f;background:#fdf3ec;border-radius:8rpx;padding:6rpx 12rpx;display:inline-block;font-weight:400}

/* D12 售后详情(只读)。⬜ 无图,复用 dsheet 的留白与字号,不自创视觉 */
.as-line{font-size:27rpx;color:#3a2e2a;line-height:1.6;padding:2rpx 0}
.as-empty{font-size:26rpx;color:#8c8279;padding:2rpx 0}
.as-steps{padding:4rpx 0}
.as-step{display:flex;align-items:center;gap:12rpx;font-size:26rpx;color:#8c8279;padding:8rpx 0}
.as-step.on{color:#3a2e2a}
.as-dot{color:#c6a27e;font-size:22rpx}
.as-lab{flex:1}
.as-at{color:#a89c92;font-size:24rpx}

/* 图 B 部:售后状态徽标与写入按钮 */
.as-badge{display:inline-block;font-size:20rpx;padding:2rpx 14rpx;border-radius:999rpx;margin-left:12rpx;vertical-align:4rpx}
.as-pending{background:#fbeeec;color:#c0554a;border:1rpx solid #c0554a}
.as-processing{background:#faf3e3;color:#b98a2f;border:1rpx solid #b98a2f}
.as-resolved{background:#eef5ee;color:#5e8c61;border:1rpx solid #5e8c61}
.as-closed{background:#f1ede8;color:#8a7f78;border:1rpx solid #e8e0d8}
.as-result{margin-top:8rpx;font-weight:700}
.as-actions{display:flex;gap:14rpx;padding:16rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));border-top:1rpx solid #efe7dd}
.as-btn{flex:1;text-align:center;font-size:26rpx;font-weight:700;padding:18rpx 0;border-radius:14rpx;background:#f3ece2;color:#3a2e2a}
.as-btn.pri{background:#2d2826;color:#fff}
.as-btn.ghost{background:#fff;border:1rpx solid #d8cec4;color:#8c8279}

/* 图 A-2:爽约定金处置弹层的二选一卡 */
.dp-opt{border:1rpx solid #e8e0d8;border-radius:14rpx;padding:16rpx 18rpx;margin:12rpx 0;background:#fff}
.dp-opt.on{border-color:#5e8c61;background:#eef5ee}
.dp-t{font-size:26rpx;font-weight:700;color:#3a2e2a}
.dp-d{font-size:22rpx;color:#8c8279;margin-top:4rpx;line-height:1.5}

/* D24:排单两级选择 —— 大类行比小类行淡一档,视觉分层 */
.ds-cats{margin-bottom:8rpx}
.ds-cats .ds-c{background:#f4efe6;border:none}
.ds-cats .ds-c.on{background:#2f2a22;color:#fff}
