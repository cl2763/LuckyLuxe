page{background:var(--paper)}
.page{padding:26rpx 26rpx 60rpx}
.hero{display:flex;align-items:center;gap:20rpx;background:var(--card);border:1rpx solid var(--line);border-radius:18rpx;padding:26rpx 24rpx;margin-bottom:22rpx}
.av{width:96rpx;height:96rpx;border-radius:50%;background:var(--wall);color:var(--brandd);display:flex;align-items:center;justify-content:center;font-size:40rpx;font-weight:600;flex:0 0 auto}
.info{flex:1;min-width:0}
.name{font-size:32rpx;font-weight:600;color:var(--ink)}
.role{font-size:23rpx;color:var(--brandd);margin-top:6rpx}
.acct{font-size:22rpx;color:var(--sub);margin-top:6rpx}
.group{background:var(--card);border:1rpx solid var(--line);border-radius:18rpx;overflow:hidden;margin-bottom:30rpx}
.row{display:flex;align-items:center;padding:26rpx 24rpx;border-bottom:1rpx solid var(--line)}
.row:last-child{border-bottom:none}
.t{flex:1;font-size:27rpx;color:var(--ink)}
.v{font-size:24rpx;color:var(--sub);margin-right:10rpx}
.tag{font-size:21rpx;color:var(--sub);background:var(--wall);border:1rpx solid var(--line);border-radius:40rpx;padding:4rpx 14rpx;margin-right:10rpx}
.tag.on{color:var(--good);background:var(--goodbg);border-color:var(--goodbg)}
.tag.warn{color:var(--bad);background:var(--badbg);border-color:var(--badbg)}
.arr{color:var(--sub);font-size:30rpx}
.out{text-align:center;color:var(--bad);font-size:27rpx;background:var(--card);border:1rpx solid var(--line);border-radius:16rpx;padding:26rpx 0}
.ver{text-align:center;color:var(--sub);font-size:21rpx;margin-top:26rpx}
