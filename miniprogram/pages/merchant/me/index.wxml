<view class="page">
  <view class="hero">
    <view class="av">{{shopName ? shopName[0] : '店'}}</view>
    <view class="info">
      <view class="name">{{shopName}}</view>
      <view class="role">{{role}}</view>
      <view class="acct" wx:if="{{account}}">账号 {{account}}</view>
    </view>
  </view>

  <view class="group" wx:if="{{isOwnerRole}}">
    <view class="row" bindtap="subscription">
      <text class="t">套餐与续费</text>
      <text class="tag {{subWarn ? 'warn' : 'on'}}" wx:if="{{subText}}">{{subText}}</text>
      <text class="arr">›</text>
    </view>
  </view>

  <view class="group">
    <view class="row" bindtap="editName">
      <text class="t">显示名称</text><text class="v">{{displayName || '未设置'}}</text><text class="arr">›</text>
    </view>
    <view class="row" bindtap="changePwd">
      <text class="t">修改密码</text><text class="arr">›</text>
    </view>
    <view class="row" bindtap="finance">
      <text class="t">财务密码</text>
      <text class="tag {{financeOn ? 'on' : ''}}">{{financeOn ? '本次已解锁' : '去财务页设置'}}</text>
      <text class="arr">›</text>
    </view>
    <view class="row" bindtap="lang">
      <text class="t">语言 / Language</text><text class="v">简体中文</text><text class="arr">›</text>
    </view>
  </view>

  <view class="out" bindtap="logout">退出登录</view>
  <view class="ver">有迹商家端</view>
</view>
