<view class="page {{themeClass}}"><view class="error" wx:if="{{error}}">{{error}}</view><block wx:if="{{card}}"><view class="title">{{card.name}}</view><view class="chips"><text class="chip">{{card.length}}甲</text><text class="chip">{{card.shot}}</text><text class="chip">{{card.style}}</text></view><view class="detail"><image wx:if="{{!imageError}}" class="hero-image" src="{{card.image}}" mode="aspectFit" binderror="failedImage"/><view wx:else class="empty">图片暂未加载，请参考下方文字指引</view><view class="badge">示意图</view></view><view class="detail" wx:for="{{sections}}" wx:key="title"><view class="detail-title">{{item.title}}</view><view class="detail-copy">{{item.text}}</view></view></block></view>