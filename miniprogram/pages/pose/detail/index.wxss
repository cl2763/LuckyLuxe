page{background:var(--paper)}.page{min-height:100vh;background:var(--paper);color:var(--ink);padding:32rpx 30rpx 70rpx;box-sizing:border-box}.title{font-family:var(--font-display,'Songti SC',serif);font-size:42rpx;font-weight:600;margin:12rpx 0 24rpx}.sub,.hint{color:var(--sub);font-size:25rpx;line-height:1.7}.hint{background:var(--wall);padding:22rpx;border-radius:18rpx;margin:20rpx 0}.filter{margin:20rpx 0}.label{font-size:26rpx;font-weight:600;margin-bottom:12rpx}.chips{display:flex;flex-wrap:wrap;gap:12rpx}.chip{font-size:24rpx;background:var(--card);border:1rpx solid var(--line);border-radius:999rpx;padding:10rpx 18rpx;margin:0;line-height:1.5;color:var(--ink)}.chip.on{background:var(--hero);color:var(--heroink);border-color:var(--hero)}button::after{border:none}.grid{display:flex;flex-wrap:wrap;justify-content:space-between}.card{width:48%;margin:0 0 24rpx;padding:16rpx;background:var(--card);border:1rpx solid var(--line);border-radius:22rpx;box-sizing:border-box;text-align:left;line-height:1.5;color:var(--ink)}.thumb{width:100%;height:360rpx;background:var(--card);border-radius:12rpx}.name{font-size:26rpx;font-weight:600;margin-top:16rpx;word-break:break-all}.group{font-size:26rpx;color:var(--sub);margin:28rpx 0 16rpx}.hero-image{width:100%;height:660rpx;background:var(--card);border-radius:20rpx}.detail{background:var(--card);padding:24rpx;border:1rpx solid var(--line);border-radius:20rpx;margin:18rpx 0}.detail-title{font-weight:600;font-size:28rpx;margin-bottom:8rpx}.detail-copy{font-size:27rpx;line-height:1.8}.button{background:var(--card);color:var(--ink);border:1rpx solid var(--line);border-radius:999rpx;padding:22rpx;font-size:28rpx;line-height:1.5;margin-top:18rpx}.button.primary{background:var(--brand);color:var(--hero);border-color:var(--brand);font-weight:600}.empty{padding:60rpx 20rpx;text-align:center;color:var(--sub)}.photo{width:100%;height:340rpx;background:var(--wall);border-radius:16rpx}.badge{color:var(--sub);font-size:23rpx}.error{color:var(--bad);font-size:25rpx;padding:14rpx 0}
/* 覆盖原生 button:not([size=mini]) 默认宽度，保持合同的横向筛选与双列卡片。 */
.page .chips button.chip{width:auto;min-width:0;flex:0 0 auto;margin:0}.page .grid button.card{width:48%;margin:0 0 24rpx}.page button.button{width:100%;box-sizing:border-box}
