<view class="page {{themeClass}}"><view class="title">拍照姿势卡</view><view class="sub">33 张拍照示意，找到适合这副甲的拍法。</view><view class="filter" wx:for="{{dimensions}}" wx:key="key" wx:for-item="dim"><view class="label">{{dim.label}}</view><view class="chips"><button class="chip {{filters[dim.key]===item?'on':''}}" wx:for="{{dim.values}}" wx:key="*this" data-key="{{dim.key}}" data-value="{{item}}" bindtap="select">{{item}}</button></view></view><view class="hint" wx:if="{{message}}">{{message}}</view><view class="sub">共 {{count}} 张 · 点击查看拍法</view><view wx:for="{{groups}}" wx:key="id" wx:for-item="group"><view class="group">{{group.id}} 组</view><view class="grid"><button class="card" wx:for="{{group.cards}}" wx:key="id" data-id="{{item.id}}" bindtap="open"><image wx:if="{{!imageErrors[item.id]}}" class="thumb" src="{{item.image}}" mode="aspectFit" data-id="{{item.id}}" binderror="imageError" lazy-load/><view wx:else class="empty">图片暂未加载，点开查看文字指引</view><view class="name">{{item.name}}</view><view class="badge">{{item.length}}甲 · {{item.shot}}</view></button></view></view><view wx:if="{{!count}}" class="empty">换个筛选组合试试</view></view>