page{background:var(--paper)}
.cp{padding:56rpx 44rpx}
.head{margin-bottom:40rpx}
.title{font-size:38rpx;font-weight:600;color:var(--ink)}
.sub{font-size:24rpx;color:var(--sub);margin-top:12rpx;line-height:1.5}
.label{font-size:24rpx;color:var(--sub);margin:0 0 12rpx 4rpx}
.field{height:92rpx;background:var(--card);border:1rpx solid var(--line);border-radius:18rpx;display:flex;align-items:center;padding:0 24rpx;margin-bottom:24rpx}
.inp{flex:1;font-size:30rpx;color:var(--ink)}
.ph{color:var(--sub)}.btn {height:92rpx;line-height:92rpx;background:var(--brand);color:var(--hero);font-size:32rpx;border-radius:999rpx;font-weight:500;margin-top:16rpx}
.btn::after{border:none}
.hint{text-align:center;font-size:23rpx;color:var(--sub);margin-top:24rpx}
