page{background:var(--paper)}.page{padding:28rpx 26rpx calc(60rpx + env(safe-area-inset-bottom));color:var(--ink)}.card{background:var(--card);border:1rpx solid var(--line);border-radius:12rpx;padding:28rpx;margin-bottom:24rpx}.title{font-size:34rpx;font-weight:700;margin-bottom:28rpx}.row{display:flex;justify-content:space-between;gap:24rpx;padding:24rpx 0;border-bottom:1rpx solid var(--line);font-size:28rpx}.row text{flex:1;text-align:right}.hint{font-size:24rpx;color:var(--sub);line-height:1.7;margin:24rpx 0;overflow-wrap:anywhere}.page button.primary,.page button.secondary{display:flex;align-items:center;justify-content:center;width:100%;min-height:88rpx;padding:22rpx 28rpx;margin-top:24rpx;font-size:28rpx;line-height:1.5;border-radius:999rpx}.page button.primary{background:var(--brand);color:var(--hero)}.page button.primary[disabled]{background:var(--wall);color:var(--sub);border:1rpx solid var(--line);opacity:.75}.secondary{background:var(--card);color:var(--ink);border:1rpx solid var(--line)}.error{color:var(--bad);font-size:26rpx;line-height:1.6}input,textarea,picker{background:var(--paper);color:var(--ink);border:1rpx solid var(--line);border-radius:12rpx;padding:22rpx;margin:12rpx 0 26rpx;box-sizing:border-box;width:100%}.qr{width:400rpx;height:400rpx;display:block;margin:24rpx auto}
