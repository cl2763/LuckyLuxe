<view class="pg">
  <view class="hero">
    <view class="hl">我的积分 · 消费 1 元 = 1 分</view>
    <view class="hv">{{balance}}</view>
    <!-- 改判①(店主 2026-08-12):三行自证 —— 累计获得≡累计消费,余额=获得−已兑换 -->
    <view class="hrows">
      <view class="hrow"><text>累计获得</text><text>{{earnedTotal}}</text></view>
      <view class="hrow"><text>已兑换</text><text>{{redeemedTotal}}</text></view>
      <view class="hrow"><text>余额</text><text>{{balance}}</text></view>
    </view>
    <!-- 裁定②(店主 08-23):这一页既能看每笔积分怎么来的,也能拿积分换东西 —— 一句话说清,别让顾客以为只是流水 -->
    <view class="hn">积分永不过期 · 下面可以拿积分换券,也能看每一笔积分从哪来</view>
  </view>

  <block wx:if="{{!loggedIn}}">
    <view class="empty">登录后可查看积分与兑换奖品</view>
  </block>

  <block wx:else>
    <view class="t2">拿积分换券</view>
    <view wx:if="{{!prizes.length}}" class="empty">老板还没上架奖品,敬请期待~</view>
    <view class="prize" wx:for="{{prizes}}" wx:key="id">
      <view class="pinfo">
        <view class="pname">{{item.name}}</view>
        <view class="pmeta">{{item.desc}}{{item.minText}} · 有效 {{item.validDays}} 天 · {{item.stockText}}</view>
      </view>
      <view class="pbtn">
        <view class="pcost">{{item.costPoints}} 分</view>
        <view class="pgo {{item.canRedeem ? '' : 'dis'}}" data-id="{{item.id}}" bindtap="redeem">{{item.btnText}}</view>
      </view>
    </view>

    <view class="t2">每一笔积分怎么来的</view>
    <view wx:if="{{history.length}}" class="list">
      <view class="li" wx:for="{{history}}" wx:key="index">
        <view class="li-main"><view class="li-t">{{item.title}}</view><view class="li-d">{{item.date}}</view></view>
        <text class="li-v {{item.up ? 'up' : 'down'}}">{{item.deltaText}}</text>
      </view>
    </view>
    <view wx:else class="empty">暂无积分记录,完成消费后自动累计。</view>
  </block>
</view>
