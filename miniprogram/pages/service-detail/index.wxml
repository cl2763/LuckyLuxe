<view class="page detail-page {{themeClass}}">
  <view wx:if="{{loading || loadFailed || missing}}" class="detail-state card">
    <view class="detail-state-label">{{loading ? (lang === 'en' ? 'Loading service…' : '正在加载服务…') : (loadFailed ? (lang === 'en' ? 'Could not load service' : '服务加载失败') : (lang === 'en' ? 'Service unavailable' : '该服务已下架或不存在'))}}</view>
    <button wx:if="{{loadFailed}}" class="btn btn-primary" bindtap="refresh">{{lang === 'en' ? 'Retry' : '重试'}}</button>
    <button wx:if="{{!loading}}" class="btn btn-ghost" bindtap="toServices">{{lang === 'en' ? 'Back to services' : '返回服务列表'}}</button>
  </view>
  <block wx:if="{{service && !loading}}">
  <img-placeholder class="detail-visual" src="{{service.image}}" image-view="{{service.imageView}}" profile="detail" img-class="detail-visual"></img-placeholder>

  <view class="detail-main card">
    <view class="detail-title">{{service.name}}</view>
    <view class="detail-desc">{{service.description}}</view>
    <view class="detail-price-row">
      <view>
        <text class="price">{{service.priceLabel}}</text>
      </view>
      <view class="deposit">{{t.deposit}} {{service.depositAmount === null ? '—' : cur.p + cur.s + service.depositAmount}}</view>
    </view>
    <view class="price-boundary" wx:if="{{service.priceExplanation}}">
      <view class="price-boundary-title">{{lang === 'en' ? 'Pricing Guide' : '价格说明'}}</view>
      <view class="price-boundary-text">{{service.priceExplanation}}</view>
      <view class="price-boundary-hint">{{service.quoteHint}}</view>
    </view>
    <view class="detail-tags">
      <text>{{service.duration}}{{t.minutes}}</text>
      <text>{{service.suitableFor}}</text>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <view class="section-title">{{t.process}}</view>
    </view>
    <view class="card list-card">
      <block wx:for="{{service.process}}" wx:key="*this">
        <view class="list-row">
          <text class="step">{{index + 1}}</text>
          <text>{{item}}</text>
        </view>
      </block>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <view class="section-title">{{t.notice}}</view>
    </view>
    <view class="card list-card">
      <block wx:for="{{service.notice}}" wx:key="*this">
        <view class="notice-row">{{item}}</view>
      </block>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <view class="section-title">{{t.reference}}</view>
      <view class="section-note">{{lang === 'en' ? 'Service reference' : '服务参考'}}</view>
    </view>
    <view class="reference-grid">
      <img-placeholder class="reference-image" src="{{service.image}}" image-view="{{service.imageView}}" profile="detail" img-class="reference-image"></img-placeholder>
      <img-placeholder class="reference-image" src="{{service.image}}" image-view="{{service.imageView}}" profile="detail" img-class="reference-image"></img-placeholder>
    </view>
  </view>

  <view class="detail-bottom-space"></view>

  <view class="bottom-bar">
    <button class="btn btn-ghost bottom-fill" bindtap="addDraftToCart">{{t.addToCart}}</button>
    <button class="btn btn-primary bottom-fill" bindtap="goBooking">{{t.bookNow}}</button>
  </view>
  </block>
</view>
