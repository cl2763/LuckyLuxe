.orders-page {
  width: 100%;
  padding-left: 24rpx;
  padding-right: 24rpx;
  box-sizing: border-box;
}

.tabs {
  width: 100%;
  margin-bottom: 22rpx;
  white-space: nowrap;
  box-sizing: border-box;
}

.orders-list {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: flex-start;
  gap: 18rpx;
  width: 100%;
  min-width: 100%;
  max-width: 100%;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

.tab {
  display: inline-flex;
  height: 68rpx;
  margin-right: 12rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  align-items: center;
  background: var(--card);
  color: var(--sub);
  font-size: 25rpx;
}

.tab.active {
  background: var(--hero);
  color: var(--heroink);
}

.order-card {
  display: block;
  width: 100%;
  min-width: 100%;
  max-width: 100%;
  margin: 0;
  padding: 22rpx;
  border-radius: 16rpx;
  text-align: left;
  line-height: 1.2;
  box-sizing: border-box;
}

.order-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 18rpx;
  font-weight: 750;
}

.order-head text:first-child {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 850;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status {
  flex: none;
  color: var(--brandd);
  font-size: 25rpx;
  font-weight: 780;
}

.order-body {
  display: grid;
  grid-template-columns: 216rpx minmax(0, 1fr);
  gap: 18rpx;
  width: 100%;
  box-sizing: border-box;
}

.mini-visual {
  width: 216rpx;
  height: 150rpx;
  flex: none;
  display: block;
  border-radius: 14rpx;
}

.order-info {
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 10rpx;
  color: var(--sub);
  font-size: 25rpx;
  font-weight: 700;
}

.order-time {
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 830;
}

.empty-title {
  margin-bottom: 14rpx;
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 750;
}

.empty-btn {
  width: 240rpx;
  margin: 32rpx auto 0;
}

/* 屏 D2 徽标三态(2026-08-10 批图):已签署绿 / 已更正暖橙 / 售后中蓝 */
.status.badge-signed{color:var(--good);background:var(--goodbg)}
.status.badge-amended{color:var(--brandd);background:var(--paper)}
.status.badge-aftersales{color:var(--tagw);background:var(--tagwbg)}
.status.badge-signed,.status.badge-amended,.status.badge-aftersales{border-radius:999rpx;padding:4rpx 16rpx;font-size:22rpx;font-weight:700}
.order-info .note{font-size:22rpx;margin-top:4rpx}

/* 屏 D3 售后进度卡:三步(发起 → 跟进中 → 结果)+ 单据页入口 */
.as-card{margin-top:16rpx;padding-top:16rpx;border-top:1rpx dashed var(--line)}
.as-step{display:flex;gap:16rpx;align-items:flex-start;padding:8rpx 0}
.as-dot{width:16rpx;height:16rpx;border-radius:50%;background:var(--wall);margin-top:10rpx;flex:none}
.as-step.done .as-dot{background:var(--tagw)}
.as-body{flex:1;min-width:0}
.as-l{font-size:24rpx;color:var(--ink)}
.as-t{font-size:21rpx;color:var(--sub);margin-top:2rpx}
.as-link{margin-top:12rpx;font-size:24rpx;font-weight:700;color:var(--tagw)}
.as-foot{margin-top:10rpx;font-size:20rpx;color:var(--sub);line-height:1.6}

/* D57 待签署置顶卡 */
.pending-sign-title{font-size:26rpx;font-weight:700;color:var(--bad);margin:16rpx 24rpx 8rpx}
.pending-sign-card{display:flex;justify-content:space-between;align-items:center;margin:0 24rpx 12rpx;padding:20rpx;border:1rpx solid var(--line);background:var(--badbg)}
.ps-t{font-size:26rpx;font-weight:600;color:var(--ink)}
.ps-s{font-size:22rpx;color:var(--sub);margin-top:4rpx}.ps-btn {font-size:24rpx;color:var(--hero);background:var(--brand);border-radius:999rpx;padding:10rpx 24rpx;flex-shrink:0}
