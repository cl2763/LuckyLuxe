.home-page {
  --home-edge: 24rpx;
  padding: 24rpx var(--home-edge) 180rpx;
  overflow-x: hidden;
  box-sizing: border-box;
}

.home-section-container {
  width: 100%;
  max-width: 100%;
  margin-right: 0;
  margin-left: 0;
  box-sizing: border-box;
}

.home-landing {
  width: 100%;
  max-width: 100%;
  min-height: 0;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.top-row {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 22rpx;
}

.brand-lockup {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}

.brand-logo {
  width: 62rpx;
  height: 62rpx;
  border-radius: 50%;
  background:var(--hero);
  flex: none;
}

/* 临时 logo(浅底,无需深色底) */
.brand-logo-img {
  background:var(--card);
  border:1rpx solid var(--line);
  padding: 6rpx;
  box-sizing: border-box;
}

.brand-name {
  color:var(--ink);
  font-size: 32rpx;
  font-weight: 850;
  line-height: 1.1;
}

.brand-sub {
  margin-top: 5rpx;
  color:var(--ink);
  font-size: 20rpx;
  font-weight: 600;
}

/* ===== 一体店卡(方案A) ===== */
.shop-card {
  border-radius: 28rpx;
  overflow: hidden;
  background:var(--card);
  box-shadow: 0 10rpx 30rpx rgba(92, 70, 48, 0.08);
  margin-bottom: 24rpx;
}

.shop-card-swiper {
  width: 100%;
  height: 500rpx;
}

.shop-card-visual {
  width: 100%;
  height: 500rpx;
}

.shop-card-info {
  padding: 24rpx 26rpx 26rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.shop-card-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.shop-card-name {
  font-size: 48rpx;
  font-weight: 850;
  color:var(--ink);
  letter-spacing: 1rpx;
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  word-break: break-all;
  line-height: 1.35;
  width: 100%;
}

.shop-status {
  flex: none;
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

.shop-status.open { color:var(--good); background:var(--wall); }
.shop-status.closed { color:var(--ink); background:var(--wall); }

.shop-card-switch {
  margin-left: auto;
  flex: none;
  font-size: 22rpx;
  color:var(--brandd);
  font-weight: 600;
}

.shop-card-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.shop-row-icon {
  flex: none;
  width: 34rpx;
  color:var(--brandd);
  font-size: 24rpx;
  text-align: center;
}

.shop-row-text {
  font-size: 26rpx;
  color:var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.shop-row-act {
  margin-left: auto;
  flex: none;
  font-size: 22rpx;
  color:var(--brandd);
}

.language-switch {
  display: flex;
  width: 164rpx;
  flex: none;
  padding: 6rpx;
  border:1rpx solid var(--line);
  border-radius: 999rpx;
  background:var(--card);
}

.lang-option {
  flex: 1;
  height: 48rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color:var(--ink);
  font-size: 22rpx;
  font-weight: 760;
  line-height: 1;
}

.lang-option.active {
  background:var(--hero);
  color:var(--heroink);
}

.hero {
  width: 100%;
  flex: none;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  min-height: 0;
  padding: 22rpx;
  border-radius: 22rpx;
  background:var(--hero);
  color:var(--heroink);
  overflow: hidden;
  box-sizing: border-box;
}

.hero-copy {
  position: relative;
  z-index: 2;
  display: block;
  width: 100%;
}

.brand-mark {
  width: 78rpx;
  height: 78rpx;
  margin-bottom: 44rpx;
  border:1rpx solid var(--line);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color:var(--brandd);
  font-weight: 700;
}

.eyebrow {
  color:var(--brandd);
  font-size: 22rpx;
  font-weight: 760;
  text-transform: uppercase;
}

.hero-title {
  margin-top: 12rpx;
  font-size: 50rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.hero-text {
  margin-top: 14rpx;
  color:var(--heroink);
  font-size: 25rpx;
  line-height: 1.45;
}

.hero-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 24rpx;
}

.hero-btn {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  font-size: 25rpx;
}

.hero-swiper {
  width: 100%;
  flex: none;
  min-height: 390rpx;
  height: 390rpx;
  margin-top: 22rpx;
  border-radius: 18rpx;
  overflow: hidden;
  background:var(--hero);
}

.hero-visual {
  width: 100%;
  height: 100%;
  display: block;
  border-radius: 18rpx;
}

.quick-section {
  display: block;
  width: 100%;
  margin-top: 18rpx;
}

.quick-row {
  width: 100%;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.quick-item {
  min-width: 0;
  height: 118rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  font-size: 24rpx;
}

.quick-icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background:var(--wall);
  color:var(--brandd);
  font-size: 26rpx;   /* D110:换成字符图标后略放大,与 .shop-row-icon 视觉一致 */
  font-weight: 400;
}

.portfolio-button {
  width: 100%;
  min-width: 100%;
  max-width: 100%;
  margin-top: 14rpx;
  min-height: 108rpx;
  padding: 20rpx 22rpx;
  display: grid;
  grid-template-columns: 58rpx 1fr 34rpx;
  align-items: center;
  gap: 18rpx;
  text-align: left;
  align-self: stretch;
  box-sizing: border-box;
}

.home-page .section {
  width: 100%;
  max-width: 100%;
  margin-top: 28rpx;
  box-sizing: border-box;
}

.home-page .section-head {
  margin-bottom: 10rpx;
}

.portfolio-copy {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.portfolio-copy text:first-child {
  color:var(--ink);
  font-size: 30rpx;
  font-weight: 850;
}

.portfolio-copy text:last-child {
  color:var(--ink);
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1.35;
}

.portfolio-arrow {
  color:var(--brandd);
  font-size: 50rpx;
  line-height: 1;
  text-align: right;
}

.recommend-grid {
  width: 100%;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.recommend-card {
  display: block;
  width: 100%;
  min-width: 0;
  padding: 14rpx;
  text-align: left;
  box-sizing: border-box;
}

.recommend-visual {
  width: 100%;
  height: 170rpx;
  display: block;
  border-radius: 14rpx;
}

.recommend-name {
  margin-top: 18rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-weight: 700;
}

.recommend-meta {
  display: grid;
  gap: 6rpx;
  margin-top: 10rpx;
  color:var(--ink);
  font-size: 23rpx;
  line-height: 1.25;
}

.store-card {
  width: 100%;
  overflow: hidden;
  box-sizing: border-box;
}

.store-visual {
  width: 100%;
  height: 230rpx;
  display: block;
  border-radius: 16rpx 16rpx 0 0;
}

.store-info {
  padding: 26rpx;
}

.store-name {
  margin-bottom: 12rpx;
  font-size: 34rpx;
  font-weight: 750;
}

.store-row {
  margin-top: 14rpx;
  color:var(--ink);
  font-size: 25rpx;
}

.store-btn {
  margin-top: 24rpx;
}

.shop-bar {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin: 14rpx 0 4rpx;
  padding: 14rpx 20rpx;
  background:var(--card);
  border:1rpx solid var(--line);
  border-radius: 40rpx;
}

.shop-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background:var(--hero2);
  flex: none;
}

.shop-name {
  flex: 1;
  font-size: 23rpx;
  color:var(--ink);
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.shop-switch {
  font-size: 22rpx;
  color:var(--brandd);
  flex: none;
}

/* D17 失败态:主体区居中一行文案 + 重试按钮(书面标准,不做局部假数据) */
.d17fail{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:20rpx;padding:140rpx 40rpx}
.d17msg{color:var(--ink);font-size:27rpx}
.d17btn{border:1rpx solid var(--line);border-radius:999rpx;padding:14rpx 48rpx;font-size:27rpx;color:var(--brandd)}

/* 轮播文案(2026-08-28 六):商家在自管面板写的字要看得见,不能只活在无障碍属性里 */
.shop-card-caption {
  position: absolute; left: 0; right: 0; bottom: 0;
  padding: 40rpx 24rpx 20rpx; color:var(--heroink); font-size: 26rpx;
  background: linear-gradient(to top, rgba(0,0,0,.55), rgba(0,0,0,0));
}

/* 兜底空态:一个服务都没有时如实说一句(不给空入口卡)*/
.fallback-empty {
  padding: 32rpx 0;
  color:var(--ink);
  font-size: 26rpx;
}

/* D108:值没有时那一行只说明、不可点 —— 视觉上也要弱下去 */
.shop-card-row.muted { color:var(--sub); }
.shop-card-row.muted .shop-row-text { color:var(--sub); }

.store-name-measure { position:fixed;left:-10000rpx;top:0;white-space:nowrap;font-size:48rpx;font-weight:850;letter-spacing:1rpx;visibility:hidden; }
