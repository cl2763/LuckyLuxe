<view class="page home-page {{themeClass}}">
  <!-- D17 失败态:接口挂了如实说,不拿假数据糊住(书面标准代图)。
       ⚠️ 与正文**互斥**(wx:else),不是叠在正文上方 —— 2026-08-11 停服实测发现:
       只加 wx:if 不排除正文,失败态下面还渲染出一整个残缺骨架(缓存门店名 +
       空地址/空营业时间/空电话),等于一边说"加载失败"一边继续摆半张假门店卡。 -->
  <view wx:if="{{loadFailed}}" class="d17fail">
    <view class="d17msg">加载失败，请检查网络后重试</view>
    <view class="d17btn" bindtap="refreshLanguage">重试</view>
  </view>

  <view wx:else class="home-landing">
    <view class="top-row">
      <view class="brand-lockup">
        <!-- 临时 logo(按店主提供设计稿绘制的近似版);正式源文件到位后直接替换此 png -->
        <image class="brand-logo brand-logo-img" src="/assets/images/youji-logo.png" mode="aspectFit"></image>
        <view>
          <view class="brand-name">有迹</view>
          <view class="brand-sub">YOUJI</view>
        </view>
      </view>
      <view class="language-switch">
        <button class="lang-option {{lang === 'zh' ? 'active' : ''}}" bindtap="switchLanguage" data-lang="zh">中文</button>
        <button class="lang-option {{lang === 'en' ? 'active' : ''}}" bindtap="switchLanguage" data-lang="en">EN</button>
      </view>
    </view>

    <!-- 一体店卡(方案A 2026-07-20 定稿):轮播为卡片封面,下接 店名/状态/地址/营业时间/电话 -->
    <view class="shop-card card home-section-container">
      <!-- D78 零回落:这家店没配轮播 → 整块不渲染,只出店卡(不拿别家店的图顶上) -->
      <swiper wx:if="{{heroSlides.length}}" class="shop-card-swiper" indicator-dots="{{heroSlides.length > 1}}" circular autoplay="{{heroSlides.length > 1}}" interval="4600" current="{{activeHero}}" bindchange="onHeroChange">
        <block wx:for="{{heroSlides}}" wx:key="image">
          <swiper-item>
            <!-- 退回一(店主 02f):裸 <image src> 字段为空=空白框,踩中占位律后半句「也不许什么都不显示」。
         B 类豁免只判外层数组空不空,数组有三条、每条图都空照样渲三个空框 → 收窄到**字段级**。 -->
            <img-placeholder class="shop-card-visual" src="{{item.image}}" img-class="shop-card-visual"></img-placeholder>
            <!-- 08-28(六):文案原来只在网页的 alt 里、小程序根本没渲染 —— 商家在面板写的字要看得见 -->
            <text class="shop-card-caption" wx:if="{{item.label}}">{{item.label}}</text>
          </swiper-item>
        </block>
      </swiper>
      <view class="shop-card-info">
        <view class="shop-card-title">
          <text class="shop-card-name">{{shopName || store.storeName}}</text>
          <text wx:if="{{hasHours}}" class="shop-status {{openNow ? 'open' : 'closed'}}">● {{openNow ? (lang === 'en' ? 'Open' : '营业中') : (lang === 'en' ? 'Closed' : '休息中')}}</text>
          <text class="shop-card-switch" bindtap="switchShop">{{lang === 'en' ? 'Switch shop ›' : '扫码/切换门店 ›'}}</text>
        </view>
        <!-- 🔴 D108:有地址才出「导航·复制」;没有就只留一句如实说明,**不挂 bindtap**
             (不可用即不呈现,呈现即说明 —— 摆着又不响是第三种,永远错) -->
        <view class="shop-card-row" wx:if="{{store.address}}" bindtap="copyAddress">
          <text class="shop-row-icon">◉</text>
          <text class="shop-row-text">{{store.address}}</text>
          <text class="shop-row-act">{{lang === 'en' ? 'Map · Copy' : '导航 · 复制'}}</text>
        </view>
        <view class="shop-card-row muted" wx:else>
          <text class="shop-row-icon">◉</text>
          <text class="shop-row-text">{{store.addressText}}</text>
        </view>
        <view class="shop-card-row" bindtap="goStore">
          <text class="shop-row-icon">◷</text>
          <text class="shop-row-text">{{todayHoursText}}</text>
          <text class="shop-row-act">{{lang === 'en' ? 'All hours ›' : '全部时间 ›'}}</text>
        </view>
        <view class="shop-card-row" wx:if="{{store.phone}}" bindtap="callStore">
          <text class="shop-row-icon">✆</text>
          <text class="shop-row-text">{{store.phone}}</text>
          <text class="shop-row-act">{{lang === 'en' ? 'Call' : '一键拨打'}}</text>
        </view>
        <view class="shop-card-row muted" wx:else>
          <text class="shop-row-icon">✆</text>
          <text class="shop-row-text">{{store.phoneText}}</text>
        </view>
      </view>
    </view>

    <view class="quick-section home-section-container">
      <!-- 美甲/美睫快捷按钮已删(2026-07-20 店主定:多商户下服务不一,预约走下方推荐或服务页) -->
      <button class="portfolio-button card" bindtap="goPortfolio">
        <!-- 🔴 D110 归因一句(店主 02x 令:先归因再改):那个「P」是**硬编码的字母**
             (Portfolio 首字母),不是头像、不是数据、也不随语言变 —— 中文界面里它什么都不表示,
             看着却像一个"没加载出来的头像"。换成与本页其余图标同款的字符图标(◉ ◷ ✆ 那一套)。 -->
        <text class="quick-icon">❖</text>
        <view class="portfolio-copy">
          <text>{{technicianWorks}}</text>
          <text>{{portfolioIntro}}</text>
        </view>
        <text class="portfolio-arrow">›</text>
      </button>
      <!-- 2026-08-04 店主定:AI 在线客服入口下线——之后走企业微信外部客服,小程序里这一环不需要。
           页面代码(pages/ai-chat)保留备用,只是不再从这里进入。要复活:恢复这段 + app.json 重新注册。 -->
    </view>
  </view>

  <!-- 失败态下这两块也要收起来:否则页面上只剩两个「人气美甲/人气美睫」空标题
       悬在失败提示下面 —— 正是《闭环回归纪律》说的"单独蹦出来找不到上下文"的状态 -->
  <!-- 🔴 D103②(店主 02y 裁定三):少于 2 张时**整个分区不出现**。
       1 张卡占半幅、右半空着,店主会觉得坏了;占满整行又比 2 卡态大一倍,两个分区一大一小更怪。
       而「人气美甲」这个标题本身承诺"有得挑",只有一个项目时这个承诺是假的。
       归族「不该有=整块不出现」+ 店主 02y 新律「不可用即不呈现」。完整目录在「服务」页,不丢东西。 -->
  <view wx:if="{{!loadFailed && recommendedNail.length >= 2}}" class="section home-section-container">
    <view class="section-head">
      <view class="section-title">{{t.popularNail}}</view>
      <view class="section-note">Popular nail</view>
    </view>
    <view class="recommend-grid">
      <block wx:for="{{recommendedNail}}" wx:key="_id">
        <view class="recommend-card card" bindtap="goDetail" data-id="{{item._id}}">
          <img-placeholder class="recommend-visual" src="{{item.image}}" img-class="recommend-visual"></img-placeholder>
          <view class="recommend-name">{{item.name}}</view>
          <view class="recommend-meta">
            <text class="price">{{cur.p}}{{cur.s}}{{item.price}}</text>
            <text>{{item.duration}}{{t.minutes}}</text>
          </view>
        </view>
      </block>
    </view>
  </view>

  <view wx:if="{{!loadFailed && recommendedLash.length >= 2}}" class="section home-section-container">
    <view class="section-head">
      <view class="section-title">{{t.popularLash}}</view>
      <view class="section-note">Popular lash</view>
    </view>
    <view class="recommend-grid">
      <block wx:for="{{recommendedLash}}" wx:key="_id">
        <view class="recommend-card card" bindtap="goDetail" data-id="{{item._id}}">
          <img-placeholder class="recommend-visual" src="{{item.image}}" img-class="recommend-visual"></img-placeholder>
          <view class="recommend-name">{{item.name}}</view>
          <view class="recommend-meta">
            <text class="price">{{cur.p}}{{cur.s}}{{item.price}}</text>
            <text>{{item.duration}}{{t.minutes}}</text>
          </view>
        </view>
      </block>
    </view>
  </view>

  <!-- 🔴 兜底(店主 02z):两个「人气」分区都够不到 2 张时,首页会只剩店卡 + 一个空作品入口。
       新店第一天开张必然经过这一天。这里用**中性标题**列服务目录前几项 —— 不承诺"人气",顾客真能点进去。
       服务一个都没有时:**不给入口卡**(那是把空推给下一页),如实说一句。 -->
  <view wx:if="{{!loadFailed && recommendedNail.length < 2 && recommendedLash.length < 2}}" class="section home-section-container">
    <view class="section-head">
      <view class="section-title">{{t.ourServices}}</view>
      <view class="section-note" wx:if="{{fallbackServices.length}}" bindtap="goServices">{{t.allServices}}</view>
    </view>
    <!-- 🔴 03a:这句原来挂在 JS 派生态 fallbackEmptyNote 上 —— **造态时它不跟着变**,
         现测服务总数=0 时这句根本没出现(与 fallbackOn 一模一样的病,上一轮改了一个漏了另一个)。
         改成直接读数组长度 + i18n 唯一出处;它有自己的身份类,**既算"首页有东西可看"也能被判据点名**。 -->
    <view wx:if="{{!fallbackServices.length}}" class="fallback-empty">{{t.emptyServiceNote}}</view>
    <view wx:else class="recommend-grid">
      <block wx:for="{{fallbackServices}}" wx:key="_id">
        <view class="recommend-card card fallback-card" bindtap="goDetail" data-id="{{item._id}}">
          <img-placeholder class="recommend-visual" src="{{item.image}}" img-class="recommend-visual"></img-placeholder>
          <view class="recommend-name">{{item.name}}</view>
          <view class="recommend-meta">
            <text class="price">{{cur.p}}{{cur.s}}{{item.price}}</text>
            <text>{{item.duration}}{{t.minutes}}</text>
          </view>
        </view>
      </block>
    </view>
  </view>

  <!-- 门店展示区已并入首屏一体店卡(2026-07-20 店主定),不再重复展示 -->
</view>
