.benefits-page {
  padding: 24rpx 24rpx 180rpx;
}

.benefit-hero {
  margin: -24rpx -24rpx 0;
  padding: 28rpx 0 42rpx;
  background: var(--hero);
}

.level-swiper {
  height: 336rpx;
}

.level-swiper swiper-item {
  box-sizing: border-box;
  padding: 0 8rpx;
}

.level-card {
  min-height: 310rpx;
  padding: 30rpx;
  border-radius: 18rpx;
  background:linear-gradient(135deg,var(--hero),var(--hero2));
  color: var(--heroink);
}

.level-card.silver {
  background:linear-gradient(135deg,var(--hero),var(--hero2));
}

.level-card.gold {
  background:linear-gradient(135deg,var(--hero),var(--hero2));
}

.level-card.platinum {
  background:linear-gradient(135deg,var(--hero),var(--hero2));
}

.level-card.diamond {
  background:linear-gradient(135deg,var(--hero),var(--hero2));
}

.level-tag {
  font-size: 24rpx;
  font-weight: 800;
}

.level-title {
  margin-top: 58rpx;
  font-size: 36rpx;
  font-weight: 880;
  line-height: 1.18;
}

.level-note {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 23rpx;
  font-weight: 650;
  line-height: 1.45;
}

.benefit-progress {
  height: 12rpx;
  margin-top: 22rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background:var(--card);
}

.benefit-progress view {
  height: 100%;
  border-radius: 999rpx;
  background: var(--card);
}

.progress-copy {
  margin-top: 10rpx;
  text-align: right;
  color: rgba(255, 255, 255, 0.82);
  font-size: 22rpx;
  font-weight: 750;
}

.benefit-section {
  margin-top: 34rpx;
}

.benefit-title {
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 850;
}

.benefit-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 26rpx 12rpx;
  margin-top: 24rpx;
}

.benefit-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  text-align: center;
}

.benefit-icon {
  width: 62rpx;
  height: 62rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--wall);
  color: var(--brandd);
  font-size: 24rpx;
  font-weight: 850;
}

.benefit-item text {
  color: var(--sub);
  font-size: 21rpx;
  font-weight: 650;
  line-height: 1.3;
}

.gift-card {
  margin-top: 16rpx;
  padding: 22rpx 24rpx;
  display: grid;
  grid-template-columns: 190rpx 1fr;
  align-items: center;
  gap: 18rpx;
  border-color: var(--brand);
  background:linear-gradient(135deg,var(--hero),var(--hero2));
}

.gift-card view {
  color: var(--brandd);
  font-size: 26rpx;
  font-weight: 800;
}

.gift-card text {
  min-height: 66rpx;
  padding: 0 18rpx;
  border: 1rpx solid var(--brand);
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--brandd);
  font-size: 25rpx;
  font-weight: 850;
  text-align: center;
}

/* 不分级店成为会员承接区 */
.plain-join { margin: 24rpx; padding: 28rpx; border-radius: 16rpx; background: var(--card); }
.pj-title { font-size: 34rpx; font-weight: 600; }
.pj-line { font-size: 26rpx; color: var(--sub); margin-top: 10rpx; }
.pj-sub { font-size: 26rpx; font-weight: 600; margin-top: 20rpx; }
.pj-perk { font-size: 26rpx; color: var(--ink); line-height: 44rpx; }
