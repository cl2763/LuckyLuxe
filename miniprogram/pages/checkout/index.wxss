.first-head {
  margin-bottom: 18rpx;
}

.checkout-item {
  display: flex;
  gap: 18rpx;
  align-items: flex-start;
  padding: 16rpx;
  margin-bottom: 18rpx;
  box-sizing: border-box;
}

.mini-visual {
  width: 150rpx;
  height: 150rpx;
  flex: none;
  display: block;
  border-radius: 14rpx;
}

.checkout-info {
  flex: 1;
  min-width: 0;
}

.checkout-title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #342b28;
  font-size: 31rpx;
  font-weight: 850;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.checkout-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.checkout-status {
  flex: none;
  color: #c39b76;
  font-size: 24rpx;
  font-weight: 760;
}

.checkout-time-row,
.checkout-meta {
  display: grid;
  gap: 6rpx;
  margin-top: 12rpx;
  color: #8a7f78;
  font-size: 23rpx;
  font-weight: 700;
}

.cost-card,
.store-box {
  padding: 24rpx;
}

.cost-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 76rpx;
  border-bottom: 1rpx solid #f0e8e1;
}

.cost-row:last-child {
  border-bottom: none;
}

.switch-row {
  min-height: 98rpx;
}

.store-name {
  margin-bottom: 12rpx;
  font-size: 30rpx;
  font-weight: 750;
}

.store-box .muted {
  margin-top: 10rpx;
}

.deposit-policy {
  padding: 24rpx;
}

.deposit-policy-title {
  color: #342b28;
  font-size: 30rpx;
  font-weight: 850;
}

.deposit-policy-text {
  margin-top: 12rpx;
  color: #8a7f78;
  font-size: 24rpx;
  font-weight: 720;
  line-height: 1.55;
  white-space: pre-wrap; /* 商家自定义原文按 custom 模式逐行展示(自动生成的文案没有换行,旗舰店观感不变) */
}

.remark {
  width: 100%;
  height: 160rpx;
  padding: 22rpx;
  line-height: 1.5;
}

.pay-btn {
  width: 240rpx;
  min-width: 0;
}

/* 屏 3｜定金规则展示(2026-08-08 P1 批3) */
.dcard{background:linear-gradient(135deg,#2d2826,#4a3f39);color:#fff;border-radius:20rpx;padding:26rpx 24rpx}
.dcard .l{font-size:23rpx;opacity:.8;line-height:1.7}
.dcard .amt{font-size:62rpx;font-weight:850;margin:6rpx 0 4rpx;letter-spacing:-1rpx}
.keyfacts{display:flex;gap:12rpx;margin-top:14rpx}
.keyfacts .kf{flex:1;background:#fff;border:1rpx solid #eadfd7;border-radius:14rpx;padding:16rpx 8rpx;text-align:center}
.keyfacts .kf .v{display:block;font-size:26rpx;font-weight:800;color:#241f1d}
.keyfacts .kf .k{display:block;font-size:20rpx;color:#9a8c7c;margin-top:4rpx}
.deposit-policy-title .from{font-size:20rpx;font-weight:400;color:#9a8c7c;margin-left:10rpx}
