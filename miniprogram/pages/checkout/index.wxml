<view class="page checkout-page {{themeClass}}">
<view class="section-note">{{lang==='en'?'Prices shown are for reference. Personal discounts and eligible offers are confirmed on the service document.':'展示价格用于预约参考；个人折扣及符合条件的优惠将在服务确认单中核对。'}}</view>
  <view class="section-head first-head">
    <view class="section-title">{{t.confirm}}</view>
  </view>

  <block wx:for="{{items}}" wx:key="_id">
    <view class="checkout-item card">
      <img-placeholder class="mini-visual" src="{{item.service.image}}" img-class="mini-visual"></img-placeholder>
      <view class="checkout-info">
        <view class="checkout-title-row">
          <text class="checkout-title">{{item.service.name}}</text>
          <text class="checkout-status">{{t.statusPendingPayment}}</text>
        </view>
        <view class="checkout-time-row">
          <text>{{item.appointmentInfo.date}}</text>
          <text>{{item.appointmentInfo.time}}</text>
          <text>{{item.service.duration}}{{t.minutes}}</text>
        </view>
        <view class="checkout-meta">
          <text class="price">{{t.deposit}} {{item.service.depositAmount === null ? '—' : cur.p + cur.s + item.service.depositAmount}}</text>
          <text>{{lang==='en'?'Service reference price':'服务参考价'}} {{cur.p}}{{cur.s}}{{item.service.price}}</text>
        </view>
      </view>
    </view>
  </block>

  <view class="section">
    <view class="section-head">
      <view class="section-title">{{t.discount}}</view>
    </view>
    <view class="cost-card card"><view wx:if="{{pending}}">上次预约结果待核实，原项目与抵扣选择已保留，请重试原操作。</view><block wx:else><view class="cost-row switch-row"><text>使用储值抵扣定金</text><switch checked="{{useBalance}}" disabled="{{busy}}" bindchange="toggleBalance"/></view><view wx:if="{{previewLoading}}">正在核对定金与余额…</view><block wx:if="{{preview}}"><view class="cost-row"><text>预约定金</text><text>{{preview.display.requiredText}}</text></view><view class="cost-row"><text>会员减免</text><text>{{preview.display.waivedText}}</text></view><view class="cost-row"><text>留存定金</text><text>{{preview.display.retainedText}}</text></view><view class="cost-row"><text>储值抵扣</text><text>{{preview.display.storedText}}</text></view><view class="cost-row"><text>到店还需支付</text><text>{{preview.display.offlineText}}</text></view><view class="cost-row"><text>当前余额</text><text>{{preview.display.balanceBeforeText}}</text></view><view class="cost-row"><text>抵扣后余额</text><text>{{preview.display.balanceAfterText}}</text></view><view>{{preview.display.note}}</view></block><button wx:if="{{!preview && !previewLoading}}" bindtap="calculate">重新核对</button></block><view wx:if="{{error}}">{{error}}</view></view>
  </view>

  <view class="section">
    <view class="section-head">
      <view class="section-title">{{t.store}}</view>
    </view>
    <view class="store-box card">
      <view class="store-name">{{store.storeName}}</view>
      <view class="muted">{{store.address}}</view>
      <view class="muted">{{store.phone}} · {{store.businessHours}}</view>
    </view>
  </view>

  <!-- 屏 3｜定金规则展示。金额、三要点、原文全部来自 GET /deposit-policy,本页不算不编 -->
  <block wx:if="{{policy}}">
    <view class="section" wx:if="{{policy.enabled}}">
      <view class="dcard">
        <view class="l">{{lang === 'en' ? 'Booking deposit' : '预约定金（订位费）'}}</view>
        <view class="amt">{{policy.amountText}}</view>
        <view class="l">{{policy.deductible ? (lang === 'en' ? 'Deducted from your bill' : '可抵扣本次消费') : (lang === 'en' ? 'Not deducted from the bill' : '不抵扣尾款')}}</view>
      </view>
      <view class="keyfacts">
        <view class="kf" wx:for="{{policy.keyFacts}}" wx:for-item="f" wx:key="key">
          <text class="v">{{f.value}}</text><text class="k">{{f.label}}</text>
        </view>
      </view>
    </view>
    <view class="section">
      <view class="deposit-policy card">
        <view class="deposit-policy-title">{{t.depositPolicyTitle}}<text class="from">{{lang === 'en' ? 'from this store' : '来自本店'}}</text></view>
        <view class="deposit-policy-text">{{policy.text}}</view>
      </view>
    </view>
  </block>
  <view class="section" wx:else>
    <view class="deposit-policy card">
      <view class="deposit-policy-title">{{t.depositPolicyTitle}}</view>
      <view class="deposit-policy-text">{{t.depositPolicyText}}</view>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <view class="section-title">{{t.orderRemark}}</view>
    </view>
    <textarea class="remark card" maxlength="100" placeholder="{{t.remarkPlaceholder}}" value="{{remark}}" disabled="{{busy || pending}}" bindinput="inputRemark"></textarea>
  </view>

  <view class="bottom-bar">
    <view class="bottom-fill">
      <view class="muted">{{t.payable}}</view>
      <view class="price">{{preview.display.offlineText || '—'}}</view>
    </view>
    <button class="btn btn-primary pay-btn" bindtap="submitOrder" loading="{{busy}}" disabled="{{busy || (!pending && !preview)}}">{{pending?'核对／重试原预约':'确认预约'}}</button>
  </view>
</view>
