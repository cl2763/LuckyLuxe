<view class="page checkout-page">
  <view class="section-head first-head">
    <view class="section-title">{{t.confirm}}</view>
    <view class="section-note">{{t.mockPay}}</view>
  </view>

  <block wx:for="{{items}}" wx:key="_id">
    <view class="checkout-item card">
      <image class="mini-visual" src="{{item.service.image}}" mode="aspectFill"></image>
      <view class="checkout-info">
        <view class="checkout-title-row">
          <text class="checkout-title">{{item.service.name}}</text>
          <text class="checkout-status">{{t.statusPendingPayment}}</text>
        </view>
        <view class="checkout-time-row">
          <text>{{item.appointmentInfo.date}}</text>
          <text>{{item.appointmentInfo.time}}</text>
          <text>{{item.service.duration}}{{t.minutes}}</text>
        </view>
        <view class="checkout-meta">
          <text class="price">{{t.deposit}} {{cur.p}}{{cur.s}}{{item.service.depositAmount}}</text>
          <text>{{t.servicePrice}} {{cur.p}}{{cur.s}}{{item.service.price}}</text>
        </view>
      </view>
    </view>
  </block>

  <view class="section">
    <view class="section-head">
      <view class="section-title">{{t.discount}}</view>
    </view>
    <view class="cost-card card">
      <view class="cost-row">
        <text>{{t.appointmentDeposit}}</text>
        <text>{{cur.p}}{{cur.s}}{{serviceDeposit}}</text>
      </view>
      <view wx:if="{{depositWaived}}" class="cost-row">
        <text>{{lang === 'en' ? 'Member deposit waiver' : '会员定金减免'}}</text>
        <text>-{{cur.p}}{{cur.s}}{{depositWaivedAmount}}</text>
      </view>
      <view class="cost-row switch-row">
        <view>
          <view>{{t.balance}}</view>
          <!-- 修:{{}} 里再套 {{}} 是字面量,顾客看到的是「余额 {{cur.p}}{{cur.s}}4500」原文
               (2026-08-11 D20 停服实测截图顺带抓到的存量缺陷) -->
          <view class="muted">{{lang === 'en' ? ('Balance ' + cur.p + cur.s + memberBalance + ', pay deposit from balance') : ('余额 ' + cur.p + cur.s + memberBalance + ',用储值抵扣定金,充足时无需另付')}}</view>
        </view>
        <switch color="#C6A27E" checked="{{useBalance}}" bindchange="toggleBalance"></switch>
      </view>
      <view wx:if="{{balanceDeduction}}" class="cost-row">
        <text>{{t.balanceDeduction}}</text>
        <text>-{{cur.p}}{{cur.s}}{{balanceDeduction}}</text>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <view class="section-title">{{t.store}}</view>
    </view>
    <view class="store-box card">
      <view class="store-name">{{store.storeName}}</view>
      <view class="muted">{{store.address}}</view>
      <view class="muted">{{store.phone}} · {{store.businessHours}}</view>
    </view>
  </view>

  <!-- 屏 3｜定金规则展示。金额、三要点、原文全部来自 GET /deposit-policy,本页不算不编 -->
  <block wx:if="{{policy}}">
    <view class="section" wx:if="{{policy.enabled}}">
      <view class="dcard">
        <view class="l">{{lang === 'en' ? 'Booking deposit' : '预约定金（订位费）'}}</view>
        <view class="amt">{{policy.amountText}}</view>
        <view class="l">{{policy.deductible ? (lang === 'en' ? 'Deducted from your bill' : '可抵扣本次消费') : (lang === 'en' ? 'Not deducted from the bill' : '不抵扣尾款')}}</view>
      </view>
      <view class="keyfacts">
        <view class="kf" wx:for="{{policy.keyFacts}}" wx:for-item="f" wx:key="key">
          <text class="v">{{f.value}}</text><text class="k">{{f.label}}</text>
        </view>
      </view>
    </view>
    <view class="section">
      <view class="deposit-policy card">
        <view class="deposit-policy-title">{{t.depositPolicyTitle}}<text class="from">{{lang === 'en' ? 'from this store' : '来自本店'}}</text></view>
        <view class="deposit-policy-text">{{policy.text}}</view>
      </view>
    </view>
  </block>
  <view class="section" wx:else>
    <view class="deposit-policy card">
      <view class="deposit-policy-title">{{t.depositPolicyTitle}}</view>
      <view class="deposit-policy-text">{{t.depositPolicyText}}</view>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <view class="section-title">{{t.orderRemark}}</view>
    </view>
    <textarea class="remark card" maxlength="100" placeholder="{{t.remarkPlaceholder}}" value="{{remark}}" bindinput="inputRemark"></textarea>
  </view>

  <view class="bottom-bar">
    <view class="bottom-fill">
      <view class="muted">{{t.payable}}</view>
      <view class="price">{{cur.p}}{{cur.s}}{{payableAmount}}</view>
    </view>
    <button class="btn btn-primary pay-btn" bindtap="submitOrder">{{payActionText || t.payAction}}</button>
  </view>
</view>
