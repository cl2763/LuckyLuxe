.about-page { padding: 24rpx; }
.about-card { background: var(--card); border-radius: 16rpx; padding: 32rpx; }
.about-title { font-size: 32rpx; font-weight: 600; margin-bottom: 24rpx; }
.about-row { display: flex; justify-content: space-between; padding: 16rpx 0; border-bottom: 1rpx solid var(--line); }
.about-k { color: var(--sub); font-size: 26rpx; }
.about-v { color: var(--ink); font-size: 26rpx; }
.about-note { margin-top: 24rpx; color: var(--sub); font-size: 24rpx; line-height: 1.6; }
